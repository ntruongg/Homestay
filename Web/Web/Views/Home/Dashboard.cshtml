@model OwnerDashboardViewModel

@{
    Layout = null;
    ViewData["Title"] = "Bảng điều khiển chủ nhà - Stayly";

    var approvedProps = Model.Properties.Where(p => (p.ApprovalStatus ?? "").Equals("Approved", StringComparison.OrdinalIgnoreCase)).ToList();
    var pendingProps = Model.Properties.Where(p => (p.ApprovalStatus ?? "").Equals("Pending", StringComparison.OrdinalIgnoreCase)).ToList();
    var rejectedProps = Model.Properties.Where(p => (p.ApprovalStatus ?? "").Equals("Rejected", StringComparison.OrdinalIgnoreCase)).ToList();
}

<!doctype html>
<html lang="vi">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>@ViewData["Title"]</title>

    <!-- Google Fonts DM Sans -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,400..800;1,9..40,400..800&display=swap" rel="stylesheet">

    <!-- Bootstrap 5.3 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <!-- Custom CSS (Soft & Harmonious Monochromatic Ocean Blue) -->
    <link rel="stylesheet" href="/css/site.css" asp-append-version="true">
</head>
<body class="dashboard-body-wrapper">

    <!-- ==========================================================================
         1. Sidebar (Cột trái, rộng ~250px, fixed, nền #caf0f8, góc phải bo tròn 24px)
         ========================================================================== -->
    <aside class="dashboard-sidebar-fixed">
        <div>
            <!-- Logo Stayly to, in đậm, màu Primary -->
            <a href="/" class="dashboard-sidebar-logo">
                <span class="brand-icon"><i class="bi bi-water"></i></span>
                <span>Stayly</span>
            </a>
            <span class="dashboard-sidebar-tag">Host Dashboard</span>

            <!-- 3 Tabs dạng menu dọc -->
            <nav class="dashboard-nav-tabs">
                <!-- Tab 1: Quản lý cơ sở (Mặc định active) -->
                <button type="button" class="dashboard-tab-link active" data-tab-target="tabProperties" id="tabBtnProperties" onclick="switchDashboardTab('tabProperties', this)">
                    <i class="bi bi-houses-fill"></i>
                    <span>Quản lý cơ sở</span>
                </button>

                <!-- Tab 2: Quản lý đơn đặt phòng -->
                <button type="button" class="dashboard-tab-link" data-tab-target="tabBookings" id="tabBtnBookings" onclick="switchDashboardTab('tabBookings', this)">
                    <i class="bi bi-calendar2-check-fill"></i>
                    <span>Quản lý đơn đặt phòng</span>
                </button>

                <!-- Tab 3: Quản lý đánh giá -->
                <button type="button" class="dashboard-tab-link" data-tab-target="tabReviews" id="tabBtnReviews" onclick="switchDashboardTab('tabReviews', this)">
                    <i class="bi bi-chat-square-quote-fill"></i>
                    <span>Quản lý đánh giá</span>
                </button>
            </nav>
        </div>

        <!-- Đáy Sidebar: Nút Về trang chủ & Nút Đăng xuất -->
        <div class="dashboard-sidebar-footer">
            <a href="/" class="btn-dashboard-home">
                <i class="bi bi-arrow-left"></i>
                <span>Về trang chủ</span>
            </a>

            <form asp-controller="Home" asp-action="Logout" method="post" id="dashboardLogoutForm">
                <button type="submit" class="btn-dashboard-logout" onclick="handleDashboardLogout()">
                    <i class="bi bi-box-arrow-right"></i>
                    <span>Đăng xuất</span>
                </button>
                @Html.AntiForgeryToken()
            </form>
        </div>
    </aside>

    <!-- ==========================================================================
         2. Main Content (Nội dung chính bên phải, nền #f8f9fc, thay đổi theo Tab)
         ========================================================================== -->
    <main class="dashboard-main-content">
        <!-- Top Bar Chào Đón & Thông tin chung -->
        <div class="dashboard-header-bar">
            <div class="dashboard-title-group">
                <h1 id="currentTabHeading">Quản lý cơ sở lưu trú</h1>
                <p id="currentTabSubheading">Theo dõi tình trạng hoạt động, hồ sơ xét duyệt và thông tin các cơ sở của bạn.</p>
            </div>
            <div class="d-flex align-items-center gap-3">
                <div class="text-end d-none d-sm-block">
                    <div class="fw-bold text-dark small">Chủ cơ sở lưu trú</div>
                    <div class="text-muted small">@DateTime.Now.ToString("dd/MM/yyyy")</div>
                </div>
                <div class="user-avatar-circle" style="width: 42px; height: 42px; font-size: 1.05rem;">
                    H
                </div>
            </div>
        </div>

        <!-- ==========================================================================
             TAB 1: QUẢN LÝ CƠ SỞ (Property Management - Mặc định active)
             ========================================================================== -->
        <section class="dashboard-tab-view active" id="tabProperties">
            <!-- Top row (Thống kê): 3 khối hình chữ nhật bo tròn 16px, nền #caf0f8, chữ & số to màu #0077b6 -->
            <div class="row g-4 mb-4">
                <!-- Khối 1: Cơ sở đang hoạt động -->
                <div class="col-md-4">
                    <div class="stat-card-harmonious">
                        <div class="stat-number-prominent">@approvedProps.Count</div>
                        <p class="stat-label-text">Cơ sở đang hoạt động</p>
                    </div>
                </div>

                <!-- Khối 2: Đang chờ duyệt -->
                <div class="col-md-4">
                    <div class="stat-card-harmonious">
                        <div class="stat-number-prominent">@pendingProps.Count</div>
                        <p class="stat-label-text">Đang chờ duyệt</p>
                    </div>
                </div>

                <!-- Khối 3: Bị từ chối duyệt -->
                <div class="col-md-4">
                    <div class="stat-card-harmonious">
                        <div class="stat-number-prominent">@rejectedProps.Count</div>
                        <p class="stat-label-text">Bị từ chối duyệt</p>
                    </div>
                </div>
            </div>

            <!-- Header Danh sách cơ sở -->
            <div class="d-flex align-items-center justify-content-between mb-3">
                <h3 class="fs-5 fw-bold mb-0 text-navy">Danh sách cơ sở của bạn</h3>
                <span class="text-muted small">Tổng số: <strong>@Model.Properties.Count</strong> cơ sở</span>
            </div>

            <!-- Bottom row (Danh sách cơ sở): List thẻ nằm ngang (ảnh thumbnail bo góc trái + thông tin phải) -->
            <div class="properties-list-container" id="propertiesListWrapper">
                @if (Model.Properties.Count == 0)
                {
                    <div class="card p-5 text-center border-0" style="border-radius: 16px; box-shadow: var(--stayly-shadow);">
                        <i class="bi bi-house-add text-primary display-4 mb-3"></i>
                        <h4 class="fw-bold text-navy">Bạn chưa đăng ký cơ sở lưu trú nào</h4>
                        <p class="text-muted small">Hãy tạo cơ sở đầu tiên để bắt đầu đón những vị khách tuyệt vời.</p>
                    </div>
                }
                else
                {
                    @foreach (var prop in Model.Properties)
                    {
                        var status = prop.ApprovalStatus ?? "Approved";
                        var isApproved = status.Equals("Approved", StringComparison.OrdinalIgnoreCase);
                        var isPending = status.Equals("Pending", StringComparison.OrdinalIgnoreCase);
                        var thumbUrl = !string.IsNullOrWhiteSpace(prop.CoverImageUrl)
                            ? prop.CoverImageUrl
                            : "https://images.unsplash.com/photo-1542314831-068cd1dbfeeb?auto=format&fit=crop&w=800&q=80";

                        <article class="property-card-host">
                            <div class="row g-0">
                                <!-- Thumbnail bo góc 16px bên trái -->
                                <div class="col-md-4 col-lg-3">
                                    <div class="property-thumb-container">
                                        <img src="@thumbUrl" alt="@prop.Name" class="property-thumb-img" loading="lazy">
                                    </div>
                                </div>

                                <!-- Thông tin cơ sở bên phải -->
                                <div class="col-md-8 col-lg-9">
                                    <div class="property-info-container">
                                        <div>
                                            <div class="d-flex align-items-center justify-content-between mb-2">
                                                <span class="property-status-pill @(isApproved ? "status-approved" : isPending ? "status-pending" : "status-rejected")">
                                                    <i class="bi @(isApproved ? "bi-check-circle-fill" : isPending ? "bi-clock-fill" : "bi-x-circle-fill")"></i>
                                                    @(isApproved ? "Đang hoạt động" : isPending ? "Đang chờ duyệt" : "Bị từ chối")
                                                </span>
                                                <span class="badge bg-light text-primary rounded-pill px-3 py-1 fw-bold text-uppercase small">
                                                    @(prop.Type ?? "Homestay")
                                                </span>
                                            </div>

                                            <h3 class="fs-5 fw-bold text-navy mb-1">@prop.Name</h3>
                                            <p class="text-muted small mb-2">
                                                <i class="bi bi-geo-alt-fill text-primary me-1"></i>
                                                @(prop.Address ?? $"{prop.Ward}, {prop.City}")
                                            </p>

                                            @if (!string.IsNullOrWhiteSpace(prop.RejectionReason))
                                            {
                                                <div class="alert alert-danger py-2 px-3 small rounded-3 mb-2">
                                                    <i class="bi bi-exclamation-triangle-fill me-1"></i>
                                                    <strong>Lý do từ chối:</strong> @prop.RejectionReason
                                                </div>
                                            }
                                            else if (!string.IsNullOrWhiteSpace(prop.Policy))
                                            {
                                                <p class="text-muted small mb-2 text-truncate" style="max-width: 600px;">
                                                    <i class="bi bi-info-circle text-primary me-1"></i> @prop.Policy
                                                </p>
                                            }

                                            <div class="d-flex align-items-center gap-3 text-muted small">
                                                <span><i class="bi bi-door-open me-1 text-primary"></i> @prop.RoomsCount phòng</span>
                                                <span><i class="bi bi-telephone me-1 text-primary"></i> @(prop.Phone ?? "0912345678")</span>
                                            </div>
                                        </div>

                                        <!-- Action: Nút Xem chi tiết ở cạnh dưới cùng bo tròn 50px -->
                                        <div class="d-flex align-items-center justify-content-between pt-3 mt-3 border-top">
                                            <span class="text-muted small">Mã cơ sở: <strong>#CS-@prop.Id</strong></span>
                                            <a href="/Home/Details/@prop.Id" class="btn btn-sm btn-primary rounded-pill px-4 fw-bold shadow-sm">
                                                <span>Xem chi tiết</span>
                                                <i class="bi bi-arrow-right-short fs-6"></i>
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </article>
                    }
                }
            </div>
        </section>

        <!-- ==========================================================================
             TAB 2: QUẢN LÝ ĐƠN ĐẶT PHÒNG (Booking Management)
             ========================================================================== -->
        <section class="dashboard-tab-view" id="tabBookings">
            <!-- Top row (Bộ lọc): Thanh ngang trắng, shadow mượt, bo góc 50px, 2 Dropdown -->
            <div class="filter-bar-pill-card">
                <!-- Dropdown 1: Lọc theo Cơ sở -->
                <div class="d-flex align-items-center gap-2">
                    <label for="filterBookingProperty">
                        <i class="bi bi-building"></i>
                        <span>Cơ sở:</span>
                    </label>
                    <select id="filterBookingProperty" class="filter-select-round" onchange="filterBookingsList()">
                        <option value="all">Tất cả cơ sở</option>
                        @foreach (var p in Model.Properties)
                        {
                            <option value="@p.Name">@p.Name</option>
                        }
                    </select>
                </div>

                <!-- Dropdown 2: Lọc theo Trạng thái -->
                <div class="d-flex align-items-center gap-2">
                    <label for="filterBookingStatus">
                        <i class="bi bi-funnel"></i>
                        <span>Trạng thái:</span>
                    </label>
                    <select id="filterBookingStatus" class="filter-select-round" onchange="filterBookingsList()">
                        <option value="all">Tất cả trạng thái</option>
                        <option value="Pending">Chờ duyệt (Pending)</option>
                        <option value="Confirmed">Đã xác nhận (Confirmed)</option>
                        <option value="Completed">Hoàn thành (Completed)</option>
                        <option value="Cancelled">Đã hủy (Cancelled)</option>
                    </select>
                </div>

                <div class="ms-auto text-muted small" id="bookingCountIndicator">
                    Hiển thị: <strong>@Model.Bookings.Count</strong> đơn
                </div>
            </div>

            <!-- Bottom row (Danh sách đơn): List card nối tiếp nhau -->
            <div class="booking-cards-wrapper" id="bookingCardsContainer">
                @if (Model.Bookings.Count == 0)
                {
                    <div class="card p-5 text-center border-0" style="border-radius: 16px; box-shadow: var(--stayly-shadow);">
                        <i class="bi bi-inbox text-muted display-4 mb-3"></i>
                        <h4 class="fw-bold text-navy">Chưa có đơn đặt phòng nào</h4>
                        <p class="text-muted small">Các đơn đặt phòng mới từ khách hàng sẽ xuất hiện tại đây.</p>
                    </div>
                }
                else
                {
                    @foreach (var bk in Model.Bookings)
                    {
                        var statusClass = bk.Status switch
                        {
                            "Confirmed" => "status-approved",
                            "Pending" => "status-pending",
                            "Completed" => "status-approved",
                            _ => "status-rejected"
                        };
                        var statusText = bk.Status switch
                        {
                            "Confirmed" => "Đã xác nhận",
                            "Pending" => "Chờ duyệt",
                            "Completed" => "Hoàn thành",
                            "Cancelled" => "Đã hủy",
                            _ => bk.Status
                        };
                        var roomsText = bk.RoomNumbers != null && bk.RoomNumbers.Count > 0
                            ? string.Join(", ", bk.RoomNumbers)
                            : "Phòng tiêu chuẩn";

                        <div class="booking-item-card" 
                             data-property="@bk.PropertyName" 
                             data-status="@bk.Status"
                             data-id="@bk.Id"
                             data-guest="@bk.GuestName"
                             data-checkin="@bk.CheckIn.ToString("dd/MM/yyyy")"
                             data-checkout="@bk.CheckOut.ToString("dd/MM/yyyy")"
                             data-amount="@bk.TotalAmount.ToString("N0") ₫"
                             data-phone="@bk.GuestPhone"
                             data-email="@bk.GuestEmail"
                             data-guests="@bk.GuestCount"
                             data-rooms="@roomsText">
                            <!-- Cột 1: Mã đơn & Tên khách -->
                            <div style="min-width: 200px;">
                                <span class="booking-id-tag">#BK-@bk.Id</span>
                                <h4 class="fs-6 fw-bold text-navy mb-1">
                                    <i class="bi bi-person-fill text-primary me-1"></i> @bk.GuestName
                                </h4>
                                <div class="text-muted small">
                                    <i class="bi bi-telephone text-muted me-1"></i> @bk.GuestPhone
                                </div>
                            </div>

                            <!-- Cột 2: Cơ sở & Ngày đến / đi -->
                            <div style="min-width: 220px;">
                                <div class="fw-bold text-dark small mb-1">
                                    <i class="bi bi-house-door text-primary me-1"></i> @bk.PropertyName
                                </div>
                                <div class="text-muted small">
                                    <span>Phòng: @roomsText</span>
                                </div>
                                <div class="text-muted small mt-1">
                                    <i class="bi bi-calendar-event me-1"></i> @bk.CheckIn.ToString("dd/MM/yyyy") &rarr; @bk.CheckOut.ToString("dd/MM/yyyy")
                                </div>
                            </div>

                            <!-- Cột 3: Trạng thái & Tổng tiền (in đậm nổi bật) -->
                            <div class="text-end" style="min-width: 160px;">
                                <div class="mb-1">
                                    <span class="property-status-pill @statusClass">@statusText</span>
                                </div>
                                <div class="booking-price-highlight">
                                    @bk.TotalAmount.ToString("N0") ₫
                                </div>
                            </div>

                            <!-- Cột 4: Nút Xem chi tiết (để xem phụ thu/giảm giá) -->
                            <div>
                                <button type="button" class="btn btn-outline-primary rounded-pill px-4 fw-bold btn-sm shadow-sm" onclick="openBookingDetailModal(this)">
                                    Xem chi tiết
                                </button>
                            </div>
                        </div>
                    }
                }
            </div>
        </section>

        <!-- ==========================================================================
             TAB 3: QUẢN LÝ ĐÁNH GIÁ (Review Management)
             ========================================================================== -->
        <section class="dashboard-tab-view" id="tabReviews">
            <!-- Top row (Bộ lọc): Thanh lọc gồm Dropdown "Chọn cơ sở" và Input Date picker -->
            <div class="filter-bar-pill-card">
                <!-- Dropdown Chọn cơ sở -->
                <div class="d-flex align-items-center gap-2">
                    <label for="filterReviewProperty">
                        <i class="bi bi-building"></i>
                        <span>Cơ sở:</span>
                    </label>
                    <select id="filterReviewProperty" class="filter-select-round" onchange="filterReviewsList()">
                        <option value="all">Tất cả cơ sở</option>
                        @foreach (var p in Model.Properties)
                        {
                            <option value="@p.Name">@p.Name</option>
                        }
                    </select>
                </div>

                <!-- Input Date picker Lọc theo ngày đánh giá -->
                <div class="d-flex align-items-center gap-2">
                    <label for="filterReviewDate">
                        <i class="bi bi-calendar3"></i>
                        <span>Ngày đánh giá:</span>
                    </label>
                    <input type="date" id="filterReviewDate" class="filter-date-round" onchange="filterReviewsList()">
                    <button type="button" class="btn btn-sm btn-link text-primary p-0 text-decoration-none" onclick="clearReviewDateFilter()">
                        Xóa ngày
                    </button>
                </div>

                <div class="ms-auto text-muted small" id="reviewCountIndicator">
                    Hiển thị: <strong id="reviewTotalCount">@(Model.Reviews?.Count ?? 0)</strong> đánh giá
                </div>
            </div>

            <!-- Bottom row (Danh sách review): Các thẻ review nối tiếp nhau -->
            <div class="review-cards-wrapper" id="reviewCardsContainer">
                @if (Model.Reviews == null || Model.Reviews.Count == 0)
                {
                    <div class="text-center py-5 bg-white rounded-4 shadow-sm">
                        <i class="bi bi-chat-square-quote text-muted fs-1 mb-3 d-block"></i>
                        <h5 class="text-navy fw-bold mb-1">Chưa có đánh giá nào</h5>
                        <p class="text-muted small">Các đánh giá từ khách hàng sau khi lưu trú sẽ hiển thị tại đây.</p>
                    </div>
                }
                else
                {
                    @foreach (var r in Model.Reviews)
                    {
                        var initial = !string.IsNullOrWhiteSpace(r.GuestName) ? r.GuestName.Trim()[0].ToString().ToUpper() : "K";
                        var dateStr = r.ReviewDate.ToString("yyyy-MM-dd");
                        var displayDate = r.ReviewDate.ToString("dd/MM/yyyy");

                        <div class="review-item-card" data-property="@r.PropertyName" data-date="@dateStr" id="review-card-@r.Id">
                            <div class="d-flex align-items-start justify-content-between mb-2">
                                <div class="d-flex align-items-center gap-3">
                                    <div class="review-avatar-circle">@initial</div>
                                    <div>
                                        <h4 class="fs-6 fw-bold text-navy mb-0">@r.GuestName</h4>
                                        <div class="review-stars-row mt-1">
                                            @for (int s = 1; s <= 5; s++)
                                            {
                                                if (s <= r.Rating)
                                                {
                                                    <i class="bi bi-star-fill"></i>
                                                }
                                                else
                                                {
                                                    <i class="bi bi-star"></i>
                                                }
                                            }
                                        </div>
                                    </div>
                                </div>
                                <div class="text-end">
                                    <span class="review-prop-badge mb-1">@r.PropertyName</span>
                                    <div class="text-muted small">@displayDate</div>
                                </div>
                            </div>
                            <p class="text-dark small mb-3 lh-base">
                                "@r.Comment"
                            </p>
                            <div class="d-flex align-items-center justify-content-between pt-2 border-top">
                                <span class="text-muted small"><i class="bi bi-patch-check-fill text-success me-1"></i> Đã đặt qua Stayly (Đơn #@r.BookingId)</span>
                                <button type="button" class="btn btn-sm btn-outline-primary rounded-pill px-3" onclick="openReplyModal(@r.Id, '@Html.Raw(Html.Encode(r.GuestName))', '@Html.Raw(Html.Encode(r.PropertyName))')">
                                    <i class="bi bi-reply-fill me-1"></i> Trả lời đánh giá
                                </button>
                            </div>
                        </div>
                    }
                }
            </div>
        </section>
    </main>

    <!-- Modal Chi tiết Đơn Đặt Phòng (Booking Details Modal) -->
    <div class="modal fade" id="bookingDetailModal" tabindex="-1" aria-labelledby="bookingDetailTitle" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered" style="max-width: 520px;">
            <div class="modal-content stayly-modal">
                <div class="modal-header-accent"></div>
                <div class="modal-body stayly-modal-body p-4 position-relative">
                    <button type="button" class="btn-close position-absolute top-0 end-0 m-3" data-bs-dismiss="modal" aria-label="Close"></button>

                    <div class="d-flex align-items-center gap-2 mb-3">
                        <span class="brand-icon" style="width: 32px; height: 32px; font-size: 1rem;"><i class="bi bi-receipt"></i></span>
                        <h4 class="fs-5 fw-bold text-navy mb-0" id="modalBookingId">Chi tiết đơn đặt phòng</h4>
                    </div>

                    <!-- Khách hàng & Cơ sở -->
                    <div class="bg-light p-3 rounded-4 mb-3">
                        <div class="d-flex justify-content-between mb-1">
                            <span class="text-muted small">Khách hàng:</span>
                            <strong class="text-dark small" id="modalGuestName">--</strong>
                        </div>
                        <div class="d-flex justify-content-between mb-1">
                            <span class="text-muted small">Số điện thoại:</span>
                            <span class="text-dark small" id="modalGuestPhone">--</span>
                        </div>
                        <div class="d-flex justify-content-between mb-1">
                            <span class="text-muted small">Email:</span>
                            <span class="text-dark small" id="modalGuestEmail">--</span>
                        </div>
                        <div class="d-flex justify-content-between mb-1">
                            <span class="text-muted small">Cơ sở lưu trú:</span>
                            <span class="text-primary fw-bold small" id="modalPropertyName">--</span>
                        </div>
                        <div class="d-flex justify-content-between">
                            <span class="text-muted small">Số khách lưu trú:</span>
                            <span class="text-dark small" id="modalGuestCount">--</span>
                        </div>
                    </div>

                    <!-- Thời gian & Chi tiết phòng -->
                    <div class="p-3 border rounded-4 mb-3">
                        <div class="d-flex justify-content-between mb-2 pb-2 border-bottom">
                            <span class="text-muted small">Thời gian lưu trú:</span>
                            <strong class="text-dark small" id="modalStayDates">--</strong>
                        </div>
                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-muted small">Tiền phòng cơ bản:</span>
                            <span class="text-dark small" id="modalBaseAmount">--</span>
                        </div>
                        <div id="modalExtraFeesSection" class="mb-2">
                            <div class="d-flex justify-content-between">
                                <span class="text-muted small">Phí dịch vụ &amp; Phụ thu:</span>
                                <span class="text-success small">+ 0 ₫ (Không có)</span>
                            </div>
                        </div>
                        <div id="modalDiscountSection" class="mb-2">
                            <div class="d-flex justify-content-between">
                                <span class="text-muted small">Mã giảm giá ưu đãi:</span>
                                <span class="text-muted small">0 ₫ (Không áp dụng)</span>
                            </div>
                        </div>
                        <div class="d-flex justify-content-between pt-2 border-top">
                            <strong class="text-navy">Tổng thanh toán:</strong>
                            <strong class="text-primary fs-5" id="modalTotalAmount">--</strong>
                        </div>
                    </div>

                    <div class="d-flex gap-2 justify-content-end">
                        <button type="button" class="btn btn-outline-secondary rounded-pill px-4" data-bs-dismiss="modal">
                            Đóng
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Modal Phản Hồi Đánh Giá (Reply Review Modal) -->
    <div class="modal fade" id="replyReviewModal" tabindex="-1" aria-labelledby="replyReviewTitle" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered" style="max-width: 480px;">
            <div class="modal-content stayly-modal">
                <div class="modal-header-accent"></div>
                <div class="modal-body stayly-modal-body p-4 position-relative">
                    <button type="button" class="btn-close position-absolute top-0 end-0 m-3" data-bs-dismiss="modal" aria-label="Close"></button>

                    <div class="d-flex align-items-center gap-2 mb-3">
                        <span class="brand-icon" style="width: 32px; height: 32px; font-size: 1rem;"><i class="bi bi-reply-fill"></i></span>
                        <h4 class="fs-5 fw-bold text-navy mb-0" id="replyReviewTitle">Phản hồi đánh giá</h4>
                    </div>

                    <div class="bg-light p-3 rounded-4 mb-3">
                        <div class="text-muted small mb-1">Khách hàng: <strong class="text-navy" id="replyGuestName">--</strong></div>
                        <div class="text-muted small">Cơ sở lưu trú: <span class="text-primary fw-bold" id="replyPropertyName">--</span></div>
                    </div>

                    <input type="hidden" id="replyReviewId" value="0">
                    <div class="mb-3">
                        <label for="replyReviewMessage" class="form-label fw-bold text-navy small">Nội dung phản hồi của bạn:</label>
                        <textarea class="form-control rounded-4 p-3" id="replyReviewMessage" rows="4" placeholder="Nhập lời cảm ơn hoặc phản hồi gửi tới khách hàng..." style="font-size: 0.92rem; border-color: rgba(0, 119, 182, 0.2);"></textarea>
                    </div>

                    <div id="replyAlertBox" class="alert d-none small rounded-pill py-2 text-center mb-3"></div>

                    <div class="d-flex gap-2 justify-content-end">
                        <button type="button" class="btn btn-outline-secondary rounded-pill px-4" data-bs-dismiss="modal">
                            Hủy
                        </button>
                        <button type="button" class="btn btn-primary rounded-pill px-4 fw-bold" id="btnSubmitReply" onclick="submitReviewReply()">
                            <i class="bi bi-send-fill me-1"></i> Gửi phản hồi
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Bootstrap 5.3 JS Bundle -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <!-- ==========================================================================
         Client-side Vanilla JS Logic
         ========================================================================== -->
    <script>
        // Vanilla JS Tab Switching Function
        function switchDashboardTab(tabId, element) {
            document.querySelectorAll('.dashboard-tab-link').forEach(btn => {
                btn.classList.remove('active');
            });

            if (element) {
                element.classList.add('active');
            }

            document.querySelectorAll('.dashboard-tab-view').forEach(pane => {
                pane.classList.remove('active');
            });

            const targetPane = document.getElementById(tabId);
            if (targetPane) {
                targetPane.classList.add('active');
            }

            const titleEl = document.getElementById('currentTabHeading');
            const subEl = document.getElementById('currentTabSubheading');

            if (tabId === 'tabProperties') {
                if (titleEl) titleEl.textContent = 'Quản lý cơ sở lưu trú';
                if (subEl) subEl.textContent = 'Theo dõi tình trạng hoạt động, hồ sơ xét duyệt và thông tin các cơ sở của bạn.';
            } else if (tabId === 'tabBookings') {
                if (titleEl) titleEl.textContent = 'Quản lý đơn đặt phòng';
                if (subEl) subEl.textContent = 'Danh sách các đơn đặt phòng từ khách hàng, lọc theo cơ sở và trạng thái thanh toán.';
            } else if (tabId === 'tabReviews') {
                if (titleEl) titleEl.textContent = 'Quản lý đánh giá khách hàng';
                if (subEl) subEl.textContent = 'Lắng nghe phản hồi từ khách lưu trú để nâng cao chất lượng dịch vụ của bạn.';
            }
        }

        // Filter bookings by Property and Status
        function filterBookingsList() {
            const propFilter = document.getElementById('filterBookingProperty').value;
            const statusFilter = document.getElementById('filterBookingStatus').value;
            const cards = document.querySelectorAll('#bookingCardsContainer .booking-item-card');
            let visibleCount = 0;

            cards.forEach(card => {
                const cardProp = card.getAttribute('data-property') || '';
                const cardStatus = card.getAttribute('data-status') || '';

                const matchProp = (propFilter === 'all' || cardProp === propFilter);
                const matchStatus = (statusFilter === 'all' || cardStatus.toLowerCase() === statusFilter.toLowerCase());

                if (matchProp && matchStatus) {
                    card.style.display = 'flex';
                    visibleCount++;
                } else {
                    card.style.display = 'none';
                }
            });

            const countIndicator = document.getElementById('bookingCountIndicator');
            if (countIndicator) {
                countIndicator.innerHTML = `Hiển thị: <strong>${visibleCount}</strong> đơn`;
            }
        }

        // Filter reviews by Property and Date
        function filterReviewsList() {
            const propFilter = document.getElementById('filterReviewProperty').value;
            const dateFilter = document.getElementById('filterReviewDate').value;
            const cards = document.querySelectorAll('#reviewCardsContainer .review-item-card');
            let visibleCount = 0;

            cards.forEach(card => {
                const cardProp = card.getAttribute('data-property') || '';
                const cardDate = card.getAttribute('data-date') || '';

                const matchProp = (propFilter === 'all' || cardProp === propFilter);
                const matchDate = (!dateFilter || cardDate === dateFilter);

                if (matchProp && matchDate) {
                    card.style.display = 'block';
                    visibleCount++;
                } else {
                    card.style.display = 'none';
                }
            });

            const countEl = document.getElementById('reviewTotalCount');
            if (countEl) {
                countEl.textContent = visibleCount;
            }
        }

        function clearReviewDateFilter() {
            const dateInput = document.getElementById('filterReviewDate');
            if (dateInput) {
                dateInput.value = '';
                filterReviewsList();
            }
        }

        // Booking Detail Modal Opener with live API call
        async function openBookingDetailModal(button) {
            const card = button.closest('.booking-item-card');
            if (!card) return;

            const bookingId = card.getAttribute('data-id');

            // Set preliminary data from card
            document.getElementById('modalBookingId').textContent = `Chi tiết đơn #${bookingId}`;
            document.getElementById('modalGuestName').textContent = card.getAttribute('data-guest') || '';
            document.getElementById('modalGuestPhone').textContent = card.getAttribute('data-phone') || '';
            document.getElementById('modalGuestEmail').textContent = card.getAttribute('data-email') || '';
            document.getElementById('modalPropertyName').textContent = `${card.getAttribute('data-property')} (${card.getAttribute('data-rooms')})`;
            document.getElementById('modalGuestCount').textContent = `${card.getAttribute('data-guests')} người`;
            document.getElementById('modalStayDates').textContent = `${card.getAttribute('data-checkin')} → ${card.getAttribute('data-checkout')}`;
            document.getElementById('modalBaseAmount').textContent = card.getAttribute('data-amount') || '';
            document.getElementById('modalTotalAmount').textContent = card.getAttribute('data-amount') || '';

            // Open modal
            const modal = new bootstrap.Modal(document.getElementById('bookingDetailModal'));
            modal.show();

            // Fetch live API details for surcharges, discounts, and itemized calculations
            try {
                const res = await fetch(`/Home/GetBookingDetailJson?id=${bookingId}`);
                if (res.ok) {
                    const result = await res.json();
                    if (result.success && result.data) {
                        const d = result.data;
                        document.getElementById('modalGuestName').textContent = d.guestName || card.getAttribute('data-guest');
                        if (d.guestPhone) document.getElementById('modalGuestPhone').textContent = d.guestPhone;
                        if (d.guestEmail) document.getElementById('modalGuestEmail').textContent = d.guestEmail;
                        if (d.propertyName) {
                            const rooms = d.roomNumbers && d.roomNumbers.length > 0 ? d.roomNumbers.join(', ') : 'Phòng tiêu chuẩn';
                            document.getElementById('modalPropertyName').textContent = `${d.propertyName} (${rooms})`;
                        }
                        if (d.guestCount) document.getElementById('modalGuestCount').textContent = `${d.guestCount} người`;

                        if (d.basePrice != null) {
                            document.getElementById('modalBaseAmount').textContent = Number(d.basePrice).toLocaleString('vi-VN') + ' ₫';
                        }
                        if (d.totalAmount != null) {
                            document.getElementById('modalTotalAmount').textContent = Number(d.totalAmount).toLocaleString('vi-VN') + ' ₫';
                        }

                        // Extra fees list
                        const feesSec = document.getElementById('modalExtraFeesSection');
                        if (d.extraFees && d.extraFees.length > 0) {
                            let feesHtml = '';
                            d.extraFees.forEach(f => {
                                feesHtml += `
                                    <div class="d-flex justify-content-between mb-1">
                                        <span class="text-muted small">${f.name} (x${f.quantity}):</span>
                                        <span class="text-danger small fw-semibold">+ ${Number(f.total).toLocaleString('vi-VN')} ₫</span>
                                    </div>`;
                            });
                            feesSec.innerHTML = feesHtml;
                        } else {
                            feesSec.innerHTML = `
                                <div class="d-flex justify-content-between">
                                    <span class="text-muted small">Phí dịch vụ &amp; Phụ thu:</span>
                                    <span class="text-success small">+ 0 ₫ (Không có phụ thu)</span>
                                </div>`;
                        }

                        // Discounts
                        const discSec = document.getElementById('modalDiscountSection');
                        if (d.discountAmount && d.discountAmount > 0) {
                            const codeTxt = d.promotionCode ? `Mã [${d.promotionCode}]` : 'Ưu đãi';
                            const pctTxt = d.discountPercentage ? ` - ${d.discountPercentage}%` : '';
                            discSec.innerHTML = `
                                <div class="d-flex justify-content-between">
                                    <span class="text-muted small">${codeTxt}${pctTxt}:</span>
                                    <span class="text-success fw-bold small">- ${Number(d.discountAmount).toLocaleString('vi-VN')} ₫</span>
                                </div>`;
                        } else {
                            discSec.innerHTML = `
                                <div class="d-flex justify-content-between">
                                    <span class="text-muted small">Mã giảm giá ưu đãi:</span>
                                    <span class="text-muted small">0 ₫ (Không áp dụng)</span>
                                </div>`;
                        }
                    }
                }
            } catch (err) {
                console.warn('Could not fetch extra booking details:', err);
            }
        }

        // Reply to Review Modal logic
        function openReplyModal(reviewId, guestName, propertyName) {
            document.getElementById('replyReviewId').value = reviewId;
            document.getElementById('replyGuestName').textContent = guestName;
            document.getElementById('replyPropertyName').textContent = propertyName;
            document.getElementById('replyReviewMessage').value = '';
            
            const alertBox = document.getElementById('replyAlertBox');
            alertBox.className = 'alert d-none small rounded-pill py-2 text-center mb-3';
            alertBox.textContent = '';

            const modal = new bootstrap.Modal(document.getElementById('replyReviewModal'));
            modal.show();
        }

        async function submitReviewReply() {
            const reviewId = document.getElementById('replyReviewId').value;
            const message = document.getElementById('replyReviewMessage').value.trim();
            const alertBox = document.getElementById('replyAlertBox');
            const submitBtn = document.getElementById('btnSubmitReply');

            if (!message) {
                alertBox.className = 'alert alert-danger small rounded-pill py-2 text-center mb-3';
                alertBox.textContent = 'Vui lòng nhập nội dung phản hồi.';
                alertBox.classList.remove('d-none');
                return;
            }

            submitBtn.disabled = true;
            submitBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-1" role="status"></span> Đang gửi...';

            try {
                const res = await fetch('/Home/ReplyReviewAjax', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ reviewId: parseInt(reviewId), message: message })
                });

                const data = await res.json();
                if (res.ok && data.success) {
                    alertBox.className = 'alert alert-success small rounded-pill py-2 text-center mb-3';
                    alertBox.textContent = data.message || 'Phản hồi thành công!';
                    alertBox.classList.remove('d-none');
                    setTimeout(() => {
                        const modalEl = document.getElementById('replyReviewModal');
                        const modal = bootstrap.Modal.getInstance(modalEl);
                        if (modal) modal.hide();
                    }, 1200);
                } else {
                    alertBox.className = 'alert alert-danger small rounded-pill py-2 text-center mb-3';
                    alertBox.textContent = data.message || 'Không thể gửi phản hồi.';
                    alertBox.classList.remove('d-none');
                }
            } catch (ex) {
                alertBox.className = 'alert alert-danger small rounded-pill py-2 text-center mb-3';
                alertBox.textContent = 'Lỗi kết nối máy chủ. Vui lòng thử lại sau.';
                alertBox.classList.remove('d-none');
            } finally {
                submitBtn.disabled = false;
                submitBtn.innerHTML = '<i class="bi bi-send-fill me-1"></i> Gửi phản hồi';
            }
        }

        // Handle Logout
        function handleDashboardLogout() {
            localStorage.removeItem('guestUser');
            localStorage.removeItem('guestToken');
        }
    </script>
</body>
</html>
