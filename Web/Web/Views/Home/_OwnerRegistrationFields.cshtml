@model RegisterOwnerInput

<partial name="_GuestRegistrationFields" model="Model" />

<div class="form-group mb-3">
    <label class="form-label fw-semibold">
        Số CCCD / Định danh cá nhân <span class="text-danger">*</span>
    </label>
    <input asp-for="CitizenId" id="CitizenIdInput" class="form-control rounded-pill px-3 py-2" placeholder="Ví dụ: 001201009999" required />
    <span asp-validation-for="CitizenId" class="text-danger small"></span>
    <div class="field-error-text" id="CitizenIdInputError"></div>
</div>

<div class="p-3 mb-3 rounded-4" style="background-color: var(--stayly-accent-subtle); border: 1px dashed rgba(0, 119, 182, 0.3);">
    <div class="fw-bold text-navy small mb-2 d-flex align-items-center gap-1">
        <i class="bi bi-bank text-primary"></i>
        <span>Thông tin tài khoản nhận thanh toán doanh thu</span>
    </div>
    <div class="row g-2">
        <div class="col-md-6">
            <label class="form-label small text-muted mb-1">Tên ngân hàng <span class="text-danger">*</span></label>
            <input asp-for="BankName" id="BankNameInput" class="form-control rounded-pill px-3 py-2" placeholder="Ví dụ: Vietcombank, MB Bank, Techcombank" required />
            <div class="field-error-text" id="BankNameInputError"></div>
        </div>
        <div class="col-md-6">
            <label class="form-label small text-muted mb-1">Số tài khoản <span class="text-danger">*</span></label>
            <input asp-for="AccountNumber" id="AccountNumberInput" class="form-control rounded-pill px-3 py-2" placeholder="Ví dụ: 1012345678" required />
            <div class="field-error-text" id="AccountNumberInputError"></div>
        </div>
        <div class="col-12 mt-2">
            <label class="form-label small text-muted mb-1">Tên chủ tài khoản (Viết hoa không dấu) <span class="text-danger">*</span></label>
            <input asp-for="AccountHolder" id="AccountHolderInput" class="form-control rounded-pill px-3 py-2" placeholder="Ví dụ: NGUYEN VAN A" required />
            <div class="field-error-text" id="AccountHolderInputError"></div>
        </div>
    </div>
    <input type="hidden" asp-for="BankInformation" id="ownerBankInfoFallback" />
</div>