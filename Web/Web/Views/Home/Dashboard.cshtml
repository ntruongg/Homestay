    <!-- Bootstrap 5.3 JS Bundle -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <!-- ==========================================================================
         Client-side Vanilla JS Logic
         ========================================================================== -->
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const urlParams = new URLSearchParams(window.location.search);
            const tabParam = urlParams.get('tab');
            if (tabParam === 'bookings') {
                const btn = document.getElementById('tabBtnBookings');
                if (btn) switchDashboardTab('tabBookings', btn);
            } else if (tabParam === 'reviews') {
                const btn = document.getElementById('tabBtnReviews');
                if (btn) switchDashboardTab('tabReviews', btn);
            }

            @if (TempData["OpenModal"] as string == "createPropertyModal")
            {
                <text>
                const createModalEl = document.getElementById('createPropertyModal');
                if (createModalEl) {
                    const createModal = new bootstrap.Modal(createModalEl);
                    createModal.show();
                }
                </text>
            }

            // Kích hoạt bộ kiểm tra hợp lệ và highlight đỏ khi thiếu thông tin
            setupCreatePropertyValidation();
        });

        // ==================== VALIDATION & HIGHLIGHT FORM TẠO CƠ SỞ ====================
        function setupCreatePropertyValidation() {
            const form = document.getElementById('createPropertyForm');
            if (!form) return;

            function markInvalid(inputEl, message) {
                if (!inputEl) return;
                inputEl.classList.add('is-invalid');
                let feedback = inputEl.parentNode.querySelector('.invalid-feedback');
                if (!feedback) {
                    feedback = document.createElement('div');
                    feedback.className = 'invalid-feedback';
                    inputEl.parentNode.appendChild(feedback);
                }
                if (message) feedback.textContent = message;
            }

            function markValid(inputEl) {
                if (!inputEl) return;
                inputEl.classList.remove('is-invalid');
            }

            // Tự động xóa highlight đỏ ngay khi người dùng nhập liệu vào ô bị lỗi
            form.querySelectorAll('input, select, textarea').forEach(field => {
                field.addEventListener('input', () => {
                    if (field.value.trim() !== '') {
                        markValid(field);
                    }
                });
                field.addEventListener('change', () => {
                    if (field.value.trim() !== '') {
                        markValid(field);
                    }
                });
            });

            form.addEventListener('submit', function(e) {
                let hasError = false;
                let firstInvalid = null;

                // 1. Tên cơ sở lưu trú
                const nameInput = document.getElementById('createPropName');
                if (!nameInput || !nameInput.value.trim()) {
                    markInvalid(nameInput, 'Vui lòng nhập tên cơ sở lưu trú.');
                    hasError = true;
                    if (!firstInvalid) firstInvalid = nameInput;
                } else {
                    markValid(nameInput);
                }

                // 2. Số điện thoại đón khách
                const phoneInput = document.getElementById('createPropPhone');
                const cleanPhone = phoneInput ? phoneInput.value.trim().replace(/[\s\.-]/g, '') : '';
                if (!phoneInput || !phoneInput.value.trim()) {
                    markInvalid(phoneInput, 'Vui lòng nhập số điện thoại đón khách.');
                    hasError = true;
                    if (!firstInvalid) firstInvalid = phoneInput;
                } else if (cleanPhone.length < 9 || cleanPhone.length > 11 || isNaN(cleanPhone)) {
                    markInvalid(phoneInput, 'Số điện thoại không hợp lệ (từ 9 đến 11 chữ số).');
                    hasError = true;
                    if (!firstInvalid) firstInvalid = phoneInput;
                } else {
                    markValid(phoneInput);
                }

                // 3. Email liên hệ
                const emailInput = document.getElementById('createPropEmail');
                const emailVal = emailInput ? emailInput.value.trim() : '';
                const atIdx = emailVal.indexOf('@@');
                const dotIdx = emailVal.lastIndexOf('.');
                const isValidEmail = atIdx > 0 && dotIdx > atIdx + 1 && dotIdx < emailVal.length - 1;
                if (!emailInput || !emailVal) {
                    markInvalid(emailInput, 'Vui lòng nhập email liên hệ.');
                    hasError = true;
                    if (!firstInvalid) firstInvalid = emailInput;
                } else if (!isValidEmail) {
                    markInvalid(emailInput, 'Địa chỉ email không đúng định dạng.');
                    hasError = true;
                    if (!firstInvalid) firstInvalid = emailInput;
                } else {
                    markValid(emailInput);
                }

                // 4. Địa chỉ cụ thể
                const addressInput = document.getElementById('createPropAddress');
                if (!addressInput || !addressInput.value.trim()) {
                    markInvalid(addressInput, 'Vui lòng nhập địa chỉ cụ thể (số nhà, tên đường).');
                    hasError = true;
                    if (!firstInvalid) firstInvalid = addressInput;
                } else {
                    markValid(addressInput);
                }

                // 5. Tỉnh / Thành phố
                const cityInput = document.getElementById('createPropCity');
                if (!cityInput || !cityInput.value.trim()) {
                    markInvalid(cityInput, 'Vui lòng nhập hoặc chọn Tỉnh / Thành phố.');
                    hasError = true;
                    if (!firstInvalid) firstInvalid = cityInput;
                } else {
                    markValid(cityInput);
                }

                // 6. Cấu hình Homestay nếu loại hình là Homestay
                const typeSelect = document.getElementById('createPropTypeSelect');
                const isHomestay = !typeSelect || typeSelect.value === 'Homestay';
                if (isHomestay) {
                    const priceInput = document.getElementById('createPropHomestayPrice');
                    if (priceInput && (!priceInput.value || Number(priceInput.value) < 50000)) {
                        markInvalid(priceInput, 'Giá thuê trọn gói tối thiểu từ 50.000 ₫/đêm.');
                        hasError = true;
                        if (!firstInvalid) firstInvalid = priceInput;
                    } else if (priceInput) {
                        markValid(priceInput);
                    }

                    const capInput = document.getElementById('createPropHomestayCapacity');
                    if (capInput && (!capInput.value || Number(capInput.value) < 1)) {
                        markInvalid(capInput, 'Sức chứa tối thiểu 1 người.');
                        hasError = true;
                        if (!firstInvalid) firstInvalid = capInput;
                    } else if (capInput) {
                        markValid(capInput);
                    }
                }

                if (hasError) {
                    e.preventDefault();
                    e.stopPropagation();
                    if (firstInvalid) {
                        firstInvalid.focus();
                        firstInvalid.scrollIntoView({ behavior: 'smooth', block: 'center' });
                    }
                    return false;
                }

                // Form hợp lệ -> chuyển nút submit sang trạng thái loading
                const submitBtn = form.querySelector('button[type="submit"]');
                if (submitBtn) {
                    submitBtn.disabled = true;
                    submitBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span> Đang gửi hồ sơ...';
                }
            });
        }

        // Tab Switching
        function switchDashboardTab(tabId, element) {
            document.querySelectorAll('.dashboard-tab-link').forEach(btn => btn.classList.remove('active'));
            if (element) element.classList.add('active');

            document.querySelectorAll('.dashboard-tab-view').forEach(pane => pane.classList.remove('active'));
            const targetPane = document.getElementById(tabId);
            if (targetPane) targetPane.classList.add('active');

            const titleEl = document.getElementById('currentTabHeading');
            const subEl = document.getElementById('currentTabSubheading');

            if (tabId === 'tabProperties') {
                if (titleEl) titleEl.textContent = 'Quản lý cơ sở lưu trú';
                if (subEl) subEl.textContent = 'Theo dõi tình trạng hoạt động, hồ sơ xét duyệt và thông tin các cơ sở của bạn.';
            } else if (tabId === 'tabBookings') {
                if (titleEl) titleEl.textContent = 'Quản lý đơn đặt phòng';
                if (subEl) subEl.textContent = 'Danh sách các đơn đặt phòng từ khách hàng, lọc theo cơ sở và trạng thái thanh toán.';
            } else if (tabId === 'tabReviews') {
                if (titleEl) titleEl.textContent = 'Quản lý đánh giá khách hàng';
                if (subEl) subEl.textContent = 'Lắng nghe phản hồi từ khách lưu trú để nâng cao chất lượng dịch vụ của bạn.';
            }
        }

        // Toggle Create Property Type (Homestay vs Hotel)
        function toggleCreatePropertyType(val) {
            const homestayPanel = document.getElementById('createHomestayConfigPanel');
            const hotelPanel = document.getElementById('createHotelConfigPanel');
            if (val === 'Hotel') {
                if (homestayPanel) homestayPanel.classList.add('d-none');
                if (hotelPanel) hotelPanel.classList.remove('d-none');
            } else {
                if (homestayPanel) homestayPanel.classList.remove('d-none');
                if (hotelPanel) hotelPanel.classList.add('d-none');
            }
        }

        // ==================== OWNER PROPERTY DETAILS LOGIC ====================
        let currentOpdData = null;

        function toggleOwnerPropertyEditMode(forceEdit) {
            const viewEl = document.getElementById('opdDynamicBody');
            const editEl = document.getElementById('opdEditContainer');
            const toggleBtn = document.getElementById('opdEditToggleBtn');
            const footerActions = document.getElementById('opdFooterActions');

            if (!viewEl || !editEl) return;

            const shouldShowEdit = forceEdit !== undefined ? forceEdit : editEl.classList.contains('d-none');

            if (shouldShowEdit) {
                if (!currentOpdData) return;
                populateOpdEditForm(currentOpdData);
                viewEl.classList.add('d-none');
                editEl.classList.remove('d-none');
                if (footerActions) footerActions.classList.add('d-none');
                if (toggleBtn) {
                    toggleBtn.innerHTML = '<i class="bi bi-eye me-1"></i> Quay lại xem chi tiết';
                    toggleBtn.className = 'btn btn-sm btn-outline-secondary rounded-pill px-3 fw-bold ms-auto me-4';
                }
            } else {
                viewEl.classList.remove('d-none');
                editEl.classList.add('d-none');
                if (footerActions) footerActions.classList.remove('d-none');
                if (toggleBtn) {
                    toggleBtn.innerHTML = '<i class="bi bi-pencil-square me-1"></i> Chỉnh sửa thông tin';
                    toggleBtn.className = 'btn btn-sm btn-outline-primary rounded-pill px-3 fw-bold ms-auto me-4';
                }
            }
        }

        function populateOpdEditForm(data) {
            document.getElementById('opdEditPropId').value = data.id;
            document.getElementById('opdEditName').value = data.name || '';
            document.getElementById('opdEditType').value = data.type || 'Homestay';
            document.getElementById('opdEditPhone').value = data.phone || '';
            document.getElementById('opdEditEmail').value = data.email || '';
            document.getElementById('opdEditAddress').value = data.address || '';
            document.getElementById('opdEditWard').value = data.ward || '';
            document.getElementById('opdEditCity').value = data.city || '';
            document.getElementById('opdEditPolicy').value = data.policy || '';

            const isHotel = (data.type || '').toLowerCase() === 'hotel' || (data.type || '').toLowerCase() === 'khách sạn';
            const isHomestay = !isHotel;
            const homestayPanel = document.getElementById('opdEditHomestayPanel');
            if (isHomestay) {
                if (homestayPanel) homestayPanel.classList.remove('d-none');
                if (data.homestayPrice) document.getElementById('opdEditHomestayPrice').value = data.homestayPrice;
                if (data.homestayCapacity) document.getElementById('opdEditHomestayCapacity').value = data.homestayCapacity;
                if (data.homestayRoomTypeId) document.getElementById('opdEditHomestayRoomTypeId').value = data.homestayRoomTypeId;
            } else {
                if (homestayPanel) homestayPanel.classList.add('d-none');
            }

            const docBL = document.getElementById('opdEditOldBusinessLicense');
            if (docBL) docBL.innerHTML = data.businessLicenseUrl ? `<a href="${data.businessLicenseUrl}" target="_blank" class="text-primary text-decoration-underline"><i class="bi bi-file-earmark-check me-1"></i>Tệp hiện tại</a>` : 'Chưa có tệp';

            const docFS = document.getElementById('opdEditOldFireSafety');
            if (docFS) docFS.innerHTML = data.fireSafetyDocumentUrl ? `<a href="${data.fireSafetyDocumentUrl}" target="_blank" class="text-primary text-decoration-underline"><i class="bi bi-file-earmark-check me-1"></i>Tệp hiện tại</a>` : 'Chưa có tệp';

            const docSEC = document.getElementById('opdEditOldSecurity');
            if (docSEC) docSEC.innerHTML = data.securityDocumentUrl ? `<a href="${data.securityDocumentUrl}" target="_blank" class="text-primary text-decoration-underline"><i class="bi bi-file-earmark-check me-1"></i>Tệp hiện tại</a>` : 'Chưa có tệp';

            const activeIds = (data.amenities || []).map(a => a.id);
            document.querySelectorAll('.opd-edit-amenity-cb').forEach(cb => {
                cb.checked = activeIds.includes(Number(cb.value));
            });
        }

