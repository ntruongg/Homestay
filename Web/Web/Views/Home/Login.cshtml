@model LoginInput

@{
    ViewData["Title"] = "Log in";
}

<section class="form-page">
    <div class="form-card">
        <p class="eyebrow">Welcome back</p>
        <h1>Log in to Stayly</h1>

        <div asp-validation-summary="ModelOnly" class="form-error"></div>

        <form asp-action="Login" method="post">
            <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl">

            <label>
                Email
                <input asp-for="Email" type="email" required>
            </label>

            <label>
                Mật khẩu
                <div class="password-field-wrapper">
                    <input asp-for="Password" id="loginPagePassword" type="password" placeholder="Nhập mật khẩu" required>
                    <button type="button" class="btn-toggle-password" data-target="loginPagePassword" title="Hiện mật khẩu" tabindex="-1">
                        <i class="bi bi-eye"></i>
                    </button>
                </div>
            </label>

            <div class="d-flex justify-content-end mb-3 mt-1">
                <a href="javascript:void(0)" onclick="openForgotPasswordModal()" class="small text-decoration-none text-primary fw-semibold">Quên mật khẩu?</a>
            </div>
            <button class="button" type="submit">
                Log in
            </button>

            @Html.AntiForgeryToken()
        </form>

        <p class="switch">
            New to Stayly?
            <a asp-action="Register">Create a guest account</a>
        </p>
    </div>
</section>
