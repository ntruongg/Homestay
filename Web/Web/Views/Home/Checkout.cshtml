@model Web.Models.Booking

@{
    ViewData["Title"] = "Thanh toán đơn đặt phòng #" + Model.Id;
    bool hasVnPayConfig = ViewBag.HasVnPayConfig is true;
    string? vnPayUrl = ViewBag.VnPayPaymentUrl as string;
    int initRemainingSecs = ViewBag.RemainingSeconds is int s ? s : 1800;
    int initM = initRemainingSecs / 60;
    int initS = initRemainingSecs % 60;
    string initTimeStr = $"{(initM < 10 ? "0" + initM : initM.ToString())}:{(initS < 10 ? "0" + initS : initS.ToString())}";
}

<div class="container py-5">
    <div class="row g-4 justify-content-center">
        <div class="col-lg-10">
            <div class="d-flex align-items-center justify-content-between mb-4">
                <div>
                    <h1 class="h3 fw-bold text-navy mb-1"><i class="bi bi-credit-card-2-front me-2 text-primary"></i>Thanh toán đơn đặt phòng #@Model.Id</h1>
                    <p class="text-muted mb-0">Hoàn tất thanh toán để chuyển đơn sang trạng thái chờ chủ cơ sở duyệt</p>
                </div>
                <a href="/Home/Trips" class="btn btn-outline-secondary rounded-pill px-3 py-1 small">
                    <i class="bi bi-arrow-left me-1"></i> Quay lại chuyến đi
                </a>
            </div>

            <div class="row g-4">
                <!-- Left: VNPay Payment & Real QR Code -->
                <div class="col-md-6">
                    <div class="card border-0 shadow-sm rounded-4 h-100">
                        <div class="card-body p-4 text-center d-flex flex-column justify-content-between align-items-center">
                            <div class="w-100">
                                <h4 class="fw-bold mb-2 text-navy"><i class="bi bi-wallet2 text-primary me-2"></i>Thanh toán qua Cổng VNPAY</h4>
                                <p class="text-muted small mb-3">Quét mã QR bằng ứng dụng Ngân hàng / Ví điện tử hoặc mở Cổng VNPay</p>

                                @if (!string.IsNullOrEmpty(vnPayUrl))
                                {
                                    <div class="mb-3">
                                        <a href="@vnPayUrl" class="btn btn-danger btn-lg w-100 rounded-pill py-3 fw-bold shadow-sm d-flex align-items-center justify-content-center gap-2 mb-2">
                                            <i class="bi bi-box-arrow-up-right fs-5"></i> Mở Cổng Thanh Toán VNPay
                                        </a>
                                        <div class="text-muted small">
                                            <i class="bi bi-shield-check text-success me-1"></i> Hỗ trợ quét VNPAY-QR trực tiếp từ App Ngân hàng, Thẻ ATM/Nội địa, Visa/Mastercard &amp; Ví VNPay
                                        </div>
                                    </div>
                                }

                                <div class="border-top pt-3 mb-2 w-100">
                                    <span class="text-muted small fw-semibold text-uppercase">MÃ QR THANH TOÁN VNPAY THỰC TẾ</span>
                                </div>

                                <!-- Vùng hiển thị mã QR thật -->
                                <div id="realQrContainer" class="qr-code-wrapper bg-white border p-3 rounded-4 mb-3 position-relative d-inline-flex justify-content-center align-items-center" style="min-width: 270px; min-height: 270px;">
                                    @if (!string.IsNullOrEmpty(vnPayUrl))
                                    {
                                        <img id="vnpayRealQrImage" 
                                             src="https://api.qrserver.com/v1/create-qr-code/?size=250x250&data=@System.Net.WebUtility.UrlEncode(vnPayUrl)" 
                                             alt="VNPAY Real QR Code" 
                                             class="img-fluid rounded" 
                                             style="width: 250px; height: 250px; object-fit: contain;"
                                             onerror="showQrLoadError()" 
                                             onload="hideQrLoadError()" />
                                    }

                                    <!-- Dòng báo lỗi và giải thích nếu không load được mã thật -->
                                    <div id="qrErrorBox" class="alert alert-danger p-3 rounded-3 text-start m-2 @(!string.IsNullOrEmpty(vnPayUrl) ? "d-none" : "")" style="max-width: 320px;">
                                        <div class="d-flex align-items-center gap-2 mb-2 text-danger fw-bold">
                                            <i class="bi bi-exclamation-triangle-fill fs-5"></i>
                                            <span>Không load được mã QR thanh toán</span>
                                        </div>
                                        <p class="small text-secondary mb-2">
                                            <strong>Giải thích:</strong> Phiên thanh toán VNPay yêu cầu chữ ký số bảo mật SHA512 với độ dài URL lớn, khiến máy chủ tạo ảnh QR không thể render hoặc trình duyệt chặn kết nối tải ảnh từ xa.
                                        </p>
                                        <p class="small text-dark mb-0 fw-semibold">
                                            <strong>Cách xử lý:</strong> Vui lòng bấm trực tiếp vào nút <span class="text-danger">"Mở Cổng Thanh Toán VNPay"</span> ở trên để thanh toán trực tiếp trên hệ thống an toàn của VNPay.
                                        </p>
                                    </div>
                                </div>

                                <div class="timer-box mb-2">
                                    <span class="badge bg-danger-subtle text-danger px-3 py-2 rounded-pill fw-bold">
                                        <i class="bi bi-clock-history me-1"></i> Mã hết hạn sau: <span id="countdownTimer">@initTimeStr</span>
                                    </span>
                                </div>
                            </div>

                            <div class="w-100 pt-3 border-top text-muted small">
                                <i class="bi bi-arrow-repeat text-primary me-1"></i> Hệ thống tự động đồng bộ và chuyển sang trạng thái <strong>Chờ duyệt</strong> ngay khi giao dịch VNPay hoàn tất.
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Right: Booking Details -->
                <div class="col-md-6">
                    <div class="card border-0 shadow-sm rounded-4 bg-light h-100">
                        <div class="card-body p-4">
                            <h4 class="fw-bold mb-4">Chi tiết thanh toán</h4>
                            
                            <div class="d-flex justify-content-between mb-3 border-bottom pb-2">
                                <span class="text-muted">Mã đơn đặt phòng:</span>
                                <span class="fw-semibold">#@Model.Id</span>
                            </div>
                            <div class="d-flex justify-content-between mb-3 border-bottom pb-2">
                                <span class="text-muted">Trạng thái:</span>
                                <span class="badge bg-warning text-dark rounded-pill px-3 py-1">Chờ thanh toán</span>
                            </div>
                            <div class="d-flex justify-content-between mb-3 border-bottom pb-2">
                                <span class="text-muted">Danh sách phòng:</span>
                                <span class="fw-semibold">
                                    @(Model.RoomNumbers != null && Model.RoomNumbers.Any() 
                                        ? string.Join(", ", Model.RoomNumbers.Select(r => "Phòng " + r)) 
                                        : string.Join(", ", Model.RoomIds))
                                </span>
                            </div>
                            <div class="d-flex justify-content-between mb-3 border-bottom pb-2">
                                <span class="text-muted">Thời gian lưu trú:</span>
                                <span class="fw-semibold">@Model.CheckIn.ToString("dd/MM/yyyy") - @Model.CheckOut.ToString("dd/MM/yyyy") (@(Math.Max(1, (Model.CheckOut.Date - Model.CheckIn.Date).Days)) đêm)</span>
                            </div>
                            <div class="d-flex justify-content-between mb-3 border-bottom pb-2">
                                <span class="text-muted">Số lượng khách:</span>
                                <span class="fw-semibold">@Model.Adults người lớn, @Model.Children trẻ em</span>
                            </div>

                            @if (Model.Services != null && Model.Services.Any())
                            {
                                <div class="mb-3 border-bottom pb-2">
                                    <div class="d-flex justify-content-between align-items-center mb-2">
                                        <span class="text-muted fw-bold"><i class="bi bi-bell-fill me-1 text-primary"></i> Dịch vụ đã chọn (@Model.Services.Count):</span>
                                        <span class="fw-bold text-success">+@Model.Services.Sum(s => s.TotalPrice).ToString("N0") ₫</span>
                                    </div>
                                    <div class="bg-white p-3 rounded-3 border">
                                        @foreach (var svc in Model.Services)
                                        {
                                            <div class="d-flex justify-content-between align-items-center small py-1 @(svc != Model.Services.Last() ? "border-bottom" : "")">
                                                <div>
                                                    <span class="fw-semibold text-navy">@svc.Name</span>
                                                    <span class="badge bg-light text-dark border ms-1">x@(svc.Quantity)</span>
                                                    <span class="text-muted ms-1">(@svc.UnitPrice.ToString("N0") ₫/lượt)</span>
                                                </div>
                                                <span class="fw-semibold text-dark">@svc.TotalPrice.ToString("N0") ₫</span>
                                            </div>
                                        }
                                    </div>
                                </div>
                            }

                            @{
                                var nightsCount = Math.Max(1, (Model.CheckOut.Date - Model.CheckIn.Date).Days);
                                var totalSvc = Model.Services?.Sum(s => s.TotalPrice) ?? 0;
                                var roomPriceEst = Model.TotalAmount + Model.DiscountAmount - totalSvc;
                            }

                            <!-- Bảng phân tích chi phí -->
                            <div class="bg-white p-3 rounded-3 border mb-3">
                                <div class="small fw-bold text-navy mb-2 border-bottom pb-1">Tóm tắt thanh toán:</div>
                                <div class="d-flex justify-content-between small text-muted mb-1">
                                    <span>Tiền phòng (@nightsCount đêm):</span>
                                    <span>@roomPriceEst.ToString("N0") ₫</span>
                                </div>
                                @if (totalSvc > 0)
                                {
                                    <div class="d-flex justify-content-between small text-muted mb-1">
                                        <span>Dịch vụ bổ sung:</span>
                                        <span class="text-success">+@totalSvc.ToString("N0") ₫</span>
                                    </div>
                                }
                                @if (!string.IsNullOrEmpty(Model.PromoCode) && Model.DiscountAmount > 0)
                                {
                                    <div class="d-flex justify-content-between small text-success mb-1">
                                        <span>Ưu đãi (@Model.PromoCode):</span>
                                        <span class="fw-bold">-@Model.DiscountAmount.ToString("N0") ₫</span>
                                    </div>
                                }
                            </div>

                            <div class="d-flex justify-content-between align-items-center mt-3 p-3 bg-white rounded-3 shadow-sm border border-danger-subtle">
                                <div>
                                    <span class="fs-6 fw-bold text-navy d-block">Tổng số tiền cần thanh toán:</span>
                                    <span class="small text-muted">(Đã bao gồm tiền phòng &amp; dịch vụ)</span>
                                </div>
                                <span class="fs-3 fw-bold text-danger">@Model.TotalAmount.ToString("N0") ₫</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal Thông báo Trạng thái Thanh toán Hiện đại (Thay thế alert) -->
<div class="modal fade" id="checkoutNoticeModal" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" style="max-width: 440px;">
        <div class="modal-content border-0 rounded-4 shadow-lg text-center p-4">
            <div class="modal-body p-0">
                <div id="noticeModalIconWrap" class="mb-3 d-inline-flex justify-content-center align-items-center rounded-circle" style="width: 80px; height: 80px; background-color: #ecfdf5;">
                    <i id="noticeModalIcon" class="bi bi-check-circle-fill text-success fs-1"></i>
                </div>
                <h4 id="noticeModalTitle" class="fw-bold text-navy mb-2">Thanh toán thành công!</h4>
                <p id="noticeModalMessage" class="text-muted small mb-4">Giao dịch đã được xác nhận. Đang chuyển hướng...</p>
                <div class="d-grid gap-2">
                    <button type="button" id="noticeModalBtn" class="btn btn-primary btn-lg rounded-pill fw-bold py-2 shadow-sm" onclick="handleNoticeModalConfirm()">
                        Xem chuyến đi của tôi
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Xử lý báo lỗi load mã QR
        function showQrLoadError() {
            const qrImg = document.getElementById('vnpayRealQrImage');
            const errBox = document.getElementById('qrErrorBox');
            if (qrImg) qrImg.style.display = 'none';
            if (errBox) errBox.classList.remove('d-none');
        }

        function hideQrLoadError() {
            const errBox = document.getElementById('qrErrorBox');
            if (errBox && '@(!string.IsNullOrEmpty(vnPayUrl))' === 'True') {
                errBox.classList.add('d-none');
            }
        }

        // Modal thông báo hiện đại thay thế alert
        let noticeRedirectUrl = '/Home/Trips';
        function showCheckoutNoticeModal({ type, title, message, btnText, redirectUrl }) {
            noticeRedirectUrl = redirectUrl || '/Home/Trips';
            const iconWrap = document.getElementById('noticeModalIconWrap');
            const iconEl = document.getElementById('noticeModalIcon');
            const titleEl = document.getElementById('noticeModalTitle');
            const msgEl = document.getElementById('noticeModalMessage');
            const btnEl = document.getElementById('noticeModalBtn');

            if (type === 'success') {
                if (iconWrap) iconWrap.style.backgroundColor = '#ecfdf5';
                if (iconEl) iconEl.className = 'bi bi-check-circle-fill text-success fs-1';
                if (btnEl) btnEl.className = 'btn btn-success btn-lg rounded-pill fw-bold py-2 shadow-sm';
            } else if (type === 'expired' || type === 'cancelled') {
                if (iconWrap) iconWrap.style.backgroundColor = '#fef2f2';
                if (iconEl) iconEl.className = 'bi bi-clock-history text-danger fs-1';
                if (btnEl) btnEl.className = 'btn btn-danger btn-lg rounded-pill fw-bold py-2 shadow-sm';
            }

            if (titleEl) titleEl.textContent = title;
            if (msgEl) msgEl.textContent = message;
            if (btnEl && btnText) btnEl.textContent = btnText;

            const modalEl = document.getElementById('checkoutNoticeModal');
            if (modalEl && typeof bootstrap !== 'undefined') {
                const modalInstance = new bootstrap.Modal(modalEl);
                modalInstance.show();
                setTimeout(() => {
                    window.location.href = noticeRedirectUrl;
                }, 3500);
            } else {
                alert(message);
                window.location.href = noticeRedirectUrl;
            }
        }

        function handleNoticeModalConfirm() {
            window.location.href = noticeRedirectUrl;
        }

        // 1. Countdown timer cho 30 phút thực tế kể từ lúc tạo đơn
        const serverRemainingSecs = Math.max(0, parseInt('@(ViewBag.RemainingSeconds ?? 1800)', 10));
        const targetExpiryTimestamp = Date.now() + (serverRemainingSecs * 1000);
        const display = document.getElementById('countdownTimer');

        function updateDisplay(secs) {
            if (!display) return;
            const m = Math.floor(secs / 60);
            const s = secs % 60;
            display.textContent = (m < 10 ? "0" + m : m) + ":" + (s < 10 ? "0" + s : s);
        }

        updateDisplay(serverRemainingSecs);

        const timer = setInterval(async function () {
            const now = Date.now();
            const diffMs = targetExpiryTimestamp - now;
            const diffSecs = Math.max(0, Math.ceil(diffMs / 1000));

            if (diffSecs <= 0) {
                clearInterval(timer);
                clearInterval(pollInterval);
                updateDisplay(0);

                try {
                    await fetch('/Home/ExpireBooking?bookingId=@Model.Id', {
                        method: 'POST',
                        headers: {
                            'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value || ''
                        }
                    });
                } catch (e) {
                    console.error('Lỗi khi hủy đơn quá hạn:', e);
                }

                showCheckoutNoticeModal({
                    type: 'expired',
                    title: 'Hết thời hạn thanh toán (30 phút)',
                    message: 'Thời hạn thanh toán đã kết thúc! Đơn đặt phòng của bạn đã tự động chuyển sang trạng thái Đã hủy và giải phóng phòng.',
                    btnText: 'Quay lại chuyến đi',
                    redirectUrl: '/Home/Trips'
                });
            } else {
                updateDisplay(diffSecs);
            }
        }, 1000);

        // 2. Real-time status polling (tự động phát hiện khi khách quét QR hoặc thanh toán xong trên VNPay hoặc đơn bị hủy)
        const pollInterval = setInterval(async function () {
            try {
                const response = await fetch('/Home/CheckPaymentStatus?bookingId=@Model.Id');
                if (response.ok) {
                    const data = await response.json();
                    if (data.isPaid) {
                        clearInterval(pollInterval);
                        clearInterval(timer);
                        showCheckoutNoticeModal({
                            type: 'success',
                            title: 'Thanh toán VNPay thành công!',
                            message: 'Giao dịch VNPay hoàn tất. Đơn đặt phòng của bạn đã được chuyển sang trạng thái Chờ chủ cơ sở duyệt.',
                            btnText: 'Xem chuyến đi của tôi',
                            redirectUrl: '/Home/Trips'
                        });
                    } else if (data.isCancelled) {
                        clearInterval(pollInterval);
                        clearInterval(timer);
                        showCheckoutNoticeModal({
                            type: 'cancelled',
                            title: 'Đơn đặt phòng đã bị hủy',
                            message: 'Đơn đặt phòng này đã tự động chuyển sang trạng thái Đã hủy do hết thời hạn thanh toán (30 phút).',
                            btnText: 'Quay lại chuyến đi',
                            redirectUrl: '/Home/Trips'
                        });
                    }
                }
            } catch (err) {
                console.error("Lỗi khi kiểm tra trạng thái thanh toán:", err);
            }
        }, 2500);
    </script>
}
