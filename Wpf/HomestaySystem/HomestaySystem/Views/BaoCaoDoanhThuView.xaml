                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="FontWeight" Value="Bold"/>
                                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                                    </Style>
                                                </DataGridTextColumn.ElementStyle>
                                            </DataGridTextColumn>

                                            <DataGridTextColumn Header="KHÁCH HÀNG" Binding="{Binding HoTen}" Width="*" MinWidth="160">
                                                <DataGridTextColumn.ElementStyle>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                                        <Setter Property="Foreground" Value="{StaticResource MauChuTieuDe}"/>
                                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                                        <Setter Property="Padding" Value="8,0"/>
                                                        <Setter Property="ToolTip" Value="{Binding HoTen}"/>
                                                    </Style>
                                                </DataGridTextColumn.ElementStyle>
                                            </DataGridTextColumn>

                                            <DataGridTextColumn Header="SỐ ĐƠN" Binding="{Binding SoDonDat, StringFormat='{}{0} đơn'}" Width="Auto" MinWidth="90">
                                                <DataGridTextColumn.ElementStyle>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="FontWeight" Value="Bold"/>
                                                        <Setter Property="Foreground" Value="{StaticResource MauStaylyPrimary}"/>
                                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                                        <Setter Property="Padding" Value="8,0"/>
                                                    </Style>
                                                </DataGridTextColumn.ElementStyle>
                                            </DataGridTextColumn>

                                            <DataGridTextColumn Header="TỔNG CHI TIÊU" Binding="{Binding TongChiTieuDinhDang}" Width="Auto" MinWidth="130">
                                                <DataGridTextColumn.ElementStyle>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="FontWeight" Value="Bold"/>
                                                        <Setter Property="Foreground" Value="{StaticResource MauStaylyGreen}"/>
                                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                                        <Setter Property="Padding" Value="8,0"/>
                                                    </Style>
                                                </DataGridTextColumn.ElementStyle>
                                            </DataGridTextColumn>

                                            <DataGridTextColumn Header="HẠNG HỘI VIÊN" Binding="{Binding HangThanhVien}" Width="Auto" MinWidth="140">
                                                <DataGridTextColumn.ElementStyle>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                                        <Setter Property="Foreground" Value="#F59E0B"/>
                                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                                        <Setter Property="Padding" Value="8,0"/>
                                                    </Style>
                                                </DataGridTextColumn.ElementStyle>
                                            </DataGridTextColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </StackPanel>
                            </Border>

                            <!-- CỘT 2: TOP CHỦ HOMESTAY HOẠT ĐỘNG XUẤT SẮC -->
                            <Border Grid.Column="2" Style="{StaticResource StaylyCard}" Padding="16">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,12">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Width="30" Height="30" CornerRadius="15" Background="#ECFDF5" Margin="0,0,8,0">
                                                <TextBlock Text="🎖️" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="TOP CHỦ HOMESTAY HOẠT ĐỘNG XUẤT SẮC" FontSize="13" FontWeight="Bold" Foreground="{StaticResource MauChuTieuDe}"/>
                                                <TextBlock Text="Đối tác TERA đạt doanh số cao &amp; dịch vụ chuẩn" FontSize="11" Foreground="{StaticResource MauChuPhu}"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </DockPanel>

                                    <DataGrid ItemsSource="{Binding DanhSachTopChuHome}" Style="{StaticResource StaylyDataGridStyle}"
                                              IsReadOnly="True" RowHeight="46" CanUserResizeColumns="True" MaxHeight="280"
                                              ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="HẠNG" Binding="{Binding HuyHieu}" Width="Auto" MinWidth="65">
                                                <DataGridTextColumn.ElementStyle>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="FontWeight" Value="Bold"/>
                                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                                    </Style>
                                                </DataGridTextColumn.ElementStyle>
                                            </DataGridTextColumn>

                                            <DataGridTextColumn Header="CHỦ HOMESTAY" Binding="{Binding HoTen}" Width="*" MinWidth="160">
                                                <DataGridTextColumn.ElementStyle>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                                        <Setter Property="Foreground" Value="{StaticResource MauChuTieuDe}"/>
                                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                                        <Setter Property="Padding" Value="8,0"/>
                                                        <Setter Property="ToolTip" Value="{Binding HoTen}"/>
                                                    </Style>
                                                </DataGridTextColumn.ElementStyle>
