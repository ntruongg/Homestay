                    <MouseBinding MouseAction="LeftClick" Command="{Binding HuyDialogThemMoiCommand}"/>
                </Border.InputBindings>
            </Border>
            <Border Background="White" CornerRadius="16" Width="550" Padding="24" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" Opacity="0.25" BlurRadius="24" ShadowDepth="4"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Header Modal -->
                    <DockPanel Grid.Row="0" Margin="0,0,0,16">
                        <Border Width="36" Height="36" CornerRadius="18" Background="{StaticResource MauStaylyPrimaryLight}" Margin="0,0,10,0">
                            <TextBlock Text="➕" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="THÊM TÀI KHOẢN NGƯỜI DÙNG MỚI" FontSize="15" FontWeight="Bold" Foreground="{StaticResource MauStaylyPrimary}"/>
                            <TextBlock Text="Cấp tài khoản sử dụng sàn Stayly cho khách thuê hoặc quản trị viên" FontSize="12" Foreground="{StaticResource MauChuPhu}"/>
                        </StackPanel>
                    </DockPanel>

                    <!-- Form Input Fields -->
                    <StackPanel Grid.Row="1" Margin="0,0,0,16">
                        <!-- Tên đăng nhập & Mật khẩu -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Tên đăng nhập (Username) *:" FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource MauChuPhu}" Margin="0,0,0,4"/>
                                <Border Background="#F1F5F9" CornerRadius="8" Padding="12,7" BorderBrush="{StaticResource MauVien}" BorderThickness="1">
                                    <TextBox Text="{Binding ThemTenDangNhap, UpdateSourceTrigger=PropertyChanged}"
                                             BorderThickness="0" Background="Transparent" FontSize="13.5" Foreground="{StaticResource MauChuChinh}"/>
                                </Border>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Mật khẩu khởi tạo *:" FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource MauChuPhu}" Margin="0,0,0,4"/>
                                <Border Background="#F1F5F9" CornerRadius="8" Padding="12,7" BorderBrush="{StaticResource MauVien}" BorderThickness="1">
                                    <TextBox Text="{Binding ThemMatKhau, UpdateSourceTrigger=PropertyChanged}"
                                             BorderThickness="0" Background="Transparent" FontSize="13.5" Foreground="{StaticResource MauChuChinh}"/>
                                </Border>
                            </StackPanel>
                        </Grid>

                        <!-- Họ tên & Vai trò -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="140"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Họ và tên người dùng *:" FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource MauChuPhu}" Margin="0,0,0,4"/>
                                <Border Background="#F1F5F9" CornerRadius="8" Padding="12,7" BorderBrush="{StaticResource MauVien}" BorderThickness="1">
                                    <TextBox Text="{Binding ThemHoTen, UpdateSourceTrigger=PropertyChanged}"
                                             BorderThickness="0" Background="Transparent" FontSize="13.5" Foreground="{StaticResource MauChuChinh}"/>
                                </Border>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Vai trò:" FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource MauChuPhu}" Margin="0,0,0,4"/>
                                <ComboBox SelectedValuePath="Tag" SelectedValue="{Binding ThemVaiTro}" Height="38" FontSize="13" VerticalAlignment="Center">
                                    <ComboBoxItem Content="Khách hàng" Tag="KhachHang" IsSelected="True"/>
                                    <ComboBoxItem Content="Quản trị viên" Tag="QuanTriVien"/>
                                </ComboBox>
                            </StackPanel>
                        </Grid>

                        <!-- Số điện thoại & Email -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Số điện thoại *:" FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource MauChuPhu}" Margin="0,0,0,4"/>
                                <Border Background="#F1F5F9" CornerRadius="8" Padding="12,7" BorderBrush="{StaticResource MauVien}" BorderThickness="1">
                                    <TextBox Text="{Binding ThemSoDienThoai, UpdateSourceTrigger=PropertyChanged}"
                                             BorderThickness="0" Background="Transparent" FontSize="13.5" Foreground="{StaticResource MauChuChinh}"/>
                                </Border>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Email liên hệ *:" FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource MauChuPhu}" Margin="0,0,0,4"/>
                                <Border Background="#F1F5F9" CornerRadius="8" Padding="12,7" BorderBrush="{StaticResource MauVien}" BorderThickness="1">
                                    <TextBox Text="{Binding ThemEmail, UpdateSourceTrigger=PropertyChanged}"
                                             BorderThickness="0" Background="Transparent" FontSize="13.5" Foreground="{StaticResource MauChuChinh}"/>
                                </Border>
                            </StackPanel>
                        </Grid>

                        <!-- Ngày sinh & Giới tính -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="140"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Ngày sinh:" FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource MauChuPhu}" Margin="0,0,0,4"/>
                                <DatePicker SelectedDate="{Binding ThemNgaySinh}" Height="38" FontSize="13" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Giới tính:" FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource MauChuPhu}" Margin="0,0,0,4"/>
                                <ComboBox SelectedValuePath="Tag" SelectedValue="{Binding ThemGioiTinh}" Height="38" FontSize="13" VerticalAlignment="Center">
                                    <ComboBoxItem Content="Nam" Tag="Nam" IsSelected="True"/>
                                    <ComboBoxItem Content="Nữ" Tag="Nữ"/>
                                    <ComboBoxItem Content="Khác" Tag="Khác"/>
                                </ComboBox>
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <!-- Buttons -->
                    <DockPanel Grid.Row="2" LastChildFill="False">
                        <Button DockPanel.Dock="Left" Command="{Binding HuyDialogThemMoiCommand}" Content="Hủy bỏ" Background="#F1F5F9"
                                BorderThickness="0" Padding="20,9" FontSize="13" FontWeight="SemiBold" Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="8"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                        <Button DockPanel.Dock="Right" Command="{Binding XacNhanThemMoiCommand}" Content="✅ Lưu &amp; Kích hoạt" Background="{StaticResource MauStaylyGreen}"
                                Foreground="White" BorderThickness="0" Padding="22,9" FontSize="13" FontWeight="Bold" Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="8"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </DockPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
