<Window x:Class="HomestaySystem.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:HomestaySystem.ViewModels"
        mc:Ignorable="d"
        Title="HomestaySystem - Cổng Quản Trị Hệ Thống" 
        Height="820" Width="1380"
        MinHeight="680" MinWidth="1100"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource MauNenChinh}">

    <!-- CẤU TRÚC 2 CỘT: CỘT TRÁI (SIDEBAR 280PX) + CỘT PHẢI (NỘI DUNG CHÍNH) -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ================= CỘT 1: SIDEBAR NAVIGATION HOMESTAYSYSTEM ================= -->
        <Border Grid.Column="0" Background="{StaticResource MauSidebarNen}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 1.1. LOGO & TIÊU ĐỀ THƯƠNG HIỆU HOMESTAYSYSTEM -->
                <Border Grid.Row="0" Padding="20,22" BorderBrush="#142E5C" BorderThickness="0,0,0,1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <!-- Biểu tượng HomestaySystem -->
                        <Border Grid.Column="0" Width="44" Height="44" CornerRadius="12" Background="#0194F3" VerticalAlignment="Center">
                            <TextBlock Text="🏡" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="HOMESTAY" FontWeight="Black" FontSize="16" Foreground="#FFFFFF"/>
                                <TextBlock Text="SYSTEM" FontWeight="Black" FontSize="16" Foreground="#0194F3" Margin="4,0,0,0"/>
                            </StackPanel>
                            <TextBlock Text="Cổng Quản Trị Hệ Thống" FontSize="11" Foreground="#93C5FD" Margin="0,3,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 1.2. DANH SÁCH MENU ĐIỀU HƯỚNG CHỨC NĂNG -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,16,0,16">
                    <StackPanel Margin="14,0">
                        <!-- Nhãn nhóm 1 -->
                        <TextBlock Text="NGHIỆP VỤ CỐT LÕI" Foreground="#64748B" FontSize="10" FontWeight="Bold" Margin="12,6,0,8"/>

                        <!-- Menu 1: Kiểm duyệt Homestay -->
                        <RadioButton GroupName="SidebarMenu" Command="{Binding ChuyenManHinhKiemDuyetCommand}" IsChecked="True">
                            <RadioButton.Template>
                                <ControlTemplate TargetType="RadioButton">
                                    <Border x:Name="btnBorder" Background="Transparent" CornerRadius="8" Padding="14,11" Margin="0,3" Cursor="Hand">
                                        <Grid>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="📋" FontSize="16" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                                <TextBlock Text="Kiểm duyệt Homestay" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" x:Name="txtTitle" Foreground="#94A3B8"/>
                                            </StackPanel>
                                            <!-- Badge số lượng chờ duyệt màu cam HomestaySystem -->
                                            <Border HorizontalAlignment="Right" Background="#FF5E1F" CornerRadius="10" Padding="8,2" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding KiemDuyetVM.SoLuongChoDuyet}" Foreground="White" FontSize="11" FontWeight="Bold"/>
                                            </Border>
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="btnBorder" Property="Background" Value="#142E5C"/>
                                            <Setter TargetName="txtTitle" Property="Foreground" Value="White"/>
                                        </Trigger>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="btnBorder" Property="Background" Value="#0194F3"/>
                                            <Setter TargetName="txtTitle" Property="Foreground" Value="White"/>
                                            <Setter TargetName="txtTitle" Property="FontWeight" Value="Bold"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </RadioButton.Template>
                        </RadioButton>

                        <!-- Menu 2: Quản lý Tài khoản & Đối tác TERA -->
                        <RadioButton GroupName="SidebarMenu" Command="{Binding ChuyenManHinhTaiKhoanCommand}">
                            <RadioButton.Template>
                                <ControlTemplate TargetType="RadioButton">
                                    <Border x:Name="btnBorder" Background="Transparent" CornerRadius="8" Padding="14,11" Margin="0,3" Cursor="Hand">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="👥" FontSize="16" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                            <TextBlock Text="Tài khoản &amp; Người dùng" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" x:Name="txtTitle" Foreground="#94A3B8"/>
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="btnBorder" Property="Background" Value="#142E5C"/>
                                            <Setter TargetName="txtTitle" Property="Foreground" Value="White"/>
                                        </Trigger>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="btnBorder" Property="Background" Value="#0194F3"/>
                                            <Setter TargetName="txtTitle" Property="Foreground" Value="White"/>
                                            <Setter TargetName="txtTitle" Property="FontWeight" Value="Bold"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </RadioButton.Template>
                        </RadioButton>

                        <!-- Nhãn nhóm 2 -->
                        <TextBlock Text="ĐẶT PHÒNG &amp; DÒNG TIỀN" Foreground="#64748B" FontSize="10" FontWeight="Bold" Margin="12,18,0,8"/>

                        <!-- Menu 3: Quản lý Đơn đặt phòng & Hoàn tiền -->
                        <RadioButton GroupName="SidebarMenu" Command="{Binding ChuyenManHinhDonDatCommand}">
                            <RadioButton.Template>
                                <ControlTemplate TargetType="RadioButton">
                                    <Border x:Name="btnBorder" Background="Transparent" CornerRadius="8" Padding="14,11" Margin="0,3" Cursor="Hand">
                                        <Grid>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="📑" FontSize="16" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                                <TextBlock Text="Đơn đặt &amp; Hoàn tiền" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" x:Name="txtTitle" Foreground="#94A3B8"/>
                                            </StackPanel>
                                            <!-- Badge số đơn yêu cầu hoàn tiền nếu có -->
                                            <Border HorizontalAlignment="Right" Background="#EF4444" CornerRadius="10" Padding="7,2" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding QuanLyDonDatVM.SoDonYeuCauHoanTien}" Foreground="White" FontSize="11" FontWeight="Bold"/>
                                            </Border>
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="btnBorder" Property="Background" Value="#142E5C"/>
                                            <Setter TargetName="txtTitle" Property="Foreground" Value="White"/>
                                        </Trigger>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="btnBorder" Property="Background" Value="#0194F3"/>
                                            <Setter TargetName="txtTitle" Property="Foreground" Value="White"/>
                                            <Setter TargetName="txtTitle" Property="FontWeight" Value="Bold"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </RadioButton.Template>
                        </RadioButton>

                        <!-- Menu 4: Báo cáo Doanh thu -->
                        <RadioButton GroupName="SidebarMenu" Command="{Binding ChuyenManHinhBaoCaoCommand}">
                            <RadioButton.Template>
                                <ControlTemplate TargetType="RadioButton">
                                    <Border x:Name="btnBorder" Background="Transparent" CornerRadius="8" Padding="14,11" Margin="0,3" Cursor="Hand">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="📊" FontSize="16" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                            <TextBlock Text="Báo cáo Doanh thu Sàn" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" x:Name="txtTitle" Foreground="#94A3B8"/>
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="btnBorder" Property="Background" Value="#142E5C"/>
                                            <Setter TargetName="txtTitle" Property="Foreground" Value="White"/>
                                        </Trigger>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="btnBorder" Property="Background" Value="#0194F3"/>
                                            <Setter TargetName="txtTitle" Property="Foreground" Value="White"/>
                                            <Setter TargetName="txtTitle" Property="FontWeight" Value="Bold"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </RadioButton.Template>
                        </RadioButton>

                        <!-- Nhãn nhóm 3 -->
                        <TextBlock Text="MARKETING &amp; ƯU ĐÃI" Foreground="#64748B" FontSize="10" FontWeight="Bold" Margin="12,18,0,8"/>

                        <!-- Menu 5: Quản lý Khuyến mãi -->
                        <RadioButton GroupName="SidebarMenu" Command="{Binding ChuyenManHinhKhuyenMaiCommand}">
                            <RadioButton.Template>
                                <ControlTemplate TargetType="RadioButton">
                                    <Border x:Name="btnBorder" Background="Transparent" CornerRadius="8" Padding="14,11" Margin="0,3" Cursor="Hand">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="🎟️" FontSize="16" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                            <TextBlock Text="Mã ưu đãi (Voucher giảm giá)" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" x:Name="txtTitle" Foreground="#94A3B8"/>
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="btnBorder" Property="Background" Value="#142E5C"/>
                                            <Setter TargetName="txtTitle" Property="Foreground" Value="White"/>
                                        </Trigger>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="btnBorder" Property="Background" Value="#0194F3"/>
                                            <Setter TargetName="txtTitle" Property="Foreground" Value="White"/>
                                            <Setter TargetName="txtTitle" Property="FontWeight" Value="Bold"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </RadioButton.Template>
                        </RadioButton>
                    </StackPanel>
                </ScrollViewer>

                <!-- 1.3. PROFILE QUẢN TRỊ VIÊN & NÚT ĐĂNG XUẤT -->
                <Border Grid.Row="2" Padding="16,14" Background="{StaticResource MauSidebarFooter}" BorderBrush="#142E5C" BorderThickness="0,1,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="38" Height="38" CornerRadius="19" Background="#0194F3" VerticalAlignment="Center">
                            <TextBlock Text="👨‍💼" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="10,0,8,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding TenQuanTriVien}" FontWeight="Bold" FontSize="12" Foreground="White" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding VaiTroQuanTriVien}" FontSize="10" Foreground="#93C5FD" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <Button Grid.Column="2" Command="{Binding DangXuatCommand}" ToolTip="Đăng xuất khỏi hệ thống"
                                Background="#1E293B" BorderBrush="#334155" BorderThickness="1" Foreground="#F87171"
                                FontWeight="Bold" FontSize="11" Cursor="Hand" Padding="10,6">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="6"/>
                                </Style>
                            </Button.Resources>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🚪" FontSize="12" Margin="0,0,4,0"/>
                                <TextBlock Text="Đăng xuất"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- ================= CỘT 2: VÙNG NỘI DUNG CHÍNH (CONTENT AREA) ================= -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="66"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 2.1. HEADER THANH TRÊN CÙNG CHUẨN HOMESTAYSYSTEM -->
            <Border Grid.Row="0" Background="White" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1" Padding="28,0">
                <Grid>
                    <!-- Tiêu đề trang hiện hành & Breadcrumb -->
                    <StackPanel Orientation="Vertical" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="HomestaySystem" FontSize="11" Foreground="#64748B" FontWeight="Medium"/>
                            <TextBlock Text=" ❯ " FontSize="10" Foreground="#94A3B8" Margin="4,0"/>
                            <TextBlock Text="{Binding TieuDeTrang}" FontSize="11" Foreground="#0194F3" FontWeight="Bold"/>
                        </StackPanel>
                        <TextBlock Text="{Binding TieuDeTrang}" FontSize="18" FontWeight="ExtraBold" Foreground="#0F172A" Margin="0,2,0,0"/>
                    </StackPanel>

                    <!-- Bên phải: Trạng thái kết nối & Đồng hồ hệ thống -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <!-- Chỉ thị trạng thái Server HomestaySystem -->
                        <Border Background="#E8F7EE" BorderBrush="#A7F3D0" BorderThickness="1" CornerRadius="14" Padding="12,5" Margin="0,0,14,0">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="8" Height="8" Fill="#0E9F6E" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Hệ Thống Trực Tuyến" Foreground="#0E9F6E" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- Đồng hồ hệ thống -->
                        <Border Background="#F7F9FA" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="8" Padding="12,6">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🕒 " FontSize="11" Foreground="#64748B"/>
                                <TextBlock Text="{Binding ThoiGianHeThong}" Foreground="#334155" FontSize="12" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 2.2. VÙNG HIỂN THỊ MÀN HÌNH CHỨC NĂNG (CONTENTCONTROL MVVM) -->
            <ContentControl Grid.Row="1" Content="{Binding ManHinhHienTai}"/>
        </Grid>
    </Grid>
</Window>
