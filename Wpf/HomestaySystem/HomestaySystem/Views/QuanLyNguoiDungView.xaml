                                        </StackPanel>
                                        <TextBlock Text="{Binding SelectedUser.LyDoTuChoiHienThi, FallbackValue='Chưa cập nhật lý do cụ thể'}" FontSize="12" Foreground="#991B1B" TextWrapping="Wrap" LineHeight="18"/>
                                    </StackPanel>
                                </Border>

                                <Separator Background="#F1F5F9" Margin="0,0,0,12"/>

                                <!-- Thông tin liên hệ -->
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Email:" FontSize="13" Foreground="{StaticResource MauChuPhu}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding SelectedUser.EmailHienThi, FallbackValue='-'}" 
                                               FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource MauChuChinh}" TextAlignment="Right" TextWrapping="Wrap"/>
                                </Grid>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Số điện thoại:" FontSize="13" Foreground="{StaticResource MauChuPhu}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding SelectedUser.SoDienThoaiHienThi, FallbackValue='-'}" 
                                               FontSize="13.5" FontWeight="Bold" Foreground="{StaticResource MauStaylyPrimary}" TextAlignment="Right"/>
                                </Grid>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Ngày sinh:" FontSize="13" Foreground="{StaticResource MauChuPhu}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding SelectedUser.NgaySinhHienThi, FallbackValue='Chưa cập nhật'}" 
                                               FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource MauChuChinh}" TextAlignment="Right"/>
                                </Grid>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Giới tính:" FontSize="13" Foreground="{StaticResource MauChuPhu}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding SelectedUser.GioiTinhHienThi, FallbackValue='Chưa cập nhật'}" 
                                               FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource MauChuChinh}" TextAlignment="Right"/>
                                </Grid>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Số đơn đã đặt:" FontSize="13" Foreground="{StaticResource MauChuPhu}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding SelectedUser.SoLuotDatPhong, StringFormat='{}{0} đơn đặt', FallbackValue='0 đơn'}" 
                                               FontSize="13.5" FontWeight="Bold" Foreground="{StaticResource MauChuTieuDe}" TextAlignment="Right"/>
                                </Grid>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Ngày tham gia:" FontSize="13" Foreground="{StaticResource MauChuPhu}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding SelectedUser.NgayTaoHienThi, FallbackValue='-'}" 
                                               FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource MauChuPhu}" TextAlignment="Right"/>
                                </Grid>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- Sticky Bottom Action Buttons -->
                        <Border Grid.Row="2" BorderBrush="{StaticResource MauVien}" BorderThickness="0,1,0,0" Padding="0,12,0,0" Margin="0,6,0,0">
                            <StackPanel>
                                <TextBlock Text="THAO TÁC TÀI KHOẢN NGƯỜI DÙNG" FontSize="12" FontWeight="Bold" Foreground="{StaticResource MauChuPhu}" Margin="0,0,0,8"/>
                                
                                <!-- NÚT CHỈNH SỬA THÔNG TIN NGƯỜI DÙNG RIÊNG BIỆT -->
                                <Button Content="✏️ Chỉnh sửa thông tin người dùng" Height="38" Background="{StaticResource MauStaylyPrimary}" Foreground="White" 
                                        FontWeight="Bold" FontSize="13" BorderThickness="0" Margin="0,0,0,8"
                                        Command="{Binding MoDialogChinhSuaCommand}" Cursor="Hand" ToolTip="Chỉnh sửa thông tin cá nhân của người dùng">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="8"/>
                                        </Style>
                                    </Button.Resources>
                                </Button>
                                
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <!-- NÚT TỪ CHỐI TÀI KHOẢN: MỞ MODAL DIALOG KHUNG NÊU LÝ DO -->
                                    <Button Grid.Column="0" Content="🚫 Từ chối / Khóa" Height="38" Background="{StaticResource MauStaylyRed}" Foreground="White" 
                                            FontWeight="Bold" FontSize="13" BorderThickness="0"
                                            Command="{Binding MoDialogTuChoiCommand}" Cursor="Hand" ToolTip="Từ chối tài khoản với khung nêu lý do chi tiết">
                                        <Button.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="8"/>
                                            </Style>
                                        </Button.Resources>
                                    </Button>

                                    <!-- NÚT MỞ TÀI KHOẢN -->
                                    <Button Grid.Column="2" Content="🔓 Mở tài khoản" Height="38" Background="{StaticResource MauStaylyGreen}" Foreground="White" 
                                            FontWeight="Bold" FontSize="13" BorderThickness="0"
                                            Command="{Binding MoKhoaTaiKhoanCommand}" Cursor="Hand" ToolTip="Kích hoạt lại tài khoản người dùng">
                                        <Button.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="8"/>
                                            </Style>
                                        </Button.Resources>
                                    </Button>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

        <!-- ================= MODAL DIALOG: KHUNG NÊU LÝ DO TỪ CHỐI TÀI KHOẢN ================= -->
        <Grid Visibility="{Binding HienThiDialogTuChoi, Converter={StaticResource BoolToVis}}"
              HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <!-- Nền mờ: Nhấp chuột ra ngoài để hủy -->
            <Border Background="#99000000" Cursor="Hand" ToolTip="Nhấp vào vùng ngoài để đóng">
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftClick" Command="{Binding HuyBoTuChoiCommand}"/>
                </Border.InputBindings>
            </Border>
            <Border Background="White" CornerRadius="16" Width="530" Padding="24" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" Opacity="0.25" BlurRadius="24" ShadowDepth="4"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Header Modal -->
                    <StackPanel Grid.Row="0" Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="🚫 " FontSize="18"/>
                            <TextBlock Text="{Binding TieuDeDialog}" FontSize="16" FontWeight="ExtraBold" Foreground="{StaticResource MauStaylyRed}"/>
                        </StackPanel>
                        <TextBlock Text="Vui lòng nêu rõ lý do từ chối để hệ thống lưu hồ sơ vi phạm và gửi thông báo tới người dùng:" 
                                   FontSize="12.5" Foreground="{StaticResource MauChuPhu}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                    </StackPanel>

                    <!-- Snippet thông tin tài khoản đang xử lý -->
                    <Border Grid.Row="1" Background="#F8FAFC" BorderBrush="{StaticResource MauVien}" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="36" Height="36" CornerRadius="18" Background="#E0F2FE" Margin="0,0,10,0">
                                <TextBlock Text="👤" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding TaiKhoanDangChon.HoTen}" FontWeight="Bold" FontSize="13.5" Foreground="{StaticResource MauChuTieuDe}"/>
                                <TextBlock Text="{Binding TaiKhoanDangChon.Email}" FontSize="12" Foreground="{StaticResource MauChuPhu}"/>
                            </StackPanel>
                            <Border Grid.Column="2" Background="#FEF3C7" CornerRadius="6" Padding="8,3" VerticalAlignment="Center">
                                <TextBlock Text="{Binding TaiKhoanDangChon.MaTaiKhoanHienThi}" FontSize="11" FontWeight="Bold" Foreground="#D97706"/>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Các lý do gợi ý nhanh -->
                    <StackPanel Grid.Row="2" Margin="0,0,0,8">
                        <TextBlock Text="Gợi ý lý do thường gặp (Nhấp để chọn nhanh):" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource MauChuPhu}" Margin="0,0,0,6"/>
                        <WrapPanel Orientation="Horizontal">
                            <Button Command="{Binding ChonLyDoGoiYCommand}" CommandParameter="Hủy phòng cận ngày nhiều lần không có lý do chính đáng"
                                    Content="Hủy phòng cận ngày" Background="#F1F5F9" BorderThickness="0" Padding="10,5" Margin="0,0,6,6" FontSize="11.5" Cursor="Hand">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="6"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                            <Button Command="{Binding ChonLyDoGoiYCommand}" CommandParameter="Vi phạm chính sách tiêu chuẩn văn hóa cộng đồng Stayly"
                                    Content="Vi phạm tiêu chuẩn cộng đồng" Background="#F1F5F9" BorderThickness="0" Padding="10,5" Margin="0,0,6,6" FontSize="11.5" Cursor="Hand">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="6"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                            <Button Command="{Binding ChonLyDoGoiYCommand}" CommandParameter="Tài khoản có dấu hiệu spam hoặc thông tin liên hệ không chính xác"
                                    Content="Spam / Thông tin ảo" Background="#F1F5F9" BorderThickness="0" Padding="10,5" Margin="0,0,6,6" FontSize="11.5" Cursor="Hand">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="6"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                        </WrapPanel>
                    </StackPanel>

                    <!-- KHUNG NÊU LÝ DO (TEXTBOX BẮT BUỘC) -->
                    <StackPanel Grid.Row="3" Margin="0,0,0,16">
                        <TextBlock Text="Nội dung lý do từ chối (*):" FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource MauChuTieuDe}" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding LyDoTuChoi, UpdateSourceTrigger=PropertyChanged}"
                                 Height="80" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                 BorderBrush="{StaticResource MauVien}" Padding="10,8" FontSize="13" Foreground="{StaticResource MauChuChinh}">
                            <TextBox.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="8"/>
                                </Style>
                            </TextBox.Resources>
                        </TextBox>
                    </StackPanel>

                    <!-- Nút thao tác xác nhận / hủy -->
                    <DockPanel Grid.Row="4" LastChildFill="False">
                        <Button DockPanel.Dock="Left" Command="{Binding HuyBoTuChoiCommand}" Content="Hủy bỏ" Background="#F1F5F9"
                                BorderThickness="0" Padding="20,9" FontSize="13" FontWeight="SemiBold" Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="8"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                        <Button DockPanel.Dock="Right" Command="{Binding XacNhanTuChoiCommand}" Content="Xác nhận từ chối tài khoản" Background="{StaticResource MauStaylyRed}"
                                Foreground="White" BorderThickness="0" Padding="22,9" FontSize="13" FontWeight="Bold" Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="8"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </DockPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- ================= MODAL DIALOG: CHỈNH SỬA THÔNG TIN NGƯỜI DÙNG ================= -->
        <Grid Visibility="{Binding HienThiDialogChinhSua, Converter={StaticResource BoolToVis}}"
              HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <!-- Nền mờ: Nhấp chuột ra ngoài để hủy -->
            <Border Background="#99000000" Cursor="Hand" ToolTip="Nhấp vào vùng ngoài để đóng">
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftClick" Command="{Binding HuyDialogChinhSuaCommand}"/>
                </Border.InputBindings>
            </Border>
            <Border Background="White" CornerRadius="16" Width="540" Padding="24" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" Opacity="0.25" BlurRadius="24" ShadowDepth="4"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Header Modal -->
                    <DockPanel Grid.Row="0" Margin="0,0,0,14" LastChildFill="True">
                        <Border DockPanel.Dock="Right" Background="{StaticResource MauStaylyPrimaryLight}" CornerRadius="8" Padding="8,3" VerticalAlignment="Center">
                            <TextBlock Text="{Binding TaiKhoanDangChon.MaTaiKhoanHienThi, FallbackValue='#USR-001'}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource MauStaylyPrimary}"/>
                        </Border>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="✏️ " FontSize="16"/>
                            <TextBlock Text="CHỈNH SỬA THÔNG TIN NGƯỜI DÙNG" FontSize="15" FontWeight="Bold" Foreground="{StaticResource MauChuTieuDe}"/>
                        </StackPanel>
                    </DockPanel>

                    <!-- Form Body -->
                    <StackPanel Grid.Row="1" Margin="0,0,0,16">
                        <!-- Họ và tên -->
                        <TextBlock Text="Họ và tên khách hàng (*):" FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource MauChuPhu}" Margin="0,0,0,4"/>
                        <Border Background="#F1F5F9" CornerRadius="8" Padding="12,7" Margin="0,0,0,10" BorderBrush="{StaticResource MauVien}" BorderThickness="1">
                            <TextBox Text="{Binding SuaHoTen, UpdateSourceTrigger=PropertyChanged}"
                                     BorderThickness="0" Background="Transparent" FontSize="13.5" Foreground="{StaticResource MauChuChinh}"/>
                        </Border>

                        <!-- SĐT & Email -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Số điện thoại:" FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource MauChuPhu}" Margin="0,0,0,4"/>
                                <Border Background="#F1F5F9" CornerRadius="8" Padding="12,7" BorderBrush="{StaticResource MauVien}" BorderThickness="1">
                                    <TextBox Text="{Binding SuaSoDienThoai, UpdateSourceTrigger=PropertyChanged}"
                                             BorderThickness="0" Background="Transparent" FontSize="13.5" Foreground="{StaticResource MauChuChinh}"/>
                                </Border>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Email liên hệ:" FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource MauChuPhu}" Margin="0,0,0,4"/>
                                <Border Background="#F1F5F9" CornerRadius="8" Padding="12,7" BorderBrush="{StaticResource MauVien}" BorderThickness="1">
                                    <TextBox Text="{Binding SuaEmail, UpdateSourceTrigger=PropertyChanged}"
                                             BorderThickness="0" Background="Transparent" FontSize="13.5" Foreground="{StaticResource MauChuChinh}"/>
                                </Border>
                            </StackPanel>
                        </Grid>

                        <!-- Ngày sinh & Giới tính -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="140"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Ngày sinh:" FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource MauChuPhu}" Margin="0,0,0,4"/>
                                <DatePicker SelectedDate="{Binding SuaNgaySinh}" Height="38" FontSize="13" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Giới tính:" FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource MauChuPhu}" Margin="0,0,0,4"/>
                                <ComboBox SelectedValuePath="Tag" SelectedValue="{Binding SuaGioiTinh}" Height="38" FontSize="13" VerticalAlignment="Center">
                                    <ComboBoxItem Content="Nam" Tag="Nam"/>
                                    <ComboBoxItem Content="Nữ" Tag="Nữ"/>
                                    <ComboBoxItem Content="Khác" Tag="Khác"/>
                                </ComboBox>
                            </StackPanel>
                        </Grid>

                        <!-- Đổi mật khẩu -->
                        <TextBlock Text="Đổi mật khẩu mới (để trống nếu không muốn đổi):" FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource MauChuPhu}" Margin="0,0,0,4"/>
                        <Border Background="#F1F5F9" CornerRadius="8" Padding="12,7" BorderBrush="{StaticResource MauVien}" BorderThickness="1">
                            <TextBox Text="{Binding SuaMatKhau, UpdateSourceTrigger=PropertyChanged}"
                                     BorderThickness="0" Background="Transparent" FontSize="13.5" Foreground="{StaticResource MauChuChinh}"/>
                        </Border>
                    </StackPanel>

                    <!-- Buttons -->
                    <DockPanel Grid.Row="2" LastChildFill="False">
                        <Button DockPanel.Dock="Left" Command="{Binding HuyDialogChinhSuaCommand}" Content="Hủy bỏ" Background="#F1F5F9"
                                BorderThickness="0" Padding="20,9" FontSize="13" FontWeight="SemiBold" Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="8"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                        <Button DockPanel.Dock="Right" Command="{Binding XacNhanChinhSuaCommand}" Content="💾 Lưu thay đổi" Background="{StaticResource MauStaylyPrimary}"
                                Foreground="White" BorderThickness="0" Padding="22,9" FontSize="13" FontWeight="Bold" Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="8"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </DockPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- ================= MODAL DIALOG: THÊM TÀI KHOẢN NGƯỜI DÙNG MỚI ================= -->
