                                        </div>

                                        <div class="col-md-6">
                                            <label class="form-label small fw-bold">Số tài khoản *</label>
                                            <input asp-for="Input.AccountNumber" class="form-control rounded-pill px-3 py-2 bg-white" required placeholder="Nhập số tài khoản" pattern="\d{6,20}" />
                                            <span asp-validation-for="Input.AccountNumber" class="text-danger small"></span>
                                        </div>

                                        <div class="col-md-12">
                                            <label class="form-label small fw-bold">Tên chủ tài khoản (Viết hoa, không dấu) *</label>
                                            <input asp-for="Input.AccountHolder" class="form-control rounded-pill px-3 py-2 bg-white text-uppercase" required placeholder="Ví dụ: NGUYEN VAN AN" pattern="^[a-zA-ZÀÁÂÃÈÉÊÌÍÒÓÔÕÙÚĂĐĨŨƠàáâãèéêìíòóôõùúăđĩũơƯĂẠẢẤẦẨẪẬẮẰẲẴẶẸẺẼỀỀỂưăạảấầẩẫậắằẳẵặẹẻẽềềểỄỆỈỊỌỎỐỒỔỖỘỚỜỞỠỢỤỦỨỪễệỉịọỏốồổỗộớờởỡợụủứừỬỮỰỲỴÝỶỸửữựỳỵỷỹ\s]+$" />
                                            <span asp-validation-for="Input.AccountHolder" class="text-danger small"></span>
                                        </div>
                                    </div>
                                </div>
                            }
                            else
                            {
                                <div class="p-3 p-md-4 bg-light rounded-4 mb-4" id="bankSection">
                                    <h6 class="fw-bold text-navy small mb-1">
                                        <i class="bi bi-bank2 text-primary me-1"></i> Tài khoản ngân hàng nhận hoàn tiền (Tùy chọn)
                                    </h6>
                                    <p class="text-muted small mb-3">Lưu sẵn thông tin ngân hàng để hệ thống tự động điền khi bạn hủy đơn hoặc yêu cầu hoàn tiền.</p>
                                    <div class="row g-3">
                                        <div class="col-md-6">
                                            <label class="form-label small fw-bold">Ngân hàng thụ hưởng</label>
                                            <select asp-for="Input.BankName" class="form-select rounded-pill px-3 py-2 bg-white">
                                                <option value="">-- Chọn ngân hàng hỗ trợ --</option>
                                                <option value="Vietcombank (VCB)">Vietcombank (Ngân hàng Ngoại thương)</option>
                                                <option value="VietinBank (CTG)">VietinBank (Ngân hàng Công thương)</option>
                                                <option value="BIDV">BIDV (Đầu tư và Phát triển)</option>
                                                <option value="Agribank">Agribank (Nông nghiệp &amp; PTNT)</option>
                                                <option value="MB Bank (Ngân hàng Quân Đội)">MB Bank (Ngân hàng Quân Đội)</option>
                                                <option value="Techcombank (TCB)">Techcombank (Kỹ thương)</option>
                                                <option value="ACB (Ngân hàng Á Châu)">ACB (Ngân hàng Á Châu)</option>
                                                <option value="VPBank">VPBank (Việt Nam Thịnh Vượng)</option>
                                                <option value="TPBank (Tiên Phong)">TPBank (Tiên Phong)</option>
                                                <option value="Sacombank">Sacombank (Sài Gòn Thương Tín)</option>
                                                <option value="HDBank">HDBank (Phát triển TP.HCM)</option>
                                                <option value="VIB (Quốc Tế)">VIB (Quốc tế Việt Nam)</option>
                                                <option value="SHB">SHB (Sài Gòn - Hà Nội)</option>
                                                <option value="SeABank">SeABank (Đông Nam Á)</option>
                                                <option value="OCB (Phương Đông)">OCB (Phương Đông)</option>
                                                <option value="MSB (Hàng Hải)">MSB (Hàng Hải)</option>
                                                <option value="Eximbank">Eximbank (Xuất Nhập Khẩu)</option>
                                                <option value="Nam A Bank">Nam A Bank (Nam Á)</option>
                                                <option value="LPBank (Lộc Phát VN)">LPBank (Lộc Phát Việt Nam)</option>
                                                <option value="BaoViet Bank">BaoViet Bank (Bảo Việt)</option>
                                            </select>
                                        </div>
                                        <div class="col-md-6">
                                            <label class="form-label small fw-bold">Số tài khoản</label>
                                            <input asp-for="Input.AccountNumber" class="form-control rounded-pill px-3 py-2 bg-white" placeholder="Nhập số tài khoản" />
                                        </div>
                                        <div class="col-md-12">
                                            <label class="form-label small fw-bold">Tên chủ tài khoản</label>
                                            <input asp-for="Input.AccountHolder" class="form-control rounded-pill px-3 py-2 bg-white text-uppercase" placeholder="Ví dụ: NGUYEN VAN AN" />
                                        </div>
                                    </div>
                                </div>
                            }

                            <!-- Nút Lưu -->
                            <div class="d-flex align-items-center justify-content-between gap-3 pt-3 border-top flex-wrap">
                                <button type="button" class="btn btn-light rounded-pill px-4 py-2 border d-lg-none" onclick="returnToMobileHub()">
                                    <i class="bi bi-arrow-left me-1"></i> Quay lại
                                </button>
                                <button type="reset" class="btn btn-light rounded-pill px-4 py-2 border d-none d-lg-inline-block">Hủy thay đổi</button>
                                <button type="submit" class="btn btn-primary rounded-pill px-4 py-2 fw-bold shadow-sm d-inline-flex align-items-center gap-2">
                                    <i class="bi bi-check2-circle"></i>
                                    <span>Lưu thông tin</span>
                                </button>
                            </div>
                        </form>
                    </div>
                </div>

                <!-- TAB 2: Bảo mật & Mật khẩu -->
                <div id="tab-security" class="tab-pane-content @(activeTab == "security" ? "active" : "d-none")">
                    <div class="card border-0 p-3 p-md-4 p-lg-5" style="border-radius: 20px; box-shadow: var(--stayly-shadow); background: #ffffff;">
                        <div class="mb-4 pb-3 border-bottom">
                            <h3 class="fs-5 fw-bold text-navy mb-1">
                                <i class="bi bi-shield-lock text-primary me-2"></i> Bảo mật &amp; Đổi mật khẩu
                            </h3>
                            <p class="text-muted small mb-0">Thay đổi mật khẩu đăng nhập và địa chỉ email để bảo vệ tài khoản Stayly của bạn.</p>
                        </div>

                        <div class="alert alert-info py-2.5 px-3 small rounded-4 mb-4 d-flex align-items-center gap-2">
                            <i class="bi bi-shield-lock-fill text-primary fs-5 flex-shrink-0"></i>
                            <div><strong>Quy định mật khẩu an toàn:</strong> Độ dài 8-20 ký tự, gồm ít nhất 1 chữ hoa, 1 chữ thường, 1 số và 1 ký tự đặc biệt.</div>
                        </div>

                        <div class="row g-4">
                            <!-- Cột Đổi Mật Khẩu -->
                            <div class="col-lg-6 col-12">
                                <div class="p-3 p-md-4 bg-light rounded-4 h-100">
                                    <h5 class="fw-bold text-navy mb-3 fs-6 d-flex align-items-center gap-2">
                                        <i class="bi bi-key-fill text-primary"></i> Đổi mật khẩu
                                    </h5>
                                    <form asp-action="ChangePassword" method="post" id="changePasswordForm">
                                        @Html.AntiForgeryToken()

                                        <div class="mb-3">
                                            <label class="form-label small fw-bold">Mật khẩu hiện tại *</label>
                                            <div class="password-field-wrapper">
                                                <input asp-for="PasswordInput.CurrentPassword" id="currentPasswordInput" type="password" class="form-control rounded-pill px-3 py-2 bg-white" required />
                                                <button type="button" class="btn-toggle-password" data-target="currentPasswordInput" title="Hiện mật khẩu" tabindex="-1">
                                                    <i class="bi bi-eye"></i>
                                                </button>
                                            </div>
                                        </div>

                                        <div class="mb-3">
                                            <label class="form-label small fw-bold">Mật khẩu mới *</label>
                                            <div class="password-field-wrapper">
                                                <input asp-for="PasswordInput.NewPassword" id="newPasswordInput" type="password" class="form-control rounded-pill px-3 py-2 bg-white" required minlength="8" maxlength="20" placeholder="Ví dụ: Stayly@2026" pattern="^(?=.*[a-z])(?=.*[A-Z])(?=.*\d)(?=.*[^a-zA-Z0-9\s])\S{8,20}$" title="Mật khẩu mới phải từ 8-20 ký tự, gồm ít nhất 1 chữ in hoa, 1 chữ thường, 1 số và 1 ký tự đặc biệt" />
                                                <button type="button" class="btn-toggle-password" data-target="newPasswordInput" title="Hiện mật khẩu" tabindex="-1">
                                                    <i class="bi bi-eye"></i>
                                                </button>
                                            </div>
                                            <span asp-validation-for="PasswordInput.NewPassword" class="text-danger small"></span>
                                        </div>

                                        <div class="mb-3">
                                            <label class="form-label small fw-bold">Xác nhận mật khẩu mới *</label>
                                            <div class="password-field-wrapper">
                                                <input asp-for="PasswordInput.ConfirmPassword" id="confirmPasswordInput" type="password" class="form-control rounded-pill px-3 py-2 bg-white" required />
                                                <button type="button" class="btn-toggle-password" data-target="confirmPasswordInput" title="Hiện mật khẩu" tabindex="-1">
                                                    <i class="bi bi-eye"></i>
                                                </button>
                                            </div>
                                            <span asp-validation-for="PasswordInput.ConfirmPassword" class="text-danger small"></span>
                                        </div>

                                        <div class="mb-4">
                                            <label class="form-label small fw-bold">Mã xác thực OTP (gửi về email) *</label>
                                            <div class="input-group">
                                                <input asp-for="PasswordInput.OtpCode" type="text" class="form-control rounded-start-pill px-3 py-2 bg-white" required placeholder="Nhập mã OTP" />
                                                <button type="button" class="btn btn-primary rounded-end-pill px-3 fw-bold" onclick="sendProfileOtp('ChangePassword', this)">Gửi mã</button>
                                            </div>
                                        </div>

                                        <button type="submit" class="btn btn-primary rounded-pill px-4 py-2.5 fw-bold w-100 shadow-sm">
                                            <i class="bi bi-check2-circle me-1"></i> Cập nhật mật khẩu
                                        </button>
                                    </form>
                                </div>
                            </div>

                            <!-- Cột Đổi Email -->
                            <div class="col-lg-6 col-12" id="changeEmailSection">
                                <div class="p-3 p-md-4 bg-light rounded-4 h-100">
                                    <h5 class="fw-bold text-navy mb-3 fs-6 d-flex align-items-center gap-2">
                                        <i class="bi bi-envelope-at-fill text-primary"></i> Đổi địa chỉ Email
                                    </h5>
                                    <form asp-action="ChangeEmail" method="post" id="changeEmailForm">
                                        @Html.AntiForgeryToken()

                                        <div class="mb-3">
                                            <label class="form-label small fw-bold">Địa chỉ Email mới *</label>
                                            <input asp-for="EmailInput.NewEmail" type="email" class="form-control rounded-pill px-3 py-2 bg-white" required placeholder="nhap.email.moi@domain.com" />
                                        </div>

                                        <div class="mb-4">
                                            <label class="form-label small fw-bold">Mã xác thực OTP (gửi về email CŨ) *</label>
                                            <div class="input-group">
                                                <input asp-for="EmailInput.OtpCode" type="text" class="form-control rounded-start-pill px-3 py-2 bg-white" required placeholder="Nhập mã OTP" />
                                                <button type="button" class="btn btn-outline-primary rounded-end-pill px-3 fw-bold" onclick="sendProfileOtp('ChangeEmail', this)">Gửi mã</button>
                                            </div>
                                        </div>

                                        <button type="submit" class="btn btn-outline-primary rounded-pill px-4 py-2.5 fw-bold w-100 shadow-sm">
                                            <i class="bi bi-envelope-check me-1"></i> Cập nhật Email
                                        </button>
                                    </form>
                                </div>
                            </div>
                        </div>

                        <div class="pt-3 mt-4 border-top d-flex justify-content-between align-items-center flex-wrap gap-2">
                            <button type="button" class="btn btn-light rounded-pill px-4 py-2 border d-lg-none" onclick="returnToMobileHub()">
                                <i class="bi bi-arrow-left me-1"></i> Quay lại
                            </button>
                            <span class="text-muted small">Cần hỗ trợ đổi email hoặc lấy lại tài khoản? Hotline: <strong>1900 6868</strong></span>
                        </div>
                    </div>
                </div>

                <!-- TAB 3: Tổng quan tài khoản -->
                <div id="tab-account" class="tab-pane-content @(activeTab == "account" ? "active" : "d-none")">
                    <div class="card border-0 p-3 p-md-4 p-lg-5" style="border-radius: 20px; box-shadow: var(--stayly-shadow); background: #ffffff;">
                        <div class="mb-4 pb-3 border-bottom">
                            <h3 class="fs-5 fw-bold text-navy mb-1">
                                <i class="bi bi-person-badge text-primary me-2"></i> Tổng quan tài khoản Stayly
                            </h3>
                            <p class="text-muted small mb-0">Tóm tắt các thông tin đăng ký định danh và quyền hạn của bạn trong hệ thống.</p>
                        </div>

                        <div class="row g-3 mb-4">
                            <div class="col-md-6 col-12">
                                <div class="p-3 bg-light rounded-4">
                                    <div class="text-muted small">Mã định danh (ID)</div>
                                    <div class="fw-bold fs-6 text-navy">#ND-@profile.Id</div>
                                </div>
                            </div>

                            <div class="col-md-6 col-12">
                                <div class="p-3 bg-light rounded-4">
                                    <div class="text-muted small">Loại tài khoản / Vai trò</div>
                                    <div class="fw-bold fs-6">
                                        @if (isOwner)
                                        {
                                            <span class="text-primary"><i class="bi bi-patch-check-fill me-1"></i> OWNER (Chủ cơ sở)</span>
                                        }
                                        else
                                        {
                                            <span class="text-info"><i class="bi bi-person-fill me-1"></i> GUEST (Khách thuê)</span>
                                        }
                                    </div>
                                </div>
                            </div>

                            <div class="col-md-6 col-12">
                                <div class="p-3 bg-light rounded-4">
                                    <div class="text-muted small">Email xác thực</div>
                                    <div class="fw-bold fs-6 text-navy">@profile.Email</div>
                                </div>
                            </div>

                            <div class="col-md-6 col-12">
                                <div class="p-3 bg-light rounded-4">
                                    <div class="text-muted small">Số điện thoại liên hệ</div>
                                    <div class="fw-bold fs-6 text-navy">@(string.IsNullOrWhiteSpace(profile.Phone) ? "Chưa cung cấp" : profile.Phone)</div>
                                </div>
                            </div>

                            @if (isOwner)
                            {
                                <div class="col-md-6 col-12">
                                    <div class="p-3 bg-light rounded-4">
                                        <div class="text-muted small">Số căn cước công dân (CCCD)</div>
                                        <div class="fw-bold fs-6 text-navy">@(string.IsNullOrWhiteSpace(profile.CitizenId) ? "Chưa cung cấp" : profile.CitizenId)</div>
                                    </div>
                                </div>

                                <div class="col-md-6 col-12">
                                    <div class="p-3 bg-light rounded-4">
                                        <div class="text-muted small">Tài khoản ngân hàng thụ hưởng</div>
                                        <div class="fw-bold fs-6 text-navy text-truncate" title="@profile.BankName - @profile.AccountNumber - @profile.AccountHolder">@(string.IsNullOrWhiteSpace(profile.BankName) ? "Chưa cung cấp" : $"{profile.BankName} - {profile.AccountNumber} - {profile.AccountHolder}")</div>
                                    </div>
                                </div>
                            }
                        </div>

                        <div class="d-flex align-items-center gap-3 pt-3 border-top flex-wrap">
                            <button type="button" class="btn btn-light rounded-pill px-4 py-2 border d-lg-none" onclick="returnToMobileHub()">
                                <i class="bi bi-arrow-left me-1"></i> Quay lại
                            </button>
                            @if (isOwner)
                            {
                                <a asp-action="Dashboard" class="btn btn-primary rounded-pill px-4 py-2 fw-bold shadow-sm d-inline-flex align-items-center gap-2">
                                    <i class="bi bi-house-gear-fill"></i>
                                    <span>Mở Bảng điều khiển Quản trị</span>
                                </a>
                            }
                            <a asp-action="Trips" class="btn btn-outline-primary rounded-pill px-4 py-2 fw-bold d-inline-flex align-items-center gap-2">
                                <i class="bi bi-calendar2-check-fill"></i>
                                <span>Xem danh sách Đơn đặt phòng</span>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal Xác nhận Đăng xuất (Chung cho Desktop & Mobile) -->
<div class="modal fade" id="logoutConfirmModal" tabindex="-1" aria-labelledby="logoutConfirmModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" style="max-width: 400px;">
        <div class="modal-content rounded-4 border-0 shadow-lg p-3">
            <div class="modal-body text-center p-3 p-md-4">
                <div class="mx-auto mb-3 d-flex align-items-center justify-content-center rounded-circle bg-danger-subtle text-danger" style="width: 60px; height: 60px;">
                    <i class="bi bi-box-arrow-right fs-2"></i>
                </div>
                <h5 class="fw-bold text-navy mb-2" id="logoutConfirmModalLabel">Đăng xuất khỏi Stayly?</h5>
                <p class="text-muted small mb-4">Bạn sẽ cần đăng nhập lại để xem lịch sử đặt phòng và quản lý tài khoản của mình.</p>
                <div class="d-flex gap-2 justify-content-center">
                    <button type="button" class="btn btn-light rounded-pill px-4 py-2 border flex-grow-1" data-bs-dismiss="modal">Ở lại</button>
                    <form asp-action="Logout" method="post" class="d-inline flex-grow-1">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-danger rounded-pill px-4 py-2 fw-bold w-100 shadow-sm" onclick="localStorage.removeItem('guestUser'); localStorage.removeItem('guestToken');">Đăng xuất</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    /* Profile Desktop Tabs */
    .profile-tab-btn {
        border: 1.5px solid transparent;
        background: #f8fafc;
        transition: all 0.2s ease;
    }
    .profile-tab-btn:hover {
        background: var(--stayly-light-accent);
        border-color: var(--stayly-primary);
    }
    .profile-tab-btn.active {
        background: var(--stayly-light-accent);
        border-color: var(--stayly-primary);
    }
    .profile-tab-btn.active .profile-tab-title {
        color: var(--stayly-primary);
    }
    .profile-tab-icon {
        width: 42px;
        height: 42px;
        border-radius: 12px;
        background: #ffffff;
        color: var(--stayly-primary);
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 1.25rem;
        box-shadow: 0 2px 6px rgba(0, 119, 182, 0.1);
        flex-shrink: 0;
    }
    .profile-tab-btn.active .profile-tab-icon {
        background: var(--stayly-primary);
        color: #ffffff;
    }

    .stayly-profile-page {
        background-color: #f8f9fc;
        width: 100%;
        max-width: 100vw;
        overflow-x: hidden;
    }

    /* Mobile Hub Elements */
