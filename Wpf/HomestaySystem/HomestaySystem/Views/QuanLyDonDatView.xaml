<UserControl x:Class="HomestaySystem.Views.QuanLyDonDatView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:conv="clr-namespace:HomestaySystem.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="850" d:DesignWidth="1200">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <conv:PhuDinhBooleanToVisibilityConverter x:Key="InverseBoolToVis"/>
        <conv:ChuoiMauToBrushConverter x:Key="ColorToBrush"/>
        <conv:NullToVisibilityConverter x:Key="NullToVis"/>
        <conv:TrangThaiDonToColorConverter x:Key="TrangThaiDonToColorConverter"/>
        <conv:TrangThaiDonToBgConverter x:Key="TrangThaiDonToBgConverter"/>
    </UserControl.Resources>

    <Grid Background="{StaticResource MauNenChinh}">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Hàng 0: Header & Bộ lọc đơn đặt -->
                <RowDefinition Height="Auto"/> <!-- Hàng 1: 4 Thẻ Card KPI -->
                <RowDefinition Height="*"/>    <!-- Hàng 2: Vùng chứa bảng BẮT BUỘC DÙNG DÒNG SAO '*' -->
            </Grid.RowDefinitions>

            <!-- ================= HÀNG 0: HEADER & THANH TÌM KIẾM / BỘ LỌC ================= -->
            <Border Grid.Row="0" Margin="0,0,0,16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Header bar -->
                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="40" Height="40" CornerRadius="20" Background="{StaticResource MauStaylyPrimaryLight}" Margin="0,0,12,0">
                                <TextBlock Text="📑" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Quản Lý Giao Dịch &amp; Hoàn Tiền" FontSize="18" FontWeight="Bold" Foreground="{StaticResource MauChuTieuDe}"/>
                                <TextBlock Text="Giám sát luồng đặt phòng, trạng thái cổng thanh toán và thẩm định yêu cầu hoàn tiền" FontSize="12" Foreground="{StaticResource MauChuPhu}"/>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button Command="{Binding TaiDuLieuCommand}" Cursor="Hand" ToolTip="Tải lại danh sách đơn đặt"
                                    Background="White" BorderBrush="{StaticResource MauVien}" BorderThickness="1" Padding="14,6">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="20"/>
                                    </Style>
                                </Button.Resources>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🔄" FontSize="12" Margin="0,0,6,0"/>
                                    <TextBlock Text="Tải lại dữ liệu" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource MauChuChinh}"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- Filter Ribbon: Ô tìm kiếm + ComboBox trạng thái -->
                    <Border Grid.Row="1" Background="White" CornerRadius="16" Padding="14,10" BorderBrush="{StaticResource MauVien}" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="220"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Ô tìm kiếm viên thuốc -->
                            <Border Grid.Column="0" Background="#F1F5F9" CornerRadius="20" Padding="12,6" BorderBrush="{StaticResource MauVien}" BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="🔍" FontSize="13" Margin="4,0,8,0" VerticalAlignment="Center"/>
                                    <TextBox Grid.Column="1" Text="{Binding TuKhoaTimKiem, UpdateSourceTrigger=PropertyChanged}"
                                             BorderThickness="0" Background="Transparent" VerticalAlignment="Center"
                                             FontSize="12" Foreground="{StaticResource MauChuChinh}"/>
                                    <TextBlock Grid.Column="1" Text="Tìm kiếm theo mã đơn (DDP...), tên khách, cơ sở, email, SĐT..." FontSize="12" Foreground="#94A3B8"
                                               VerticalAlignment="Center" Margin="2,0,0,0" IsHitTestVisible="False">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding TuKhoaTimKiem}" Value="">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding TuKhoaTimKiem}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </Border>

                            <!-- ComboBox trạng thái đơn đặt chuẩn bo tròn 8px hiện đại không lộ khung xám -->
                            <ComboBox Grid.Column="2" SelectedValue="{Binding BoLocTrangThai}" SelectedValuePath="Tag" Height="36" VerticalAlignment="Center" MinWidth="170">
                                <ComboBoxItem Content="Tất cả trạng thái" Tag="TatCa" IsSelected="True"/>
                                <ComboBoxItem Content="Chờ xét duyệt" Tag="ChoDuyet"/>
                                <ComboBoxItem Content="Đã xét duyệt" Tag="DaDuyet"/>
                                <ComboBoxItem Content="Đang lưu trú" Tag="DangO"/>
                                <ComboBoxItem Content="Đã hoàn tất" Tag="DaHoanTat"/>
                                <ComboBoxItem Content="Chờ hoàn tiền" Tag="YeuCauHoanTien"/>
                                <ComboBoxItem Content="Đã hoàn tiền" Tag="DaHoanTien"/>
                                <ComboBoxItem Content="Đã hủy" Tag="DaHuy"/>
                            </ComboBox>

                            <!-- Badge kết quả -->
                            <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Background="{StaticResource MauStaylyPrimaryLight}" CornerRadius="12" Padding="12,6">
                                    <TextBlock Text="{Binding DanhSachHienThi.Count, StringFormat='{}Hiển thị {0} đơn hàng'}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource MauStaylyPrimary}"/>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- ================= HÀNG 1: 4 THẺ CARD KPI (FORMAT CHUẨN THỐNG NHẤT) ================= -->
            <Grid Grid.Row="1" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- KPI 1: Tổng giá trị giao dịch -->
                <Border Grid.Column="0" Background="White" CornerRadius="12" BorderBrush="#E2E8F0" BorderThickness="1" Padding="14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="TỔNG ĐƠN ĐẶT PHÒNG" FontSize="11" FontWeight="Bold" Foreground="#64748B" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding TongSoDon, FallbackValue='0'}" FontSize="22" FontWeight="Black" Foreground="#0F172A" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="Giao dịch sàn Stayly" FontSize="11" Foreground="#0194F3" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <Border Grid.Column="1" Width="42" Height="42" CornerRadius="21" Background="#E0F2FE" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="💳" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- KPI 2: Đơn đặt phòng thành công -->
                <Border Grid.Column="2" Background="White" CornerRadius="12" BorderBrush="#E2E8F0" BorderThickness="1" Padding="14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="ĐƠN ĐẶT HOÀN TẤT" FontSize="11" FontWeight="Bold" Foreground="#64748B" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding SoDonHoanThanh, FallbackValue='0'}" FontSize="22" FontWeight="Black" Foreground="#10B981" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="Khách đã hoàn thành kỳ nghỉ" FontSize="11" Foreground="#64748B" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <Border Grid.Column="1" Width="42" Height="42" CornerRadius="21" Background="#ECFDF5" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="🛌" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- KPI 3: Chờ hoàn tiền -->
                <Border Grid.Column="4" Background="White" CornerRadius="12" BorderBrush="#E2E8F0" BorderThickness="1" Padding="14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="CHỜ HOÀN TIỀN" FontSize="11" FontWeight="Bold" Foreground="#64748B" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding SoDonYeuCauHoanTien, FallbackValue='0'}" FontSize="22" FontWeight="Black" Foreground="#EF4444" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="Chờ sàn thẩm định" FontSize="11" Foreground="#64748B" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <Border Grid.Column="1" Width="42" Height="42" CornerRadius="21" Background="#FEE2E2" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="💸" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- KPI 4: Chờ xét duyệt -->
                <Border Grid.Column="6" Background="White" CornerRadius="12" BorderBrush="#E2E8F0" BorderThickness="1" Padding="14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="CHỜ XÉT DUYỆT" FontSize="11" FontWeight="Bold" Foreground="#64748B" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding SoDonChoXacNhan, FallbackValue='0'}" FontSize="22" FontWeight="Black" Foreground="#F59E0B" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="Chờ đối tác duyệt" FontSize="11" Foreground="#64748B" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <Border Grid.Column="1" Width="42" Height="42" CornerRadius="21" Background="#FEF3C7" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="⏳" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <!-- ================= HÀNG 2: BẢNG KÊ ĐƠN ĐẶT PHÒNG FULL-WIDTH ================= -->
            <Border Grid.Row="2" Style="{StaticResource StaylyCard}" Padding="0" ClipToBounds="True">
                <DataGrid ItemsSource="{Binding DanhSachHienThi}" SelectedItem="{Binding DonDangChon}"
                              Style="{StaticResource StaylyDataGridStyle}"
                              IsReadOnly="True"
                              RowHeight="54"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              CanUserResizeColumns="True"
                              CanUserSortColumns="True">
                        <DataGrid.Columns>
                            <!-- Cột Mã đơn -->
                            <DataGridTextColumn Header="MÃ ĐƠN" Binding="{Binding MaDonHienThi}" Width="105">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="Foreground" Value="{StaticResource MauStaylyPrimary}"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Padding" Value="10,0"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Cột Khách hàng -->
                            <DataGridTextColumn Header="KHÁCH HÀNG" Binding="{Binding TenKhachHang}" Width="140">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="Foreground" Value="{StaticResource MauChuTieuDe}"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Padding" Value="10,0"/>
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                        <Setter Property="ToolTip" Value="{Binding TenKhachHang}"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Cột Chỗ nghỉ Homestay: Bọc TextWrapping để không bao giờ bị đè chữ / cắt cụt -->
                            <DataGridTemplateColumn Header="CƠ SỞ HOMESTAY" Width="*" MinWidth="180">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding TenCoSo}" VerticalAlignment="Center" Padding="10,0"
                                                   FontWeight="Medium" Foreground="{StaticResource MauChuChinh}"
                                                   TextWrapping="Wrap" MaxHeight="44" ToolTip="{Binding TenCoSo}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Cột Nhận / Trả phòng -->
                            <DataGridTextColumn Header="THỜI GIAN LƯU TRÚ" Binding="{Binding NgayNhanTraHienThi}" Width="150">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource MauChuPhu}"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Padding" Value="10,0"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Cột Tổng tiền -->
                            <DataGridTextColumn Header="TỔNG TIỀN" Binding="{Binding TongTienDinhDang}" Width="110">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="Foreground" Value="{StaticResource MauChuTieuDe}"/>
                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Padding" Value="0,0,10,0"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Cột Cổng thanh toán -->
                            <DataGridTextColumn Header="CỔNG TT" Binding="{Binding CongThanhToan}" Width="90">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource MauStaylyPrimary}"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Padding" Value="8,0"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Cột Trạng thái đơn: Đồng bộ mọi trạng thái -->
                            <DataGridTemplateColumn Header="TRẠNG THÁI" Width="130">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="8" Padding="10,4" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="8,0"
                                                Background="{Binding NenTrangThai, Converter={StaticResource ColorToBrush}}">
                                            <TextBlock Text="{Binding TenHienThiTrangThai}" FontSize="11" FontWeight="Bold"
                                                       Foreground="{Binding MauTrangThai, Converter={StaticResource ColorToBrush}}"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Cột Thao tác: Chi tiết hồ sơ đơn -->
                            <DataGridTemplateColumn Header="THAO TÁC" Width="95">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="📋 Chi tiết"
                                                Command="{Binding DataContext.XemHoSoCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource StaylyBtnSmall}"
                                                Background="{StaticResource MauStaylyPrimaryLight}"
                                                Foreground="{StaticResource MauStaylyPrimaryDark}"
                                                BorderThickness="0" FontWeight="Bold" FontSize="11" Padding="10,6"
                                                HorizontalAlignment="Center" VerticalAlignment="Center" Cursor="Hand"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
        </Grid>

        <!-- ================= MODAL DIALOG: THẨM ĐỊNH HOÀN TIỀN & CHI TIẾT ĐƠN ĐẶT (HIỆN NGAY GIỮA MÀN HÌNH) ================= -->
        <Grid Visibility="{Binding DonDangChon, Converter={StaticResource NullToVis}, FallbackValue=Collapsed}"
              HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <!-- Nền mờ: Nhấp chuột ra ngoài để đóng hồ sơ -->
            <Border Background="#99000000" Cursor="Hand" ToolTip="Nhấp vào vùng ngoài để đóng">
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftClick" Command="{Binding DongHoSoCommand}"/>
                </Border.InputBindings>
            </Border>
            <Border Background="White" CornerRadius="16" Width="600" MaxHeight="760" Padding="22" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" Opacity="0.25" BlurRadius="24" ShadowDepth="4"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Header Modal -->
                        <RowDefinition Height="*"/>   <!-- Vùng nội dung cuộn -->
                        <RowDefinition Height="Auto"/> <!-- Footer Nút tác vụ -->
                    </Grid.RowDefinitions>

                    <!-- Header Modal có nút [✕ Đóng] & Badge trạng thái -->
                    <Border Grid.Row="0" BorderBrush="{StaticResource MauVien}" BorderThickness="0,0,0,1" Padding="0,0,0,12" Margin="0,0,0,14">
                        <DockPanel LastChildFill="True">
                            <Button DockPanel.Dock="Right" Command="{Binding DongHoSoCommand}"
                                    Content="✕ Đóng" ToolTip="Đóng chi tiết hồ sơ đơn"
                                    Background="#F1F5F9" Foreground="#64748B" BorderThickness="0"
                                    FontWeight="Bold" FontSize="12" Padding="14,6" Cursor="Hand" Margin="8,0,0,0">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="6"/>
                                    </Style>
                                </Button.Resources>
                            </Button>

                            <!-- Badge trạng thái đơn -->
                            <Border DockPanel.Dock="Right" CornerRadius="8" Padding="10,4" Margin="0,0,8,0" VerticalAlignment="Center"
                                    Background="{Binding DonDangChon.NenTrangThai, Converter={StaticResource ColorToBrush}}">
                                <TextBlock Text="{Binding DonDangChon.TenHienThiTrangThai}" FontSize="11.5" FontWeight="Bold"
                                           Foreground="{Binding DonDangChon.MauTrangThai, Converter={StaticResource ColorToBrush}}"/>
                            </Border>

                            <!-- Badge mã đơn -->
                            <Border DockPanel.Dock="Right" Background="{StaticResource MauStaylyPrimaryLight}" CornerRadius="8" Padding="10,4" Margin="0,0,8,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding DonDangChon.MaDonHienThi, FallbackValue='#DDP-001'}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource MauStaylyPrimary}"/>
                            </Border>

                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="📋 " FontSize="18" Margin="0,0,8,0"/>
                                <TextBlock Text="CHI TIẾT HỒ SƠ ĐƠN ĐẶT PHÒNG" FontSize="15" FontWeight="Bold" Foreground="{StaticResource MauChuTieuDe}"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- VÙNG NỘI DUNG CUỘN CHI TIẾT ĐẦY ĐỦ -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,6,0">
                        <StackPanel>
                            <!-- 1. Profile khách hàng -->
                            <Border Background="#F8FAFC" CornerRadius="12" Padding="14,12" Margin="0,0,0,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="44" Height="44" CornerRadius="22" Background="{StaticResource MauStaylyPrimaryLight}" Margin="0,0,12,0">
                                        <TextBlock Text="🧑" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding DonDangChon.TenKhachHang, FallbackValue='---'}" FontSize="14.5" FontWeight="Bold" Foreground="{StaticResource MauChuTieuDe}"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                            <TextBlock Text="{Binding DonDangChon.SoDienThoaiKhach, FallbackValue='---'}" FontSize="12" Foreground="{StaticResource MauChuPhu}" Margin="0,0,12,0"/>
                                            <TextBlock Text="{Binding DonDangChon.EmailKhach, FallbackValue='---'}" FontSize="12" Foreground="{StaticResource MauChuPhu}"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <Border Grid.Column="2" Background="#E0F2FE" CornerRadius="10" Padding="10,4" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding DonDangChon.HangThanhVienKhach, FallbackValue='Khách hàng Stayly'}" FontSize="11" FontWeight="Bold" Foreground="#0284C7"/>
                                    </Border>
                                </Grid>
                            </Border>

                            <!-- 2. Thông tin chỗ nghỉ & Thời gian lưu trú (LUÔN HIỂN THỊ ĐẦY ĐỦ) -->
                            <Border Background="#F8FAFC" CornerRadius="12" Padding="14,12" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="THÔNG TIN CHỖ NGHỈ &amp; THỜI GIAN LƯU TRÚ" FontSize="12" FontWeight="Bold" Foreground="{StaticResource MauChuTieuDe}" Margin="0,0,0,10"/>
                                    
                                    <Grid Margin="0,0,0,7">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Cơ sở homestay:" FontSize="12.5" Foreground="{StaticResource MauChuPhu}" Margin="0,0,12,0"/>
                                        <TextBlock Grid.Column="1" HorizontalAlignment="Right" Text="{Binding DonDangChon.TenCoSo, FallbackValue='---'}" FontSize="13" FontWeight="Bold" Foreground="{StaticResource MauChuChinh}" TextAlignment="Right" TextWrapping="Wrap"/>
                                    </Grid>

                                    <Grid Margin="0,0,0,7">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Phòng:" FontSize="12.5" Foreground="{StaticResource MauChuPhu}" Margin="0,0,12,0"/>
                                        <TextBlock Grid.Column="1" HorizontalAlignment="Right" Text="{Binding DonDangChon.TenPhong, FallbackValue='---'}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource MauChuChinh}" TextAlignment="Right"/>
                                    </Grid>

                                    <Grid Margin="0,0,0,7">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Thời gian ở:" FontSize="12.5" Foreground="{StaticResource MauChuPhu}" Margin="0,0,12,0"/>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                            <TextBlock Text="{Binding DonDangChon.NgayNhanTraHienThi}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource MauChuChinh}"/>
                                            <TextBlock Text="{Binding DonDangChon.SoDem, StringFormat=' ({0} đêm)'}" FontSize="12.5" Foreground="{StaticResource MauChuPhu}"/>
                                        </StackPanel>
                                    </Grid>

                                    <Grid Margin="0,0,0,7">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Số lượng khách:" FontSize="12.5" Foreground="{StaticResource MauChuPhu}" Margin="0,0,12,0"/>
                                        <TextBlock Grid.Column="1" HorizontalAlignment="Right">
                                            <Run Text="{Binding DonDangChon.SoNguoiLon, Mode=OneWay}" FontWeight="Bold"/>
                                            <Run Text=" người lớn, "/>
                                            <Run Text="{Binding DonDangChon.SoTreEm, Mode=OneWay}" FontWeight="Bold"/>
                                            <Run Text=" trẻ em"/>
                                        </TextBlock>
                                    </Grid>

                                    <Grid Margin="0,0,0,7">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Cổng thanh toán:" FontSize="12.5" Foreground="{StaticResource MauChuPhu}" Margin="0,0,12,0"/>
                                        <TextBlock Grid.Column="1" HorizontalAlignment="Right" Text="{Binding DonDangChon.CongThanhToan, FallbackValue='VNPay QR'}" FontSize="13" FontWeight="SemiBold" Foreground="#2563EB" TextAlignment="Right"/>
                                    </Grid>

                                    <Border BorderBrush="{StaticResource MauVien}" BorderThickness="0,1,0,0" Margin="0,6,0,10"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="TỔNG TIỀN ĐƠN:" FontSize="13" FontWeight="Bold" Foreground="{StaticResource MauChuTieuDe}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" HorizontalAlignment="Right" Text="{Binding DonDangChon.TongTienDinhDang, FallbackValue='0 đ'}" FontSize="16" FontWeight="Black" Foreground="{StaticResource MauStaylyPrimary}" TextAlignment="Right"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- 3. KHỐI THẨM ĐỊNH & ĐỐI SOÁT HOÀN TIỀN (TỰ ĐỘNG HIỆN KHI ĐƠN YÊU CẦU HOÀN) -->
                            <StackPanel Visibility="{Binding DonDangChon.LaDonHoanTien, Converter={StaticResource BoolToVis}}">
                                <!-- Thông tin tài khoản ngân hàng của khách để hoàn tiền -->
                                <Border Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="1" CornerRadius="12" Padding="14,10" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="TÀI KHOẢN NGÂN HÀNG HOÀN TIỀN (KHÁCH):" FontSize="11.5" FontWeight="Bold" Foreground="#15803D" Margin="0,0,0,4"/>
                                        <TextBlock Text="{Binding DonDangChon.ThongTinNganHangKhachHienThi, FallbackValue='Chưa cung cấp'}" FontSize="13" FontWeight="Bold" Foreground="#1E293B"/>
                                        <TextBlock Text="{Binding DonDangChon.LyDoHoanTien, StringFormat='Lý do: {0}', FallbackValue='Lý do: Khách yêu cầu hủy phòng'}" FontSize="12" Foreground="#64748B" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>

                                <!-- Đối soát chính sách hủy phòng -->
                                <Border Background="#F1F5F9" CornerRadius="12" Padding="14,12" Margin="0,0,0,12">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,8">
                                            <TextBlock Text="QUY TẮC ĐỐI SOÁT CHÍNH SÁCH" FontSize="12" FontWeight="Bold" Foreground="{StaticResource MauChuTieuDe}"/>
                                            <Border HorizontalAlignment="Right" Background="{Binding DonDangChon.KetQuaThamDinhNen, Converter={StaticResource ColorToBrush}}" CornerRadius="8" Padding="8,3">
                                                <TextBlock Text="{Binding DonDangChon.KetQuaThamDinhBadge}" FontSize="10.5" FontWeight="Bold" Foreground="{Binding DonDangChon.KetQuaThamDinhMau, Converter={StaticResource ColorToBrush}}"/>
                                            </Border>
                                        </Grid>
                                        
                                        <Border Background="White" CornerRadius="8" Padding="12,8" Margin="0,0,0,8">
                                            <TextBlock Text="{Binding DonDangChon.ChinhSachHuy}"
                                                       FontSize="12" Foreground="{StaticResource MauChuPhu}" TextWrapping="Wrap"/>
                                        </Border>

                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Thời điểm khách hủy:" FontSize="12.5" Foreground="{StaticResource MauChuPhu}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <TextBlock Grid.Column="1" HorizontalAlignment="Right" Text="{Binding DonDangChon.ThoiDiemKhachHuy, FallbackValue='Chưa có yêu cầu'}" FontSize="13" FontWeight="Bold" Foreground="{StaticResource MauChuChinh}" TextAlignment="Right" TextWrapping="Wrap"/>
                                        </Grid>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Kết quả thẩm định:" FontSize="12.5" Foreground="{StaticResource MauChuPhu}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <TextBlock Grid.Column="1" HorizontalAlignment="Right" Text="{Binding DonDangChon.KetQuaThamDinh}" FontSize="13" FontWeight="Bold" Foreground="{Binding DonDangChon.KetQuaThamDinhMau, Converter={StaticResource ColorToBrush}}" TextAlignment="Right" TextWrapping="Wrap"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- Bảng chiết tính dòng tiền hoàn -->
                                <Border Background="#F8FAFC" CornerRadius="12" Padding="14,12" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="BẢNG CHIẾT TÍNH DÒNG TIỀN HOÀN" FontSize="12" FontWeight="Bold" Foreground="{StaticResource MauChuTieuDe}" Margin="0,0,0,10"/>
                                        
                                        <Grid Margin="0,0,0,7">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Tổng tiền thanh toán:" FontSize="12.5" Foreground="{StaticResource MauChuPhu}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <TextBlock Grid.Column="1" HorizontalAlignment="Right" Text="{Binding DonDangChon.TongTienDinhDang, FallbackValue='0 đ'}" FontSize="13.5" FontWeight="Bold" Foreground="{StaticResource MauChuChinh}" TextAlignment="Right"/>
                                        </Grid>
                                        <Grid Margin="0,0,0,7">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Phí xử lý giao dịch sàn:" FontSize="12.5" Foreground="{StaticResource MauChuPhu}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <TextBlock Grid.Column="1" HorizontalAlignment="Right" Text="0 đ (Miễn phí)" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource MauStaylyGreen}" TextAlignment="Right"/>
                                        </Grid>
                                        <Border BorderBrush="{StaticResource MauVien}" BorderThickness="0,1,0,0" Margin="0,6,0,10"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="SỐ TIỀN HOÀN THỰC TẾ:" FontSize="13" FontWeight="Bold" Foreground="{StaticResource MauChuTieuDe}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <TextBlock Grid.Column="1" HorizontalAlignment="Right" Text="{Binding DonDangChon.TienHoanThucTeDinhDang, FallbackValue='0 đ'}" FontSize="16" FontWeight="Black" Foreground="{StaticResource MauStaylyPrimary}" TextAlignment="Right"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Footer Nút tác vụ theo ngữ cảnh -->
                    <Border Grid.Row="2" BorderBrush="{StaticResource MauVien}" BorderThickness="0,1,0,0" Padding="0,12,0,0">
                        <StackPanel>
                            <!-- THÔNG BÁO: ĐƠN CHỜ CHỦ HOMESTAY XÉT DUYỆT (Chủ nhà duyệt trên Web Portal, Admin không duyệt thay) -->
                            <Border Visibility="{Binding DonDangChon.LaDonChoDuyet, Converter={StaticResource BoolToVis}}"
                                    Background="#FEF3C7" CornerRadius="8" Padding="12,10" Margin="0,0,0,10"
                                    BorderBrush="#FDE68A" BorderThickness="1">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <TextBlock Text="⏳ " FontSize="13" VerticalAlignment="Center"/>
                                    <TextBlock Text="Đơn đang chờ Chủ homestay (Đối tác) xét duyệt tiếp nhận trên Web Portal" 
                                               FontSize="12" FontWeight="SemiBold" Foreground="#B45309" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <!-- NÚT HOÀN TIỀN (YeuCauHoanTien) -->
                            <StackPanel Visibility="{Binding DonDangChon.LaDonHoanTien, Converter={StaticResource BoolToVis}}">
                                <Button Command="{Binding MoDialogHoanTienCommand}" Cursor="Hand" Margin="0,0,0,8"
                                        Background="{StaticResource MauStaylyGreen}" Foreground="White"
                                        FontSize="13" FontWeight="Bold" Height="40" ToolTip="Xác nhận hoàn tiền cho khách hàng">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="10"/>
                                        </Style>
                                    </Button.Resources>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <TextBlock Text="💰 " FontSize="13"/>
                                        <TextBlock Text="Xác Nhận Hoàn Tiền Cho Khách"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>

                            <!-- NÚT ĐÓNG CỬA SỔ HỒ SƠ -->
                            <Button Command="{Binding DongHoSoCommand}" Content="Đóng cửa sổ" Background="#F1F5F9" Foreground="#475569"
                                    BorderThickness="0" Height="36" FontSize="12.5" FontWeight="SemiBold" Cursor="Hand">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="8"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- ================= DIALOG DUYỆT HOÀN TIỀN ================= -->
        <Grid Visibility="{Binding HienThiDialogHoanTien, Converter={StaticResource BoolToVis}}"
              HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <!-- Nền mờ: Nhấp chuột ra ngoài để hủy -->
            <Border Background="#99000000" Cursor="Hand" ToolTip="Nhấp vào vùng ngoài để đóng">
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftClick" Command="{Binding HuyDialogHoanTienCommand}"/>
                </Border.InputBindings>
            </Border>
            <Border Background="White" CornerRadius="16" Width="530" Padding="26" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Header Modal -->
                    <DockPanel Grid.Row="0" Margin="0,0,0,12" LastChildFill="True">
                        <Border DockPanel.Dock="Right" Background="#DCFCE7" CornerRadius="8" Padding="10,4" VerticalAlignment="Center">
                            <TextBlock Text="{Binding DonDangChon.MaDonHienThi, FallbackValue='#DDP-001'}" FontSize="12" FontWeight="Bold" Foreground="#15803D"/>
                        </Border>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="💳 " FontSize="18"/>
                            <TextBlock Text="XÁC NHẬN CHUYỂN KHOẢN HOÀN TIỀN" FontSize="15" FontWeight="Bold" Foreground="{StaticResource MauChuTieuDe}"/>
                        </StackPanel>
                    </DockPanel>

                    <TextBlock Grid.Row="1" Text="Quy trình chuyển tiền thủ công tương tự quyết toán doanh thu đối tác:" FontSize="12.5" Foreground="{StaticResource MauChuPhu}" Margin="0,0,0,12"/>

                    <StackPanel Grid.Row="2" Margin="0,0,0,16">
                        <!-- Thông tin tài khoản ngân hàng thụ hưởng của khách -->
                        <Border Background="#F0FDF4" BorderBrush="#86EFAC" BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="TÀI KHOẢN NGÂN HÀNG NHẬN TIỀN CỦA KHÁCH:" FontSize="11.5" FontWeight="Bold" Foreground="#15803D" Margin="0,0,0,6"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Ngân hàng:" Foreground="#64748B" FontSize="12.5" Margin="0,0,8,3"/>
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding DonDangChon.TenNganHangKhach, FallbackValue='Chưa cung cấp'}" FontWeight="Bold" Foreground="#1E293B" FontSize="12.5"/>
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Số tài khoản:" Foreground="#64748B" FontSize="12.5" Margin="0,0,8,3"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding DonDangChon.SoTaiKhoanKhach, FallbackValue='Chưa cung cấp'}" FontWeight="Black" Foreground="#2563EB" FontSize="14" FontFamily="Consolas"/>
                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Chủ tài khoản:" Foreground="#64748B" FontSize="12.5"/>
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding DonDangChon.TenChuTaiKhoanKhach, FallbackValue='Chưa cung cấp'}" FontWeight="Bold" Foreground="#1E293B" FontSize="12.5"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Số tiền hoàn (VNĐ) (*):" FontSize="12" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,5"/>
                                <Border Background="#F8FAFC" CornerRadius="8" Padding="12,8" BorderBrush="{StaticResource MauVien}" BorderThickness="1">
                                    <TextBox Text="{Binding SoTienHoan, UpdateSourceTrigger=PropertyChanged}"
                                             BorderThickness="0" Background="Transparent" FontSize="13.5" FontWeight="Bold" Foreground="{StaticResource MauStaylyGreen}"/>
                                </Border>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Mã GD ngân hàng / Mã chuẩn chi (*):" FontSize="12" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,5"/>
                                <Border Background="#F8FAFC" CornerRadius="8" Padding="12,8" BorderBrush="{StaticResource MauVien}" BorderThickness="1">
                                    <TextBox Text="{Binding MaGiaoDichHoanTien, UpdateSourceTrigger=PropertyChanged}"
                                             BorderThickness="0" Background="Transparent" FontSize="13.5" FontWeight="Bold" Foreground="#2563EB" FontFamily="Consolas"/>
                                </Border>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Lý do hoàn tiền:" FontSize="12" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,5"/>
                        <Border Background="#F8FAFC" CornerRadius="8" Padding="12,7" Margin="0,0,0,10" BorderBrush="{StaticResource MauVien}" BorderThickness="1">
                            <TextBox Text="{Binding LyDoHoanTien, UpdateSourceTrigger=PropertyChanged}"
                                     BorderThickness="0" Background="Transparent" FontSize="12.5" Foreground="{StaticResource MauChuChinh}"/>
                        </Border>

                        <TextBlock Text="Ghi chú đối soát hoàn tiền:" FontSize="12" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,5"/>
                        <Border Background="#F8FAFC" CornerRadius="8" Padding="12,7" Margin="0,0,0,10" BorderBrush="{StaticResource MauVien}" BorderThickness="1">
                            <TextBox Text="{Binding GhiChuHoanTien, UpdateSourceTrigger=PropertyChanged}"
                                     BorderThickness="0" Background="Transparent" FontSize="12.5" Foreground="{StaticResource MauChuChinh}"/>
                        </Border>

                        <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="8" Padding="10,8">
                            <TextBlock Text="ℹ️ Thao tác: Quản trị viên sử dụng App ngân hàng (Internet Banking) chuyển khoản tiền hoàn về số tài khoản của khách, sau đó bấm Xác nhận để hệ thống ghi vết đối soát và tự động gửi email thông báo cho khách."
                                       FontSize="11.5" Foreground="#1E40AF" TextWrapping="Wrap" LineHeight="16"/>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Command="{Binding HuyDialogHoanTienCommand}" Content="Hủy bỏ" Background="#F1F5F9"
                                BorderThickness="0" Padding="18,9" Margin="0,0,12,0" FontSize="13" FontWeight="SemiBold" Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="8"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                        <Button Command="{Binding XacNhanHoanTienCommand}" Content="✔ Xác nhận đã chuyển khoản" Background="{StaticResource MauStaylyGreen}"
                                Foreground="White" BorderThickness="0" Padding="20,9" FontSize="13" FontWeight="Bold" Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="8"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
