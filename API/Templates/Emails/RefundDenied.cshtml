@model API.DTOs.Email.RefundDeniedEmailModel

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Thông báo kết quả xử lý yêu cầu hoàn tiền Stayly</title>
</head>
<body style="margin: 0; padding: 0; background-color: #f8fafc; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; color: #1e293b;">
    <table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="background-color: #f8fafc; padding: 32px 16px;">
        <tr>
            <td align="center">
                <table role="presentation" width="100%" style="max-width: 580px; background-color: #ffffff; border-radius: 16px; overflow: hidden; box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05); border: 1px solid #e2e8f0;">
                    <!-- Header -->
                    <tr>
                        <td style="background: linear-gradient(135deg, #475569 0%, #334155 100%); padding: 32px 32px 28px; text-align: center;">
                            <h1 style="margin: 0; font-size: 26px; font-weight: 800; color: #ffffff; letter-spacing: -0.5px;">STAYLY</h1>
                            <p style="margin: 6px 0 0; color: #cbd5e1; font-size: 14px; font-weight: 500;">Thông báo Kết quả Khiếu nại / Hoàn tiền</p>
                        </td>
                    </tr>

                    <!-- Body -->
                    <tr>
                        <td style="padding: 36px 32px 28px;">
                            <div style="display: inline-block; background-color: #fee2e2; color: #b91c1c; padding: 4px 12px; border-radius: 9999px; font-size: 12px; font-weight: 700; margin-bottom: 16px; text-transform: uppercase;">
                                Yêu cầu không được chấp thuận
                            </div>
                            <h2 style="margin: 0 0 16px; font-size: 20px; font-weight: 700; color: #0f172a;">Thông báo về yêu cầu hoàn tiền đơn đặt</h2>
                            <p style="margin: 0 0 16px; font-size: 15px; line-height: 1.6; color: #475569;">
                                Xin chào <strong>@Model.GuestName</strong>,
                            </p>
                            <p style="margin: 0 0 20px; font-size: 15px; line-height: 1.6; color: #475569;">
                                Ban Quản trị Stayly đã tiến hành kiểm tra và đối chiếu các chính sách hủy phòng áp dụng cho đơn đặt phòng <strong>#@Model.BookingId</strong> tại cơ sở lưu trú <strong>@Model.PropertyName</strong>.
                            </p>

                            <!-- Denial Reason Box -->
                            <div style="background-color: #fef2f2; border-radius: 12px; padding: 20px; border: 1px solid #fee2e2; border-left: 5px solid #ef4444; margin: 20px 0;">
                                <span style="font-size: 12px; font-weight: 700; color: #b91c1c; text-transform: uppercase; letter-spacing: 0.5px; display: block; margin-bottom: 6px;">Lý do từ chối hoàn tiền:</span>
                                <p style="margin: 0; font-size: 14px; line-height: 1.6; color: #991b1b; font-weight: 500;">
                                    @Model.DenialReason
                                </p>
                                @if (!string.IsNullOrWhiteSpace(Model.DecisionNote))
                                {
                                    <p style="margin: 10px 0 0; font-size: 13px; color: #7f1d1d; border-top: 1px dashed #fecaca; padding-top: 8px;">
                                        <strong>Ghi chú bổ sung:</strong> @Model.DecisionNote
                                    </p>
                                }
                            </div>

                            <p style="margin: 20px 0 0; font-size: 14px; line-height: 1.6; color: #64748b;">
                                Quyết định này được đưa ra dựa trên điều khoản chính sách đặt phòng đã thỏa thuận giữa Quý khách và Cơ sở lưu trú. Nếu có tài liệu chứng minh bổ sung, bạn có thể gửi khiếu nại lại qua email <a href="mailto:@Model.SupportEmail" style="color: #2563eb; text-decoration: none;">@Model.SupportEmail</a>.
                            </p>
                        </td>
                    </tr>

                    <!-- Footer -->
                    <tr>
                        <td style="background-color: #f8fafc; padding: 24px 32px; border-top: 1px solid #e2e8f0; text-align: center;">
                            <p style="margin: 0; font-size: 12px; color: #94a3b8;">
                                &copy; @DateTime.UtcNow.Year Stayly Dispute Resolution.
                            </p>
                        </td>
                    </tr>
                </table>
            </td>
        </tr>
    </table>
</body>
</html>
