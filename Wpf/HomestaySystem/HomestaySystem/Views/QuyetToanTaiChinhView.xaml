<UserControl x:Class="HomestaySystem.Views.QuyetToanTaiChinhView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:conv="clr-namespace:HomestaySystem.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="750" d:DesignWidth="1100">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <conv:ChuoiMauToBrushConverter x:Key="ColorToBrush"/>
        <conv:NullToVisibilityConverter x:Key="NullToVis"/>
        <conv:ChuoiSoSanhToVisibilityConverter x:Key="StrCompareToVis"/>
    </UserControl.Resources>

    <Grid Background="{StaticResource MauNenChinh}">
        <Grid Margin="22">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 1. THẺ THỐNG KÊ TÀI CHÍNH DÒNG TIỀN 85/15 (SỬA LỖI VỠ CỘT 14PX) -->
            <Grid Grid.Row="0" Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Thẻ 1: Cần chuyển trả Chủ home (85% chưa quyết toán) -->
                <Border Grid.Column="0" Background="White" CornerRadius="12" Padding="18,16" BorderBrush="#FECDD3" BorderThickness="1.5">
                    <StackPanel>
                        <TextBlock Text="CẦN QUYẾT TOÁN CHỦ HOME (85%)" FontSize="11" FontWeight="Bold" Foreground="#E11D48"/>
                        <TextBlock Text="{Binding TongTienCanQuyetToanDinhDang}" FontSize="24" FontWeight="Black" Foreground="#E11D48" Margin="0,6,0,0"/>
                        <TextBlock Text="{Binding SoDonChuaQuyetToan, StringFormat='Đơn chờ giải ngân: {0} đơn'}" FontSize="12" Foreground="#64748B" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Thẻ 2: Đã quyết toán thành công (SỬA: Grid.Column="2" thay vì Column 1) -->
                <Border Grid.Column="2" Background="White" CornerRadius="12" Padding="18,16" BorderBrush="#BBF7D0" BorderThickness="1.5">
                    <StackPanel>
                        <TextBlock Text="ĐÃ QUYẾT TOÁN CHO CHỦ HOME (85%)" FontSize="11" FontWeight="Bold" Foreground="#0E9F6E"/>
                        <TextBlock Text="{Binding TongTienDaQuyetToanDinhDang}" FontSize="24" FontWeight="Black" Foreground="#0E9F6E" Margin="0,6,0,0"/>
                        <TextBlock Text="{Binding SoDonDaQuyetToan, StringFormat='Đã giải ngân hoàn tất: {0} đơn'}" FontSize="12" Foreground="#64748B" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Thẻ 3: Hoa hồng sàn thu 15% (SỬA: Grid.Column="4" thay vì Column 2) -->
                <Border Grid.Column="4" Background="White" CornerRadius="12" Padding="18,16" BorderBrush="#BAE6FD" BorderThickness="1.5">
                    <StackPanel>
                        <TextBlock Text="HOA HỒNG SÀN GIỮ LẠI (15%)" FontSize="11" FontWeight="Bold" Foreground="#0194F3"/>
                        <TextBlock Text="{Binding TongHoaHongSanDinhDang}" FontSize="24" FontWeight="Black" Foreground="#0194F3" Margin="0,6,0,0"/>
                        <TextBlock Text="Thu tự động 100% qua cổng Web" FontSize="12" Foreground="#64748B" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 2. THANH LỌC TRẠNG THÁI QUYẾT TOÁN -->
            <Border Grid.Row="1" Background="White" CornerRadius="12" Padding="18,14" Margin="0,0,0,18" BorderBrush="{StaticResource MauVien}" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="Trạng thái quyết toán:" VerticalAlignment="Center" FontWeight="Bold" Foreground="#334155" Margin="0,0,10,0" FontSize="13"/>
                    <ComboBox Grid.Column="1" SelectedValue="{Binding BoLocTrangThai}" SelectedValuePath="Tag" Width="220" Padding="8,6" VerticalAlignment="Center">
                        <ComboBoxItem Content="Chưa quyết toán (Cần chuyển tiền)" Tag="ChuaQuyetToan" IsSelected="True"/>
                        <ComboBoxItem Content="Đã quyết toán thành công" Tag="DaQuyetToan"/>
                        <ComboBoxItem Content="-- Xem tất cả đơn Check-out --" Tag="TatCa"/>
                    </ComboBox>

                    <TextBlock Grid.Column="2" Text="{Binding ThongBaoTrangThai}" VerticalAlignment="Center" Margin="18,0,0,0" Foreground="#64748B" FontSize="12"/>

                    <Button Grid.Column="3" Content="🔄 Tải lại đơn" Command="{Binding TaiDuLieuCommand}"
                            Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" Foreground="#334155"
                            Padding="16,8" Cursor="Hand" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="8"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </Grid>
            </Border>

            <!-- 3. KHU VỰC DỮ LIỆU: BẢNG ĐƠN CHECK-OUT + THÔNG TIN CHUYỂN KHOẢN -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="18"/>
                    <ColumnDefinition Width="400"/>
                </Grid.ColumnDefinitions>

                <!-- BẢNG ĐƠN HÀNG HOÀN THÀNH -->
                <Border Grid.Column="0" Background="White" CornerRadius="12" BorderBrush="{StaticResource MauVien}" BorderThickness="1">
                    <DataGrid ItemsSource="{Binding DanhSachHienThi}" SelectedItem="{Binding DonDangChon}"
                              AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#F1F5F9"
                              Background="White" BorderThickness="0" RowHeight="46" Padding="6">
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#F8FAFC"/>
                                <Setter Property="Foreground" Value="#475569"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="FontSize" Value="12"/>
                                <Setter Property="Padding" Value="12,10"/>
                                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                <Setter Property="BorderBrush" Value="#E5E7EB"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Mã đơn" Binding="{Binding MaDonHienThi, Mode=OneWay}" Width="85"/>
                            <DataGridTextColumn Header="Cơ sở Homestay" Binding="{Binding TenCoSo, Mode=OneWay}" Width="160"/>
                            <DataGridTextColumn Header="Chủ nhà" Binding="{Binding TenChuHome, Mode=OneWay}" Width="120"/>
                            <DataGridTextColumn Header="Check-out" Binding="{Binding NgayCheckOut, Mode=OneWay, StringFormat='{}{0:dd/MM/yyyy}'}" Width="95"/>
                            <DataGridTextColumn Header="Khách trả (100%)" Binding="{Binding TongTienDinhDang, Mode=OneWay}" Width="115"/>
                            <DataGridTextColumn Header="Hoa hồng (15%)" Binding="{Binding HoaHongSanDinhDang, Mode=OneWay}" Width="115"/>
                            <DataGridTemplateColumn Header="Trả Chủ (85%)" Width="135">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding TienChuHomeDinhDang}" FontWeight="Bold" Foreground="#0E9F6E" VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Quyết toán" Width="135">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="{Binding MauQuyetToan, Converter={StaticResource ColorToBrush}}"
                                                CornerRadius="10" Padding="8,2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding TenHienThiQuyetToan}" Foreground="White" FontSize="10" FontWeight="Bold"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

                <!-- CHI TIẾT NGÂN HÀNG & THAO TÁC QUYẾT TOÁN 85% -->
                <Border Grid.Column="2" Background="White" CornerRadius="12" BorderBrush="{StaticResource MauVien}" BorderThickness="1">
                    <Grid>
                        <!-- EMPTY STATE KHI CHƯA CHỌN ĐƠN -->
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="22"
                                    Visibility="{Binding DonDangChon, Converter={StaticResource NullToVis}, ConverterParameter=Inverse}">
                            <Border Width="76" Height="76" CornerRadius="38" Background="{StaticResource MauHomestayBlueNhat}" Margin="0,0,0,14" HorizontalAlignment="Center">
                                <TextBlock Text="💳" FontSize="34" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="CHƯA CHỌN ĐƠN CHECK-OUT" FontSize="15" FontWeight="Bold" Foreground="{StaticResource MauChuChinh}" HorizontalAlignment="Center"/>
                            <TextBlock Text="Vui lòng chọn một đơn đặt phòng đã hoàn tất từ danh sách để kiểm tra thông tin số tài khoản và thực hiện giải ngân 85%."
                                       Foreground="{StaticResource MauChuPhu}" FontSize="12" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="320" Margin="0,6,0,0" LineHeight="18"/>
                        </StackPanel>

                        <!-- CHI TIẾT KHI ĐÃ CHỌN ĐƠN -->
                        <Grid Visibility="{Binding DonDangChon, Converter={StaticResource NullToVis}}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Khu vực thông tin cuộn -->
                            <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Padding="22,22,22,12">
                                <StackPanel>
                                    <TextBlock Text="THÔNG TIN CHUYỂN KHOẢN 85%" FontSize="14" FontWeight="Bold" Foreground="{StaticResource MauChuChinh}" Margin="0,0,0,14"/>

                                    <!-- Khối số tiền cần chuyển kiểu HomestaySystem Green Card -->
                                    <Border Background="#ECFDF5" BorderBrush="#A7F3D0" BorderThickness="1.5" CornerRadius="10" Padding="16" Margin="0,0,0,16">
                                        <StackPanel>
                                            <TextBlock Text="SỐ TIỀN CẦN CHUYỂN TRẢ (85%):" FontSize="11" FontWeight="Bold" Foreground="#047857"/>
                                            <TextBlock Text="{Binding DonDangChon.TienChuHomeDinhDang, FallbackValue='0 đ'}" FontSize="26" FontWeight="Black" Foreground="#047857" Margin="0,4,0,0"/>
                                            <TextBlock Text="{Binding DonDangChon.TongTienDinhDang, StringFormat='Tổng tiền khách đã trả trước: {0}'}" FontSize="12" Foreground="#475569" Margin="0,6,0,0"/>
                                            <TextBlock Text="{Binding DonDangChon.HoaHongSanDinhDang, StringFormat='Hoa hồng sàn giữ 15%: {0}'}" FontSize="12" Foreground="#0194F3" FontWeight="SemiBold" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Thông tin tài khoản thụ hưởng -->
                                    <Border Background="#F8FAFC" BorderBrush="{StaticResource MauVien}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,16">
                                        <StackPanel>
                                            <TextBlock Text="TÀI KHOẢN NGÂN HÀNG THỤ HƯỞNG" FontSize="11" FontWeight="Bold" Foreground="#334155" Margin="0,0,0,10"/>

                                            <Grid Margin="0,0,0,8">
                                                <TextBlock Text="Chủ Homestay:" Foreground="#64748B" FontSize="12"/>
                                                <TextBlock Text="{Binding DonDangChon.TenChuHome}" FontWeight="Bold" Foreground="#1E293B" HorizontalAlignment="Right" FontSize="12"/>
                                            </Grid>
                                            <Grid Margin="0,0,0,8">
                                                <TextBlock Text="SĐT liên hệ:" Foreground="#64748B" FontSize="12"/>
                                                <TextBlock Text="{Binding DonDangChon.SoDienThoaiChuHome}" FontWeight="Medium" Foreground="#1E293B" HorizontalAlignment="Right" FontSize="12"/>
                                            </Grid>
                                            <Grid Margin="0,0,0,8">
                                                <TextBlock Text="Ngân hàng:" Foreground="#64748B" FontSize="12"/>
                                                <TextBlock Text="{Binding DonDangChon.TenNganHangChuHome, FallbackValue='Chưa cập nhật'}" FontWeight="SemiBold" Foreground="#0F172A" HorizontalAlignment="Right" FontSize="12" MaxWidth="190" TextTrimming="CharacterEllipsis"/>
                                            </Grid>
                                            <Grid Margin="0,0,0,8">
                                                <TextBlock Text="Số tài khoản:" Foreground="#64748B" FontSize="12"/>
                                                <TextBlock Text="{Binding DonDangChon.SoTaiKhoanNganHangChuHome, FallbackValue='---'}" FontWeight="Bold" Foreground="#0194F3" HorizontalAlignment="Right" FontSize="14"/>
                                            </Grid>
                                            <Grid>
                                                <TextBlock Text="Tên chủ TK:" Foreground="#64748B" FontSize="12"/>
                                                <TextBlock Text="{Binding DonDangChon.ChuTaiKhoanNganHangChuHome, FallbackValue='---'}" FontWeight="Bold" Foreground="#1E293B" HorizontalAlignment="Right" FontSize="12"/>
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <!-- ================= BẰNG CHỨNG QUYẾT TOÁN THÀNH CÔNG (KHI ĐÃ QUYẾT TOÁN) ================= -->
                                    <Border Background="#F0FDF4" BorderBrush="#86EFAC" BorderThickness="1.5" CornerRadius="10" Padding="14" Margin="0,0,0,8"
                                            Visibility="{Binding DonDangChon.TrangThaiQuyetToan, Converter={StaticResource StrCompareToVis}, ConverterParameter=DaQuyetToan}">
                                        <StackPanel>
                                            <TextBlock Text="✔ ĐÃ HOÀN TẤT GIẢI NGÂN (85%)" FontWeight="Bold" FontSize="12" Foreground="#15803D" Margin="0,0,0,8"/>
                                            <Grid Margin="0,0,0,6">
                                                <TextBlock Text="Mã GD ngân hàng:" Foreground="#475569" FontSize="12"/>
                                                <TextBlock Text="{Binding DonDangChon.MaGiaoDichQuyetToan, FallbackValue='---'}" FontWeight="Bold" Foreground="#0F172A" HorizontalAlignment="Right" FontSize="12"/>
                                            </Grid>
                                            <Grid Margin="0,0,0,6">
                                                <TextBlock Text="Thời gian quyết toán:" Foreground="#475569" FontSize="12"/>
                                                <TextBlock Text="{Binding DonDangChon.NgayQuyetToan, StringFormat='{}{0:dd/MM/yyyy HH:mm}', FallbackValue='---'}" FontWeight="SemiBold" Foreground="#0F172A" HorizontalAlignment="Right" FontSize="12"/>
                                            </Grid>
                                            <Grid>
                                                <TextBlock Text="Ghi chú đối soát:" Foreground="#475569" FontSize="12"/>
                                                <TextBlock Text="{Binding DonDangChon.GhiChuQuyetToan, FallbackValue='Không có ghi chú'}" FontWeight="Medium" Foreground="#475569" HorizontalAlignment="Right" FontSize="12" MaxWidth="190" TextTrimming="CharacterEllipsis"/>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>

                            <!-- THANH THAO TÁC CỐ ĐỊNH Ở CHÂN CARD (KHÔNG BAO GIỜ BỊ CHE / KHUẤT) -->
                            <Border Grid.Row="1" Background="#F8FAFC" Padding="18,14" BorderBrush="{StaticResource MauVien}" BorderThickness="0,1,0,0" CornerRadius="0,0,12,12">
                                <Grid>
                                    <!-- Nút Xác nhận Quyết toán (khi CHƯA quyết toán) -->
                                    <Button Content="✔ Xác nhận đã chuyển tiền 85%" Command="{Binding MoDialogQuyetToanCommand}"
                                            Background="#0E9F6E" Foreground="White" FontWeight="Bold" FontSize="13" Padding="0,12"
                                            BorderThickness="0" Cursor="Hand" HorizontalAlignment="Stretch"
                                            Visibility="{Binding DonDangChon.TrangThaiQuyetToan, Converter={StaticResource StrCompareToVis}, ConverterParameter=ChuaQuyetToan}">
                                        <Button.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="8"/>
                                            </Style>
                                        </Button.Resources>
                                    </Button>

                                    <!-- Thông báo đã quyết toán xong (khi ĐÃ quyết toán) -->
                                    <Border Background="#E8F7EE" BorderBrush="#A7F3D0" BorderThickness="1" CornerRadius="8" Padding="12,10"
                                            Visibility="{Binding DonDangChon.TrangThaiQuyetToan, Converter={StaticResource StrCompareToVis}, ConverterParameter=DaQuyetToan}">
                                        <TextBlock Text="✔ Đơn này đã hoàn tất chuyển tiền 85% vào tài khoản Chủ nhà."
                                                   Foreground="#0E9F6E" FontWeight="Bold" FontSize="12" TextWrapping="Wrap" TextAlignment="Center"/>
                                    </Border>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- ================= POPUP DIALOG XÁC NHẬN QUYẾT TOÁN ================= -->
        <Grid Background="#70000000" Visibility="{Binding HienThiDialogXacNhan, Converter={StaticResource BoolToVis}}">
            <Border Width="520" Background="White" CornerRadius="12" Padding="26" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="XÁC NHẬN ĐÃ QUYẾT TOÁN (CHUYỂN TRẢ 85%)" FontSize="16" FontWeight="Bold" Foreground="#0E9F6E"/>
                    <TextBlock Text="Vui lòng kiểm tra kỹ số tiền và nhập mã giao dịch ngân hàng để lưu vết đối soát:"
                               Foreground="#64748B" FontSize="12" Margin="0,6,0,16" TextWrapping="Wrap"/>

                    <Border Background="#F8FAFC" BorderBrush="{StaticResource MauVien}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,16">
                        <StackPanel>
                            <Grid Margin="0,0,0,6">
                                <TextBlock Text="Đơn đặt phòng:" Foreground="#64748B" FontSize="12"/>
                                <TextBlock Text="{Binding DonDangChon.MaDonHienThi}" FontWeight="Bold" Foreground="#1E293B" HorizontalAlignment="Right" FontSize="12"/>
                            </Grid>
                            <Grid Margin="0,0,0,6">
                                <TextBlock Text="Chủ nhận tiền:" Foreground="#64748B" FontSize="12"/>
                                <TextBlock Text="{Binding DonDangChon.TenChuHome}" FontWeight="SemiBold" Foreground="#1E293B" HorizontalAlignment="Right" FontSize="12"/>
                            </Grid>
                            <Grid>
                                <TextBlock Text="Số tiền chuyển trả (85%):" FontWeight="Bold" Foreground="#047857" FontSize="13"/>
                                <TextBlock Text="{Binding DonDangChon.TienChuHomeDinhDang}" FontWeight="Black" Foreground="#047857" HorizontalAlignment="Right" FontSize="16"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Mã giao dịch ngân hàng / Ủy nhiệm chi (* Bắt buộc):" FontWeight="SemiBold" FontSize="12" Foreground="#334155" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding MaGiaoDichNhap, UpdateSourceTrigger=PropertyChanged}" Padding="8" FontSize="13" Margin="0,0,0,12" BorderBrush="#CBD5E1" BorderThickness="1">
                        <TextBox.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </TextBox.Resources>
                    </TextBox>

                    <TextBlock Text="Ghi chú đối soát:" FontWeight="SemiBold" FontSize="12" Foreground="#334155" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding GhiChuNhap, UpdateSourceTrigger=PropertyChanged}" Height="60" TextWrapping="Wrap" AcceptsReturn="True"
                             Padding="8" FontSize="13" BorderBrush="#CBD5E1" BorderThickness="1">
                        <TextBox.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </TextBox.Resources>
                    </TextBox>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                        <Button Content="Hủy bỏ" Command="{Binding HuyDialogQuyetToanCommand}" Padding="20,10" Margin="0,0,12,0"
                                Background="#E2E8F0" Foreground="#475569" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand" MinWidth="100">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="8"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                        <Button Content="✔ Xác nhận hoàn tất quyết toán" Command="{Binding XacNhanQuyetToanCommand}" Padding="24,10"
                                Background="#0E9F6E" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand" MinWidth="220">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="8"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
