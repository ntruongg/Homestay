@model IReadOnlyList<PropertySummary>
@{
    ViewData["Title"] = "Đặt Homestay & Khách Sạn Trực Tuyến - Giá Tốt Nhất";
    var currentLoaiHinh = (string)(ViewBag.LoaiHinh ?? "ALL");
}

<!-- HERO BANNER VỚI GRADIENT NỀN XANH TRAVELOKA -->
<section class="traveloka-hero">
    <div class="container hero-container">
        <div class="hero-text-content">
            <div class="hero-badge">
                <span>🌟 Khám phá Việt Nam theo cách riêng của bạn</span>
            </div>
            <h1 class="hero-title">
                Tìm kiếm chỗ nghỉ tuyệt vời<br>
                <span class="hero-title-highlight">cho kỳ nghỉ đáng nhớ</span>
            </h1>
            <p class="hero-subtitle">
                Hơn 10,000+ homestay nguyên căn, biệt thự nghỉ dưỡng và khách sạn tiện nghi khắp Việt Nam với cam kết giá minh bạch chuẩn Traveloka.
            </p>
        </div>

        <!-- THANH SEARCH BAR ĐA TẦNG NỔI (FLOATING SEARCH BOX TRAVELOKA) -->
        <div class="floating-search-wrapper">
            <!-- Search Type Tabs -->
            <div class="search-category-tabs">
                <a asp-action="Index" asp-route-loaiHinh="ALL" class="cat-tab @(currentLoaiHinh == "ALL" ? "active" : "")">
                    <span>🏨 Tất cả chỗ nghỉ</span>
                </a>
                <a asp-action="Index" asp-route-loaiHinh="Homestay" class="cat-tab @(currentLoaiHinh == "Homestay" ? "active" : "")">
                    <span>🏡 Homestay nguyên căn</span>
                </a>
                <a asp-action="Index" asp-route-loaiHinh="Hotel" class="cat-tab @(currentLoaiHinh == "Hotel" ? "active" : "")">
                    <span>🏢 Khách sạn theo phòng</span>
                </a>
            </div>

            <!-- Form tìm kiếm đa tầng -->
            <form class="traveloka-search-form" asp-action="Index" method="get">
                <input type="hidden" name="loaiHinh" value="@currentLoaiHinh" />

                <!-- Ô 1: Điểm đến / Tên homestay -->
                <div class="search-field field-location">
                    <label class="field-label">
                        <span class="field-icon">📍</span>
                        <span>Điểm đến hoặc Tên chỗ nghỉ</span>
                    </label>
                    <div class="field-input-wrap">
                        <input type="text" name="location" value="@ViewBag.Location" placeholder="TP.HCM, Đà Lạt, Hà Nội, Vũng Tàu..." class="search-input" />
                    </div>
                </div>

                <!-- Ô 2: Ngày nhận phòng & Ngày trả phòng -->
                <div class="search-field field-dates">
                    <div class="date-sub-field">
                        <label class="field-label">
                            <span class="field-icon">📅</span>
                            <span>Nhận phòng</span>
                        </label>
                        <input type="date" name="checkIn" value="@ViewBag.CheckIn" class="search-input input-date" />
                    </div>
                    <div class="date-divider">➝</div>
                    <div class="date-sub-field">
                        <label class="field-label">
                            <span class="field-icon">📅</span>
                            <span>Trả phòng</span>
                        </label>
                        <input type="date" name="checkOut" value="@ViewBag.CheckOut" class="search-input input-date" />
                    </div>
                </div>

                <!-- Ô 3: Số khách & Số phòng -->
                <div class="search-field field-guests">
                    <label class="field-label">
                        <span class="field-icon">👥</span>
                        <span>Số khách lưu trú</span>
                    </label>
                    <div class="field-input-wrap">
                        <select name="guests" class="search-input search-select">
                            <option value="1" selected="@(ViewBag.Guests == 1)">1 khách (Đi công tác / Một mình)</option>
                            <option value="2" selected="@(ViewBag.Guests == 2)">2 khách (Cặp đôi / Bạn thân)</option>
                            <option value="3" selected="@(ViewBag.Guests == 3)">3 khách (Gia đình nhỏ)</option>
                            <option value="4" selected="@(ViewBag.Guests == 4)">4 khách (2 phòng / Nhóm bạn)</option>
                            <option value="6" selected="@(ViewBag.Guests == 6)">6+ khách (Thuê nguyên căn lớn)</option>
                        </select>
                    </div>
                </div>

                <!-- Nút CTA màu cam Traveloka Vivid Orange #FF5E1F -->
                <div class="search-action">
                    <button type="submit" class="traveloka-search-btn">
                        <span class="btn-search-icon">🔍</span>
                        <span>Tìm Kiếm</span>
                    </button>
                </div>
            </form>
        </div>
    </div>
</section>

<!-- SECTION DANH SÁCH CHỖ NGHỈ -->
<section class="section-stays container" id="stays">
    <!-- HEADER DANH SÁCH & BỘ LỌC NHANH (QUICK FILTER TABS) -->
    <div class="stays-header-wrap">
        <div>
            <div class="quick-filter-eyebrow">Khám phá lựa chọn tốt nhất</div>
            <h2 class="stays-section-title">Điểm đến hàng đầu dành cho bạn</h2>
            <p class="stays-section-desc">Không gian ấm cúng, thiết kế ấn tượng và giá niêm yết rõ ràng minh bạch.</p>
        </div>

        <!-- BỘ LỌC NHANH (QUICK FILTER TABS TRAVELOKA) -->
        <div class="quick-filters-bar">
            <a asp-action="Index" asp-route-location="@ViewBag.Location" asp-route-loaiHinh="ALL"
               class="filter-pill @(currentLoaiHinh == "ALL" ? "selected" : "")">
                Tất cả (@Model.Count)
            </a>
            <a asp-action="Index" asp-route-location="@ViewBag.Location" asp-route-loaiHinh="Homestay"
               class="filter-pill @(currentLoaiHinh == "Homestay" ? "selected" : "")">
                🏡 Homestay nguyên căn
            </a>
            <a asp-action="Index" asp-route-location="@ViewBag.Location" asp-route-loaiHinh="Hotel"
               class="filter-pill @(currentLoaiHinh == "Hotel" ? "selected" : "")">
                🏨 Khách sạn theo phòng
            </a>
        </div>
    </div>

    @if (ViewBag.Error is string error)
    {
        <div class="alert error-traveloka">
            <span class="alert-icon">⚠️</span>
            <span>@error</span>
        </div>
    }

    @if (!Model.Any())
    {
        <div class="empty-stays-box">
            <div class="empty-icon">🔍</div>
            <h3>Không tìm thấy chỗ nghỉ phù hợp</h3>
            <p>Hãy thử tìm kiếm với từ khóa khác, điều chỉnh bộ lọc hoặc xem các homestay khác trên hệ thống.</p>
            <a asp-action="Index" class="button traveloka-search-btn" style="display:inline-flex; width:auto; margin-top:14px;">
                Xem tất cả chỗ nghỉ
            </a>
        </div>
    }
    else
    {
        <!-- DANH SÁCH THẺ CARD CHỖ NGHỈ (BO GÓC 12PX, BADGE RATING, GIÁ NỔI BẬT TRAVELOKA) -->
        <div class="stay-cards-grid">
            @foreach (var property in Model)
            {
                var isHome = (property.Type ?? "").Equals("Homestay", StringComparison.OrdinalIgnoreCase);
                // Tạo rating badge ngẫu nhiên thực tế (8.9 - 9.8) dựa theo Id của cơ sở
                var score = 8.8 + ((property.Id * 7) % 11) * 0.1;
                var reviewCount = 20 + ((property.Id * 13) % 150);

                <article class="traveloka-card">
                    <!-- Ảnh đại diện bo góc 12px -->
                    <div class="card-image-box">
                        <a asp-action="Details" asp-route-id="@property.Id">
                            <img src="@(string.IsNullOrWhiteSpace(property.CoverImageUrl) ? "https://images.unsplash.com/photo-1566073771259-6a8506099945?w=800&q=80" : property.CoverImageUrl)"
                                 alt="@property.Name" class="card-thumb" loading="lazy" />
                        </a>

                        <!-- Badge loại hình -->
                        <span class="card-type-badge @(isHome ? "badge-homestay" : "badge-hotel")">
                            @(isHome ? "🏡 Homestay nguyên căn" : "🏨 Khách sạn")
                        </span>

                        <!-- Badge đánh giá Traveloka -->
                        <div class="card-rating-badge">
                            <span class="rating-score">@score.ToString("0.0")</span>
                            <span class="rating-text">Tuyệt vời (@reviewCount)</span>
                        </div>
                    </div>

                    <!-- Nội dung thông tin card -->
                    <div class="card-content">
                        <div class="card-location">
                            <span>📍</span> @(property.Address ?? "Vị trí trung tâm thuận tiện")
                        </div>

                        <h3 class="card-title">
                            <a asp-action="Details" asp-route-id="@property.Id">
                                @property.Name
                            </a>
                        </h3>

                        <!-- Tiện ích tóm tắt -->
                        <div class="card-amenities-mini">
                            <span class="amenity-tag">📶 WiFi tốc độ cao</span>
                            <span class="amenity-tag">❄️ Máy lạnh</span>
                            <span class="amenity-tag">🍳 Bếp riêng</span>
                        </div>

                        <div class="card-divider"></div>

                        <!-- Khu vực giá hiển thị nổi bật kèm nhãn "Chưa bao gồm thuế & phí" -->
                        <div class="card-price-footer">
                            <div class="price-info">
                                <span class="price-prefix">Giá chỉ từ</span>
                                <div class="price-amount-wrap">
                                    <strong class="price-highlight">@property.MinimumPrice.ToString("N0") ₫</strong>
                                    <span class="price-unit">/ đêm</span>
                                </div>
                                <span class="price-note">Chưa bao gồm thuế &amp; phí</span>
                            </div>

                            <a asp-action="Details" asp-route-id="@property.Id" class="card-cta-btn">
                                Xem phòng
                            </a>
                        </div>
                    </div>
                </article>
            }
        </div>
    }
</section>

<!-- SECTION VÌ SAO CHỌN TRAVELOKA STAYLY -->
<section class="traveloka-features-section">
    <div class="container">
        <div class="features-header">
            <span class="features-eyebrow">Cam kết dịch vụ</span>
            <h2 class="features-title">Tại sao hàng triệu khách hàng chọn Stayly?</h2>
        </div>

        <div class="features-grid">
            <div class="feature-item">
                <div class="feature-icon-circle blue">
                    <span>🏷️</span>
                </div>
                <h3>Giá cả minh bạch 100%</h3>
                <p>Mọi mức giá niêm yết đều được bóc tách rõ ràng gồm giá gốc và phí sàn, không có phí ẩn khi thanh toán.</p>
            </div>

            <div class="feature-item">
                <div class="feature-icon-circle orange">
                    <span>🛡️</span>
                </div>
                <h3>Bảo đảm chỗ nghỉ chuẩn xác</h3>
                <p>100% hồ sơ pháp lý (GPKD, PCCC, ANTT) của đối tác đều được Quản trị viên thẩm định trực tiếp trước khi mở bán.</p>
            </div>

            <div class="feature-item">
                <div class="feature-icon-circle green">
                    <span>⚡</span>
                </div>
                <h3>Xác nhận đặt phòng tức thì</h3>
                <p>Nhận ngay mã voucher xác nhận và hướng dẫn check-in chi tiết qua Email và tin nhắn ngay sau khi hoàn tất.</p>
            </div>

            <div class="feature-item">
                <div class="feature-icon-circle navy">
                    <span>📞</span>
                </div>
                <h3>Chăm sóc khách hàng 24/7</h3>
                <p>Đội ngũ hỗ trợ chuyên nghiệp luôn sẵn sàng đồng hành từ lúc chọn phòng đến khi hoàn tất chuyến đi.</p>
            </div>
        </div>
    </div>
</section>
