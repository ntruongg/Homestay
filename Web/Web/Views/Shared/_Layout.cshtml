<!doctype html>
<html lang="vi">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>@ViewData["Title"] - Stayly | Đặt Chỗ Nghỉ, Homestay &amp; Khách Sạn Trực Tuyến</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/site.css" asp-append-version="true">
</head>
<body class="traveloka-theme">
    <!-- TOP PROMO BAR -->
    <div class="top-announcement">
        <div class="container top-announcement-inner">
            <span>🎉 <strong>Ưu đãi thành viên mới:</strong> Giảm ngay 10% khi đặt homestay hoặc khách sạn lần đầu với mã <strong>STAYLYNEW</strong></span>
            <span class="hotline-mini">📞 Hotline hỗ trợ 24/7: <strong>1900 8888</strong></span>
        </div>
    </div>

    <!-- MAIN NAVBAR -->
    <header class="traveloka-header">
        <nav class="nav container">
            <!-- BRAND LOGO -->
            <a class="brand traveloka-brand" asp-controller="Home" asp-action="Index">
                <div class="brand-badge">✈️</div>
                <div class="brand-text-wrap">
                    <span class="brand-name">stayly</span>
                    <span class="brand-tagline">Traveloka Accommodation</span>
                </div>
            </a>

            <!-- NAVIGATION LINKS -->
            <div class="nav-links">
                <a class="nav-item active" asp-controller="Home" asp-action="Index" asp-fragment="stays">
                    <span class="nav-icon">🏨</span> Khách sạn &amp; Homestay
                </a>
                <a class="nav-item" asp-controller="Home" asp-action="Trips">
                    <span class="nav-icon">🎒</span> Chuyến đi của tôi
                </a>
                @if (Context.Session.GetString("role") == "OWNER")
                {
                    <a class="nav-item host-portal-link active-host" asp-controller="Home" asp-action="Dashboard">
                        <span class="nav-icon">📊</span> Kênh Chủ Nhà (Host Portal)
                    </a>
                }
