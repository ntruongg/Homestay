                                <Border Grid.Column="1" Background="White" BorderBrush="#BBF7D0" BorderThickness="1" CornerRadius="6" Padding="8,3" HorizontalAlignment="Right">
                                    <TextBlock Text="{Binding DonDangQuyetToan.MaGiaoDichQuyetToan, FallbackValue='---'}" FontWeight="Bold" Foreground="#0F172A" FontSize="12.5" FontFamily="Consolas"/>
                                </Border>
                            </Grid>

                            <!-- Thời gian quyết toán -->
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Thời gian tất toán:" FontSize="12" Foreground="#475569" Width="140"/>
                                <TextBlock Grid.Column="1" Text="{Binding DonDangQuyetToan.NgayQuyetToanDinhDang, FallbackValue='---'}" FontWeight="SemiBold" Foreground="#0F172A" FontSize="12" HorizontalAlignment="Right"/>
                            </Grid>

                            <!-- Ghi chú đối soát -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Ghi chú đối soát:" FontSize="12" Foreground="#475569" Width="140" VerticalAlignment="Top"/>
                                <TextBlock Grid.Column="1" Text="{Binding DonDangQuyetToan.GhiChuQuyetToan, FallbackValue='Đã chuyển khoản thành công'}" FontWeight="Normal" Foreground="#334155" FontSize="12" HorizontalAlignment="Right" TextWrapping="Wrap" MaxWidth="320" TextAlignment="Right"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- ================= TRƯỜNG HỢP 2: CHƯA QUYẾT TOÁN (FORM NHẬP ĐỐI SOÁT) ================= -->
                    <StackPanel Visibility="{Binding LaChuaQuyetToan, Converter={StaticResource BoolToVis}}">
                        <!-- Form nhập đối soát -->
                        <StackPanel Margin="0,0,0,14">
                            <TextBlock Text="MÃ GIAO DỊCH NGÂN HÀNG (Mã FT / Biên lai ủy nhiệm chi):" FontSize="11" FontWeight="Bold" Foreground="#334155" Margin="0,0,0,5"/>
                            <TextBox Text="{Binding MaGiaoDichNhap, UpdateSourceTrigger=PropertyChanged}"
                                     Height="36" VerticalContentAlignment="Center" Padding="10,0"
                                     FontSize="12.5" FontWeight="SemiBold"
                                     BorderBrush="#CBD5E1" Background="#FFFFFF" Style="{StaticResource StaylyTextBoxStyle}"/>
                        </StackPanel>

                        <StackPanel Margin="0,0,0,20">
                            <TextBlock Text="GHI CHÚ ĐỐI SOÁT CHUYỂN KHOẢN:" FontSize="11" FontWeight="Bold" Foreground="#334155" Margin="0,0,0,5"/>
                            <TextBox Text="{Binding GhiChuNhap, UpdateSourceTrigger=PropertyChanged}"
                                     Height="36" VerticalContentAlignment="Center" Padding="10,0"
                                     FontSize="12" BorderBrush="#CBD5E1" Background="#FFFFFF" Style="{StaticResource StaylyTextBoxStyle}"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- ================= NÚT HÀNH ĐỘNG DƯỚI ĐÁY ================= -->
                    <!-- Khi CHƯA quyết toán: 2 nút Hủy bỏ + Xác nhận hoàn tất -->
                    <Grid Visibility="{Binding LaChuaQuyetToan, Converter={StaticResource BoolToVis}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="Hủy bỏ" Command="{Binding DongDialogQuyetToanCommand}"
                                Height="40" Background="#F1F5F9" Foreground="#475569" BorderThickness="0"
                                FontWeight="SemiBold" Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="8"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                        <Button Grid.Column="2" Content="✔ Xác nhận đã chuyển khoản &amp; Hoàn tất"
                                Command="{Binding XacNhanQuyetToanCommand}"
                                Height="40" Padding="20,0" Background="#10B981" Foreground="White" BorderThickness="0"
                                FontWeight="Bold" Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="8"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </Grid>

                    <!-- Khi ĐÃ tất toán: Chỉ DUY NHẤT 1 nút Đóng biên lai, TUYỆT ĐỐI KHÔNG CÓ NÚT XÁC NHẬN -->
                    <Grid Visibility="{Binding LaDaQuyetToan, Converter={StaticResource BoolToVis}}">
                        <Button Content="Đóng biên lai" Command="{Binding DongDialogQuyetToanCommand}"
                                Height="40" Background="#0077B6" Foreground="White" BorderThickness="0"
                                FontWeight="Bold" FontSize="13" Cursor="Hand" HorizontalAlignment="Stretch">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="8"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
