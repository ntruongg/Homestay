                                <TextBlock Grid.Column="1" Text="{Binding DonDangQuyetToan.TienChuHomeDinhDang}" FontSize="18" FontWeight="Black" Foreground="#10B981" HorizontalAlignment="Right"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- ================= TRƯỜNG HỢP 1: ĐÃ TẤT TOÁN XONG (READ-ONLY BIÊN LAI) ================= -->
                    <Border Background="#F0FDF4" BorderBrush="#86EFAC" BorderThickness="1.5" CornerRadius="12" Padding="16" Margin="0,0,0,18"
                            Visibility="{Binding LaDaQuyetToan, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,12">
                                <Border Background="#DCFCE7" CornerRadius="6" Padding="8,3" DockPanel.Dock="Right">
                                    <TextBlock Text="ĐÃ GIẢI NGÂN (85%)" FontSize="11" FontWeight="Bold" Foreground="#15803D"/>
