<UserControl x:Class="HomestaySystem.Views.QuyetToanTaiChinhView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:conv="clr-namespace:HomestaySystem.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="750" d:DesignWidth="1100">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <conv:ChuoiMauToBrushConverter x:Key="ColorToBrush"/>
        <conv:NullToVisibilityConverter x:Key="NullToVis"/>
        <conv:ChuoiSoSanhToVisibilityConverter x:Key="StrCompareToVis"/>
    </UserControl.Resources>

    <Grid Background="{StaticResource MauNenChinh}">
        <Grid Margin="22">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 1. THẺ THỐNG KÊ TÀI CHÍNH DÒNG TIỀN 85/15 (FORMAT CHUẨN THỐNG NHẤT) -->
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Thẻ 1: Cần chuyển trả Chủ home (85% chưa quyết toán) -->
                <Border Grid.Column="0" Background="White" CornerRadius="12" BorderBrush="#E2E8F0" BorderThickness="1" Padding="14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="CẦN QUYẾT TOÁN CHỦ HOME (85%)" FontSize="11" FontWeight="Bold" Foreground="#64748B" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding TongTienCanQuyetToanDinhDang, FallbackValue='0 đ'}" FontSize="22" FontWeight="Black" Foreground="#E11D48" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding SoDonChuaQuyetToan, StringFormat='Đơn chờ giải ngân: {0} đơn'}" FontSize="11" Foreground="#64748B" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <Border Grid.Column="1" Width="42" Height="42" CornerRadius="21" Background="#FEE2E2" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="💸" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- Thẻ 2: Đã quyết toán thành công -->
                <Border Grid.Column="2" Background="White" CornerRadius="12" BorderBrush="#E2E8F0" BorderThickness="1" Padding="14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="ĐÃ QUYẾT TOÁN CHO HOST (85%)" FontSize="11" FontWeight="Bold" Foreground="#64748B" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding TongTienDaQuyetToanDinhDang, FallbackValue='0 đ'}" FontSize="22" FontWeight="Black" Foreground="#10B981" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding SoDonDaQuyetToan, StringFormat='Đã giải ngân hoàn tất: {0} đơn'}" FontSize="11" Foreground="#64748B" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <Border Grid.Column="1" Width="42" Height="42" CornerRadius="21" Background="#ECFDF5" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="✅" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- Thẻ 3: Hoa hồng sàn thu 15% -->
                <Border Grid.Column="4" Background="White" CornerRadius="12" BorderBrush="#E2E8F0" BorderThickness="1" Padding="14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="HOA HỒNG SÀN GIỮ LẠI (15%)" FontSize="11" FontWeight="Bold" Foreground="#64748B" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding TongHoaHongSanDinhDang, FallbackValue='0 đ'}" FontSize="22" FontWeight="Black" Foreground="#0194F3" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="Thu tự động 100% qua cổng Web" FontSize="11" Foreground="#64748B" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <Border Grid.Column="1" Width="42" Height="42" CornerRadius="21" Background="#E0F2FE" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="🛡️" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <!-- 2. THANH LỌC TRẠNG THÁI QUYẾT TOÁN -->
            <Border Grid.Row="1" Background="White" CornerRadius="12" Padding="18,14" Margin="0,0,0,18" BorderBrush="{StaticResource MauVien}" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="Trạng thái quyết toán:" VerticalAlignment="Center" FontWeight="Bold" Foreground="#334155" Margin="0,0,10,0" FontSize="13"/>
                    <ComboBox Grid.Column="1" SelectedValue="{Binding BoLocTrangThai}" SelectedValuePath="Tag" Width="240" Height="36" VerticalAlignment="Center">
                        <ComboBoxItem Content="Chưa quyết toán (Cần chuyển tiền)" Tag="ChuaQuyetToan" IsSelected="True"/>
                        <ComboBoxItem Content="Đã quyết toán thành công" Tag="DaQuyetToan"/>
                        <ComboBoxItem Content="-- Xem tất cả đơn Check-out --" Tag="TatCa"/>
                    </ComboBox>

                    <TextBlock Grid.Column="2" Text="{Binding ThongBaoTrangThai}" VerticalAlignment="Center" Margin="18,0,0,0" Foreground="#64748B" FontSize="12"/>

                    <Button Grid.Column="3" Content="🔄 Tải lại đơn" Command="{Binding TaiDuLieuCommand}"
                            Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" Foreground="#334155"
                            Padding="16,8" Cursor="Hand" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="8"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </Grid>
            </Border>

            <!-- 3. KHU VỰC DỮ LIỆU: BẢNG ĐƠN CHECK-OUT + THÔNG TIN CHUYỂN KHOẢN -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- BẢNG ĐƠN HÀNG HOÀN THÀNH (FULL-WIDTH RÕ RÀNG) -->
                <Border Grid.Column="0" Background="White" CornerRadius="12" BorderBrush="{StaticResource MauVien}" BorderThickness="1" Padding="12">
                    <DataGrid ItemsSource="{Binding DanhSachHienThi}" SelectedItem="{Binding DonDangChon}"
                              Style="{StaticResource StaylyDataGridStyle}"
                              AutoGenerateColumns="False" CanUserAddRows="False" CanUserResizeColumns="True" IsReadOnly="True"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#F1F5F9"
                              RowHeight="54"
                              ScrollViewer.CanContentScroll="True"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalAlignment="Stretch"
                              HorizontalAlignment="Stretch">
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#F8FAFC"/>
                                <Setter Property="Foreground" Value="#475569"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="FontSize" Value="12"/>
                                <Setter Property="Padding" Value="12,0"/>
                                <Setter Property="Height" Value="42"/>
                                <Setter Property="BorderThickness" Value="0,0,1,1"/>
                                <Setter Property="BorderBrush" Value="#E2E8F0"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>
                        <DataGrid.Columns>
                            <!-- Mã đơn -->
                            <DataGridTextColumn Header="MÃ ĐƠN" Binding="{Binding MaDonHienThi, Mode=OneWay}" Width="Auto" MinWidth="110">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="Foreground" Value="#0194F3"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Padding" Value="8,0"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Cơ sở Homestay -->
                            <DataGridTextColumn Header="CƠ SỞ HOMESTAY" Binding="{Binding TenCoSo, Mode=OneWay}" Width="*" MinWidth="220">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="Foreground" Value="#0F172A"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Padding" Value="8,0"/>
                                        <Setter Property="ToolTip" Value="{Binding TenCoSo}"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Chủ nhà -->
                            <DataGridTextColumn Header="CHỦ NHÀ" Binding="{Binding TenChuHome, Mode=OneWay}" Width="Auto" MinWidth="160">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#475569"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Padding" Value="8,0"/>
                                        <Setter Property="ToolTip" Value="{Binding TenChuHome}"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Check-out -->
                            <DataGridTextColumn Header="CHECK-OUT" Binding="{Binding NgayCheckOut, Mode=OneWay, StringFormat='{}{0:dd/MM/yyyy}'}" Width="Auto" MinWidth="115">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#64748B"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Padding" Value="8,0"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Khách trả -->
                            <DataGridTextColumn Header="KHÁCH TRẢ (100%)" Binding="{Binding TongTienDinhDang, Mode=OneWay}" Width="Auto" MinWidth="140">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="Foreground" Value="#0F172A"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Padding" Value="8,0"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Hoa hồng -->
                            <DataGridTextColumn Header="HOA HỒNG (15%)" Binding="{Binding HoaHongSanDinhDang, Mode=OneWay}" Width="Auto" MinWidth="135">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="Foreground" Value="#0194F3"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Padding" Value="8,0"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Trả Chủ (85%) -->
                            <DataGridTemplateColumn Header="TRẢ CHỦ (85%)" Width="Auto" MinWidth="140">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding TienChuHomeDinhDang}" FontWeight="Bold" Foreground="#0E9F6E" VerticalAlignment="Center" Padding="8,0"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Quyết toán -->
                            <DataGridTemplateColumn Header="QUYẾT TOÁN" Width="Auto" MinWidth="135">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="{Binding MauQuyetToan, Converter={StaticResource ColorToBrush}}"
                                                CornerRadius="6" Padding="8,3" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding TenHienThiQuyetToan}" Foreground="White" FontSize="11" FontWeight="Bold"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Thao tác mở hồ sơ / chi tiết quyết toán -->
                            <DataGridTemplateColumn Header="THAO TÁC" Width="Auto" MinWidth="135">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="💳 Quyết toán"
                                                Command="{Binding DataContext.XemHoSoCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource StaylyBtnSmall}"
                                                Background="{StaticResource MauStaylyPrimaryLight}"
                                                Foreground="{StaticResource MauStaylyPrimaryDark}"
                                                BorderThickness="0" FontWeight="Bold" FontSize="11" Padding="10,5"
                                                HorizontalAlignment="Center" VerticalAlignment="Center" Cursor="Hand"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

                <!-- CHI TIẾT NGÂN HÀNG & THAO TÁC QUYẾT TOÁN 85% (CHỈ HIỆN KHI CHỌN 1 ĐƠN) -->
                <Border Grid.Column="1" Width="460" Margin="14,0,0,0" Background="White" CornerRadius="12" BorderBrush="{StaticResource MauVien}" BorderThickness="1"
                        Visibility="{Binding DonDangChon, Converter={StaticResource NullToVis}, FallbackValue=Collapsed}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Header Drawer có nút [✕ Đóng] -->
                        <Border Grid.Row="0" BorderBrush="{StaticResource MauVien}" BorderThickness="0,0,0,1" Padding="18,14">
                            <DockPanel LastChildFill="True">
                                <Button DockPanel.Dock="Right" Command="{Binding DongHoSoCommand}"
                                        Content="✕ Đóng" ToolTip="Đóng chi tiết để xem danh sách toàn màn hình"
                                        Background="#F1F5F9" Foreground="#64748B" BorderThickness="0"
                                        FontWeight="Bold" FontSize="12" Padding="12,5" Cursor="Hand" Margin="8,0,0,0">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="6"/>
                                        </Style>
                                    </Button.Resources>
                                </Button>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="💳" FontSize="18" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="HỒ SƠ QUYẾT TOÁN 85%" FontSize="14.5" FontWeight="Bold" Foreground="{StaticResource MauChuTieuDe}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <Grid Grid.Row="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Khu vực thông tin cuộn -->
                            <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Padding="22,20,22,12">
                                <StackPanel>
                                    <TextBlock Text="THÔNG TIN CHUYỂN KHOẢN 85%" FontSize="14" FontWeight="Bold" Foreground="{StaticResource MauChuChinh}" Margin="0,0,0,14"/>

                                    <!-- Khối số tiền cần chuyển kiểu HomestaySystem Green Card -->
                                    <Border Background="#ECFDF5" BorderBrush="#A7F3D0" BorderThickness="1.5" CornerRadius="10" Padding="16" Margin="0,0,0,16">
                                        <StackPanel>
                                            <TextBlock Text="SỐ TIỀN CẦN CHUYỂN TRẢ (85%):" FontSize="12" FontWeight="Bold" Foreground="#047857"/>
                                            <TextBlock Text="{Binding DonDangChon.TienChuHomeDinhDang, FallbackValue='0 đ'}" FontSize="26" FontWeight="Black" Foreground="#047857" Margin="0,4,0,0"/>
                                            <TextBlock Text="{Binding DonDangChon.TongTienDinhDang, StringFormat='Tổng tiền khách đã trả trước: {0}'}" FontSize="12.5" Foreground="#475569" Margin="0,6,0,0"/>
                                            <TextBlock Text="{Binding DonDangChon.HoaHongSanDinhDang, StringFormat='Hoa hồng sàn giữ 15%: {0}'}" FontSize="12.5" Foreground="#0194F3" FontWeight="SemiBold" Margin="0,3,0,0"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Thông tin tài khoản thụ hưởng -->
                                    <Border Background="#F8FAFC" BorderBrush="{StaticResource MauVien}" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,16">
                                        <StackPanel>
                                            <TextBlock Text="TÀI KHOẢN NGÂN HÀNG THỤ HƯỞNG" FontSize="12.5" FontWeight="Bold" Foreground="#334155" Margin="0,0,0,12"/>

                                            <Grid Margin="0,0,0,9">
                                                <TextBlock Text="Chủ Homestay:" Foreground="#64748B" FontSize="13"/>
                                                <TextBlock Text="{Binding DonDangChon.TenChuHome}" FontWeight="Bold" Foreground="#1E293B" HorizontalAlignment="Right" FontSize="13.5"/>
                                            </Grid>
                                            <Grid Margin="0,0,0,9">
                                                <TextBlock Text="SĐT liên hệ:" Foreground="#64748B" FontSize="13"/>
                                                <TextBlock Text="{Binding DonDangChon.SoDienThoaiChuHome}" FontWeight="SemiBold" Foreground="#1E293B" HorizontalAlignment="Right" FontSize="13.5"/>
                                            </Grid>
                                            <Grid Margin="0,0,0,9">
                                                <TextBlock Text="Ngân hàng:" Foreground="#64748B" FontSize="13" VerticalAlignment="Top"/>
                                                <TextBlock Text="{Binding DonDangChon.TenNganHangChuHome, FallbackValue='Chưa cập nhật'}" FontWeight="SemiBold" Foreground="#0F172A" HorizontalAlignment="Right" FontSize="13" MaxWidth="260" TextWrapping="Wrap" TextAlignment="Right" ToolTip="{Binding DonDangChon.TenNganHangChuHome}"/>
                                            </Grid>
                                            <Grid Margin="0,0,0,9">
                                                <TextBlock Text="Số tài khoản:" Foreground="#64748B" FontSize="13"/>
                                                <TextBlock Text="{Binding DonDangChon.SoTaiKhoanNganHangChuHome, FallbackValue='---'}" FontWeight="Bold" Foreground="#0194F3" HorizontalAlignment="Right" FontSize="15"/>
                                            </Grid>
                                            <Grid>
                                                <TextBlock Text="Tên chủ TK:" Foreground="#64748B" FontSize="13"/>
                                                <TextBlock Text="{Binding DonDangChon.ChuTaiKhoanNganHangChuHome, FallbackValue='---'}" FontWeight="Bold" Foreground="#1E293B" HorizontalAlignment="Right" FontSize="13.5"/>
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <!-- ================= BẰNG CHỨNG QUYẾT TOÁN THÀNH CÔNG (KHI ĐÃ QUYẾT TOÁN) ================= -->
                                    <Border Background="#F0FDF4" BorderBrush="#86EFAC" BorderThickness="1.5" CornerRadius="10" Padding="16" Margin="0,0,0,8"
                                            Visibility="{Binding DonDangChon.TrangThaiQuyetToan, Converter={StaticResource StrCompareToVis}, ConverterParameter=DaQuyetToan}">
                                        <StackPanel>
                                            <TextBlock Text="✔ ĐÃ HOÀN TẤT GIẢI NGÂN (85%)" FontWeight="Bold" FontSize="12.5" Foreground="#15803D" Margin="0,0,0,10"/>
                                            <Grid Margin="0,0,0,8">
                                                <TextBlock Text="Mã GD ngân hàng:" Foreground="#475569" FontSize="13"/>
                                                <TextBlock Text="{Binding DonDangChon.MaGiaoDichQuyetToan, FallbackValue='---'}" FontWeight="Bold" Foreground="#0F172A" HorizontalAlignment="Right" FontSize="13.5"/>
                                            </Grid>
                                            <Grid Margin="0,0,0,8">
                                                <TextBlock Text="Thời gian quyết toán:" Foreground="#475569" FontSize="13"/>
                                                <TextBlock Text="{Binding DonDangChon.NgayQuyetToan, StringFormat='{}{0:dd/MM/yyyy HH:mm}', FallbackValue='---'}" FontWeight="SemiBold" Foreground="#0F172A" HorizontalAlignment="Right" FontSize="13"/>
                                            </Grid>
                                            <Grid>
                                                <TextBlock Text="Ghi chú đối soát:" Foreground="#475569" FontSize="13" VerticalAlignment="Top"/>
                                                <TextBlock Text="{Binding DonDangChon.GhiChuQuyetToan, FallbackValue='Không có ghi chú'}" FontWeight="Medium" Foreground="#475569" HorizontalAlignment="Right" FontSize="13" MaxWidth="260" TextWrapping="Wrap" TextAlignment="Right" ToolTip="{Binding DonDangChon.GhiChuQuyetToan}"/>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>

                            <!-- THANH THAO TÁC CỐ ĐỊNH Ở CHÂN CARD (KHÔNG BAO GIỜ BỊ CHE / KHUẤT) -->
                            <Border Grid.Row="1" Background="#F8FAFC" Padding="18,14" BorderBrush="{StaticResource MauVien}" BorderThickness="0,1,0,0" CornerRadius="0,0,12,12">
                                <Grid>
                                    <!-- Nút Xác nhận Quyết toán (khi CHƯA quyết toán) -->
                                    <Button Content="✔ Xác nhận đã chuyển tiền 85%" Command="{Binding MoDialogQuyetToanCommand}"
                                            Background="#0E9F6E" Foreground="White" FontWeight="Bold" FontSize="13.5" Padding="0,12"
                                            BorderThickness="0" Cursor="Hand" HorizontalAlignment="Stretch"
                                            Visibility="{Binding DonDangChon.TrangThaiQuyetToan, Converter={StaticResource StrCompareToVis}, ConverterParameter=ChuaQuyetToan}">
                                        <Button.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="8"/>
                                            </Style>
                                        </Button.Resources>
                                    </Button>

                                    <!-- Thông báo đã quyết toán xong (khi ĐÃ quyết toán) -->
                                    <Border Background="#E8F7EE" BorderBrush="#A7F3D0" BorderThickness="1" CornerRadius="8" Padding="12,10"
                                            Visibility="{Binding DonDangChon.TrangThaiQuyetToan, Converter={StaticResource StrCompareToVis}, ConverterParameter=DaQuyetToan}">
                                        <TextBlock Text="✔ Đơn này đã hoàn tất chuyển tiền 85% vào tài khoản Chủ nhà."
                                                   Foreground="#0E9F6E" FontWeight="Bold" FontSize="12.5" TextWrapping="Wrap" TextAlignment="Center"/>
                                    </Border>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- ================= POPUP DIALOG XÁC NHẬN QUYẾT TOÁN ================= -->
        <Grid Visibility="{Binding HienThiDialogXacNhan, Converter={StaticResource BoolToVis}}"
              HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <!-- Nền mờ: Nhấp chuột ra ngoài để đóng dialog -->
            <Border Background="#99000000" Cursor="Hand" ToolTip="Nhấp vào vùng ngoài để đóng">
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftClick" Command="{Binding HuyDialogQuyetToanCommand}"/>
                </Border.InputBindings>
            </Border>
            <Border Width="540" Background="White" CornerRadius="16" Padding="26" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" Opacity="0.25" BlurRadius="24" ShadowDepth="4"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="XÁC NHẬN ĐÃ QUYẾT TOÁN (CHUYỂN TRẢ 85%)" FontSize="16" FontWeight="Bold" Foreground="#0E9F6E"/>
                    <TextBlock Text="Vui lòng kiểm tra kỹ số tiền và nhập mã giao dịch ngân hàng để lưu vết đối soát:"
                               Foreground="#64748B" FontSize="13" Margin="0,6,0,16" TextWrapping="Wrap"/>

                    <Border Background="#F8FAFC" BorderBrush="{StaticResource MauVien}" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,16">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <TextBlock Text="Đơn đặt phòng:" Foreground="#64748B" FontSize="12.5"/>
                                <TextBlock Text="{Binding DonDangChon.MaDonHienThi}" FontWeight="Bold" Foreground="#1E293B" HorizontalAlignment="Right" FontSize="13"/>
                            </Grid>
                            <Grid Margin="0,0,0,8">
                                <TextBlock Text="Chủ nhận tiền:" Foreground="#64748B" FontSize="12.5"/>
                                <TextBlock Text="{Binding DonDangChon.TenChuHome}" FontWeight="SemiBold" Foreground="#1E293B" HorizontalAlignment="Right" FontSize="13"/>
                            </Grid>
                            <Grid>
                                <TextBlock Text="Số tiền chuyển trả (85%):" FontWeight="Bold" Foreground="#047857" FontSize="13"/>
                                <TextBlock Text="{Binding DonDangChon.TienChuHomeDinhDang}" FontWeight="Black" Foreground="#047857" HorizontalAlignment="Right" FontSize="17"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Mã giao dịch ngân hàng / Ủy nhiệm chi (* Bắt buộc):" FontWeight="Bold" FontSize="12.5" Foreground="#64748B" Margin="0,0,0,5"/>
                    <Border Background="#F1F5F9" CornerRadius="8" Padding="12,7" Margin="0,0,0,14" BorderBrush="{StaticResource MauVien}" BorderThickness="1">
                        <TextBox Text="{Binding MaGiaoDichNhap, UpdateSourceTrigger=PropertyChanged}" BorderThickness="0" Background="Transparent" FontSize="13.5" Foreground="{StaticResource MauChuChinh}"/>
                    </Border>

                    <TextBlock Text="Ghi chú đối soát:" FontWeight="Bold" FontSize="12.5" Foreground="#64748B" Margin="0,0,0,5"/>
                    <Border Background="#F1F5F9" CornerRadius="8" Padding="12,7" BorderBrush="{StaticResource MauVien}" BorderThickness="1">
                        <TextBox Text="{Binding GhiChuNhap, UpdateSourceTrigger=PropertyChanged}" Height="70" TextWrapping="Wrap" AcceptsReturn="True"
                                 BorderThickness="0" Background="Transparent" FontSize="13.5" Foreground="{StaticResource MauChuChinh}"/>
                    </Border>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                        <Button Content="Hủy bỏ" Command="{Binding HuyDialogQuyetToanCommand}" Padding="20,9" Margin="0,0,12,0"
                                Background="#F1F5F9" Foreground="#64748B" FontWeight="SemiBold" FontSize="13" BorderThickness="0" Cursor="Hand" MinWidth="100">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="8"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                        <Button Content="✔ Xác nhận hoàn tất quyết toán" Command="{Binding XacNhanQuyetToanCommand}" Padding="22,9"
                                Background="#0E9F6E" Foreground="White" FontWeight="Bold" FontSize="13" BorderThickness="0" Cursor="Hand" MinWidth="220">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="8"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
