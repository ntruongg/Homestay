        // ==================== RESUBMIT REJECTED MODAL OPENER ====================
        async function openResubmitModal(propId) {
            try {
                const res = await fetch(`/Home/GetPropertyDetailsJson?id=${propId}`);
                if (!res.ok) throw new Error('Không thể tải dữ liệu cơ sở.');
                const data = await res.json();
                populateAndOpenResubmitModal(data);
            } catch (err) {
                alert('Lỗi: ' + err.message);
            }
        }

        function populateAndOpenResubmitModal(data) {
            document.getElementById('resubmitPropId').value = data.id;
            document.getElementById('resubmitRejectionReasonText').textContent = data.rejectionReason || 'Vui lòng bổ sung đầy đủ thông tin hoặc hồ sơ pháp lý hợp lệ.';
            document.getElementById('resubmitName').value = data.name || '';
            document.getElementById('resubmitType').value = data.type || 'Homestay';
            document.getElementById('resubmitPhone').value = data.phone || '';
            document.getElementById('resubmitEmail').value = data.email || '';
            document.getElementById('resubmitAddress').value = data.address || '';
            document.getElementById('resubmitWard').value = data.ward || '';
            document.getElementById('resubmitCity').value = data.city || '';
            document.getElementById('resubmitPolicy').value = data.policy || '';

            const isHomestay = (data.type || '').toLowerCase() === 'homestay';
            const homestayPanel = document.getElementById('resubmitHomestayPanel');
            if (isHomestay) {
                if (homestayPanel) homestayPanel.classList.remove('d-none');
                if (data.homestayPrice) document.getElementById('resubmitHomestayPrice').value = data.homestayPrice;
                if (data.homestayCapacity) document.getElementById('resubmitHomestayCapacity').value = data.homestayCapacity;
                if (data.homestayRoomTypeId) document.getElementById('resubmitHomestayRoomTypeId').value = data.homestayRoomTypeId;
            } else {
                if (homestayPanel) homestayPanel.classList.add('d-none');
            }

            // Old document links
            const docBL = document.getElementById('resubmitOldBusinessLicenseLink');
            if (docBL) docBL.innerHTML = data.businessLicenseUrl ? `<a href="${data.businessLicenseUrl}" target="_blank" class="text-primary text-decoration-underline"><i class="bi bi-file-earmark-check me-1"></i>Tệp đã nộp</a>` : 'Chưa có tệp';

            const docFS = document.getElementById('resubmitOldFireSafetyLink');
            if (docFS) docFS.innerHTML = data.fireSafetyDocumentUrl ? `<a href="${data.fireSafetyDocumentUrl}" target="_blank" class="text-primary text-decoration-underline"><i class="bi bi-file-earmark-check me-1"></i>Tệp đã nộp</a>` : 'Chưa có tệp';

            const docSEC = document.getElementById('resubmitOldSecurityLink');
            if (docSEC) docSEC.innerHTML = data.securityDocumentUrl ? `<a href="${data.securityDocumentUrl}" target="_blank" class="text-primary text-decoration-underline"><i class="bi bi-file-earmark-check me-1"></i>Tệp đã nộp</a>` : 'Chưa có tệp';

            // Checkboxes amenities
            const activeIds = (data.amenities || []).map(a => a.id);
            document.querySelectorAll('.resubmit-amenity-cb').forEach(cb => {
                cb.checked = activeIds.includes(Number(cb.value));
            });

            // Close details modal if open
            const opdModalEl = document.getElementById('ownerPropertyDetailsModal');
            const opdModal = bootstrap.Modal.getInstance(opdModalEl);
            if (opdModal) opdModal.hide();

            const resubmitModal = new bootstrap.Modal(document.getElementById('resubmitPropertyModal'));
            resubmitModal.show();
        }

        // ==================== ADD ROOM MODAL ====================
        function openAddRoomModal(propertyId, propertyName) {
            document.getElementById('addRoomPropertyId').value = propertyId;
            document.getElementById('addRoomPropertyName').textContent = propertyName;

            const modal = new bootstrap.Modal(document.getElementById('addRoomModal'));
            modal.show();
        }

        // ==================== APPROVAL HISTORY TIMELINE ====================
        async function viewApprovalHistory(propId, propName) {
            const modalEl = document.getElementById('approvalHistoryModal');
            const timelineEl = document.getElementById('approvalHistoryTimeline');
            const modal = new bootstrap.Modal(modalEl);
            modal.show();

            timelineEl.innerHTML = '<div class="text-center py-4 text-muted small">Đang tải lịch sử...</div>';

            try {
                const res = await fetch(`/Home/PropertyApprovalHistory?id=${propId}`);
                if (!res.ok) throw new Error('Không thể tải lịch sử.');
                const history = await res.json();

                if (!Array.isArray(history) || history.length === 0) {
                    timelineEl.innerHTML = '<div class="text-center py-4 text-muted small">Chưa có bản ghi lịch sử xét duyệt nào.</div>';
                    return;
                }

                let html = '<div class="d-flex flex-column gap-3">';
                history.forEach(item => {
                    const isApproved = item.action === 'Approved' || item.status === 'Approved';
                    const isRejected = item.action === 'Rejected' || item.status === 'Rejected';
                    const badgeClass = isApproved ? 'bg-success' : isRejected ? 'bg-danger' : 'bg-warning text-dark';

                    html += `
                        <div class="p-3 bg-light rounded-4 border-start border-4 ${isApproved ? 'border-success' : isRejected ? 'border-danger' : 'border-warning'}">
                            <div class="d-flex align-items-center justify-content-between mb-1">
                                <span class="badge ${badgeClass} rounded-pill px-3 py-1">${item.action || item.status || 'Xét duyệt'}</span>
                                <small class="text-muted">${item.reviewDate ? new Date(item.reviewDate).toLocaleString('vi-VN') : ''}</small>
                            </div>
                            <div class="small text-muted mt-1">Người thẩm định: <strong>${item.reviewerName || 'Ban Quản trị Stayly'}</strong></div>
                            ${item.reason ? `<div class="small text-dark mt-2 p-2 bg-white rounded-3">Ghi chú: "${item.reason}"</div>` : ''}
                        </div>
                    `;
                });
                html += '</div>';
                timelineEl.innerHTML = html;
            } catch (err) {
                timelineEl.innerHTML = `<div class="text-danger text-center small py-3">${err.message}</div>`;
            }
        }

        // ==================== FILTER BOOKINGS ====================
        function filterBookingsList() {
            const propFilter = document.getElementById('filterBookingProperty').value;
            const statusFilter = document.getElementById('filterBookingStatus').value;
            const cards = document.querySelectorAll('#bookingCardsContainer .booking-item-card');
            let visibleCount = 0;

            cards.forEach(card => {
                const cardProp = card.getAttribute('data-property') || '';
                const cardStatus = card.getAttribute('data-status') || '';

                const matchProp = (propFilter === 'all' || cardProp === propFilter);
                const matchStatus = (statusFilter === 'all' || cardStatus.toLowerCase() === statusFilter.toLowerCase());

                if (matchProp && matchStatus) {
                    card.style.display = 'block';
                    visibleCount++;
                } else {
                    card.style.display = 'none';
                }
            });

            const countIndicator = document.getElementById('bookingCountIndicator');
            if (countIndicator) {
                countIndicator.innerHTML = `Hiển thị: <strong>${visibleCount}</strong> đơn đặt phòng`;
            }
        }

        // ==================== FILTER REVIEWS ====================
        function filterReviewsList() {
            const propFilter = document.getElementById('filterReviewProperty').value;
            const dateFilter = document.getElementById('filterReviewDate').value;
            const cards = document.querySelectorAll('#reviewCardsContainer .review-item-card');
            let visibleCount = 0;

            cards.forEach(card => {
                const cardProp = card.getAttribute('data-property') || '';
                const cardDate = card.getAttribute('data-date') || '';

                const matchProp = (propFilter === 'all' || cardProp === propFilter);
                const matchDate = (!dateFilter || cardDate === dateFilter);

                if (matchProp && matchDate) {
                    card.style.display = 'block';
                    visibleCount++;
                } else {
                    card.style.display = 'none';
                }
            });

            const countEl = document.getElementById('reviewTotalCount');
            if (countEl) countEl.textContent = visibleCount;
        }

        function clearReviewDateFilter() {
            const dateInput = document.getElementById('filterReviewDate');
            if (dateInput) {
                dateInput.value = '';
                filterReviewsList();
            }
        }

        // ==================== BOOKING DETAIL MODAL ====================
        async function openBookingDetailModal(button) {
            const card = button.closest('.booking-item-card');
            if (!card) return;

            const bookingId = card.getAttribute('data-id');

            document.getElementById('modalBookingId').textContent = `Chi tiết đơn #${bookingId}`;
            document.getElementById('modalGuestName').textContent = card.getAttribute('data-guest') || '';
            document.getElementById('modalGuestPhone').textContent = card.getAttribute('data-phone') || '';
            document.getElementById('modalGuestEmail').textContent = card.getAttribute('data-email') || '';
            document.getElementById('modalPropertyName').textContent = `${card.getAttribute('data-property')} (${card.getAttribute('data-rooms')})`;
            document.getElementById('modalGuestCount').textContent = `${card.getAttribute('data-guests')} người`;
            document.getElementById('modalStayDates').textContent = `${card.getAttribute('data-checkin')} → ${card.getAttribute('data-checkout')}`;
            document.getElementById('modalBaseAmount').textContent = card.getAttribute('data-amount') || '';
            document.getElementById('modalTotalAmount').textContent = card.getAttribute('data-amount') || '';

            const modal = new bootstrap.Modal(document.getElementById('bookingDetailModal'));
            modal.show();

            try {
                const res = await fetch(`/Home/GetBookingDetailJson?id=${bookingId}`);
                if (res.ok) {
                    const result = await res.json();
                    if (result.success && result.data) {
                        const d = result.data;
                        document.getElementById('modalGuestName').textContent = d.guestName || card.getAttribute('data-guest');
                        if (d.guestPhone) document.getElementById('modalGuestPhone').textContent = d.guestPhone;
                        if (d.guestEmail) document.getElementById('modalGuestEmail').textContent = d.guestEmail;
                        if (d.basePrice != null) document.getElementById('modalBaseAmount').textContent = Number(d.basePrice).toLocaleString('vi-VN') + ' ₫';
                        if (d.totalAmount != null) document.getElementById('modalTotalAmount').textContent = Number(d.totalAmount).toLocaleString('vi-VN') + ' ₫';
                    }
                }
            } catch (e) {
                // ignore
            }
        }

        // ==================== REPLY REVIEW ====================
        function openReplyReviewModal(reviewId, guestName, propName) {
            document.getElementById('replyReviewId').value = reviewId;
            document.getElementById('replyGuestName').textContent = guestName;
            document.getElementById('replyPropertyName').textContent = propName;
            document.getElementById('replyReviewMessage').value = '';
            document.getElementById('replyAlertBox').classList.add('d-none');

            const modal = new bootstrap.Modal(document.getElementById('replyReviewModal'));
            modal.show();
        }

        async function submitReviewReply() {
            const reviewId = document.getElementById('replyReviewId').value;
            const message = document.getElementById('replyReviewMessage').value.trim();
            const alertBox = document.getElementById('replyAlertBox');
            const btn = document.getElementById('btnSubmitReply');

            if (!message) {
                alertBox.className = 'alert alert-danger small rounded-pill py-2 text-center mb-3';
                alertBox.textContent = 'Vui lòng nhập nội dung phản hồi.';
                alertBox.classList.remove('d-none');
                return;
            }

            btn.disabled = true;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> Đang gửi...';

            try {
                const response = await fetch('/Home/ReplyReview', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ reviewId: Number(reviewId), message })
                });

                const data = await response.json();
                if (response.ok && data.success) {
                    alertBox.className = 'alert alert-success small rounded-pill py-2 text-center mb-3';
                    alertBox.textContent = data.message || 'Phản hồi đánh giá thành công!';
                    alertBox.classList.remove('d-none');
                    setTimeout(() => window.location.reload(), 900);
                } else {
                    alertBox.className = 'alert alert-danger small rounded-pill py-2 text-center mb-3';
                    alertBox.textContent = data.message || 'Không thể gửi phản hồi.';
                    alertBox.classList.remove('d-none');
                }
            } catch (err) {
                alertBox.className = 'alert alert-danger small rounded-pill py-2 text-center mb-3';
                alertBox.textContent = 'Lỗi kết nối máy chủ: ' + err.message;
                alertBox.classList.remove('d-none');
            } finally {
                btn.disabled = false;
                btn.innerHTML = '<i class="bi bi-send-fill me-1"></i> Gửi phản hồi';
            }
        }

        function handleDashboardLogout() {
            localStorage.removeItem('guestUser');
            localStorage.removeItem('guestToken');
        }

        function escapeJs(str) {
            if (!str) return '';
            return str.replace(/'/g, "\\'").replace(/"/g, '\\"');
        }
    </script>
</body>
</html>
