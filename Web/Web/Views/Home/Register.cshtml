@model RegisterGuestInput

@{
    var isPartner = ViewBag.IsPartner is true;
    ViewData["Title"] = isPartner ? "Đăng ký chủ cơ sở lưu trú - Stayly" : "Đăng ký thành viên - Stayly";
}

<section class="py-5" style="background-color: var(--stayly-bg); min-height: calc(100vh - 200px);">
    <div class="container" style="max-width: 580px;">
        <div class="card border-0 p-4 p-md-5" style="border-radius: 16px; box-shadow: 0 10px 30px rgba(0, 119, 182, 0.08); background: #ffffff;">
            <div class="text-center mb-4">
                <span class="badge rounded-pill px-3 py-2 mb-2" style="background-color: var(--stayly-light-accent); color: var(--stayly-primary); font-weight: 700; font-size: 0.8rem; letter-spacing: 0.05em; text-transform: uppercase;">
                    @(isPartner ? "Đối tác chủ nhà Stayly" : "Chào mừng đến với Stayly")
                </span>
                <h2 class="fw-bold text-navy mb-1" style="font-size: 1.65rem;">
                    @(isPartner ? "Đăng ký chủ cơ sở lưu trú" : "Tạo tài khoản khách hàng")
                </h2>
                <p class="text-muted small">
                    @(isPartner ? "Mở rộng kinh doanh homestay & khách sạn cùng hàng triệu khách hàng Stayly." : "Trải nghiệm kỳ nghỉ dưỡng tuyệt vời cùng ngập tràn ưu đãi độc quyền.")
                </p>
            </div>

            <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-4 py-2 px-3 small mb-3"></div>

            @if (isPartner)
            {
                <form id="registerForm" asp-action="RegisterOwner" method="post">
                    <partial name="_OwnerRegistrationFields" model="Model" />
                    
                    <div class="form-check mb-3 mt-3 text-start">
                        <input class="form-check-input" type="checkbox" id="agreeTermsPartner">
                        <label class="form-check-label small text-muted" for="agreeTermsPartner">
                            Tôi đã đọc và đồng ý với <a asp-controller="Home" asp-action="PartnerPolicy" target="_blank" class="fw-bold text-primary text-decoration-none">điều khoản và chính sách</a> của hệ thống
                        </label>
                        <div id="agreeTermsPartnerError" class="text-danger small mt-1 d-none"></div>
                    </div>
                    
                    @Html.AntiForgeryToken()

                    <button id="submitRegisterBtn" class="btn btn-primary w-100 rounded-pill py-2 mt-2 fw-bold shadow-sm" type="submit" style="background-color: var(--stayly-primary); border: none;">
                        <i class="bi bi-shield-lock-fill me-1"></i> Đăng ký chủ cơ sở lưu trú
                    </button>
                </form>
            }
            else
            {
                <form id="registerForm" asp-action="Register" asp-route-partner="false" method="post">
                    <partial name="_GuestRegistrationFields" model="Model" />
                    @Html.AntiForgeryToken()

                    <button id="submitRegisterBtn" class="btn btn-primary w-100 rounded-pill py-2 mt-3 fw-bold shadow-sm" type="submit" style="background-color: var(--stayly-primary); border: none;">
                        <i class="bi bi-person-check-fill me-1"></i> Tạo tài khoản khách hàng
                    </button>
                </form>
            }

            <div class="text-center mt-4 pt-3 border-top">
                <p class="small text-muted mb-2">
                    @(isPartner ? "Bạn muốn đặt phòng nghỉ dưỡng?" : "Bạn muốn kinh doanh cơ sở lưu trú?")
                    <a asp-action="Register" asp-route-partner="@(!isPartner)" class="fw-bold text-primary text-decoration-none">
                        @(isPartner ? "Đăng ký tài khoản khách" : "Đăng ký làm đối tác chủ nhà") &rarr;
                    </a>
                </p>
                <p class="small text-muted mb-0">
                    Đã có tài khoản Stayly?
                    <a href="javascript:void(0)" onclick="bootstrap.Modal.getOrCreateInstance(document.getElementById('authModal')).show();" class="fw-bold text-navy text-decoration-none">
                        Đăng nhập ngay
                    </a>
                </p>
            </div>
        </div>
    </div>
</section>

<!-- Modern OTP Verification Popup Modal -->
<div id="otpModalBackdrop" class="otp-backdrop" style="display: none;">
    <div class="otp-modal-box">
        <button type="button" class="otp-close-btn" id="closeOtpModalBtn" aria-label="Đóng">&times;</button>
        
        <div class="otp-icon-header">
            <div class="otp-shield-icon">
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                    <path d="m9 12 2 2 4-4"/>
                </svg>
            </div>
            <h3>Xác thực mã OTP</h3>
            <p class="otp-subtitle">
                Chúng tôi đã gửi mã xác thực gồm 6 chữ số đến email:
                <br/><strong id="otpEmailDisplay" style="color: #0f172a; word-break: break-all;"></strong>
            </p>
        </div>

        <div id="otpModalAlert" class="otp-alert" style="display: none;"></div>

        <div class="otp-input-wrapper">
            <label for="otpCodeEntry" class="otp-input-label">Nhập 6 chữ số OTP</label>
            <input type="text"
                   id="otpCodeEntry"
                   maxlength="6"
                   pattern="\d{6}"
                   inputmode="numeric"
                   autocomplete="one-time-code"
                   placeholder="· · · · · ·"
                   class="otp-digit-input" />
        </div>

        <div class="otp-timer-row">
            <span>Mã hết hạn trong: <strong id="otpCountdown">10:00</strong></span>
        </div>

        <div class="otp-actions">
            <button type="button" id="confirmOtpBtn" class="button otp-confirm-btn">
                Xác nhận & Hoàn tất đăng ký
            </button>

            <button type="button" id="resendOtpBtn" class="otp-resend-btn" disabled>
                Chưa nhận được mã? <span id="resendText">Gửi lại (60s)</span>
            </button>
        </div>
    </div>
</div>

<style>
    .otp-backdrop {
        position: fixed;
        top: 0;
        left: 0;
        width: 100vw;
        height: 100vh;
        background: rgba(15, 23, 42, 0.65);
        backdrop-filter: blur(6px);
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 99999;
        padding: 16px;
        animation: fadeIn 0.2s ease-out;
    }

    .otp-modal-box {
        background: #ffffff;
        border-radius: 20px;
        max-width: 440px;
        width: 100%;
        padding: 32px 28px 28px;
        position: relative;
        box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25);
        text-align: center;
        animation: popUp 0.25s cubic-bezier(0.16, 1, 0.3, 1);
        border: 1px solid #e2e8f0;
    }

    .otp-close-btn {
        position: absolute;
        top: 16px;
        right: 18px;
        background: transparent;
        border: none;
        font-size: 26px;
        line-height: 1;
        color: #94a3b8;
        cursor: pointer;
        transition: color 0.15s;
    }
    .otp-close-btn:hover {
        color: #334155;
    }

    .otp-icon-header {
        margin-bottom: 20px;
    }

    .otp-shield-icon {
        width: 56px;
        height: 56px;
        background: var(--stayly-light-accent);
        color: var(--stayly-primary);
        border-radius: 50%;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 12px;
        box-shadow: 0 0 0 8px #f8fafc;
    }

    .otp-icon-header h3 {
        margin: 0 0 8px 0;
        font-size: 21px;
        font-weight: 700;
        color: var(--stayly-navy);
    }

    .otp-subtitle {
        margin: 0;
        font-size: 14px;
        line-height: 1.5;
        color: #64748b;
    }

    .otp-alert {
        background: #fef2f2;
        color: #991b1b;
        border: 1px solid #fecaca;
        border-radius: 8px;
        padding: 10px 14px;
        font-size: 13px;
        margin-bottom: 16px;
        text-align: left;
    }

    .otp-input-wrapper {
        margin: 20px 0 12px;
    }

    .otp-input-label {
        display: block;
        font-size: 12px;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        color: #64748b;
        margin-bottom: 8px;
    }

    .otp-digit-input {
        width: 100%;
        box-sizing: border-box;
        text-align: center;
        font-family: 'Courier New', Courier, monospace;
        font-size: 34px;
        font-weight: 800;
        letter-spacing: 12px;
        padding: 12px 8px 12px 20px;
        border: 2px solid #cbd5e1;
        border-radius: 12px;
        outline: none;
        color: var(--stayly-navy);
        background: #f8fafc;
        transition: border-color 0.2s, box-shadow 0.2s;
    }

    .otp-digit-input:focus {
        border-color: var(--stayly-primary);
        box-shadow: 0 0 0 3px rgba(0, 119, 182, 0.18);
        background: #ffffff;
    }

    .otp-timer-row {
        font-size: 13px;
        color: #64748b;
        margin-bottom: 20px;
    }

    .otp-timer-row strong {
        color: var(--stayly-primary);
    }

    .otp-actions {
        display: flex;
        flex-direction: column;
        gap: 10px;
    }

    .otp-confirm-btn {
        width: 100%;
        padding: 12px;
        font-size: 15px;
        font-weight: 600;
        border-radius: 50px;
        background: var(--stayly-primary);
        color: #ffffff;
        border: none;
        cursor: pointer;
        transition: all 0.2s ease;
    }
    .otp-confirm-btn:hover {
        background: var(--stayly-primary-hover);
    }

    .otp-resend-btn {
        background: transparent;
        border: none;
        font-size: 13px;
        color: #64748b;
        cursor: pointer;
        padding: 6px;
    }
    .otp-resend-btn:not([disabled]) {
        color: #2563eb;
        font-weight: 600;
    }
    .otp-resend-btn[disabled] {
        cursor: not-allowed;
        color: #94a3b8;
    }

    @@keyframes fadeIn {
        from { opacity: 0; }
        to { opacity: 1; }
    }
    @@keyframes popUp {
        from { opacity: 0; transform: scale(0.95); }
        to { opacity: 1; transform: scale(1); }
    }
</style>

@section Scripts {
<script>
    (function () {
        const form = document.getElementById('registerForm');
        const submitBtn = document.getElementById('submitRegisterBtn');
        const otpModal = document.getElementById('otpModalBackdrop');
        const closeBtn = document.getElementById('closeOtpModalBtn');
        const confirmBtn = document.getElementById('confirmOtpBtn');
        const resendBtn = document.getElementById('resendOtpBtn');
        const resendText = document.getElementById('resendText');
        const otpInput = document.getElementById('otpCodeEntry');
        const otpEmailDisplay = document.getElementById('otpEmailDisplay');
        const otpCountdown = document.getElementById('otpCountdown');
        const otpAlert = document.getElementById('otpModalAlert');

        let countdownInterval = null;
        let resendInterval = null;
        let countdownSeconds = 600; // 10 minutes
        let resendCooldown = 60;

        if (!form) return;

        function setFieldError(fieldId, errorId, message) {
            const field = document.getElementById(fieldId);
            const errEl = document.getElementById(errorId);
            if (field) {
                field.classList.add('is-invalid');
            }
            if (errEl) {
                errEl.textContent = message;
                errEl.classList.add('show');
            }
        }

        function clearFieldError(fieldId, errorId) {
            const field = document.getElementById(fieldId);
            const errEl = document.getElementById(errorId);
            if (field) {
                field.classList.remove('is-invalid');
            }
            if (errEl) {
                errEl.textContent = '';
                errEl.classList.remove('show');
            }
        }

        const monitoredFields = [
            'FullNameInput', 'PhoneInput', 'EmailInput', 'PasswordInput',
            'CitizenIdInput', 'BankNameInput', 'AccountNumberInput', 'AccountHolderInput'
        ];

        monitoredFields.forEach(id => {
            const el = document.getElementById(id);
            if (el) {
                el.addEventListener('input', () => clearFieldError(id, id + 'Error'));
                el.addEventListener('change', () => clearFieldError(id, id + 'Error'));
            }
        });
        
        const agreeCb = document.getElementById('agreeTermsPartner');
        if (agreeCb) {
            agreeCb.addEventListener('change', () => {
                const errEl = document.getElementById('agreeTermsPartnerError');
                if (errEl) errEl.classList.add('d-none');
            });
        }

        form.addEventListener('submit', async function (e) {
            const hiddenOtp = document.getElementById('OtpCodeInput');
            if (hiddenOtp && hiddenOtp.value && hiddenOtp.value.trim().length === 6) {
                // OTP already entered and confirmed, allow form to submit
                return true;
            }

            e.preventDefault();

            // Clear previous errors
            monitoredFields.forEach(id => clearFieldError(id, id + 'Error'));

            let hasError = false;
            let firstInvalidEl = null;

            function markInvalid(fieldId, errorId, message) {
                setFieldError(fieldId, errorId, message);
                hasError = true;
                if (!firstInvalidEl) {
                    firstInvalidEl = document.getElementById(fieldId);
                }
            }

            // 1. FullName
            const fullNameEl = document.getElementById('FullNameInput');
            const fullName = fullNameEl ? fullNameEl.value.trim() : '';
            const nameRegex = /^[a-zA-ZÀÁÂÃÈÉÊÌÍÒÓÔÕÙÚĂĐĨŨƠàáâãèéêìíòóôõùúăđĩũơƯĂẠẢẤẦẨẪẬẮẰẲẴẶẸẺẼỀỀỂưăạảấầẩẫậắằẳẵặẹẻẽềềểỄỆỈỊỌỎỐỒỔỖỘỚỜỞỠỢỤỦỨỪễệỉịọỏốồổỗộớờởỡợụủứừỬỮỰỲỴÝỶỸửữựỳỵỷỹ\s]+$/;
            if (!fullName || !nameRegex.test(fullName)) {
                markInvalid('FullNameInput', 'FullNameInputError', 'Họ tên bắt buộc và chỉ chứa chữ cái, khoảng trắng.');
            }

            // 1.5 DateOfBirth
            const dobEl = document.getElementById('DateOfBirthInput');
            const dob = dobEl ? dobEl.value : '';
            if (!dob) {
                markInvalid('DateOfBirthInput', 'DateOfBirthInputError', 'Vui lòng chọn ngày sinh.');
            }

            // 2. Phone
            const phoneEl = document.getElementById('PhoneInput');
            const phone = phoneEl ? phoneEl.value.trim() : '';
            const phoneRegex = /^(0[35789])[0-9]{8}$/;
            if (!phone || !phoneRegex.test(phone)) {
                markInvalid('PhoneInput', 'PhoneInputError', 'Số điện thoại không hợp lệ (10 chữ số, bắt đầu bằng 03, 05, 07, 08 hoặc 09).');
            }

            // 3. Email
            const emailEl = document.getElementById('EmailInput');
            const email = emailEl ? emailEl.value.trim().toLowerCase() : '';
            const emailRegex = /^[^\s@@]+@@[^\s@@]+\.[^\s@@]+$/;
            if (!email || !emailRegex.test(email)) {
                markInvalid('EmailInput', 'EmailInputError', 'Địa chỉ email không đúng định dạng.');
            }

            // 4. Password
            const passwordEl = document.getElementById('PasswordInput');
            const password = passwordEl ? passwordEl.value : '';
            if (!password || password.length < 8) {
                markInvalid('PasswordInput', 'PasswordInputError', 'Mật khẩu phải có tối thiểu 8 ký tự.');
            }

            // 5. Owner fields (if present)
            const citizenIdEl = document.getElementById('CitizenIdInput');
            if (citizenIdEl) {
                const citizenId = citizenIdEl.value.trim();
                if (!citizenId || citizenId.length < 9) {
                    markInvalid('CitizenIdInput', 'CitizenIdInputError', 'Vui lòng nhập số CCCD / định danh cá nhân hợp lệ (9 - 12 chữ số).');
                }

                const bankNameEl = document.getElementById('BankNameInput');
                if (bankNameEl && !bankNameEl.value.trim()) {
                    markInvalid('BankNameInput', 'BankNameInputError', 'Vui lòng nhập tên ngân hàng thụ hưởng.');
                }

                const accountNoEl = document.getElementById('AccountNumberInput');
                const accNoRegex = /^\d{6,20}$/;
                if (accountNoEl && (!accountNoEl.value.trim() || !accNoRegex.test(accountNoEl.value.trim()))) {
                    markInvalid('AccountNumberInput', 'AccountNumberInputError', 'Số tài khoản bắt buộc và chỉ chứa 6-20 chữ số.');
                }

                const accountHolderEl = document.getElementById('AccountHolderInput');
                if (accountHolderEl && (!accountHolderEl.value.trim() || !nameRegex.test(accountHolderEl.value.trim()))) {
                    markInvalid('AccountHolderInput', 'AccountHolderInputError', 'Tên chủ tài khoản bắt buộc và chỉ chứa chữ cái.');
                }
                
                // Validate checkbox
                const agreeCb = document.getElementById('agreeTermsPartner');
                if (agreeCb && !agreeCb.checked) {
                    const errEl = document.getElementById('agreeTermsPartnerError');
                    if (errEl) {
                        errEl.textContent = 'Bạn cần đồng ý với điều khoản và chính sách để tiếp tục.';
                        errEl.classList.remove('d-none');
                    }
                    hasError = true;
                    if (!firstInvalidEl) firstInvalidEl = agreeCb;
                }
            }

            if (hasError) {
                if (firstInvalidEl) {
                    firstInvalidEl.scrollIntoView({ behavior: 'smooth', block: 'center' });
                    firstInvalidEl.focus();
                }
                return;
            }

            // 6. Check database uniqueness for Email and Phone
            const originalBtnText = submitBtn.textContent;
            submitBtn.disabled = true;
            submitBtn.textContent = 'Đang kiểm tra thông tin...';

            try {
                const checkRes = await fetch(`/Home/CheckContactAvailability?email=${encodeURIComponent(email)}&phone=${encodeURIComponent(phone)}`);
                if (checkRes.ok) {
                    const checkData = await checkRes.json();
                    if (checkData.emailExists) {
                        markInvalid('EmailInput', 'EmailInputError', 'Địa chỉ email này đã được sử dụng trên hệ thống.');
                    }
                    if (checkData.phoneExists) {
                        markInvalid('PhoneInput', 'PhoneInputError', 'Số điện thoại này đã được sử dụng trên hệ thống.');
                    }
                }
            } catch (err) {
                // If network check fails, allow continuing
            }

            if (hasError) {
                submitBtn.disabled = false;
                submitBtn.textContent = originalBtnText;
                if (firstInvalidEl) {
                    firstInvalidEl.scrollIntoView({ behavior: 'smooth', block: 'center' });
                    firstInvalidEl.focus();
                }
                return;
            }

            // 7. Trigger OTP sending
            submitBtn.textContent = 'Đang gửi mã OTP...';

            try {
                const response = await fetch('/Home/RequestRegisterOtp', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({ email: email, fullName: fullName, purpose: 'Register' })
                });

                const data = await response.json();

                if (!response.ok) {
                    alert(data.message || 'Không thể gửi mã OTP. Vui lòng thử lại.');
                    return;
                }

                // Show modal
                otpEmailDisplay.textContent = email;
                showOtpModal();
            } catch (err) {
                alert('Lỗi kết nối khi gửi mã OTP. Vui lòng kiểm tra lại mạng hoặc thử lại sau.');
            } finally {
                submitBtn.disabled = false;
                submitBtn.textContent = originalBtnText;
            }
        });

        function showOtpModal() {
            otpModal.style.display = 'flex';
            otpInput.value = '';
            otpAlert.style.display = 'none';
            otpInput.focus();

            startCountdown();
            startResendCooldown();
        }

        function hideOtpModal() {
            otpModal.style.display = 'none';
            clearInterval(countdownInterval);
            clearInterval(resendInterval);
        }

        closeBtn.addEventListener('click', hideOtpModal);

        otpModal.addEventListener('click', function (e) {
            if (e.target === otpModal) {
                hideOtpModal();
            }
        });

        // Auto format and only allow digits
        otpInput.addEventListener('input', function () {
            this.value = this.value.replace(/\D/g, '').slice(0, 6);
            if (this.value.length === 6) {
                confirmBtn.focus();
            }
        });

        otpInput.addEventListener('keydown', function (e) {
            if (e.key === 'Enter') {
                e.preventDefault();
                confirmBtn.click();
            }
        });

        confirmBtn.addEventListener('click', async function () {
            const code = otpInput.value.trim();
            if (code.length !== 6) {
                showModalError('Vui lòng nhập đủ 6 chữ số mã OTP.');
                otpInput.focus();
                return;
            }

            confirmBtn.disabled = true;
            confirmBtn.textContent = 'Đang xác thực & tạo tài khoản...';

            const fullName = (document.getElementById('FullNameInput')?.value || '').trim();
            const phone = (document.getElementById('PhoneInput')?.value || '').trim();
            const email = (document.getElementById('EmailInput')?.value || '').trim();
            const password = document.getElementById('PasswordInput')?.value || '';
            const dob = document.getElementById('DateOfBirthInput')?.value || null;
            const gender = document.getElementById('GenderInput')?.value || 'M';

            const isPartner = @(isPartner ? "true" : "false");
            const endpoint = isPartner ? '/Home/AjaxRegisterOwner' : '/Home/AjaxRegisterGuest';

            const payload = {
                fullName,
                phone,
                email,
                password,
                dateOfBirth: dob,
                gender,
                otpCode: code
            };

            if (isPartner) {
                payload.citizenId = (document.getElementById('CitizenIdInput')?.value || '').trim();
                payload.bankName = (document.getElementById('BankNameInput')?.value || '').trim();
                payload.accountNumber = (document.getElementById('AccountNumberInput')?.value || '').trim();
                payload.accountHolder = (document.getElementById('AccountHolderInput')?.value || '').trim();
            }

            try {
                const response = await fetch(endpoint, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });

                const data = await response.json();

                if (response.ok && data.success) {
                    localStorage.setItem('guestUser', JSON.stringify(data.user));
                    if (data.token) {
                        localStorage.setItem('guestToken', data.token);
                    }

                    showModalSuccess('Chúc mừng! Tài khoản đã được tạo thành công.');
                    setTimeout(() => {
                        window.location.href = isPartner ? '/Home/Dashboard' : '/';
                    }, 1200);
                } else {
                    showModalError(data.message || 'Mã xác thực OTP không chính xác hoặc thông tin không hợp lệ.');
                    confirmBtn.disabled = false;
                    confirmBtn.textContent = 'Xác nhận & Hoàn tất';
                }
            } catch (err) {
                showModalError('Lỗi kết nối máy chủ khi hoàn tất đăng ký.');
                confirmBtn.disabled = false;
                confirmBtn.textContent = 'Xác nhận & Hoàn tất';
            }
        });

        resendBtn.addEventListener('click', async function () {
            if (resendBtn.disabled) return;

            const emailInput = document.getElementById('EmailInput') || form.querySelector('input[type="email"]');
            const fullNameInput = document.getElementById('FullNameInput') || form.querySelector('input[name="FullName"]');

            const email = emailInput ? emailInput.value.trim() : '';
            const fullName = fullNameInput ? fullNameInput.value.trim() : '';

            resendBtn.disabled = true;
            resendText.textContent = 'Đang gửi...';

            try {
                const response = await fetch('/Home/RequestRegisterOtp', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ email: email, fullName: fullName, purpose: 'Register' })
                });

                const data = await response.json();
                if (!response.ok) {
                    showModalError(data.message || 'Không thể gửi lại mã OTP.');
                    resendBtn.disabled = false;
                    resendText.textContent = 'Gửi lại ngay';
                    return;
                }

                showModalSuccess('Mã OTP mới đã được gửi tới email của bạn!');
                startCountdown();
                startResendCooldown();
            } catch (err) {
                showModalError('Lỗi kết nối khi gửi lại mã OTP.');
                resendBtn.disabled = false;
                resendText.textContent = 'Gửi lại ngay';
            }
        });

        function showModalError(msg) {
            otpAlert.style.display = 'block';
            otpAlert.style.background = '#fef2f2';
            otpAlert.style.color = '#991b1b';
            otpAlert.style.borderColor = '#fecaca';
            otpAlert.textContent = msg;
        }

        function showModalSuccess(msg) {
            otpAlert.style.display = 'block';
            otpAlert.style.background = '#f0fdf4';
            otpAlert.style.color = '#15803d';
            otpAlert.style.borderColor = '#bbf7d0';
            otpAlert.textContent = msg;
        }

        function startCountdown() {
            clearInterval(countdownInterval);
            countdownSeconds = 600;
            updateCountdownDisplay();

            countdownInterval = setInterval(function () {
                countdownSeconds--;
                if (countdownSeconds <= 0) {
                    clearInterval(countdownInterval);
                    otpCountdown.textContent = '00:00 (Hết hạn)';
                    showModalError('Mã OTP đã hết hiệu lực. Vui lòng bấm "Gửi lại" để nhận mã mới.');
                    return;
                }
                updateCountdownDisplay();
            }, 1000);
        }

        function updateCountdownDisplay() {
            const minutes = Math.floor(countdownSeconds / 60);
            const seconds = countdownSeconds % 60;
            otpCountdown.textContent = `${minutes.toString().padStart(2, '0')}:${seconds.toString().padStart(2, '0')}`;
        }

        function startResendCooldown() {
            clearInterval(resendInterval);
            resendCooldown = 60;
            resendBtn.disabled = true;
            resendText.textContent = `Gửi lại (${resendCooldown}s)`;

            resendInterval = setInterval(function () {
                resendCooldown--;
                if (resendCooldown <= 0) {
                    clearInterval(resendInterval);
                    resendBtn.disabled = false;
                    resendText.textContent = 'Gửi lại mã';
                    return;
                }
                resendText.textContent = `Gửi lại (${resendCooldown}s)`;
            }, 1000);
        }
    })();
</script>
}
