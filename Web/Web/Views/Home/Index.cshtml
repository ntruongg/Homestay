@{
    ViewBag.Title = "Trang chủ - Đặt phòng";
}
<div class="hero-section text-center">
    <div class="container">
        <h1 class="display-4 fw-bold mb-4">Tìm chỗ nghỉ hoàn hảo của bạn</h1>
        <div class="search-box mx-auto" style="max-width: 800px;">
            <div class="row g-2">
                <div class="col-md-4"><input type="text" class="form-control" placeholder="Bạn muốn đến đâu?"></div>
                <div class="col-md-3"><input type="date" class="form-control" title="Ngày nhận"></div>
                <div class="col-md-3"><input type="date" class="form-control" title="Ngày trả"></div>
                <div class="col-md-2"><button class="btn btn-primary w-100" onclick="search()"><i class="bi bi-search"></i> Tìm</button></div>
            </div>
        </div>
    </div>
</div>

<div class="container my-5" id="searchResults">
    <h3 class="mb-4">Khám phá nổi bật</h3>
    <div class="row g-4">
        <!-- Item Homestay -->
        <div class="col-md-4">
            <div class="card h-100 shadow-sm">
                <img src="https://source.unsplash.com/400x300/?homestay" class="card-img-top" alt="Homestay">
                <div class="card-body">
                    <h5 class="card-title">Chill Homestay Đà Lạt</h5>
                    <p class="text-muted small">Homestay nguyên căn • Sức chứa 6 người</p>
                    <button class="btn btn-outline-dark w-100" onclick="viewDetail('Homestay')">Xem chi tiết</button>
                </div>
            </div>
        </div>
        <!-- Item Khách sạn -->
        <div class="col-md-4">
            <div class="card h-100 shadow-sm">
                <img src="https://source.unsplash.com/400x300/?hotel" class="card-img-top" alt="Hotel">
                <div class="card-body">
                    <h5 class="card-title">Luxury Hotel Nha Trang</h5>
                    <p class="text-muted small">Khách sạn • Đa dạng loại phòng</p>
                    <button class="btn btn-outline-dark w-100" onclick="viewDetail('Hotel')">Xem phòng</button>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="detailModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalTitle">Chi tiết</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="modalContent">
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-success px-4" onclick="initiateBooking()">ĐẶT NGAY</button>
            </div>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script>
document.addEventListener("DOMContentLoaded", () => {
    const user = JSON.parse(localStorage.getItem('guestUser'));
    if (user) {
        document.getElementById('authArea').style.display = 'none';
        document.getElementById('userArea').style.display = 'block';
        document.getElementById('userNameDisplay').innerText = `Chào, ${user.HoTen}`;
    }
});

function viewDetail(type) {
    const modal = new bootstrap.Modal(document.getElementById('detailModal'));
    const content = document.getElementById('modalContent');
    document.getElementById('modalTitle').innerText = type === 'Homestay' ? 'Chi tiết Homestay' : 'Danh sách phòng Khách sạn';

    if (type === 'Homestay') {
        content.innerHTML = `
            <div id="galleryCarousel" class="carousel slide mb-3" data-bs-ride="carousel">
                <div class="carousel-inner rounded">
                    <div class="carousel-item active"><img src="https://source.unsplash.com/800x400/?livingroom" class="d-block w-100 gallery-img"></div>
                    <div class="carousel-item"><img src="https://source.unsplash.com/800x400/?bedroom" class="d-block w-100 gallery-img"></div>
                </div>
                <button class="carousel-control-prev" type="button" data-bs-target="#galleryCarousel" data-bs-slide="prev"><span class="carousel-control-prev-icon"></span></button>
                <button class="carousel-control-next" type="button" data-bs-target="#galleryCarousel" data-bs-slide="next"><span class="carousel-control-next-icon"></span></button>
            </div>
            <h5>Tiện nghi:</h5>
            <ul><li>Wifi miễn phí</li><li>Bếp nướng BBQ</li><li>View hồ</li></ul>
        `;
    } else {
        content.innerHTML = `
            <div class="room-item" onclick="viewRoomDetail()">
                <div class="row align-items-center">
                    <div class="col-4"><img src="https://source.unsplash.com/200x150/?hotel,bed" class="img-fluid rounded"></div>
                    <div class="col-8">
                        <h5>Phòng Deluxe Hướng Biển</h5>
                        <p class="mb-1 text-muted">2 người lớn • 1 giường King</p>
                        <span class="text-danger fw-bold">1,200,000 VND / đêm</span>
                    </div>
                </div>
            </div>
            <div class="room-item" onclick="viewRoomDetail()">
                <div class="row align-items-center">
                    <div class="col-4"><img src="https://source.unsplash.com/200x150/?hotel,room" class="img-fluid rounded"></div>
                    <div class="col-8">
                        <h5>Phòng Standard</h5>
                        <p class="mb-1 text-muted">2 người lớn • 2 giường đơn</p>
                        <span class="text-danger fw-bold">800,000 VND / đêm</span>
                    </div>
                </div>
            </div>
        `;
    }
    modal.show();
}

function viewRoomDetail() {
    document.getElementById('modalTitle').innerText = 'Chi tiết Phòng Deluxe';
    document.getElementById('modalContent').innerHTML = `
        <div id="roomCarousel" class="carousel slide mb-3" data-bs-ride="carousel">
            <div class="carousel-inner rounded">
                <div class="carousel-item active"><img src="https://source.unsplash.com/800x400/?hotel,bed" class="d-block w-100 gallery-img"></div>
                <div class="carousel-item"><img src="https://source.unsplash.com/800x400/?bathroom" class="d-block w-100 gallery-img"></div>
            </div>
            <button class="carousel-control-prev" type="button" data-bs-target="#roomCarousel" data-bs-slide="prev"><span class="carousel-control-prev-icon"></span></button>
            <button class="carousel-control-next" type="button" data-bs-target="#roomCarousel" data-bs-slide="next"><span class="carousel-control-next-icon"></span></button>
        </div>
        <p>Phòng rộng 40m2, ban công nhìn ra biển, trang bị bồn tắm nằm...</p>
    `;
}

function initiateBooking() {
    const user = localStorage.getItem('guestUser');
    if (!user) {
        alert("Vui lòng đăng nhập tài khoản Khách hàng để tiếp tục đặt phòng.");
        return;
    }
    alert("Đang chuyển đến trang thanh toán...");
}

function openAuthModal(type) {
    // Redirect tới file Login.cshtml bạn đã làm ở bước trước
    // Hoặc mở form Modal tại đây
    window.location.href = '/Home/Login';
}

function logout() {
    localStorage.removeItem('guestUser');
    window.location.reload();
}
</script>
