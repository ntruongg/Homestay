@model IReadOnlyList<Booking>

@{
    ViewData["Title"] = "Đơn đặt phòng của tôi";
}

<div class="container py-5">
    <div class="row mb-4">
        <div class="col-12 text-center">
            <h1 class="fw-bold text-navy mb-2"><i class="bi bi-journal-bookmark-fill me-2 text-primary"></i>Đơn đặt phòng của tôi</h1>
            <p class="text-muted">Theo dõi và quản lý các chuyến đi của bạn</p>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-4 shadow-sm mb-4" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-4 shadow-sm mb-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="row g-4 justify-content-center">
        <div class="col-lg-9">
            @if (!Model.Any())
            {
                <div class="text-center py-5 bg-light rounded-4 border-0 shadow-sm">
                    <i class="bi bi-box-seam display-1 text-muted mb-3 d-block"></i>
                    <h4 class="text-navy">Chưa có đơn đặt phòng nào</h4>
                    <p class="text-muted mb-4">Bạn chưa thực hiện bất kỳ chuyến đi nào cùng Stayly.</p>
                    <a href="/" class="btn btn-primary rounded-pill px-4 py-2 fw-semibold">Khám phá ngay</a>
                </div>
            }
            else
            {
                @foreach (var booking in Model)
                {
                    string badgeClass = booking.Status switch
                    {
                        "ChoThanhToan" => "bg-warning-subtle text-warning-emphasis border border-warning",
                        "Pending" or "ChoDuyet" => "bg-warning text-dark",
                        "Confirmed" or "DaDuyet" => "bg-info text-dark",
                        "CheckedIn" or "DangLuuTru" => "bg-primary",
                        "Completed" or "DaHoanTat" => "bg-success",
                        "Cancelled" or "DaHuy" => "bg-danger",
                        "RefundRequested" or "YeuCauHoanTien" => "bg-warning text-dark",
                        "Refunded" or "DaHoanTien" => "bg-secondary",
                        _ => "bg-secondary"
                    };

                    string statusText = booking.Status switch
                    {
                        "ChoThanhToan" => "Chờ thanh toán",
                        "Pending" or "ChoDuyet" => "Chờ chủ duyệt",
                        "Confirmed" or "DaDuyet" => "Đã xác nhận",
                        "CheckedIn" or "DangLuuTru" => "Đang lưu trú",
                        "Completed" or "DaHoanTat" => "Đã hoàn tất",
                        "Cancelled" or "DaHuy" => "Đã huỷ",
                        "RefundRequested" or "YeuCauHoanTien" => "Chờ duyệt hoàn tiền",
                        "Refunded" or "DaHoanTien" => "Đã hoàn tiền",
                        _ => booking.Status
                    };

                    bool canCancel = booking.Status is "Pending" or "ChoDuyet" or "Confirmed" or "DaDuyet" or "ChoThanhToan";
                    bool canRequestRefund = (booking.Status is "Confirmed" or "DaDuyet") && (DateTime.UtcNow.Date <= booking.CheckIn.Date.AddDays(-2));
                    bool canReview = booking.Status is "Completed" or "DaHoanTat"
                        || ((booking.Status is "Confirmed" or "DaDuyet") && DateTime.UtcNow.Date >= booking.CheckOut.Date);

                    var propTitle = !string.IsNullOrWhiteSpace(booking.PropertyName) ? booking.PropertyName : "Homestay nghỉ dưỡng";
                    var roomsText = booking.RoomNumbers != null && booking.RoomNumbers.Any() 
                        ? string.Join(", ", booking.RoomNumbers.Select(r => "Phòng " + r)) 
                        : "Phòng: " + string.Join(", ", booking.RoomIds);
                    var imageUrl = !string.IsNullOrWhiteSpace(booking.PropertyImage) 
                        ? booking.PropertyImage 
                        : "https://images.unsplash.com/photo-1587061949409-02df41d5e562?auto=format&fit=crop&w=600&q=80";

                    <div class="card border-0 shadow-sm rounded-4 mb-4 overflow-hidden">
                        <div class="card-header bg-white border-bottom-0 pt-4 pb-0 px-4 d-flex justify-content-between align-items-center">
                            <span class="fw-bold text-muted small"><i class="bi bi-receipt me-1"></i> Mã đơn: #@booking.Id</span>
                            <span class="badge @badgeClass rounded-pill px-3 py-2 fw-semibold">@statusText</span>
                        </div>
                        <div class="card-body p-4">
                            <div class="row align-items-center">
                                <div class="col-md-3 mb-3 mb-md-0">
                                    <img src="@imageUrl" alt="@propTitle" class="img-fluid rounded-4 shadow-sm w-100 object-fit-cover" style="aspect-ratio: 16 / 10; height: auto; object-fit: cover;" />
                                </div>
                                <div class="col-md-5 mb-3 mb-md-0">
                                    <h5 class="fw-bold text-navy mb-1">@propTitle</h5>
                                    <div class="text-primary small fw-semibold mb-2"><i class="bi bi-door-open-fill me-1"></i>@roomsText</div>
                                    <div class="d-flex align-items-center text-muted small mb-1">
                                        <i class="bi bi-calendar2-check me-2 text-primary"></i>
                                        <span>@booking.CheckIn.ToString("dd/MM/yyyy") - @booking.CheckOut.ToString("dd/MM/yyyy")</span>
                                    </div>
                                    <div class="d-flex align-items-center text-muted small mb-2">
                                        <i class="bi bi-people me-2 text-primary"></i>
                                        <span>@booking.Adults người lớn, @booking.Children trẻ em</span>
                                    </div>
                                    
                                    @if (!string.IsNullOrEmpty(booking.PromoCode))
                                    {
                                        <div class="d-inline-flex align-items-center bg-light text-success rounded-pill px-3 py-1 fw-semibold small">
                                            <i class="bi bi-tag-fill me-1"></i> Mã @booking.PromoCode (-@booking.DiscountAmount.ToString("N0") ₫)
                                        </div>
                                    }
                                </div>
                                <div class="col-md-4 text-md-end">
                                    <div class="text-muted small mb-1">Tổng thanh toán</div>
                                    <h4 class="fw-bold text-primary mb-3">@booking.TotalAmount.ToString("N0") ₫</h4>
                                    
                                    <div class="d-flex flex-wrap gap-2 justify-content-md-end">
                                        @if (booking.Status == "ChoThanhToan")
                                        {
                                            <a href="/Home/Checkout?bookingId=@booking.Id" class="btn btn-primary btn-sm rounded-pill px-3">
                                                <i class="bi bi-credit-card-2-front me-1"></i> Thanh toán ngay
                                            </a>
                                            <button type="button" class="btn btn-outline-danger btn-sm rounded-pill px-3" onclick="confirmCancelBooking(@booking.Id)">
                                                <i class="bi bi-x-circle me-1"></i> Hủy đơn
                                            </button>
                                        }
                                        else if (booking.Status is "Pending" or "ChoDuyet")
                                        {
                                            <button type="button" class="btn btn-outline-danger btn-sm rounded-pill px-3" onclick="openRefundModal(@booking.Id, '@propTitle', true, @booking.TotalAmount)">
                                                <i class="bi bi-x-circle me-1"></i> Hủy đơn &amp; Hoàn tiền
                                            </button>
                                        }
                                        else if (canRequestRefund)
                                        {
                                            <button type="button" class="btn btn-outline-warning text-dark btn-sm rounded-pill px-3" onclick="openRefundModal(@booking.Id, '@propTitle', false, @booking.TotalAmount)">
                                                <i class="bi bi-arrow-counterclockwise me-1"></i> Hoàn tiền
                                            </button>
                                        }

                                        @if (booking.HasReviewed)
                                        {
                                            <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-3 py-2 fw-semibold">
                                                <i class="bi bi-star-fill text-warning me-1"></i> Đã đánh giá (@(booking.ReviewRating ?? 5)⭐)
                                            </span>
                                        }
                                        else if (canReview)
                                        {
                                            <button type="button" class="btn btn-warning text-dark btn-sm rounded-pill px-3 fw-semibold shadow-sm" onclick="openReviewModal(@booking.Id, '@propTitle')">
                                                <i class="bi bi-star-fill me-1"></i> Đánh giá
                                            </button>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            }
        </div>
    </div>
</div>

<!-- Modal Hủy đơn đặt phòng -->
<div class="modal fade" id="cancelBookingModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow">
            <div class="modal-header border-bottom-0 pb-0">
                <h5 class="modal-title fw-bold text-danger"><i class="bi bi-exclamation-triangle-fill me-2"></i>Xác nhận hủy đơn</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="CancelBooking" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="bookingId" id="cancelBookingId" value="" />
                <div class="modal-body py-3">
                    <p class="text-muted mb-0">Bạn có chắc chắn muốn hủy đơn đặt phòng này? Hành động này không thể hoàn tác.</p>
                </div>
                <div class="modal-footer border-top-0 pt-0">
                    <button type="button" class="btn btn-light rounded-pill px-3" data-bs-dismiss="modal">Đóng</button>
                    <button type="submit" class="btn btn-danger rounded-pill px-4 fw-semibold">Xác nhận hủy</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal Yêu cầu hoàn tiền & Thông tin ngân hàng -->
<div class="modal fade" id="refundBookingModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow">
            <div class="modal-header border-bottom-0 pb-0">
                <h5 class="modal-title fw-bold text-navy">
                    <i class="bi bi-cash-stack me-2 text-warning"></i>
                    <span id="refundModalTitleText">Yêu cầu hoàn tiền</span>
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="RequestRefund" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="bookingId" id="refundBookingId" value="" />
                <div class="modal-body py-3">
                    <p class="text-muted small mb-2">Đơn đặt phòng: <strong id="refundPropTitle" class="text-navy"></strong></p>
                    <div id="refundNotice" class="alert alert-info py-2 px-3 small rounded-3 mb-3">
                        <i class="bi bi-info-circle me-1"></i> Chính sách: Yêu cầu hoàn tiền chỉ được chấp nhận trước ngày nhận phòng tối thiểu 2 ngày. Quản trị viên sẽ xét duyệt trong 24 giờ.
                    </div>

                    <div class="p-3 mb-3 rounded-4 bg-light border">
                        <div class="fw-bold text-navy small mb-2 d-flex align-items-center gap-1">
                            <i class="bi bi-bank text-primary"></i>
                            <span>Tài khoản ngân hàng nhận tiền hoàn</span>
                        </div>
                        <div class="row g-2">
                            <div class="col-md-12">
                                <label class="form-label small text-muted mb-1">Ngân hàng thụ hưởng <span class="text-danger">*</span></label>
                                <select name="bankName" id="refundBankName" class="form-select rounded-pill px-3 py-2" required>
                                    <option value="">-- Chọn ngân hàng hỗ trợ --</option>
                                    <option value="Vietcombank (VCB)">Vietcombank (Ngân hàng Ngoại thương)</option>
                                    <option value="VietinBank (CTG)">VietinBank (Ngân hàng Công thương)</option>
                                    <option value="BIDV">BIDV (Đầu tư và Phát triển)</option>
                                    <option value="Agribank">Agribank (Nông nghiệp &amp; PTNT)</option>
                                    <option value="MB Bank (Ngân hàng Quân Đội)">MB Bank (Ngân hàng Quân Đội)</option>
                                    <option value="Techcombank (TCB)">Techcombank (Kỹ thương)</option>
                                    <option value="ACB (Ngân hàng Á Châu)">ACB (Ngân hàng Á Châu)</option>
                                    <option value="VPBank">VPBank (Việt Nam Thịnh Vượng)</option>
                                    <option value="TPBank (Tiên Phong)">TPBank (Tiên Phong)</option>
                                    <option value="Sacombank">Sacombank (Sài Gòn Thương Tín)</option>
                                    <option value="HDBank">HDBank (Phát triển TP.HCM)</option>
                                    <option value="VIB (Quốc Tế)">VIB (Quốc tế Việt Nam)</option>
                                    <option value="SHB">SHB (Sài Gòn - Hà Nội)</option>
                                    <option value="SeABank">SeABank (Đông Nam Á)</option>
                                    <option value="OCB (Phương Đông)">OCB (Phương Đông)</option>
                                    <option value="MSB (Hàng Hải)">MSB (Hàng Hải)</option>
                                    <option value="Eximbank">Eximbank (Xuất Nhập Khẩu)</option>
                                    <option value="Nam A Bank">Nam A Bank (Nam Á)</option>
                                    <option value="LPBank (Lộc Phát VN)">LPBank (Lộc Phát Việt Nam)</option>
                                    <option value="BaoViet Bank">BaoViet Bank (Bảo Việt)</option>
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small text-muted mb-1">Số tài khoản <span class="text-danger">*</span></label>
                                <input type="text" name="accountNumber" id="refundAccountNumber" class="form-control rounded-pill px-3 py-2" placeholder="Ví dụ: 1012345678" required />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small text-muted mb-1">Tên chủ tài khoản <span class="text-danger">*</span></label>
                                <input type="text" name="accountHolder" id="refundAccountHolder" class="form-control rounded-pill px-3 py-2" placeholder="Ví dụ: NGUYEN VAN A" required />
                            </div>
                        </div>
                    </div>

                    <div class="mb-2">
                        <label class="form-label small fw-bold text-navy">Lý do yêu cầu hủy / hoàn tiền <span class="text-danger">*</span></label>
                        <textarea name="reason" class="form-control rounded-3" rows="2" required placeholder="Nhập chi tiết lý do (thay đổi lịch trình, sức khỏe, việc đột xuất,...)"></textarea>
                    </div>
                </div>
                <div class="modal-footer border-top-0 pt-0">
                    <button type="button" class="btn btn-light rounded-pill px-3" data-bs-dismiss="modal">Hủy bỏ</button>
                    <button type="submit" class="btn btn-warning rounded-pill px-4 fw-semibold">Gửi yêu cầu hoàn tiền</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal Đánh giá kỳ nghỉ -->
<div class="modal fade" id="reviewModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow">
            <div class="modal-header border-bottom-0 pb-0">
                <h5 class="modal-title fw-bold text-navy"><i class="bi bi-star-half me-2 text-warning"></i>Đánh giá kỳ nghỉ của bạn</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="submitReviewForm" onsubmit="submitGuestReview(event)">
                <input type="hidden" id="reviewBookingId" value="" />
                <div class="modal-body py-3">
                    <p class="text-muted small mb-2">Kỳ nghỉ tại: <strong id="reviewPropTitle" class="text-navy"></strong></p>
                    <div class="mb-3 text-center">
                        <label class="form-label small fw-bold text-navy d-block">Mức độ hài lòng</label>
                        <div class="d-inline-flex gap-2 fs-3 text-warning cursor-pointer" id="starRatingContainer">
                            <i class="bi bi-star-fill star-item" data-val="1" onclick="setRating(1)"></i>
                            <i class="bi bi-star-fill star-item" data-val="2" onclick="setRating(2)"></i>
                            <i class="bi bi-star-fill star-item" data-val="3" onclick="setRating(3)"></i>
                            <i class="bi bi-star-fill star-item" data-val="4" onclick="setRating(4)"></i>
                            <i class="bi bi-star-fill star-item" data-val="5" onclick="setRating(5)"></i>
                        </div>
                        <input type="hidden" id="reviewRatingVal" value="5" />
                        <div class="text-muted small mt-1" id="ratingTextDesc">5/5 - Rất hài lòng</div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold text-navy">Nhận xét chi tiết</label>
                        <textarea id="reviewComment" class="form-control rounded-3" rows="3" required placeholder="Chia sẻ cảm nhận về phòng ở, dịch vụ, thái độ của chủ nhà..."></textarea>
                    </div>
                </div>
                <div class="modal-footer border-top-0 pt-0">
                    <button type="button" class="btn btn-light rounded-pill px-3" data-bs-dismiss="modal">Đóng</button>
                    <button type="submit" id="btnSubmitReview" class="btn btn-primary rounded-pill px-4 fw-semibold">Gửi đánh giá</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    function confirmCancelBooking(bookingId) {
        document.getElementById('cancelBookingId').value = bookingId;
        new bootstrap.Modal(document.getElementById('cancelBookingModal')).show();
    }

    function openRefundModal(bookingId, propTitle, isPendingApproval, amount) {
        document.getElementById('refundBookingId').value = bookingId;
        document.getElementById('refundPropTitle').textContent = propTitle;

        const noticeEl = document.getElementById('refundNotice');
        const titleTextEl = document.getElementById('refundModalTitleText');

        if (isPendingApproval) {
            if (titleTextEl) titleTextEl.textContent = 'Hủy đơn & Nhận hoàn tiền 100%';
            if (noticeEl) {
                noticeEl.className = 'alert alert-success py-2 px-3 small rounded-3 mb-3';
                noticeEl.innerHTML = `<i class="bi bi-check-circle me-1"></i> Đơn của bạn đang chờ chủ duyệt. Bạn được hoàn lại <strong>100% số tiền (${Number(amount || 0).toLocaleString('vi-VN')} ₫)</strong>. Vui lòng cung cấp tài khoản ngân hàng để Quản trị viên chuyển trả tiền.`;
            }
        } else {
            if (titleTextEl) titleTextEl.textContent = 'Yêu cầu hoàn tiền';
            if (noticeEl) {
                noticeEl.className = 'alert alert-info py-2 px-3 small rounded-3 mb-3';
                noticeEl.innerHTML = '<i class="bi bi-info-circle me-1"></i> Chính sách: Yêu cầu hoàn tiền chỉ được chấp nhận trước ngày nhận phòng tối thiểu 2 ngày. Quản trị viên sẽ xét duyệt trong 24 giờ.';
            }
        }

        // Tự động điền thông tin ngân hàng nếu khách đã lưu trong hồ sơ cá nhân
        const defaultBank = '@(ViewBag.GuestBankName ?? "")';
        const defaultAcc = '@(ViewBag.GuestAccountNumber ?? "")';
        const defaultHolder = '@(ViewBag.GuestAccountHolder ?? "")';
        const bankEl = document.getElementById('refundBankName');
        const accEl = document.getElementById('refundAccountNumber');
        const holderEl = document.getElementById('refundAccountHolder');
        if (bankEl) bankEl.value = defaultBank || '';
        if (accEl) accEl.value = defaultAcc || '';
        if (holderEl) holderEl.value = defaultHolder || '';

        new bootstrap.Modal(document.getElementById('refundBookingModal')).show();
    }

    function openReviewModal(bookingId, propTitle) {
        document.getElementById('reviewBookingId').value = bookingId;
        document.getElementById('reviewPropTitle').textContent = propTitle;
        setRating(5);
        document.getElementById('reviewComment').value = '';
        new bootstrap.Modal(document.getElementById('reviewModal')).show();
    }

    function setRating(val) {
        document.getElementById('reviewRatingVal').value = val;
        const stars = document.querySelectorAll('#starRatingContainer .star-item');
        stars.forEach((s, idx) => {
            if (idx < val) {
                s.classList.remove('bi-star');
                s.classList.add('bi-star-fill');
            } else {
                s.classList.remove('bi-star-fill');
                s.classList.add('bi-star');
            }
        });
        const descs = ['1/5 - Kém', '2/5 - Tạm được', '3/5 - Bình thường', '4/5 - Hài lòng', '5/5 - Rất hài lòng'];
        document.getElementById('ratingTextDesc').textContent = descs[val - 1];
    }

    async function submitGuestReview(e) {
        e.preventDefault();
        const bookingId = parseInt(document.getElementById('reviewBookingId').value);
        const rating = parseInt(document.getElementById('reviewRatingVal').value);
        const comment = document.getElementById('reviewComment').value.trim();

        const btn = document.getElementById('btnSubmitReview');
        btn.disabled = true;
        btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> Đang gửi...';

        try {
            const res = await fetch('/Home/CreateReviewAjax', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    bookingId: bookingId,
                    rating: rating,
                    comment: comment
                })
            });

            const data = await res.json();
            if (data.success) {
                alert(data.message || 'Cảm ơn bạn đã gửi đánh giá!');
                bootstrap.Modal.getInstance(document.getElementById('reviewModal')).hide();
                window.location.reload();
            } else {
                alert(data.error || 'Không thể gửi đánh giá.');
            }
        } catch (err) {
            alert('Lỗi kết nối: ' + err.message);
        } finally {
            btn.disabled = false;
            btn.textContent = 'Gửi đánh giá';
        }
    }
</script>

