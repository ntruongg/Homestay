@model API.DTOs.Email.PropertySubmissionEmailModel

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Hồ sơ cơ sở lưu trú đã được gửi xét duyệt</title>
</head>
<body style="margin: 0; padding: 0; background-color: #f8fafc; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; color: #1e293b;">
    <table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="background-color: #f8fafc; padding: 32px 16px;">
        <tr>
            <td align="center">
                <table role="presentation" width="100%" style="max-width: 580px; background-color: #ffffff; border-radius: 16px; overflow: hidden; box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05); border: 1px solid #e2e8f0;">
                    <!-- Header -->
                    <tr>
                        <td style="background: linear-gradient(135deg, #0284c7 0%, #0369a1 100%); padding: 32px 32px 28px; text-align: center;">
                            <h1 style="margin: 0; font-size: 26px; font-weight: 800; color: #ffffff; letter-spacing: -0.5px;">STAYLY</h1>
                            <p style="margin: 6px 0 0; color: #bae6fd; font-size: 14px; font-weight: 500;">Cổng Đối tác Cho thuê Homestay</p>
                        </td>
                    </tr>

                    <!-- Body -->
                    <tr>
                        <td style="padding: 36px 32px 28px;">
                            <div style="display: inline-block; background-color: #e0f2fe; color: #0369a1; padding: 4px 12px; border-radius: 9999px; font-size: 12px; font-weight: 700; margin-bottom: 16px; text-transform: uppercase;">
                                Đang chờ duyệt
                            </div>
                            <h2 style="margin: 0 0 16px; font-size: 20px; font-weight: 700; color: #0f172a;">Đã tiếp nhận hồ sơ đăng ký cơ sở</h2>
                            <p style="margin: 0 0 16px; font-size: 15px; line-height: 1.6; color: #475569;">
                                Xin chào đối tác <strong>@Model.OwnerName</strong>,
                            </p>
                            <p style="margin: 0 0 20px; font-size: 15px; line-height: 1.6; color: #475569;">
                                Chúng tôi đã nhận được hồ sơ đăng ký cơ sở lưu trú của bạn trên hệ thống Stayly. Đội ngũ kiểm duyệt đang tiến hành thẩm định thông tin và giấy tờ pháp lý.
                            </p>

                            <!-- Property Details Card -->
                            <div style="background-color: #f8fafc; border-radius: 12px; padding: 20px; border: 1px solid #e2e8f0; margin: 20px 0;">
                                <table role="presentation" width="100%" cellspacing="0" cellpadding="6">
                                    <tr>
                                        <td width="35%" style="color: #64748b; font-size: 14px; font-weight: 500;">Mã hồ sơ:</td>
                                        <td width="65%" style="color: #0f172a; font-size: 14px; font-weight: 700;">#@Model.ReferenceId</td>
                                    </tr>
                                    <tr>
                                        <td style="color: #64748b; font-size: 14px; font-weight: 500;">Tên cơ sở:</td>
                                        <td style="color: #0f172a; font-size: 14px; font-weight: 700;">@Model.PropertyName</td>
                                    </tr>
                                    <tr>
                                        <td style="color: #64748b; font-size: 14px; font-weight: 500;">Loại hình:</td>
                                        <td style="color: #0f172a; font-size: 14px;">@Model.PropertyType</td>
                                    </tr>
                                    <tr>
                                        <td style="color: #64748b; font-size: 14px; font-weight: 500;">Địa chỉ:</td>
                                        <td style="color: #0f172a; font-size: 14px;">@(Model.PropertyAddress ?? "Chưa cập nhật")</td>
                                    </tr>
                                    <tr>
                                        <td style="color: #64748b; font-size: 14px; font-weight: 500;">Ngày nộp đơn:</td>
                                        <td style="color: #0f172a; font-size: 14px;">@Model.SubmissionDate.ToString("dd/MM/yyyy HH:mm")</td>
                                    </tr>
                                </table>
                            </div>

                            <!-- Timeline Notice -->
                            <div style="background-color: #f0fdf4; border-left: 4px solid #16a34a; padding: 14px 16px; border-radius: 4px; margin: 24px 0;">
                                <p style="margin: 0; font-size: 13px; line-height: 1.5; color: #166534;">
                                    <strong>Thời gian phản hồi dự kiến:</strong> Quá trình xét duyệt thường diễn ra trong vòng <strong>24 - 48 giờ làm việc</strong>. Chúng tôi sẽ gửi email thông báo kết quả ngay khi quá trình kiểm tra hoàn tất.
                                </p>
                            </div>

                            <p style="margin: 24px 0 0; font-size: 14px; line-height: 1.6; color: #64748b;">
                                Bạn có thể theo dõi trạng thái phê duyệt trong trang Quản lý cơ sở lưu trú của Đối tác.
                            </p>
                        </td>
                    </tr>

                    <!-- Footer -->
                    <tr>
                        <td style="background-color: #f8fafc; padding: 24px 32px; border-top: 1px solid #e2e8f0; text-align: center;">
                            <p style="margin: 0; font-size: 12px; color: #94a3b8;">
                                &copy; @DateTime.UtcNow.Year Stayly Partner Services.
                            </p>
                        </td>
                    </tr>
                </table>
            </td>
        </tr>
    </table>
</body>
</html>
