@model PropertyDetails

@{
    ViewData["Title"] = $"{Model.Name} - Stayly Homestay & Khách sạn";
    var defaultImages = new List<string>
    {
        "https://images.unsplash.com/photo-1582719478250-c89cae4dc85b?auto=format&fit=crop&w=1200&q=80",
        "https://images.unsplash.com/photo-1542314831-068cd1dbfeeb?auto=format&fit=crop&w=800&q=80",
        "https://images.unsplash.com/photo-1512917774080-9991f1c4c750?auto=format&fit=crop&w=800&q=80",
        "https://images.unsplash.com/photo-1613977257363-707ba9348227?auto=format&fit=crop&w=800&q=80",
        "https://images.unsplash.com/photo-1520250497591-112f2f40a3f4?auto=format&fit=crop&w=800&q=80"
    };

    var propertyImages = (Model.Images != null && Model.Images.Count > 0)
        ? Model.Images.ToList()
        : defaultImages;

    var mainImage = propertyImages.FirstOrDefault() ?? defaultImages[0];
    var subImages = propertyImages.Skip(1).Take(4).ToList();
    if (subImages.Count == 0)
    {
        subImages = defaultImages.Skip(1).Take(4).ToList();
    }

    var minPrice = Model.Rooms.Any() ? Model.Rooms.Min(r => r.CurrentPrice) : 500000m;
    var reviews = ViewBag.Reviews as IReadOnlyList<ReviewItem> ?? Array.Empty<ReviewItem>();
    var amenities = ViewBag.Amenities as IReadOnlyList<AmenityItem> ?? Array.Empty<AmenityItem>();
}

<div class="stayly-details-wrapper py-4">
    <div class="container">
        <!-- Top Navigation / Breadcrumb -->
        <div class="d-flex align-items-center justify-content-between mb-3 flex-wrap gap-2">
            <a asp-action="Index" class="btn-stayly-back">
                <i class="bi bi-arrow-left me-2"></i> Quay lại danh sách
            </a>
            <div class="d-flex align-items-center gap-2">
                <button class="btn btn-sm btn-outline-secondary rounded-pill px-3" onclick="navigator.clipboard.writeText(window.location.href); showStaylyToast('info', 'Đã sao chép liên kết vào clipboard!');">
                    <i class="bi bi-share-fill me-1"></i> Chia sẻ
                </button>
                <button class="btn btn-sm btn-outline-danger rounded-pill px-3" onclick="this.classList.toggle('active'); showStaylyToast('success', 'Đã lưu vào danh sách yêu thích!');">
                    <i class="bi bi-heart me-1"></i> Yêu thích
                </button>
            </div>
        </div>

        <!-- Property Header -->
        <div class="property-header-card mb-4">
            <div class="d-flex align-items-center gap-2 mb-2 flex-wrap">
                <span class="stayly-tag-type">
                    <i class="bi @(Model.Type == "Hotel" ? "bi-building" : "bi-house-heart") me-1"></i>
                    @(Model.Type ?? "Homestay")
                </span>
                <span class="stayly-tag-rating">
                    <i class="bi bi-star-fill text-warning me-1"></i> 4.9 (128 đánh giá)
                </span>
                <span class="stayly-tag-badge">
                    <i class="bi bi-shield-check text-success me-1"></i> Đối tác đã xác thực
                </span>
            </div>

            <h1 class="property-main-title">@Model.Name</h1>

            <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mt-2 text-muted">
                <div class="property-address-line">
                    <i class="bi bi-geo-alt-fill text-primary me-1"></i>
                    <span>@(string.IsNullOrWhiteSpace(Model.Address) ? "Đang cập nhật địa chỉ" : Model.Address)</span>
                </div>
                <div class="property-contact-hints">
                    @if (!string.IsNullOrWhiteSpace(Model.Phone))
                    {
                        <span class="me-3"><i class="bi bi-telephone-fill me-1 text-primary"></i> @Model.Phone</span>
                    }
                    @if (!string.IsNullOrWhiteSpace(Model.Email))
                    {
                        <span><i class="bi bi-envelope-fill me-1 text-primary"></i> @Model.Email</span>
                    }
                </div>
            </div>
        </div>

        <!-- Bento Photo Gallery -->
        <div class="property-gallery-bento mb-5">
            <div class="row g-2">
                <!-- Main Feature Photo (Left) -->
                <div class="col-lg-7 col-12">
                    <div class="gallery-feature-item" onclick="openPhotoModal(0)">
                        <img src="@mainImage" alt="@Model.Name" class="gallery-img-large" />
                        <div class="gallery-overlay-tag">
                            <i class="bi bi-camera-fill me-1"></i> Hình ảnh thực tế
                        </div>
                    </div>
                </div>

                <!-- Sub Photos Grid (Right) -->
                <div class="col-lg-5 col-12">
                    <div class="row g-2 h-100">
                        @for (var i = 0; i < subImages.Count; i++)
                        {
                            var imgIndex = i + 1;
                            <div class="col-6">
                                <div class="gallery-sub-item position-relative" onclick="openPhotoModal(@imgIndex)">
                                    <img src="@subImages[i]" alt="@Model.Name photo @imgIndex" class="gallery-img-thumb" />
                                    @if (i == subImages.Count - 1 && propertyImages.Count > 5)
                                    {
                                        <div class="gallery-more-overlay">
                                            <span>+@(propertyImages.Count - 5) ảnh</span>
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- View All Button -->
            <button type="button" class="btn-view-all-photos" onclick="openPhotoModal(0)">
                <i class="bi bi-grid-3x3-gap-fill me-2"></i> Xem tất cả hình ảnh (@propertyImages.Count)
            </button>
        </div>

        <!-- Main Layout: Content (8 cols) & Sticky Booking Widget (4 cols) -->
        <div class="row g-4">
            <!-- Left Column: Details, Amenities, Rooms, Reviews -->
            <div class="col-lg-8">
                <!-- 1. Highlights & Host Overview -->
                <div class="stayly-card-box mb-4">
                    <h3 class="box-section-title">
                        <i class="bi bi-stars text-primary me-2"></i> Điểm nổi bật của nơi lưu trú
                    </h3>
                    <div class="row g-3 mt-1">
                        <div class="col-md-6">
                            <div class="highlight-item d-flex align-items-center gap-3 p-3 rounded-4 bg-light">
                                <div class="highlight-icon-circle">
                                    <i class="bi bi-award-fill text-primary fs-4"></i>
                                </div>
                                <div>
                                    <div class="fw-bold text-navy">Chủ nhà siêu tận tâm</div>
                                    <small class="text-muted">Được đánh giá cao về lòng hiếu khách và hỗ trợ nhanh chóng.</small>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="highlight-item d-flex align-items-center gap-3 p-3 rounded-4 bg-light">
                                <div class="highlight-icon-circle">
                                    <i class="bi bi-geo-fill text-primary fs-4"></i>
                                </div>
                                <div>
                                    <div class="fw-bold text-navy">Vị trí đắc địa</div>
                                    <small class="text-muted">95% khách gần đây chấm 5 sao cho sự thuận tiện đi lại.</small>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="highlight-item d-flex align-items-center gap-3 p-3 rounded-4 bg-light">
                                <div class="highlight-icon-circle">
                                    <i class="bi bi-shield-lock-fill text-primary fs-4"></i>
                                </div>
                                <div>
                                    <div class="fw-bold text-navy">Nhận phòng tự động an toàn</div>
                                    <small class="text-muted">Khóa thông minh và hướng dẫn chi tiết qua ứng dụng.</small>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="highlight-item d-flex align-items-center gap-3 p-3 rounded-4 bg-light">
                                <div class="highlight-icon-circle">
                                    <i class="bi bi-calendar-check-fill text-primary fs-4"></i>
                                </div>
                                <div>
                                    <div class="fw-bold text-navy">Hủy phòng linh hoạt</div>
                                    <small class="text-muted">Hủy miễn phí trước 24 giờ nhận phòng.</small>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- 2. Description & House Rules -->
                <div class="stayly-card-box mb-4">
                    <h3 class="box-section-title">
                        <i class="bi bi-info-circle-fill text-primary me-2"></i> Giới thiệu về không gian nghỉ ngơi
                    </h3>
                    <div class="property-description text-muted lh-lg mt-3">
                        <p>
                            Chào mừng bạn đến với <strong>@Model.Name</strong>! Nằm tại vị trí trung tâm thanh bình và thoáng mát, nơi đây được thiết kế hài hòa giữa vẻ đẹp hiện đại và sự ấm cúng, đem lại trải nghiệm nghỉ dưỡng đích thực cho chuyến du lịch hoặc công tác của bạn.
                        </p>
                        <p>
                            Từng căn phòng được trang bị đầy đủ giường nệm êm ái cao cấp, máy điều hòa, smart TV và phòng tắm riêng tinh tế. Không gian mở ngập tràn ánh sáng tự nhiên với view thoáng đãng giúp bạn có những phút giây thư giãn tuyệt đối bên gia đình và người thân.
                        </p>
                    </div>

                    <div class="d-flex align-items-center gap-4 flex-wrap mt-3 pt-3 border-top">
                        <div class="d-flex align-items-center gap-2">
                            <i class="bi bi-clock-history text-primary fs-5"></i>
                            <div>
                                <div class="small text-muted">Nhận phòng</div>
                                <div class="fw-semibold text-navy">Từ 14:00</div>
                            </div>
                        </div>
                        <div class="d-flex align-items-center gap-2">
                            <i class="bi bi-box-arrow-right text-primary fs-5"></i>
                            <div>
                                <div class="small text-muted">Trả phòng</div>
                                <div class="fw-semibold text-navy">Trước 12:00</div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- 3. Amenities Section -->
                <div class="stayly-card-box mb-4">
                    <h3 class="box-section-title mb-3">
                        <i class="bi bi-grid-fill text-primary me-2"></i> Tiện ích có sẵn
                    </h3>
                    <div class="row g-3">
                        @if (amenities != null && amenities.Count > 0)
                        {
                            foreach (var a in amenities)
                            {
                                <div class="col-md-4 col-6">
                                    <div class="amenity-pill-item">
                                        <i class="bi bi-check-circle-fill text-primary me-2"></i>
                                        <span>@a.Name</span>
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="col-md-4 col-6"><div class="amenity-pill-item"><i class="bi bi-wifi text-primary me-2"></i> Wifi tốc độ cao</div></div>
                            <div class="col-md-4 col-6"><div class="amenity-pill-item"><i class="bi bi-snow text-primary me-2"></i> Điều hòa không khí</div></div>
                            <div class="col-md-4 col-6"><div class="amenity-pill-item"><i class="bi bi-cup-hot text-primary me-2"></i> Bếp nấu ăn đầy đủ</div></div>
                            <div class="col-md-4 col-6"><div class="amenity-pill-item"><i class="bi bi-p-circle text-primary me-2"></i> Bãi đỗ xe an toàn</div></div>
                            <div class="col-md-4 col-6"><div class="amenity-pill-item"><i class="bi bi-tv text-primary me-2"></i> Smart TV Netflix</div></div>
                            <div class="col-md-4 col-6"><div class="amenity-pill-item"><i class="bi bi-water text-primary me-2"></i> Bồn tắm thư giãn</div></div>
                        }
                    </div>
                </div>

                <!-- 4. Available Rooms Section -->
                <div class="stayly-card-box mb-4" id="roomsSection">
                    <div class="d-flex align-items-center justify-content-between mb-3 flex-wrap gap-2">
                        <h3 class="box-section-title mb-0">
                            <i class="bi bi-door-open-fill text-primary me-2"></i> Danh sách phòng trống (@Model.Rooms.Count)
                        </h3>
                        <span class="badge bg-light text-primary rounded-pill px-3 py-2 border">
                            Giá tốt nhất hôm nay
                        </span>
                    </div>

                    @if (Model.Rooms == null || Model.Rooms.Count == 0)
                    {
                        <div class="alert alert-info rounded-4 border-0 p-4 text-center">
                            <i class="bi bi-calendar-x fs-1 text-primary mb-2 d-block"></i>
                            <h5 class="fw-bold">Hiện chưa có phòng nào khả dụng</h5>
                            <p class="text-muted mb-0">Vui lòng quay lại sau hoặc liên hệ trực tiếp chủ cơ sở để biết thêm chi tiết.</p>
                        </div>
                    }
                    else
                    {
                        <div class="room-cards-list d-flex flex-column gap-3">
                            @foreach (var room in Model.Rooms)
                            {
                                var roomImg = (room.Images != null && room.Images.Count > 0)
                                    ? room.Images.First()
                                    : mainImage;

                                <div class="room-card-item p-3 border rounded-4 bg-white hover-shadow-sm">
                                    <div class="row g-3 align-items-center">
                                        <!-- Room Photo -->
                                        <div class="col-md-4 col-12">
                                            <div class="room-photo-wrapper position-relative">
                                                <img src="@roomImg" alt="Room @room.RoomNumber" class="room-photo-img rounded-3 w-100" />
                                                <span class="room-badge-status position-absolute top-0 start-0 m-2 badge bg-success rounded-pill">
                                                    @(string.IsNullOrWhiteSpace(room.RoomStatus) ? "Trống" : room.RoomStatus)
                                                </span>
                                            </div>
                                        </div>

                                        <!-- Room Details -->
                                        <div class="col-md-5 col-12">
                                            <div class="room-type-tag text-primary small fw-bold text-uppercase mb-1">
                                                @(string.IsNullOrWhiteSpace(room.RoomType) ? "Phòng Tiêu Chuẩn" : room.RoomType)
                                            </div>
                                            <h4 class="room-title mb-2">Phòng @room.RoomNumber</h4>
                                            <div class="room-features d-flex flex-wrap gap-2 mb-2 text-muted small">
                                                <span class="d-flex align-items-center gap-1">
                                                    <i class="bi bi-people-fill text-primary"></i> Sức chứa: <strong>@room.Capacity khách</strong>
                                                </span>
                                                <span class="d-flex align-items-center gap-1">
                                                    <i class="bi bi-door-closed text-primary"></i> Phòng riêng
                                                </span>
                                                <span class="d-flex align-items-center gap-1">
                                                    <i class="bi bi-check2-circle text-success"></i> Vệ sinh khép kín
                                                </span>
                                            </div>
                                        </div>

                                        <!-- Pricing & Select Button -->
                                        <div class="col-md-3 col-12 text-md-end border-md-start ps-md-3">
                                            <div class="room-price-box mb-2">
                                                <div class="text-muted small">Giá mỗi đêm</div>
                                                <div class="fs-4 fw-bold text-primary">
                                                    @room.CurrentPrice.ToString("N0") <span class="fs-6">₫</span>
                                                </div>
                                            </div>
                                            <button type="button" class="btn-stayly-select-room w-100" onclick="selectRoomForBooking(@room.Id, '@room.RoomNumber', @room.CurrentPrice, @room.Capacity)">
                                                <i class="bi bi-bookmark-check-fill me-1"></i> Chọn phòng
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>

                <!-- 5. Customer Reviews Section -->
                <div class="stayly-card-box mb-4">
                    <div class="d-flex align-items-center justify-content-between mb-4 flex-wrap gap-2">
                        <div>
                            <h3 class="box-section-title mb-1">
                                <i class="bi bi-chat-heart-fill text-primary me-2"></i> Đánh giá từ khách hàng
                            </h3>
                            <div class="d-flex align-items-center gap-2">
                                <div class="rating-stars text-warning fs-5">
                                    <i class="bi bi-star-fill"></i>
                                    <i class="bi bi-star-fill"></i>
                                    <i class="bi bi-star-fill"></i>
                                    <i class="bi bi-star-fill"></i>
                                    <i class="bi bi-star-fill"></i>
                                </div>
                                <span class="fw-bold text-navy fs-5">4.92 / 5</span>
                                <span class="text-muted small">• 100% đánh giá thực tế từ khách đã lưu trú</span>
                            </div>
                        </div>
                    </div>

                    @if (reviews != null && reviews.Count > 0)
                    {
                        <div class="reviews-list d-flex flex-column gap-3">
                            @foreach (var rev in reviews)
                            {
                                <div class="review-item-card p-3 rounded-4 bg-light border-0">
                                    <div class="d-flex align-items-center justify-content-between mb-2">
                                        <div class="d-flex align-items-center gap-2">
                                            <div class="reviewer-avatar">
                                                @(string.IsNullOrWhiteSpace(rev.GuestName) ? "K" : rev.GuestName.Substring(0, 1).ToUpper())
                                            </div>
                                            <div>
                                                <div class="fw-bold text-navy">@(string.IsNullOrWhiteSpace(rev.GuestName) ? "Khách lưu trú" : rev.GuestName)</div>
                                                <small class="text-muted">@rev.ReviewDate.ToString("dd/MM/yyyy")</small>
                                            </div>
                                        </div>
                                        <div class="text-warning">
                                            @for (var s = 0; s < rev.Rating; s++)
                                            {
                                                <i class="bi bi-star-fill"></i>
                                            }
                                        </div>
                                    </div>
                                    <p class="review-comment text-muted mb-0">@rev.Comment</p>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <!-- Sample Curated Reviews -->
                        <div class="reviews-list d-flex flex-column gap-3">
                            <div class="review-item-card p-3 rounded-4 bg-light border-0">
                                <div class="d-flex align-items-center justify-content-between mb-2">
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="reviewer-avatar">H</div>
                                        <div>
                                            <div class="fw-bold text-navy">Hoàng Nam Anh</div>
                                            <small class="text-muted">Đã ở 3 đêm • Tháng 8/2026</small>
                                        </div>
                                    </div>
                                    <div class="text-warning">
                                        <i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i>
                                    </div>
                                </div>
                                <p class="review-comment text-muted mb-0">
                                    "Homestay rất đẹp và sạch sẽ, view ngắm cảnh cực kỳ chill. Chủ nhà nhiệt tình hướng dẫn các địa điểm ăn uống ngon bổ rẻ quanh khu vực. Nhất định sẽ quay lại lần tới!"
                                </p>
                            </div>

                            <div class="review-item-card p-3 rounded-4 bg-light border-0">
                                <div class="d-flex align-items-center justify-content-between mb-2">
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="reviewer-avatar">M</div>
                                        <div>
                                            <div class="fw-bold text-navy">Mai Thanh Thảo</div>
                                            <small class="text-muted">Đã ở 2 đêm • Tháng 9/2026</small>
                                        </div>
                                    </div>
                                    <div class="text-warning">
                                        <i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i>
                                    </div>
                                </div>
                                <p class="review-comment text-muted mb-0">
                                    "Giường nệm rất êm, phòng thơm tho, nước nóng đầy đủ. Điểm cộng lớn là wifi nhanh mượt mà nên làm việc từ xa rất tiện lợi. 10/10 điểm!"
                                </p>
                            </div>
                        </div>
                    }
                </div>
            </div>

            <!-- Right Column: Sticky Booking Widget -->
            <div class="col-lg-4">
                <div class="stayly-sticky-booking-card p-4 rounded-4 shadow-sm bg-white position-sticky" style="top: 100px;">
                    <div class="booking-price-header d-flex align-items-baseline justify-content-between mb-3 pb-3 border-bottom">
                        <div>
                            <span class="fs-3 fw-bold text-primary" id="widgetDisplayPrice">@minPrice.ToString("N0")</span>
                            <span class="fs-6 text-primary fw-bold">₫</span>
                            <span class="text-muted small"> / đêm</span>
                        </div>
                        <div class="d-flex align-items-center gap-1 text-warning small">
                            <i class="bi bi-star-fill"></i>
                            <span class="fw-bold text-dark">4.9</span>
                        </div>
                    </div>

                    <form asp-action="Book" method="post" id="staylyBookingForm" onsubmit="return validateBookingSubmit(event)">
                        @Html.AntiForgeryToken()

                        <!-- Room Selector -->
                        <div class="mb-3">
                            <label class="form-label small fw-bold text-navy">Chọn phòng nghỉ</label>
                            <select name="RoomId" id="bookingRoomSelect" class="form-select stayly-select-input rounded-pill" required onchange="onRoomChanged(this)">
                                @if (Model.Rooms != null && Model.Rooms.Count > 0)
                                {
                                    foreach (var r in Model.Rooms)
                                    {
                                        <option value="@r.Id" data-price="@r.CurrentPrice" data-capacity="@r.Capacity">
                                            Phòng @r.RoomNumber - @r.CurrentPrice.ToString("N0") ₫ / đêm (tối đa @r.Capacity người)
                                        </option>
                                    }
                                }
                                else
                                {
                                    <option value="1" data-price="500000" data-capacity="2">Phòng Tiêu Chuẩn - 500,000 ₫ / đêm</option>
                                }
                            </select>
                        </div>

                        <!-- Date Pickers (Check-in / Check-out) -->
                        <div class="row g-2 mb-3">
                            <div class="col-6">
                                <label class="form-label small fw-bold text-navy">Nhận phòng</label>
                                <input name="CheckIn" id="bookingCheckIn" type="date" class="form-control stayly-date-input rounded-pill" required onchange="calculateBookingTotal()" />
                            </div>
                            <div class="col-6">
                                <label class="form-label small fw-bold text-navy">Trả phòng</label>
                                <input name="CheckOut" id="bookingCheckOut" type="date" class="form-control stayly-date-input rounded-pill" required onchange="calculateBookingTotal()" />
                            </div>
                        </div>

                        <!-- Guest Count -->
                        <div class="mb-3">
                            <label class="form-label small fw-bold text-navy">Số lượng khách</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light rounded-start-pill border-end-0">
                                    <i class="bi bi-people-fill text-primary"></i>
                                </span>
                                <input name="GuestCount" id="bookingGuestCount" type="number" min="1" max="10" value="2" class="form-control rounded-end-pill border-start-0" required />
                            </div>
                        </div>

                        <!-- Price Breakdown -->
                        <div class="booking-breakdown p-3 bg-light rounded-4 mb-3" id="bookingBreakdownBox">
                            <div class="d-flex justify-content-between small text-muted mb-1">
                                <span id="breakdownNightsText">500,000 ₫ × 1 đêm</span>
                                <span id="breakdownSubtotal">500,000 ₫</span>
                            </div>
                            <div class="d-flex justify-content-between small text-muted mb-2">
                                <span>Phí dịch vụ &amp; dọn dẹp</span>
                                <span class="text-success fw-semibold">Miễn phí</span>
                            </div>
                            <div class="d-flex justify-content-between fw-bold text-navy pt-2 border-top">
                                <span>Tổng tạm tính</span>
                                <span class="text-primary fs-5" id="breakdownTotal">500,000 ₫</span>
                            </div>
                        </div>

                        <!-- Submit Button -->
                        <button type="submit" class="btn-stayly-submit-book w-100 rounded-pill py-3 fw-bold mb-2">
                            <i class="bi bi-calendar2-check-fill me-2"></i> Yêu cầu đặt phòng
                        </button>

                        <div class="text-center small text-muted">
                            <i class="bi bi-shield-check text-success me-1"></i> Bạn chưa bị trừ tiền ở bước này
                        </div>
                    </form>

                    <!-- Host info summary -->
                    <div class="host-info-summary mt-4 pt-3 border-top d-flex align-items-center gap-3">
                        <div class="host-avatar-circle">
                            <i class="bi bi-person-fill fs-3 text-primary"></i>
                        </div>
                        <div>
                            <div class="fw-bold text-navy small">Cần hỗ trợ tư vấn?</div>
                            <div class="text-muted small">Hotline: <strong>@(string.IsNullOrWhiteSpace(Model.Phone) ? "1900 6868" : Model.Phone)</strong></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Photo Modal Gallery (Full Resolution) -->
<div class="modal fade" id="staylyPhotoModal" tabindex="-1" aria-labelledby="photoModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-xl">
        <div class="modal-content rounded-4 border-0 shadow-lg overflow-hidden">
