<UserControl x:Class="HomestaySystem.Views.BaoTriHeThongView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:conv="clr-namespace:HomestaySystem.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="950" d:DesignWidth="1300">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <conv:PhuDinhBooleanToVisibilityConverter x:Key="PhuDinhBoolToVis"/>
        <conv:ChuoiMauToBrushConverter x:Key="ColorToBrush"/>
        <conv:NullToVisibilityConverter x:Key="NullToVis"/>
    </UserControl.Resources>

    <Grid Background="#F8FAFC">
        <!-- Main Layout ScrollViewer -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="28,24,28,32">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Hàng 0: Header & Thanh trạng thái -->
                    <RowDefinition Height="Auto"/> <!-- Hàng 1: 4 Thẻ KPI Metrics -->
                    <RowDefinition Height="Auto"/> <!-- Hàng 2: Lịch sao lưu tự động & Chính sách lưu trữ -->
                    <RowDefinition Height="Auto"/> <!-- Hàng 3: Thanh công cụ sao lưu nhanh -->
                    <RowDefinition Height="Auto"/> <!-- Hàng 4: Danh sách bản sao lưu & Nhật ký -->
                </Grid.RowDefinitions>

                <!-- ================= HÀNG 0: HEADER & ACTIONS ================= -->
                <Grid Grid.Row="0" Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Trung tâm Quản trị &amp; Sao lưu CSDL" FontSize="22" FontWeight="Bold" Foreground="#0F172A"/>
                            <Border Background="#ECFDF5" BorderBrush="#A7F3D0" BorderThickness="1" CornerRadius="12" Padding="10,4" Margin="14,0,0,0" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="8" Height="8" Fill="#10B981" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="SQL Server: Trực tuyến" FontSize="11" FontWeight="SemiBold" Foreground="#047857"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="Quản lý sao lưu nén (COMPRESSION), streaming tải về máy trạm và phục hồi dữ liệu an toàn qua API"
                                   FontSize="13" Foreground="#64748B" Margin="0,4,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Nút Mở thư mục máy trạm -->
                        <Button Command="{Binding MoThuMucSaoLuuCommand}" Cursor="Hand" Margin="0,0,10,0"
                                Background="White" BorderBrush="#E2E8F0" BorderThickness="1" Padding="14,8">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="8"/>
                                </Style>
                            </Button.Resources>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📁" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Thư mục máy trạm" FontSize="12.5" FontWeight="SemiBold" Foreground="#334155"/>
                            </StackPanel>
                        </Button>

                        <!-- Nút Làm mới -->
                        <Button Command="{Binding TaiDuLieuCommand}" Cursor="Hand"
                                Background="#0077B6" Foreground="White" BorderThickness="0" Padding="16,8">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="8"/>
                                </Style>
                            </Button.Resources>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🔄" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Đồng bộ CSDL" FontSize="12.5" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- ================= HÀNG 1: 4 THẺ KPI METRICS ================= -->
                <Grid Grid.Row="1" Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- KPI 1: Dung lượng CSDL -->
                    <Border Grid.Column="0" Background="White" CornerRadius="12" BorderBrush="#E2E8F0" BorderThickness="1" Padding="18">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,8">
                                <Border Width="34" Height="34" Background="#E0F2FE" CornerRadius="8" Margin="0,0,10,0">
                                    <TextBlock Text="💾" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel>
                                    <TextBlock Text="Dung lượng CSDL" FontSize="12" FontWeight="SemiBold" Foreground="#64748B"/>
                                    <TextBlock Text="{Binding TenCSDL}" FontSize="11" Foreground="#94A3B8"/>
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,4,0,4">
                                <TextBlock Text="{Binding TongDungLuongMB, StringFormat='{}{0:N1}'}" FontSize="24" FontWeight="Bold" Foreground="#0F172A"/>
                                <TextBlock Text=" MB" FontSize="14" FontWeight="SemiBold" Foreground="#64748B" Margin="2,0,0,3" VerticalAlignment="Bottom"/>
                            </StackPanel>
                            <TextBlock FontSize="11.5" Foreground="#64748B">
                                <Run Text="Data: "/>
                                <Run Text="{Binding DungLuongDataMB, StringFormat='{}{0:N1} MB'}" FontWeight="SemiBold" Foreground="#0284C7"/>
                                <Run Text=" | Log: "/>
                                <Run Text="{Binding DungLuongLogMB, StringFormat='{}{0:N1} MB'}" FontWeight="SemiBold" Foreground="#64748B"/>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- KPI 2: Cấu trúc CSDL -->
                    <Border Grid.Column="2" Background="White" CornerRadius="12" BorderBrush="#E2E8F0" BorderThickness="1" Padding="18">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,8">
                                <Border Width="34" Height="34" Background="#EDE9FE" CornerRadius="8" Margin="0,0,10,0">
                                    <TextBlock Text="🗄️" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel>
                                    <TextBlock Text="Cấu trúc hệ thống" FontSize="12" FontWeight="SemiBold" Foreground="#64748B"/>
                                    <TextBlock Text="Số bảng dữ liệu" FontSize="11" Foreground="#94A3B8"/>
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,4,0,4">
                                <TextBlock Text="{Binding SoBang}" FontSize="24" FontWeight="Bold" Foreground="#0F172A"/>
                                <TextBlock Text=" bảng" FontSize="14" FontWeight="SemiBold" Foreground="#64748B" Margin="4,0,0,3" VerticalAlignment="Bottom"/>
                            </StackPanel>
                            <TextBlock Text="{Binding PhienBanMayChu}" FontSize="11" Foreground="#64748B" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Border>

                    <!-- KPI 3: Lần sao lưu gần nhất -->
                    <Border Grid.Column="4" Background="White" CornerRadius="12" BorderBrush="#E2E8F0" BorderThickness="1" Padding="18">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,8">
                                <Border Width="34" Height="34" Background="#ECFDF5" CornerRadius="8" Margin="0,0,10,0">
                                    <TextBlock Text="⏱️" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel>
                                    <TextBlock Text="Bản sao lưu mới nhất" FontSize="12" FontWeight="SemiBold" Foreground="#64748B"/>
                                    <TextBlock Text="Thời điểm ghi nhận" FontSize="11" Foreground="#94A3B8"/>
                                </StackPanel>
                            </StackPanel>
                            <TextBlock Text="{Binding LanSaoLuuCuoi}" FontSize="15" FontWeight="Bold" Foreground="#047857" Margin="0,6,0,6"/>
                            <TextBlock Text="Đảm bảo an toàn phục hồi dữ liệu" FontSize="11" Foreground="#10B981"/>
                        </StackPanel>
                    </Border>

                    <!-- KPI 4: Bản sao lưu máy chủ -->
                    <Border Grid.Column="6" Background="White" CornerRadius="12" BorderBrush="#E2E8F0" BorderThickness="1" Padding="18">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,8">
                                <Border Width="34" Height="34" Background="#FEF3C7" CornerRadius="8" Margin="0,0,10,0">
                                    <TextBlock Text="📦" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel>
                                    <TextBlock Text="Kho bản sao lưu" FontSize="12" FontWeight="SemiBold" Foreground="#64748B"/>
                                    <TextBlock Text="Lưu trữ trên máy chủ" FontSize="11" Foreground="#94A3B8"/>
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,4,0,4">
                                <TextBlock Text="{Binding TongSoBanSaoLuu}" FontSize="24" FontWeight="Bold" Foreground="#0F172A"/>
                                <TextBlock Text=" tệp .bak" FontSize="14" FontWeight="SemiBold" Foreground="#64748B" Margin="4,0,0,3" VerticalAlignment="Bottom"/>
                            </StackPanel>
                            <TextBlock FontSize="11.5" Foreground="#64748B">
                                <Run Text="Tổng dung lượng: "/>
                                <Run Text="{Binding TongDungLuongSaoLuu}" FontWeight="SemiBold" Foreground="#D97706"/>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- ================= HÀNG 2: LỊCH SAO LƯU TỰ ĐỘNG & CHÍNH SÁCH LƯU TRỮ ================= -->
                <Border Grid.Row="2" Background="#F0FDF4" CornerRadius="12" BorderBrush="#BBF7D0" BorderThickness="1" Padding="18,14" Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Width="40" Height="40" Background="#DCFCE7" CornerRadius="10" Margin="0,0,14,0" VerticalAlignment="Center">
                            <TextBlock Text="⏰" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Lịch sao lưu tự động &amp; Chính sách dọn dẹp đĩa (Retention Policy)" FontSize="13.5" FontWeight="Bold" Foreground="#14532D"/>
                                <Border Background="#DCFCE7" CornerRadius="8" Padding="8,2" Margin="10,0,0,0">
                                    <TextBlock Text="{Binding TrangThaiLichText}" FontSize="11" FontWeight="Bold" Foreground="#15803D"/>
                                </Border>
                            </StackPanel>
                            <TextBlock FontSize="12" Foreground="#166534" Margin="0,3,0,0">
                                <Run Text="Lần chạy tới: "/>
                                <Run Text="{Binding LanChayTiepTheoText}" FontWeight="Bold"/>
                                <Run Text=" | Chính sách: "/>
                                <Run Text="{Binding LuuTruText}"/>
                            </TextBlock>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <CheckBox IsChecked="{Binding LichTuDongBat}" VerticalAlignment="Center" Margin="0,0,12,0" Cursor="Hand">
                                <TextBlock Text="Bật lịch tự động" FontSize="12" FontWeight="SemiBold" Foreground="#14532D"/>
                            </CheckBox>

                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                                <TextBlock Text="Lưu trữ:" FontSize="12" Foreground="#14532D" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <Border Background="White" CornerRadius="6" BorderBrush="#86EFAC" BorderThickness="1" Padding="6,3">
                                    <TextBox Text="{Binding SoNgayLuuTru, UpdateSourceTrigger=PropertyChanged}" Width="32" FontSize="12" FontWeight="Bold" Foreground="#14532D" BorderThickness="0" Background="Transparent" TextAlignment="Center"/>
                                </Border>
                                <TextBlock Text="ngày" FontSize="12" Foreground="#14532D" VerticalAlignment="Center" Margin="6,0,0,0"/>
                            </StackPanel>

                            <Button Command="{Binding LuuLichSaoLuuCommand}" Cursor="Hand"
                                    Background="#16A34A" Foreground="White" BorderThickness="0" Padding="12,6" Margin="0,0,8,0">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="6"/>
                                    </Style>
                                </Button.Resources>
                                <TextBlock Text="💾 Lưu cấu hình" FontSize="11.5" FontWeight="Bold"/>
                            </Button>

                            <Button Command="{Binding KichHoatSaoLuuTuDongNgayCommand}" Cursor="Hand" ToolTip="Chạy thử chu kỳ sao lưu và dọn dẹp tự động ngay lập tức"
                                    Background="White" BorderBrush="#86EFAC" BorderThickness="1" Foreground="#15803D" Padding="12,6">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="6"/>
                                    </Style>
                                </Button.Resources>
                                <TextBlock Text="▶ Chạy thử ngay" FontSize="11.5" FontWeight="SemiBold"/>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ================= HÀNG 3: THANH CÔNG CỤ TẠO SAO LƯU & TẢI LÊN ================= -->
                <Border Grid.Row="3" Background="White" CornerRadius="12" BorderBrush="#E2E8F0" BorderThickness="1" Padding="20" Margin="0,0,0,20">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Phần tạo sao lưu nhanh trên máy chủ -->
                        <Grid Grid.Column="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Margin="0,0,0,10">
                                <TextBlock Text="Tạo bản sao lưu máy chủ mới" FontSize="14" FontWeight="Bold" Foreground="#0F172A"/>
                                <TextBlock Text="Thực thi T-SQL BACKUP DATABASE với thuật toán nén COMPRESSION giúp tiết kiệm dung lượng ổ đĩa."
                                           FontSize="12" Foreground="#64748B" Margin="0,2,0,0"/>
                            </StackPanel>

                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Ô nhập mô tả bản sao lưu -->
                                <Border Grid.Column="0" Background="#F8FAFC" CornerRadius="8" Padding="12,8" BorderBrush="#CBD5E1" BorderThickness="1" Margin="0,0,12,0">
                                    <TextBox Text="{Binding MoTaSaoLuu, UpdateSourceTrigger=PropertyChanged}"
                                             BorderThickness="0" Background="Transparent" FontSize="13" Foreground="#0F172A"
                                             ToolTip="Nhập mô tả lý do sao lưu (ví dụ: Sao lưu trước khi nâng cấp)"/>
                                </Border>

                                <!-- Tùy chọn nén COMPRESSION -->
                                <CheckBox Grid.Column="1" IsChecked="{Binding NenDuLieu}" VerticalAlignment="Center" Margin="0,0,16,0" Cursor="Hand">
                                    <TextBlock Text="Nén dữ liệu (COMPRESSION)" FontSize="12.5" FontWeight="SemiBold" Foreground="#334155"/>
                                </CheckBox>

                                <!-- Nút Tạo bản sao lưu -->
                                <Button Grid.Column="2" Command="{Binding TaoBanSaoLuuMoiCommand}" Cursor="Hand" Height="38"
                                        Background="#0077B6" Foreground="White" BorderThickness="0" Padding="18,0">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="8"/>
                                        </Style>
                                    </Button.Resources>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="⚡" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Tạo bản sao lưu ngay" FontSize="12.5" FontWeight="Bold"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Grid>

                        <!-- Ngăn cách dọc -->
                        <Border Grid.Column="1" Width="1" Background="#E2E8F0" HorizontalAlignment="Center"/>

                        <!-- Phần Phục hồi từ file cục bộ máy trạm -->
                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Width="280">
                            <TextBlock Text="Phục hồi từ máy trạm" FontSize="14" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,4"/>
                            <TextBlock Text="Tải tệp .bak từ ổ cứng máy trạm lên máy chủ và thực hiện phục hồi an toàn."
                                       FontSize="11.5" Foreground="#64748B" TextWrapping="Wrap" Margin="0,0,0,12"/>

                            <Button Command="{Binding MoXacNhanPhucHoiCucBoCommand}" Cursor="Hand" Height="38"
                                    Background="#FEF2F2" BorderBrush="#FCA5A5" BorderThickness="1" Foreground="#DC2626" Padding="14,0">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="8"/>
                                    </Style>
                                </Button.Resources>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📤" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Tải lên &amp; Phục hồi tệp .bak..." FontSize="12.5" FontWeight="Bold"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ================= HÀNG 4: DANH SÁCH BẢN SAO LƯU & AUDIT LOG ================= -->
                <Grid Grid.Row="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="7*"/>
                        <ColumnDefinition Width="18"/>
                        <ColumnDefinition Width="3*"/>
                    </Grid.ColumnDefinitions>

                    <!-- CỘT TRÁI: DATAGRID BẢN SAO LƯU MÁY CHỦ -->
                    <Border Grid.Column="0" Background="White" CornerRadius="12" BorderBrush="#E2E8F0" BorderThickness="1" Padding="18">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,14">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Danh sách bản sao lưu trên máy chủ" FontSize="15" FontWeight="Bold" Foreground="#0F172A"/>
                                    <Border Background="#F1F5F9" CornerRadius="10" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding DanhSachBanSaoLuu.Count, StringFormat='{}{0} tệp'}" FontSize="11" FontWeight="Bold" Foreground="#475569"/>
                                    </Border>
                                </StackPanel>
                            </Grid>

                            <!-- DataGrid hiển thị các bản sao lưu -->
                            <DataGrid Grid.Row="1" ItemsSource="{Binding DanhSachBanSaoLuu}"
                                      SelectedItem="{Binding SelectedBackupItem}"
                                      AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                                      IsReadOnly="True" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#F1F5F9"
                                      HeadersVisibility="Column" Background="Transparent" BorderThickness="0"
                                      RowHeight="46" MinHeight="260">
                                <DataGrid.ColumnHeaderStyle>
                                    <Style TargetType="DataGridColumnHeader">
                                        <Setter Property="Background" Value="#F8FAFC"/>
                                        <Setter Property="Foreground" Value="#475569"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="FontSize" Value="12"/>
                                        <Setter Property="Padding" Value="12,10"/>
                                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                        <Setter Property="BorderBrush" Value="#E2E8F0"/>
                                    </Style>
                                </DataGrid.ColumnHeaderStyle>

                                <DataGrid.RowStyle>
                                    <Style TargetType="DataGridRow">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#F8FAFC"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter Property="Background" Value="#E0F2FE"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGrid.RowStyle>

                                <DataGrid.Columns>
                                    <!-- Tên tệp -->
                                    <DataGridTemplateColumn Header="TÊN TỆP SAO LƯU (.BAK)" Width="2.2*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0">
                                                    <TextBlock Text="🗄️" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding FileName}" FontSize="12.5" FontWeight="SemiBold" Foreground="#0F172A" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <!-- Kích thước -->
                                    <DataGridTemplateColumn Header="DUNG LƯỢNG" Width="1.1*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border Background="#F1F5F9" CornerRadius="6" Padding="8,4" HorizontalAlignment="Left" Margin="8,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding FormattedSize}" FontSize="11.5" FontWeight="SemiBold" Foreground="#334155"/>
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <!-- Ngày tạo -->
                                    <DataGridTemplateColumn Header="NGÀY TẠO" Width="1.5*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding NgayTaoText}" FontSize="12" Foreground="#475569" Margin="8,0" VerticalAlignment="Center"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <!-- Loại -->
                                    <DataGridTemplateColumn Header="LOẠI" Width="1.3*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding LoaiSaoLuuText}" FontSize="11.5" Foreground="#64748B" Margin="8,0" VerticalAlignment="Center"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <!-- Mô tả -->
                                    <DataGridTemplateColumn Header="MÔ TẢ" Width="2*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Description}" FontSize="12" Foreground="#64748B" Margin="8,0"
                                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <!-- Hành động -->
                                    <DataGridTemplateColumn Header="THAO TÁC" Width="2*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,10,0">
                                                    <!-- Tải về máy trạm -->
                                                    <Button Command="{Binding DataContext.TaiBanSaoLuuVeMayCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                            CommandParameter="{Binding}"
                                                            Cursor="Hand" ToolTip="Tải tệp sao lưu này về máy trạm"
                                                            Background="White" BorderBrush="#BAE6FD" BorderThickness="1"
                                                            Padding="8,4" Margin="0,0,6,0">
                                                        <Button.Resources>
                                                            <Style TargetType="Border">
                                                                <Setter Property="CornerRadius" Value="6"/>
                                                            </Style>
                                                        </Button.Resources>
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="⬇️" FontSize="11" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                                            <TextBlock Text="Tải về" FontSize="11" FontWeight="SemiBold" Foreground="#0284C7"/>
                                                        </StackPanel>
                                                    </Button>

                                                    <!-- Phục hồi CSDL -->
                                                    <Button Command="{Binding DataContext.MoXacNhanPhucHoiMayChuCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                            CommandParameter="{Binding}"
                                                            Cursor="Hand" ToolTip="Khôi phục CSDL từ bản sao lưu này"
                                                            Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1"
                                                            Padding="8,4" Margin="0,0,6,0">
                                                        <Button.Resources>
                                                            <Style TargetType="Border">
                                                                <Setter Property="CornerRadius" Value="6"/>
                                                            </Style>
                                                        </Button.Resources>
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="⚠️" FontSize="10" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                                            <TextBlock Text="Phục hồi" FontSize="11" FontWeight="SemiBold" Foreground="#DC2626"/>
                                                        </StackPanel>
                                                    </Button>

                                                    <!-- Xóa bản sao lưu -->
                                                    <Button Command="{Binding DataContext.XoaBanSaoLuuCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                            CommandParameter="{Binding}"
                                                            Cursor="Hand" ToolTip="Xóa tệp sao lưu này trên máy chủ"
                                                            Background="White" BorderBrush="#E2E8F0" BorderThickness="1"
                                                            Padding="8,4">
                                                        <Button.Resources>
                                                            <Style TargetType="Border">
                                                                <Setter Property="CornerRadius" Value="6"/>
                                                            </Style>
                                                        </Button.Resources>
                                                        <TextBlock Text="🗑️" FontSize="11" Foreground="#64748B"/>
                                                    </Button>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>

                    <!-- CỘT PHẢI: NHẬT KÝ BẢO TRÌ & AUDIT LOG -->
                    <Border Grid.Column="2" Background="White" CornerRadius="12" BorderBrush="#E2E8F0" BorderThickness="1" Padding="18">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="Nhật ký bảo trì &amp; Audit Log" FontSize="14" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,12"/>

                            <ListBox Grid.Row="1" ItemsSource="{Binding DanhSachNhatKy}"
                                     BorderThickness="0" Background="Transparent" ScrollViewer.VerticalScrollBarVisibility="Auto" MinHeight="260">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#F8FAFC" CornerRadius="8" BorderBrush="#E2E8F0" BorderThickness="1" Padding="12,10" Margin="0,0,0,8">
                                            <TextBlock Text="{Binding}" FontSize="12" Foreground="#334155" TextWrapping="Wrap" LineHeight="17"/>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </ScrollViewer>

        <!-- ================= MODAL XÁC NHẬN PHỤC HỒI AN TOÀN ================= -->
        <Grid Background="#990F172A" Visibility="{Binding HienThiXacNhanPhucHoi, Converter={StaticResource BoolToVis}}">
            <Border Background="White" CornerRadius="16" Width="560" Padding="28" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="30" Color="#000000" Opacity="0.3" ShadowDepth="10"/>
                </Border.Effect>

                <StackPanel>
                    <!-- Header Modal cảnh báo -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <Border Width="44" Height="44" Background="#FEE2E2" CornerRadius="22" Margin="0,0,14,0">
                            <TextBlock Text="🛡️" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Xác nhận Phục hồi Cơ sở Dữ liệu" FontSize="17" FontWeight="Bold" Foreground="#991B1B"/>
                            <TextBlock Text="Thao tác nguy hiểm yêu cầu thẩm định Quản trị viên" FontSize="12" Foreground="#64748B" Margin="0,2,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Khối Cảnh báo đỏ -->
                    <Border Background="#FEF2F2" CornerRadius="10" BorderBrush="#FECACA" BorderThickness="1" Padding="14" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="⚠️ CẢNH BÁO QUAN TRỌNG:" FontWeight="Bold" FontSize="12.5" Foreground="#B91C1C" Margin="0,0,0,4"/>
                            <TextBlock Text="Khi tiến hành phục hồi, hệ thống sẽ ngắt mọi kết nối hiện tại của khách hàng và đối tác (SINGLE_USER WITH ROLLBACK IMMEDIATE). Toàn bộ dữ liệu hiện tại sẽ bị GHI ĐÈ bằng dữ liệu trong bản sao lưu được chọn!"
                                       FontSize="12" Foreground="#991B1B" TextWrapping="Wrap" LineHeight="18"/>
                        </StackPanel>
                    </Border>

                    <!-- Thông tin tệp sao lưu mục tiêu -->
                    <Border Background="#F8FAFC" CornerRadius="8" BorderBrush="#E2E8F0" BorderThickness="1" Padding="12" Margin="0,0,0,16">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="Tệp sao lưu nguồn được chọn:" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,2"/>
                            <TextBlock Grid.Row="1" Text="{Binding TepPhucHoiMucTieu}" FontSize="13" FontWeight="Bold" Foreground="#0F172A" TextWrapping="Wrap"/>
                        </Grid>
                    </Border>

                    <!-- Ô 1: Nhập mật khẩu Quản trị viên -->
                    <StackPanel Margin="0,0,0,12">
                        <TextBlock Text="1. Nhập mật khẩu tài khoản Quản trị viên của bạn:" FontSize="12.5" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,6"/>
                        <Border Background="#F8FAFC" CornerRadius="8" Padding="12,8" BorderBrush="#CBD5E1" BorderThickness="1">
                            <TextBox Text="{Binding MatKhauXacNhan, UpdateSourceTrigger=PropertyChanged}"
                                     BorderThickness="0" Background="Transparent" FontSize="13" Foreground="#0F172A"/>
                        </Border>
                    </StackPanel>

                    <!-- Ô 2: Gõ xác nhận tên CSDL HOMESTAY_DB -->
                    <StackPanel Margin="0,0,0,22">
                        <TextBlock Text="2. Gõ chính xác tên CSDL để xác nhận ('HOMESTAY_DB'):" FontSize="12.5" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,6"/>
                        <Border Background="#F8FAFC" CornerRadius="8" Padding="12,8" BorderBrush="#CBD5E1" BorderThickness="1">
                            <TextBox Text="{Binding TenDbXacNhan, UpdateSourceTrigger=PropertyChanged}"
                                     BorderThickness="0" Background="Transparent" FontSize="13" Foreground="#0F172A"/>
                        </Border>
                    </StackPanel>

                    <!-- Nút hành động Modal -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0" Command="{Binding DongModalXacNhanCommand}" Cursor="Hand" Height="42"
                                Background="White" BorderBrush="#CBD5E1" BorderThickness="1" Foreground="#334155" FontSize="13" FontWeight="SemiBold">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="8"/>
                                </Style>
                            </Button.Resources>
                            <TextBlock Text="Hủy bỏ"/>
                        </Button>

                        <Button Grid.Column="2" Command="{Binding XacNhanPhucHoiCommand}" Cursor="Hand" Height="42"
                                Background="#DC2626" Foreground="White" BorderThickness="0" FontSize="13" FontWeight="Bold">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="8"/>
                                </Style>
                            </Button.Resources>
                            <TextBlock Text="🔥 TIẾN HÀNH PHỤC HỒI"/>
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ================= OVERLAY ĐANG XỬ LÝ (BUSY INDICATOR) ================= -->
        <Grid Background="#66000000" Visibility="{Binding DangXuLy, Converter={StaticResource BoolToVis}}">
            <Border Background="White" CornerRadius="12" Padding="28,20" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" Color="#000000" Opacity="0.2" ShadowDepth="4"/>
                </Border.Effect>
                <StackPanel HorizontalAlignment="Center">
                    <ProgressBar IsIndeterminate="True" Width="220" Height="6" Margin="0,0,0,14" Foreground="#0077B6"/>
                    <TextBlock Text="{Binding ThongBaoTrangThai}" FontSize="13" FontWeight="SemiBold" Foreground="#0F172A" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
