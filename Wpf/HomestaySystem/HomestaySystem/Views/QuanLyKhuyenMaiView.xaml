<UserControl x:Class="HomestaySystem.Views.QuanLyKhuyenMaiView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:conv="clr-namespace:HomestaySystem.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="780" d:DesignWidth="1150">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <conv:ChuoiMauToBrushConverter x:Key="ColorToBrush"/>
    </UserControl.Resources>

    <Grid Background="{StaticResource MauNenChinh}">
        <Grid Margin="22">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 1. THANH CÔNG CỤ & HÀNH ĐỘNG HOMESTAYSYSTEM COUPON -->
            <Border Grid.Row="0" Background="White" CornerRadius="12" Padding="20,14" Margin="0,0,0,16" BorderBrush="#E2E8F0" BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="10" Direction="270" ShadowDepth="2" Opacity="0.04" Color="#000000"/>
                </Border.Effect>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Tiêu đề & Trạng thái HomestaySystem Promo Center (Thiết kế 2 dòng cân đối, chống đè chữ 100%) -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                        <Border Width="40" Height="40" CornerRadius="20" Background="{StaticResource MauHomestayOrangeNhat}" Margin="0,0,12,0" VerticalAlignment="Center">
                            <TextBlock Text="🎟️" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Quản lý Ưu Đãi &amp; Voucher Khuyến Mãi" FontWeight="Bold" FontSize="15" Foreground="#0F172A" VerticalAlignment="Center"/>
                                <Border Background="{StaticResource MauHomestayOrangeNhat}" BorderBrush="{StaticResource MauHomestayOrange}" BorderThickness="1" CornerRadius="6" Padding="6,2" Margin="8,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="HomestaySystem Promo" FontSize="10" FontWeight="Bold" Foreground="{StaticResource MauHomestayOrange}"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="{Binding ThongBaoTrangThai}" Foreground="#64748B" FontSize="11.5" Margin="0,3,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Các nút hành động: Khóa/Mở, Chỉnh sửa, Tạo mới (Bố cục gọn gàng, nút bấm cân đối) -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <!-- Nút Khóa / Mở voucher -->
                        <Button Content="🔒 Khóa / Mở" Command="{Binding KhoaMoKhoaCommand}"
                                Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" Foreground="#475569"
                                FontWeight="SemiBold" Padding="12,7" Margin="0,0,8,0" Cursor="Hand" MinWidth="110">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="8"/>
                                </Style>
                            </Button.Resources>
                        </Button>

                        <!-- Nút Chỉnh sửa -->
                        <Button Content="✏️ Chỉnh sửa" Command="{Binding MoDialogSuaCommand}"
                                Background="{StaticResource MauHomestayBlue}" Foreground="White" FontWeight="Bold"
                                Padding="12,7" Margin="0,0,8,0" BorderThickness="0" Cursor="Hand" MinWidth="95">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="8"/>
                                </Style>
                            </Button.Resources>
                        </Button>

                        <!-- Nút Tạo mới HomestaySystem Orange -->
                        <Button Content="➕ Tạo Voucher Mới" Command="{Binding MoDialogThemMoiCommand}"
                                Background="{StaticResource MauHomestayOrange}" Foreground="White" FontWeight="Bold"
                                Padding="14,7" BorderThickness="0" Cursor="Hand" MinWidth="135">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="8"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 2. KHU VỰC CHÍNH (BẢNG DANH SÁCH + HOMESTAYSYSTEM VOUCHER TICKET PREVIEW) -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="18"/>
                    <ColumnDefinition Width="360"/>
                </Grid.ColumnDefinitions>

                <!-- CỘT TRÁI: BẢNG DỮ LIỆU KHUYẾN MÃI -->
                <Border Grid.Column="0" Background="White" CornerRadius="12" BorderBrush="#E2E8F0" BorderThickness="1">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="8" Direction="270" ShadowDepth="2" Opacity="0.03" Color="#000000"/>
                    </Border.Effect>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Background="#F8FAFC" CornerRadius="12,12,0,0" Padding="16,12" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
                            <Grid>
                                <TextBlock Text="Tất cả mã ưu đãi đang quản lý" FontWeight="Bold" FontSize="13" Foreground="#0F172A" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding DanhSachKhuyenMai.Count, StringFormat='Tổng cộng: {0} mã'}" HorizontalAlignment="Right" Foreground="#64748B" FontSize="12" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <DataGrid Grid.Row="1" ItemsSource="{Binding DanhSachKhuyenMai}" SelectedItem="{Binding KhuyenMaiDangChon}"
                                  AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                                  HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#F1F5F9"
                                  Background="White" BorderThickness="0" RowHeight="48"
                                  HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                                  ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto"
                                  ScrollViewer.CanContentScroll="True">
                            <DataGrid.ColumnHeaderStyle>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#F8FAFC"/>
                                    <Setter Property="Foreground" Value="#475569"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="FontSize" Value="12"/>
                                    <Setter Property="Padding" Value="12,10"/>
                                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                    <Setter Property="BorderBrush" Value="#E2E8F0"/>
                                </Style>
                            </DataGrid.ColumnHeaderStyle>
                            <DataGrid.Columns>
                                <!-- Mã Code vé HomestaySystem -->
                                <DataGridTemplateColumn Header="Mã Voucher" Width="120">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Background="{StaticResource MauHomestayOrangeNhat}" BorderBrush="{StaticResource MauHomestayOrange}" BorderThickness="1"
                                                    CornerRadius="6" Padding="8,4" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding MaCode}" FontWeight="Bold" Foreground="{StaticResource MauHomestayOrange}" FontSize="12"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Tên chương trình hiển thị đầy đủ, không bị cụt hay teo chữ -->
                                <DataGridTextColumn Header="Chương trình ưu đãi" Binding="{Binding TenChuongTrinh, Mode=OneWay}" Width="240"/>
                                
                                <!-- % Giảm -->
                                <DataGridTemplateColumn Header="% Giảm" Width="80">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Background="#EFF6FF" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding PhanTramGiam, StringFormat='-{0}%'}" FontWeight="Bold" Foreground="#0064D2" FontSize="11"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTextColumn Header="Giảm tối đa" Binding="{Binding GiamToiDaDinhDang, Mode=OneWay}" Width="110"/>
                                <DataGridTextColumn Header="Đơn tối thiểu" Binding="{Binding DonGiaToiThieuDinhDang, Mode=OneWay}" Width="115"/>
                                <DataGridTextColumn Header="Bắt đầu" Binding="{Binding NgayBatDau, Mode=OneWay, StringFormat='{}{0:dd/MM/yyyy}'}" Width="95"/>
                                <DataGridTextColumn Header="Hết hạn" Binding="{Binding NgayKetThuc, Mode=OneWay, StringFormat='{}{0:dd/MM/yyyy}'}" Width="95"/>

                                <!-- Lượt dùng -->
                                <DataGridTemplateColumn Header="Đã dùng / Tổng" Width="120">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock VerticalAlignment="Center" Margin="6,0,0,0">
                                                <Run Text="{Binding SoLuongDaDung}" FontWeight="Bold" Foreground="#0F172A"/>
                                                <Run Text="/" Foreground="#94A3B8"/>
                                                <Run Text="{Binding SoLuongToiDa}" Foreground="#64748B"/>
                                                <Run Text="{Binding SoLuongConLai, StringFormat=' ({0})'}" Foreground="#0E9F6E" FontWeight="SemiBold"/>
                                            </TextBlock>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Trạng thái -->
                                <DataGridTemplateColumn Header="Trạng thái" Width="110">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Background="{Binding MauTrangThai, Converter={StaticResource ColorToBrush}}"
                                                    CornerRadius="10" Padding="8,3" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding TenHienThiTrangThai}" Foreground="White" FontSize="11" FontWeight="Bold"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>

                <!-- CỘT PHẢI: HOMESTAYSYSTEM VOUCHER TICKET PREVIEW CARD -->
                <Grid Grid.Column="2">
                    <!-- Trạng thái trống (Chưa chọn voucher) -->
                    <Border Background="White" CornerRadius="12" BorderBrush="#E2E8F0" BorderThickness="1" Padding="28"
                            Visibility="{Binding KhuyenMaiDangChon, Converter={StaticResource NullToVisConverter}, ConverterParameter='Inverse'}">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <Border Width="64" Height="64" CornerRadius="32" Background="#F1F5F9" Margin="0,0,0,14" HorizontalAlignment="Center">
                                <TextBlock Text="🎟️" FontSize="30" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Chưa chọn mã ưu đãi" FontWeight="Bold" FontSize="15" Foreground="#0F172A" HorizontalAlignment="Center"/>
                            <TextBlock Text="Vui lòng bấm chọn một dòng trong bảng danh sách bên trái để xem mô phỏng vé ưu đãi HomestaySystem."
                                       FontSize="12" Foreground="#64748B" TextWrapping="Wrap" TextAlignment="Center" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Thẻ vé khuyến mãi HomestaySystem Coupon Ticket (Khi đã chọn) -->
                    <Border Background="White" CornerRadius="14" BorderBrush="#FED7AA" BorderThickness="1.5"
                            Visibility="{Binding KhuyenMaiDangChon, Converter={StaticResource NullToVisConverter}}">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="12" Direction="270" ShadowDepth="3" Opacity="0.08" Color="#FF5E1F"/>
                        </Border.Effect>

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Header vé HomestaySystem màu cam đặc trưng -->
                            <Border Grid.Row="0" Background="{StaticResource MauHomestayOrange}" CornerRadius="12,12,0,0" Padding="18,14">
                                <Grid>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="🎟️" FontSize="18" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="HOMESTAYSYSTEM PROMO COUPON" FontWeight="Bold" FontSize="12" Foreground="White" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <Border HorizontalAlignment="Right" Background="White" CornerRadius="12" Padding="10,3">
                                        <TextBlock Text="{Binding KhuyenMaiDangChon.PhanTramGiam, StringFormat='GIẢM {0}%'}"
                                                   FontWeight="Bold" FontSize="11" Foreground="{StaticResource MauHomestayOrange}"/>
                                    </Border>
                                </Grid>
                            </Border>

                            <!-- Thân vé -->
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20,16">
                                <StackPanel>
                                    <!-- Tên chương trình -->
                                    <TextBlock Text="{Binding KhuyenMaiDangChon.TenChuongTrinh}" FontWeight="Bold" FontSize="17" Foreground="#0F172A" TextWrapping="Wrap"/>

                                    <!-- Đường cắt vé (Ticket Perforation line) -->
                                    <Grid Margin="0,16,0,16">
                                        <Rectangle Height="1" Fill="#E2E8F0" StrokeDashArray="3 3" Stroke="#94A3B8" StrokeThickness="1"/>
                                    </Grid>

                                    <!-- Khung Mã Code vé HomestaySystem lớn -->
                                    <TextBlock Text="MÃ VOUCHER ÁP DỤNG" FontSize="10" FontWeight="Bold" Foreground="#64748B" HorizontalAlignment="Center"/>
                                    <Border Background="{StaticResource MauHomestayOrangeNhat}" BorderBrush="{StaticResource MauHomestayOrange}" BorderThickness="1.5"
                                            CornerRadius="8" Padding="14,10" Margin="0,6,0,16" HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding KhuyenMaiDangChon.MaCode}" FontSize="20" FontWeight="Bold"
                                                   Foreground="{StaticResource MauHomestayOrange}"/>
                                    </Border>

                                    <!-- Bảng chi tiết điều kiện -->
                                    <Border Background="#F8FAFC" CornerRadius="10" Padding="14,12" BorderBrush="#E2E8F0" BorderThickness="1" Margin="0,0,0,14">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,8">
                                                <TextBlock Text="Giảm tối đa:" FontSize="12" Foreground="#64748B"/>
                                                <TextBlock Text="{Binding KhuyenMaiDangChon.GiamToiDaDinhDang}" FontSize="12" FontWeight="Bold" Foreground="#0F172A" HorizontalAlignment="Right"/>
                                            </Grid>
                                            <Grid Margin="0,0,0,8">
                                                <TextBlock Text="Đơn tối thiểu:" FontSize="12" Foreground="#64748B"/>
                                                <TextBlock Text="{Binding KhuyenMaiDangChon.DonGiaToiThieuDinhDang}" FontSize="12" FontWeight="SemiBold" Foreground="#0F172A" HorizontalAlignment="Right"/>
                                            </Grid>
                                            <Grid Margin="0,0,0,8">
                                                <TextBlock Text="Thời gian hiệu lực:" FontSize="12" Foreground="#64748B"/>
                                                <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="#0F172A" HorizontalAlignment="Right">
                                                    <Run Text="{Binding KhuyenMaiDangChon.NgayBatDau, StringFormat='{}{0:dd/MM/yy}'}"/>
                                                    <Run Text=" - "/>
                                                    <Run Text="{Binding KhuyenMaiDangChon.NgayKetThuc, StringFormat='{}{0:dd/MM/yy}'}"/>
                                                </TextBlock>
                                            </Grid>
                                            <Grid>
                                                <TextBlock Text="Lượt đã phát hành:" FontSize="12" Foreground="#64748B"/>
                                                <TextBlock FontSize="12" FontWeight="Bold" Foreground="#0064D2" HorizontalAlignment="Right">
                                                    <Run Text="{Binding KhuyenMaiDangChon.SoLuongDaDung}"/>
                                                    <Run Text=" / " Foreground="#94A3B8"/>
                                                    <Run Text="{Binding KhuyenMaiDangChon.SoLuongToiDa}"/>
                                                    <Run Text="{Binding KhuyenMaiDangChon.SoLuongConLai, StringFormat=' (Còn {0})'}" Foreground="#0E9F6E" FontWeight="Normal"/>
                                                </TextBlock>
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <!-- Huy hiệu trạng thái -->
                                    <Grid>
                                        <TextBlock Text="Trạng thái áp dụng:" FontSize="12" Foreground="#64748B" VerticalAlignment="Center"/>
                                        <Border Background="{Binding KhuyenMaiDangChon.MauTrangThai, Converter={StaticResource ColorToBrush}}"
                                                CornerRadius="10" Padding="10,4" HorizontalAlignment="Right">
                                            <TextBlock Text="{Binding KhuyenMaiDangChon.TenHienThiTrangThai}" Foreground="White" FontSize="11" FontWeight="Bold"/>
                                        </Border>
                                    </Grid>
                                </StackPanel>
                            </ScrollViewer>

                            <!-- Footer nút thao tác nhanh -->
                            <Border Grid.Row="2" Background="#F8FAFC" CornerRadius="0,0,12,12" Padding="16,12" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Button Grid.Column="0" Content="✏️ Sửa Voucher" Command="{Binding MoDialogSuaCommand}"
                                            Background="{StaticResource MauHomestayBlue}" Foreground="White" FontWeight="Bold"
                                            Padding="0,8" BorderThickness="0" Cursor="Hand">
                                        <Button.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="6"/>
                                            </Style>
                                        </Button.Resources>
                                    </Button>

                                    <Button Grid.Column="2" Content="🔒 Khóa / Mở" Command="{Binding KhoaMoKhoaCommand}"
                                            Background="White" BorderBrush="#CBD5E1" BorderThickness="1" Foreground="#475569" FontWeight="SemiBold"
                                            Padding="0,8" Cursor="Hand">
                                        <Button.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="6"/>
                                            </Style>
                                        </Button.Resources>
                                    </Button>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>

        <!-- ================= MODAL FORM THÊM / SỬA MÃ GIẢM GIÁ HOMESTAYSYSTEM ================= -->
        <Grid Background="#70000000" Visibility="{Binding HienThiDialogForm, Converter={StaticResource BoolToVis}}">
            <Border Width="540" MaxHeight="620" Background="White" CornerRadius="14" Padding="28,24" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" Direction="270" ShadowDepth="4" Opacity="0.2" Color="#000000"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Header Modal -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
                        <Border Width="36" Height="36" CornerRadius="18" Background="{StaticResource MauHomestayOrangeNhat}" Margin="0,0,10,0">
                            <TextBlock Text="🎟️" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding TieuDeDialog}" FontSize="16" FontWeight="Bold" Foreground="#0F172A"/>
                            <TextBlock Text="Cấu hình thông số voucher ưu đãi sàn HomestaySystem" FontSize="11" Foreground="#64748B"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Thân form cuộn an toàn tránh tràn màn hình -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" MaxHeight="440" Padding="0,0,8,0">
                        <StackPanel>
                            <!-- Mã Code & % Giảm -->
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="14"/>
                                    <ColumnDefinition Width="140"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Mã Voucher Code (*):" FontWeight="SemiBold" FontSize="12" Foreground="#334155" Margin="0,0,0,5"/>
                                    <TextBox Text="{Binding KhuyenMaiForm.MaCode, UpdateSourceTrigger=PropertyChanged}" Padding="10,8" FontSize="13" CharacterCasing="Upper" BorderBrush="#CBD5E1" BorderThickness="1">
                                        <TextBox.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="6"/>
                                            </Style>
                                        </TextBox.Resources>
                                    </TextBox>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="% Giảm giá (*):" FontWeight="SemiBold" FontSize="12" Foreground="#334155" Margin="0,0,0,5"/>
                                    <TextBox Text="{Binding KhuyenMaiForm.PhanTramGiam, UpdateSourceTrigger=PropertyChanged}" Padding="10,8" FontSize="13" BorderBrush="#CBD5E1" BorderThickness="1">
                                        <TextBox.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="6"/>
                                            </Style>
                                        </TextBox.Resources>
                                    </TextBox>
                                </StackPanel>
                            </Grid>

                            <!-- Tên chương trình -->
                            <TextBlock Text="Tên chương trình ưu đãi (*):" FontWeight="SemiBold" FontSize="12" Foreground="#334155" Margin="0,0,0,5"/>
                            <TextBox Text="{Binding KhuyenMaiForm.TenChuongTrinh, UpdateSourceTrigger=PropertyChanged}" Padding="10,8" FontSize="13" Margin="0,0,0,14" BorderBrush="#CBD5E1" BorderThickness="1">
                                <TextBox.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="6"/>
                                    </Style>
                                </TextBox.Resources>
                            </TextBox>

                            <!-- Giảm tối đa & Đơn tối thiểu -->
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="14"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Giảm tối đa (VNĐ):" FontWeight="SemiBold" FontSize="12" Foreground="#334155" Margin="0,0,0,5"/>
                                    <TextBox Text="{Binding KhuyenMaiForm.GiamToiDa, UpdateSourceTrigger=PropertyChanged}" Padding="10,8" FontSize="13" BorderBrush="#CBD5E1" BorderThickness="1">
                                        <TextBox.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="6"/>
                                            </Style>
                                        </TextBox.Resources>
                                    </TextBox>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Đơn tối thiểu (VNĐ):" FontWeight="SemiBold" FontSize="12" Foreground="#334155" Margin="0,0,0,5"/>
                                    <TextBox Text="{Binding KhuyenMaiForm.DonGiaToiThieu, UpdateSourceTrigger=PropertyChanged}" Padding="10,8" FontSize="13" BorderBrush="#CBD5E1" BorderThickness="1">
                                        <TextBox.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="6"/>
                                            </Style>
                                        </TextBox.Resources>
                                    </TextBox>
                                </StackPanel>
                            </Grid>

                            <!-- Ngày bắt đầu & Ngày kết thúc -->
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="14"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Ngày bắt đầu áp dụng:" FontWeight="SemiBold" FontSize="12" Foreground="#334155" Margin="0,0,0,5"/>
                                    <DatePicker SelectedDate="{Binding KhuyenMaiForm.NgayBatDau}" Height="36"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Ngày hết hạn:" FontWeight="SemiBold" FontSize="12" Foreground="#334155" Margin="0,0,0,5"/>
                                    <DatePicker SelectedDate="{Binding KhuyenMaiForm.NgayKetThuc}" Height="36"/>
                                </StackPanel>
                            </Grid>

                            <!-- Số lượng phát hành -->
                            <StackPanel Margin="0,0,0,10">
                                <TextBlock Text="Số lượng phát hành tối đa:" FontWeight="SemiBold" FontSize="12" Foreground="#334155" Margin="0,0,0,5"/>
                                <TextBox Text="{Binding KhuyenMaiForm.SoLuongToiDa, UpdateSourceTrigger=PropertyChanged}" Padding="10,8" FontSize="13" BorderBrush="#CBD5E1" BorderThickness="1">
                                    <TextBox.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="6"/>
                                        </Style>
                                    </TextBox.Resources>
                                </TextBox>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Nút hành động cố định ở chân modal (KHÔNG BAO GIỜ BỊ TRÀN HAY KHUẤT) -->
                    <Border Grid.Row="2" Margin="0,16,0,0" Padding="0,14,0,0" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Hủy bỏ" Command="{Binding HuyDialogFormCommand}" Padding="20,10" Margin="0,0,12,0"
                                    Background="#E2E8F0" Foreground="#475569" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand" MinWidth="100">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="8"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                            <Button Content="💾 Lưu Voucher" Command="{Binding LuuKhuyenMaiCommand}" Padding="24,10"
                                    Background="{StaticResource MauHomestayOrange}" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand" MinWidth="140">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="8"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
