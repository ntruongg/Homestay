@model OwnerDashboardViewModel

@{
    Layout = null;
    ViewData["Title"] = "Bảng điều khiển chủ nhà - Stayly";

    var approvedProps = Model.Properties.Where(p => (p.ApprovalStatus ?? "").Equals("Approved", StringComparison.OrdinalIgnoreCase)).ToList();
    var pendingProps = Model.Properties.Where(p => (p.ApprovalStatus ?? "").Equals("Pending", StringComparison.OrdinalIgnoreCase)).ToList();
    var rejectedProps = Model.Properties.Where(p => (p.ApprovalStatus ?? "").Equals("Rejected", StringComparison.OrdinalIgnoreCase)).ToList();
}

<!doctype html>
<html lang="vi">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>@ViewData["Title"]</title>

    <!-- Google Fonts DM Sans -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,400..800;1,9..40,400..800&display=swap" rel="stylesheet">

    <!-- Bootstrap 5.3 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <!-- Custom CSS (Soft & Harmonious Monochromatic Ocean Blue) -->
    <link rel="stylesheet" href="/css/site.css" asp-append-version="true">
</head>
<body class="dashboard-body-wrapper">

    <!-- ==========================================================================
         1. Sidebar (Cột trái, rộng ~250px, fixed, nền #caf0f8, góc phải bo tròn 24px)
         ========================================================================== -->
    <aside class="dashboard-sidebar-fixed">
        <div>
            <!-- Logo Stayly to, in đậm, màu Primary -->
            <a href="/" class="dashboard-sidebar-logo">
                <span class="brand-icon"><i class="bi bi-water"></i></span>
                <span>Stayly</span>
            </a>
            <span class="dashboard-sidebar-tag">Host Dashboard</span>

            <!-- 3 Tabs dạng menu dọc -->
            <nav class="dashboard-nav-tabs">
                <!-- Tab 1: Quản lý cơ sở (Mặc định active) -->
                <button type="button" class="dashboard-tab-link @(Model.ActiveTab == "properties" ? "active" : "")" data-tab-target="tabProperties" id="tabBtnProperties" onclick="switchDashboardTab('tabProperties', this)">
                    <i class="bi bi-houses-fill"></i>
                    <span>Quản lý cơ sở</span>
                </button>

                <!-- Tab 2: Quản lý đơn đặt phòng -->
                <button type="button" class="dashboard-tab-link @(Model.ActiveTab == "bookings" ? "active" : "")" data-tab-target="tabBookings" id="tabBtnBookings" onclick="switchDashboardTab('tabBookings', this)">
                    <i class="bi bi-calendar2-check-fill"></i>
                    <span>Quản lý đơn đặt phòng</span>
                </button>

                <!-- Tab 3: Quản lý đánh giá -->
                <button type="button" class="dashboard-tab-link @(Model.ActiveTab == "reviews" ? "active" : "")" data-tab-target="tabReviews" id="tabBtnReviews" onclick="switchDashboardTab('tabReviews', this)">
                    <i class="bi bi-chat-square-quote-fill"></i>
                    <span>Quản lý đánh giá</span>
                </button>
            </nav>
        </div>

        <!-- Đáy Sidebar: Nút Về trang chủ & Nút Đăng xuất -->
        <div class="dashboard-sidebar-footer">
            <a href="/" class="btn-dashboard-home">
                <i class="bi bi-arrow-left"></i>
                <span>Về trang chủ</span>
            </a>

            <form asp-controller="Home" asp-action="Logout" method="post" id="dashboardLogoutForm">
                <button type="submit" class="btn-dashboard-logout" onclick="handleDashboardLogout()">
                    <i class="bi bi-box-arrow-right"></i>
                    <span>Đăng xuất</span>
                </button>
                @Html.AntiForgeryToken()
            </form>
        </div>
    </aside>

    <!-- ==========================================================================
         2. Main Content (Nội dung chính bên phải, nền #f8f9fc, thay đổi theo Tab)
         ========================================================================== -->
    <main class="dashboard-main-content">
        <!-- Top Bar Chào Đón & Thông tin chung -->
        <div class="dashboard-header-bar">
            <div class="dashboard-title-group">
                <h1 id="currentTabHeading">Quản lý cơ sở lưu trú</h1>
                <p id="currentTabSubheading">Theo dõi tình trạng hoạt động, hồ sơ xét duyệt và thông tin các cơ sở của bạn.</p>
            </div>
            <div class="d-flex align-items-center gap-3">
                <div class="text-end d-none d-sm-block">
                    <div class="fw-bold text-dark small">Chủ cơ sở lưu trú</div>
                    <div class="text-muted small">@DateTime.Now.ToString("dd/MM/yyyy")</div>
                </div>
                <div class="user-avatar-circle" style="width: 42px; height: 42px; font-size: 1.05rem;">
                    H
                </div>
            </div>
        </div>

        <!-- Thông báo từ TempData -->
        @if (TempData["Success"] is string successMsg)
        {
            <div class="alert alert-success alert-dismissible fade show rounded-4 shadow-sm mb-4" role="alert">
                <i class="bi bi-check-circle-fill me-2"></i> @successMsg
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @if (TempData["Error"] is string errorMsg)
        {
            <div class="alert alert-danger alert-dismissible fade show rounded-4 shadow-sm mb-4" role="alert">
                <i class="bi bi-exclamation-triangle-fill me-2"></i> @errorMsg
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <!-- ==========================================================================
             TAB 1: QUẢN LÝ CƠ SỞ (Property Management)
             ========================================================================== -->
        <section class="dashboard-tab-view @(Model.ActiveTab == "properties" ? "active" : "")" id="tabProperties">
            <!-- Top row (Thống kê): 3 khối hình chữ nhật bo tròn 16px, nền #caf0f8, chữ & số to màu #0077b6 -->
            <div class="row g-4 mb-4">
                <!-- Khối 1: Cơ sở đang hoạt động -->
                <div class="col-md-4">
                    <div class="stat-card-harmonious">
                        <div class="stat-number-prominent">@approvedProps.Count</div>
                        <p class="stat-label-text">Cơ sở đang hoạt động</p>
                    </div>
                </div>

                <!-- Khối 2: Đang chờ duyệt -->
                <div class="col-md-4">
                    <div class="stat-card-harmonious">
                        <div class="stat-number-prominent">@pendingProps.Count</div>
                        <p class="stat-label-text">Đang chờ duyệt</p>
                    </div>
                </div>

                <!-- Khối 3: Bị từ chối duyệt -->
                <div class="col-md-4">
                    <div class="stat-card-harmonious">
                        <div class="stat-number-prominent">@rejectedProps.Count</div>
                        <p class="stat-label-text">Bị từ chối duyệt</p>
                    </div>
                </div>
            </div>

            <!-- Header Danh sách cơ sở & Nút Tạo cơ sở mới -->
            <div class="d-flex align-items-center justify-content-between mb-3 flex-wrap gap-2">
                <div>
                    <h3 class="fs-5 fw-bold mb-0 text-navy">Danh sách cơ sở của bạn</h3>
                    <span class="text-muted small">Tổng số: <strong>@Model.Properties.Count</strong> cơ sở</span>
                </div>
                <button type="button" class="btn btn-primary rounded-pill px-4 py-2 fw-bold shadow-sm" data-bs-toggle="modal" data-bs-target="#createPropertyModal">
                    <i class="bi bi-plus-lg me-1"></i> Tạo cơ sở mới
                </button>
            </div>

            <!-- Danh sách cơ sở: List thẻ nằm ngang (ảnh thumbnail bo góc trái + thông tin phải) -->
            <div class="properties-list-container" id="propertiesListWrapper">
                @if (Model.Properties.Count == 0)
                {
                    <div class="card p-5 text-center border-0" style="border-radius: 16px; box-shadow: var(--stayly-shadow);">
                        <i class="bi bi-house-add text-primary display-4 mb-3"></i>
                        <h4 class="fw-bold text-navy">Bạn chưa đăng ký cơ sở lưu trú nào</h4>
                        <p class="text-muted small mb-3">Hãy tạo cơ sở đầu tiên để Ban Quản trị phê duyệt và bắt đầu đón khách.</p>
                        <div>
                            <button type="button" class="btn btn-primary rounded-pill px-4 py-2 fw-bold shadow-sm" data-bs-toggle="modal" data-bs-target="#createPropertyModal">
                                <i class="bi bi-plus-lg me-1"></i> Đăng ký cơ sở ngay
                            </button>
                        </div>
                    </div>
                }
                else
                {
                    @foreach (var prop in Model.Properties)
                    {
                        var status = prop.ApprovalStatus ?? "Approved";
                        var isApproved = status.Equals("Approved", StringComparison.OrdinalIgnoreCase);
                        var isPending = status.Equals("Pending", StringComparison.OrdinalIgnoreCase);
                        var isRejected = status.Equals("Rejected", StringComparison.OrdinalIgnoreCase);
                        var thumbUrl = !string.IsNullOrWhiteSpace(prop.CoverImageUrl)
                            ? prop.CoverImageUrl
                            : "https://images.unsplash.com/photo-1542314831-068cd1dbfeeb?auto=format&fit=crop&w=800&q=80";

                        <article class="property-card-host">
                            <div class="row g-0">
                                <!-- Thumbnail bo góc 16px bên trái -->
                                <div class="col-md-4 col-lg-3">
                                    <div class="property-thumb-container">
                                        <img src="@thumbUrl" alt="@prop.Name" class="property-thumb-img" loading="lazy">
                                    </div>
                                </div>

                                <!-- Thông tin cơ sở bên phải -->
                                <div class="col-md-8 col-lg-9">
                                    <div class="property-info-container">
                                        <div>
                                            <div class="d-flex align-items-center justify-content-between mb-2">
                                                <span class="property-status-pill @(isApproved ? "status-approved" : isPending ? "status-pending" : "status-rejected")">
                                                    <i class="bi @(isApproved ? "bi-check-circle-fill" : isPending ? "bi-clock-fill" : "bi-x-circle-fill")"></i>
                                                    @(isApproved ? "Đang hoạt động" : isPending ? "Đang chờ duyệt" : "Bị từ chối")
                                                </span>
                                                <span class="badge bg-light text-primary rounded-pill px-3 py-1 fw-bold text-uppercase small">
                                                    @(prop.Type ?? "Homestay")
                                                </span>
                                            </div>

                                            <h3 class="fs-5 fw-bold text-navy mb-1">@prop.Name</h3>
                                            <p class="text-muted small mb-2">
                                                <i class="bi bi-geo-alt-fill text-primary me-1"></i>
                                                @(prop.Address ?? $"{prop.Ward}, {prop.City}")
                                            </p>

                                            @if (!string.IsNullOrWhiteSpace(prop.RejectionReason))
                                            {
                                                <div class="alert alert-danger py-2 px-3 small rounded-3 mb-2">
                                                    <i class="bi bi-exclamation-triangle-fill me-1"></i>
                                                    <strong>Lý do từ chối:</strong> @prop.RejectionReason
                                                </div>
                                            }
                                            else if (!string.IsNullOrWhiteSpace(prop.Policy))
                                            {
                                                <p class="text-muted small mb-2 text-truncate" style="max-width: 600px;">
                                                    <i class="bi bi-info-circle text-primary me-1"></i> @prop.Policy
                                                </p>
                                            }

                                            <div class="d-flex align-items-center gap-3 text-muted small">
                                                <span><i class="bi bi-door-open me-1 text-primary"></i> @prop.RoomsCount phòng</span>
                                                <span><i class="bi bi-telephone me-1 text-primary"></i> @(prop.Phone ?? "Chưa có SĐT")</span>
                                            </div>
                                        </div>

                                        <!-- Action: Nút Xem chi tiết & Sửa lại -->
                                        <div class="d-flex align-items-center justify-content-between pt-3 mt-3 border-top flex-wrap gap-2">
                                            <span class="text-muted small">Mã cơ sở: <strong>#CS-@prop.Id</strong></span>
                                            <div class="d-flex align-items-center gap-2">
                                                @if (isRejected)
                                                {
                                                    <button type="button" class="btn btn-sm btn-warning rounded-pill px-3 fw-bold shadow-sm text-dark" onclick="openResubmitModal(@prop.Id)">
                                                        <i class="bi bi-pencil-square me-1"></i> Sửa &amp; Gửi lại
                                                    </button>
                                                }
                                                <button type="button" class="btn btn-sm btn-primary rounded-pill px-4 fw-bold shadow-sm" onclick="openOwnerPropertyDetails(@prop.Id)">
                                                    <span>Xem chi tiết</span>
                                                    <i class="bi bi-arrow-right-short fs-6"></i>
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </article>
                    }
                }
            </div>
        </section>

        <!-- ==========================================================================
             TAB 2: QUẢN LÝ ĐƠN ĐẶT PHÒNG (Booking Management)
             ========================================================================== -->
        <section class="dashboard-tab-view @(Model.ActiveTab == "bookings" ? "active" : "")" id="tabBookings">
            <!-- Top row (Bộ lọc): Thanh ngang trắng, shadow mượt, bo góc 50px, 2 Dropdown -->
            <div class="filter-bar-pill-card">
                <!-- Dropdown 1: Lọc theo Cơ sở -->
                <div class="d-flex align-items-center gap-2">
                    <label for="filterBookingProperty">
                        <i class="bi bi-building"></i>
                        <span>Cơ sở:</span>
                    </label>
                    <select id="filterBookingProperty" class="filter-select-round" onchange="filterBookingsList()">
                        <option value="all">Tất cả cơ sở</option>
                        @foreach (var p in Model.Properties)
                        {
                            <option value="@p.Name">@p.Name</option>
                        }
                    </select>
                </div>

                <!-- Dropdown 2: Lọc theo Trạng thái -->
                <div class="d-flex align-items-center gap-2">
                    <label for="filterBookingStatus">
                        <i class="bi bi-funnel"></i>
                        <span>Trạng thái:</span>
                    </label>
                    <select id="filterBookingStatus" class="filter-select-round" onchange="filterBookingsList()">
                        <option value="all">Tất cả trạng thái</option>
                        <option value="Pending">Chờ duyệt (Pending)</option>
                        <option value="Confirmed">Đã xác nhận (Confirmed)</option>
                        <option value="CheckedIn">Đang lưu trú (CheckedIn)</option>
                        <option value="Completed">Đã hoàn thành (Completed)</option>
                        <option value="Cancelled">Đã hủy (Cancelled)</option>
                    </select>
                </div>
            </div>

            <!-- Indicator số lượng đơn -->
            <div class="d-flex align-items-center justify-content-between mb-3 px-2">
                <span class="text-muted small" id="bookingCountIndicator">
                    Hiển thị: <strong>@Model.Bookings.Count</strong> đơn đặt phòng
                </span>
            </div>

            <!-- Bottom row (Danh sách đơn): Thẻ nằm ngang (Card bo tròn 16px) -->
            <div class="bookings-list-container" id="bookingCardsContainer">
                @if (Model.Bookings.Count == 0)
                {
                    <div class="card p-5 text-center border-0" style="border-radius: 16px; box-shadow: var(--stayly-shadow);">
                        <i class="bi bi-calendar2-x text-primary display-4 mb-3"></i>
                        <h4 class="fw-bold text-navy">Chưa có đơn đặt phòng nào</h4>
                        <p class="text-muted small">Các đơn đặt phòng từ khách du lịch sẽ hiển thị tại đây khi khách gửi yêu cầu.</p>
                    </div>
                }
                else
                {
                    @foreach (var b in Model.Bookings)
                    {
                        var statusClass = b.Status switch
                        {
                            "Pending" => "status-pending",
                            "Confirmed" => "status-confirmed",
                            "CheckedIn" => "status-checkedin",
                            "Completed" => "status-completed",
                            "Cancelled" => "status-cancelled",
                            _ => "status-pending"
                        };

                        var statusText = b.Status switch
                        {
                            "Pending" => "Chờ duyệt",
                            "Confirmed" => "Đã xác nhận",
                            "CheckedIn" => "Đang lưu trú",
                            "Completed" => "Đã hoàn thành",
                            "Cancelled" => "Đã hủy",
                            _ => b.Status
                        };

                        <article class="booking-item-card"
                                 data-id="@b.Id"
                                 data-property="@b.PropertyName"
                                 data-status="@b.Status"
                                 data-guest="@b.GuestName"
                                 data-phone="@b.GuestPhone"
                                 data-email="@b.GuestEmail"
                                 data-rooms="@string.Join(", ", b.RoomNumbers)"
                                 data-guests="@b.GuestCount"
                                 data-checkin="@b.CheckIn.ToString("dd/MM/yyyy")"
                                 data-checkout="@b.CheckOut.ToString("dd/MM/yyyy")"
                                 data-amount="@b.TotalAmount.ToString("N0") ₫">
                            <div class="row align-items-center g-3">
                                <!-- Info 1: Mã đơn & Tên khách hàng -->
                                <div class="col-md-3">
                                    <div class="d-flex align-items-center gap-2 mb-1">
                                        <span class="booking-code-pill">#@b.Id</span>
                                        <strong class="text-navy">@b.GuestName</strong>
                                    </div>
                                    <div class="text-muted small">
                                        <i class="bi bi-telephone me-1 text-primary"></i> @b.GuestPhone
                                    </div>
                                </div>

                                <!-- Info 2: Tên cơ sở & Phòng -->
                                <div class="col-md-3">
                                    <div class="fw-bold text-dark small mb-1">@b.PropertyName</div>
                                    <div class="text-muted small">
                                        <i class="bi bi-door-open me-1 text-primary"></i>
                                        Phòng: <strong>@(b.RoomNumbers.Count > 0 ? string.Join(", ", b.RoomNumbers) : "Nguyên căn")</strong>
                                    </div>
                                </div>

                                <!-- Info 3: Thời gian check-in / check-out -->
                                <div class="col-md-3">
                                    <div class="booking-date-range small">
                                        <i class="bi bi-calendar-event text-primary me-1"></i>
                                        <span>@b.CheckIn.ToString("dd/MM")</span>
                                        <i class="bi bi-arrow-right mx-1 text-muted"></i>
                                        <span>@b.CheckOut.ToString("dd/MM/yyyy")</span>
                                    </div>
                                    <div class="text-muted small mt-1">
                                        Số khách: <strong>@b.GuestCount người</strong>
                                    </div>
                                </div>

                                <!-- Info 4: Tổng tiền & Badge trạng thái -->
                                <div class="col-md-3 text-md-end">
                                    <div class="booking-price-text mb-1">
                                        @b.TotalAmount.ToString("N0") <span class="fs-6">₫</span>
                                    </div>
                                    <span class="booking-status-tag @statusClass mb-2">
                                        @statusText
                                    </span>
                                </div>
                            </div>

                            <!-- Actions Row: Xem chi tiết & Duyệt đơn -->
                            <div class="d-flex align-items-center justify-content-between pt-3 mt-3 border-top flex-wrap gap-2">
                                <button type="button" class="btn btn-sm btn-outline-primary rounded-pill px-3" onclick="openBookingDetailModal(this)">
                                    <i class="bi bi-receipt me-1"></i> Xem chi tiết thanh toán
                                </button>

                                <div class="d-flex align-items-center gap-2">
                                    @if (b.Status == "Pending")
                                    {
                                        <form asp-action="UpdateBookingStatus" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="bookingId" value="@b.Id">
                                            <input type="hidden" name="status" value="Confirmed">
                                            <button type="submit" class="btn btn-sm btn-primary rounded-pill px-3 fw-bold">
                                                <i class="bi bi-check2-circle me-1"></i> Xác nhận đơn
                                            </button>
                                        </form>

                                        <form asp-action="UpdateBookingStatus" method="post" class="d-inline" onsubmit="return confirm('Bạn có chắc chắn muốn hủy đơn đặt phòng này?');">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="bookingId" value="@b.Id">
                                            <input type="hidden" name="status" value="Cancelled">
                                            <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill px-3">
                                                Từ chối
                                            </button>
                                        </form>
                                    }
                                    else if (b.Status == "Confirmed")
                                    {
                                        <form asp-action="UpdateBookingStatus" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="bookingId" value="@b.Id">
                                            <input type="hidden" name="status" value="CheckedIn">
                                            <button type="submit" class="btn btn-sm btn-info text-white rounded-pill px-3">
                                                Nhận phòng (Check-in)
                                            </button>
                                        </form>
                                    }
                                    else if (b.Status == "CheckedIn")
                                    {
                                        <form asp-action="UpdateBookingStatus" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="bookingId" value="@b.Id">
                                            <input type="hidden" name="status" value="Completed">
                                            <button type="submit" class="btn btn-sm btn-success rounded-pill px-3">
                                                Trả phòng (Check-out)
                                            </button>
                                        </form>
                                    }
                                </div>
                            </div>
                        </article>
                    }
                }
            </div>
        </section>

        <!-- ==========================================================================
             TAB 3: QUẢN LÝ ĐÁNH GIÁ (Review Management)
             ========================================================================== -->
        <section class="dashboard-tab-view @(Model.ActiveTab == "reviews" ? "active" : "")" id="tabReviews">
            <!-- Top row (Bộ lọc): Lọc theo cơ sở & ngày tháng -->
            <div class="filter-bar-pill-card">
                <!-- Dropdown lọc theo Cơ sở -->
                <div class="d-flex align-items-center gap-2">
                    <label for="filterReviewProperty">
                        <i class="bi bi-building"></i>
                        <span>Cơ sở:</span>
                    </label>
                    <select id="filterReviewProperty" class="filter-select-round" onchange="filterReviewsList()">
                        <option value="all">Tất cả cơ sở</option>
                        @foreach (var p in Model.Properties)
                        {
                            <option value="@p.Name">@p.Name</option>
                        }
                    </select>
                </div>

                <!-- Input lọc theo Ngày -->
                <div class="d-flex align-items-center gap-2">
                    <label for="filterReviewDate">
                        <i class="bi bi-calendar3"></i>
                        <span>Ngày đánh giá:</span>
                    </label>
                    <input type="date" id="filterReviewDate" class="filter-select-round" onchange="filterReviewsList()">
                    <button type="button" class="btn btn-sm btn-link text-muted p-0" onclick="clearReviewDateFilter()">Xóa lọc ngày</button>
                </div>
            </div>

            <!-- Indicator số lượng đánh giá -->
            <div class="d-flex align-items-center justify-content-between mb-3 px-2">
                <span class="text-muted small">
                    Tổng số: <strong id="reviewTotalCount">@Model.Reviews.Count</strong> đánh giá từ khách lưu trú
                </span>
            </div>

            <!-- Danh sách Review Cards -->
            <div class="reviews-list-container" id="reviewCardsContainer">
                @if (Model.Reviews.Count == 0)
                {
                    <div class="card p-5 text-center border-0" style="border-radius: 16px; box-shadow: var(--stayly-shadow);">
                        <i class="bi bi-chat-heart text-primary display-4 mb-3"></i>
                        <h4 class="fw-bold text-navy">Chưa có đánh giá nào</h4>
                        <p class="text-muted small">Sau khi khách hàng hoàn tất chuyến lưu trú, đánh giá và nhận xét sẽ hiển thị tại đây.</p>
                    </div>
                }
                else
                {
                    @foreach (var rev in Model.Reviews)
                    {
                        <article class="review-item-card"
                                 data-property="@rev.PropertyName"
                                 data-date="@rev.ReviewDate.ToString("yyyy-MM-dd")"
                                 data-id="@rev.Id">
                            <div class="d-flex align-items-start justify-content-between mb-2">
                                <div class="d-flex align-items-center gap-3">
                                    <div class="user-avatar-circle">
                                        @(string.IsNullOrWhiteSpace(rev.GuestName) ? "K" : rev.GuestName.Substring(0, 1).ToUpper())
                                    </div>
                                    <div>
                                        <div class="fw-bold text-navy">@rev.GuestName</div>
                                        <div class="text-muted small">
                                            Đã lưu trú tại: <strong class="text-primary">@rev.PropertyName</strong> • Ngày: @rev.ReviewDate.ToString("dd/MM/yyyy")
                                        </div>
                                    </div>
                                </div>
                                <div class="review-rating-stars">
                                    @for (var s = 0; s < rev.Rating; s++)
                                    {
                                        <i class="bi bi-star-fill text-warning"></i>
                                    }
                                </div>
                            </div>

                            <p class="review-content-text mb-3">@rev.Comment</p>

                            <div class="d-flex justify-content-end pt-2 border-top">
                                <button type="button" class="btn btn-sm btn-outline-primary rounded-pill px-3" onclick="openReplyReviewModal(@rev.Id, '@rev.GuestName', '@rev.PropertyName')">
                                    <i class="bi bi-reply-fill me-1"></i> Phản hồi đánh giá
                                </button>
                            </div>
                        </article>
                    }
                }
            </div>
        </section>
    </main>

    <!-- ==========================================================================
         3. MODALS HỆ THỐNG
         ========================================================================== -->

    <!-- Modal 1: Đăng ký cơ sở lưu trú mới (Create Property Modal) -->
    <div class="modal fade" id="createPropertyModal" tabindex="-1" aria-labelledby="createPropModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content stayly-modal">
                <div class="modal-header-accent"></div>
                <div class="modal-body stayly-modal-body p-4 position-relative">
                    <button type="button" class="btn-close position-absolute top-0 end-0 m-3" data-bs-dismiss="modal" aria-label="Close"></button>

                    <div class="d-flex align-items-center gap-2 mb-3">
                        <span class="brand-icon" style="width: 36px; height: 36px; font-size: 1.1rem;"><i class="bi bi-house-add-fill"></i></span>
                        <h4 class="fs-5 fw-bold text-navy mb-0" id="createPropModalLabel">Đăng ký cơ sở lưu trú mới</h4>
                    </div>
                    <p class="text-muted small mb-4">Điền đầy đủ thông tin và tải lên hồ sơ pháp lý để Quản trị viên (Admin WPF) thẩm định kích hoạt.</p>

                    <form asp-action="CreateProperty" method="post" enctype="multipart/form-data" id="createPropertyForm" novalidate>
                        @Html.AntiForgeryToken()

                        <!-- 1. Thông tin cơ bản -->
                        <div class="p-3 bg-light rounded-4 mb-3">
                            <h6 class="fw-bold text-navy small mb-3"><i class="bi bi-info-circle-fill text-primary me-1"></i> 1. Thông tin chung &amp; Liên hệ</h6>
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label class="form-label small fw-bold">Tên cơ sở lưu trú *</label>
                                    <input name="Name" id="createPropName" class="form-control rounded-pill" placeholder="Ví dụ: Stayly Pine Hill Villa" required />
                                    <div class="invalid-feedback">Vui lòng nhập tên cơ sở lưu trú.</div>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label small fw-bold">Loại hình lưu trú *</label>
                                    <select name="Type" id="createPropTypeSelect" class="form-select rounded-pill" onchange="toggleCreatePropertyType(this.value)">
                                        <option value="Homestay">Homestay (Thuê nguyên căn)</option>
                                        <option value="Hotel">Hotel (Khách sạn nhiều phòng)</option>
                                    </select>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label small fw-bold">Số điện thoại đón khách *</label>
                                    <input name="Phone" id="createPropPhone" class="form-control rounded-pill" placeholder="Ví dụ: 0901234567" required />
                                    <div class="invalid-feedback">Vui lòng nhập số điện thoại hợp lệ (9 - 11 chữ số).</div>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label small fw-bold">Email liên hệ *</label>
                                    <input name="Email" id="createPropEmail" type="email" class="form-control rounded-pill" placeholder="contact@homestay.com" required />
                                    <div class="invalid-feedback">Vui lòng nhập địa chỉ email hợp lệ.</div>
                                </div>
                            </div>
                        </div>

                        <!-- 2. Vị trí & Địa chỉ -->
                        <div class="p-3 bg-light rounded-4 mb-3">
                            <h6 class="fw-bold text-navy small mb-3"><i class="bi bi-geo-alt-fill text-primary me-1"></i> 2. Vị trí &amp; Địa chỉ</h6>
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label class="form-label small fw-bold">Địa chỉ số nhà, tên đường *</label>
                                    <input name="Address" id="createPropAddress" class="form-control rounded-pill" placeholder="Ví dụ: 14/2 Khởi Nghĩa Bắc Sơn" required />
                                    <div class="invalid-feedback">Vui lòng nhập địa chỉ cụ thể (số nhà, tên đường).</div>
                                </div>
                                <div class="col-md-3">
                                    <label class="form-label small fw-bold">Phường / Xã</label>
                                    <input name="Ward" id="createPropWard" class="form-control rounded-pill" placeholder="Phường 10" />
                                </div>
                                <div class="col-md-3">
                                    <label class="form-label small fw-bold">Tỉnh / Thành phố *</label>
                                    <input name="City" id="createPropCity" class="form-control rounded-pill" placeholder="Đà Lạt" required />
                                    <div class="invalid-feedback">Vui lòng nhập hoặc chọn Tỉnh / Thành phố.</div>
                                </div>
                            </div>
                        </div>

                        <!-- 3. Cấu hình phòng Homestay / Hotel -->
                        <div class="p-3 bg-light rounded-4 mb-3">
                            <h6 class="fw-bold text-navy small mb-3"><i class="bi bi-door-open-fill text-primary me-1"></i> 3. Cấu hình đặt phòng</h6>

                            <!-- Panel Homestay -->
                            <div id="createHomestayConfigPanel">
                                <div class="alert alert-info py-2 px-3 small rounded-3 mb-3">
                                    <i class="bi bi-info-circle me-1"></i> <strong>Quy chuẩn Homestay nguyên căn:</strong> Khách sẽ đặt trọn gói toàn bộ homestay. Khi được Admin duyệt, hệ thống sẽ tự động tạo một phòng "Nguyên căn" theo giá và sức chứa bạn nhập bên dưới.
                                </div>
                                <div class="row g-3">
                                    <div class="col-md-4">
                                        <label class="form-label small fw-bold">Giá thuê trọn gói / đêm (₫) *</label>
                                        <input name="HomestayPrice" id="createPropHomestayPrice" type="number" step="10000" min="50000" value="650000" class="form-control rounded-pill" />
                                        <div class="invalid-feedback">Giá thuê tối thiểu từ 50.000 ₫/đêm.</div>
                                    </div>
                                    <div class="col-md-4">
                                        <label class="form-label small fw-bold">Sức chứa tối đa (người) *</label>
                                        <input name="HomestayCapacity" id="createPropHomestayCapacity" type="number" min="1" max="50" value="4" class="form-control rounded-pill" />
                                        <div class="invalid-feedback">Sức chứa tối thiểu 1 người.</div>
                                    </div>
                                    <div class="col-md-4">
                                        <label class="form-label small fw-bold">Phân loại không gian</label>
                                        <select name="HomestayRoomTypeId" id="createPropHomestayRoomTypeId" class="form-select rounded-pill">
                                            @foreach (var rt in Model.AvailableRoomTypes)
                                            {
                                                <option value="@rt.Id">@rt.Name</option>
                                            }
                                        </select>
                                    </div>
                                </div>
                            </div>

                            <!-- Panel Hotel -->
                            <div id="createHotelConfigPanel" class="d-none">
                                <div class="alert alert-primary py-2 px-3 small rounded-3 mb-0">
                                    <i class="bi bi-building me-1"></i> <strong>Quy chuẩn Khách sạn (Hotel):</strong> Khách sạn quản lý nhiều phòng độc lập. Sau khi hồ sơ khách sạn được Admin duyệt thành công, bạn có thể tạo thêm không giới hạn các phòng đón khách qua nút <strong>"+ Thêm phòng mới"</strong> trong chi tiết cơ sở.
                                </div>
                            </div>
                        </div>

                        <!-- 4. Hồ sơ pháp lý thẩm định (WPF Admin) -->
                        <div class="p-3 bg-light rounded-4 mb-3">
                            <h6 class="fw-bold text-navy small mb-2"><i class="bi bi-shield-check text-primary me-1"></i> 4. Hồ sơ pháp lý thẩm định (WPF Admin kiểm duyệt)</h6>
                            <p class="text-muted small mb-3">Tải lên tệp ảnh hoặc PDF rõ nét để Admin xác thực pháp lý cơ sở.</p>
                            <div class="row g-3">
                                <div class="col-md-4">
                                    <label class="form-label small fw-bold">Giấy phép kinh doanh</label>
                                    <input name="BusinessLicenseFile" type="file" class="form-control rounded-pill" accept="image/*,.pdf" />
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label small fw-bold">Chứng nhận an toàn PCCC</label>
                                    <input name="FireSafetyDocumentFile" type="file" class="form-control rounded-pill" accept="image/*,.pdf" />
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label small fw-bold">Giấy tờ An ninh trật tự</label>
                                    <input name="SecurityDocumentFile" type="file" class="form-control rounded-pill" accept="image/*,.pdf" />
                                </div>
                            </div>
                        </div>

                        <!-- 5. Tiện ích & Quy định & Ảnh -->
                        <div class="p-3 bg-light rounded-4 mb-3">
                            <h6 class="fw-bold text-navy small mb-3"><i class="bi bi-card-checklist text-primary me-1"></i> 5. Tiện ích &amp; Hình ảnh khuôn viên</h6>
                            <div class="mb-3">
                                <label class="form-label small fw-bold d-block mb-2">Tiện ích có sẵn</label>
                                <div class="d-flex flex-wrap gap-2">
                                    @foreach (var a in Model.AvailableAmenities)
                                    {
                                        <div class="form-check form-check-inline amenity-chip m-0">
                                            <input class="form-check-input" type="checkbox" name="AmenityIds" value="@a.Id" id="createAmenity_@a.Id">
                                            <label class="form-check-label small" for="createAmenity_@a.Id">@a.Name</label>
                                        </div>
                                    }
                                </div>
                            </div>
                            <div class="mb-3">
                                <label class="form-label small fw-bold">Chính sách &amp; Quy định nhận/trả phòng</label>
                                <textarea name="Policy" class="form-control rounded-4 p-3" rows="2" placeholder="Ví dụ: Nhận phòng từ 14:00, trả phòng trước 12:00. Không mang giày dép vào nhà."></textarea>
                            </div>
                            <div>
                                <label class="form-label small fw-bold">Hình ảnh khuôn viên cơ sở</label>
                                <input name="PhotoFiles" type="file" class="form-control rounded-pill" multiple accept="image/*" />
                            </div>
                        </div>

                        <div class="d-flex justify-content-end gap-2 pt-2">
                            <button type="button" class="btn btn-outline-secondary rounded-pill px-4" data-bs-dismiss="modal">Hủy</button>
                            <button type="submit" class="btn btn-primary rounded-pill px-4 fw-bold shadow-sm">
                                <i class="bi bi-send-fill me-1"></i> Gửi hồ sơ duyệt
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <!-- Modal 2: Chi tiết cơ sở lưu trú của Chủ nhà (Owner Property Details Modal) -->
    <div class="modal fade" id="ownerPropertyDetailsModal" tabindex="-1" aria-labelledby="ownerPropertyDetailsTitle" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-xl">
            <div class="modal-content stayly-modal">
                <div class="modal-header-accent"></div>
                <div class="modal-body stayly-modal-body p-4 position-relative">
                    <button type="button" class="btn-close position-absolute top-0 end-0 m-3" data-bs-dismiss="modal" aria-label="Close"></button>

                    <!-- Header modal chi tiết -->
                    <div class="d-flex align-items-center gap-2 mb-1 flex-wrap">
                        <h4 class="fs-4 fw-bold text-navy mb-0" id="opdTitle">Chi tiết Cơ sở</h4>
                        <span class="badge rounded-pill px-3 py-1 fw-bold text-uppercase small" id="opdTypeBadge">Homestay</span>
                        <span class="property-status-pill" id="opdStatusBadge">Đang hoạt động</span>
                        <button type="button" class="btn btn-sm btn-outline-primary rounded-pill px-3 fw-bold ms-auto me-4 d-none" id="opdEditToggleBtn" onclick="toggleOwnerPropertyEditMode()">
                            <i class="bi bi-pencil-square me-1"></i> Chỉnh sửa thông tin
                        </button>
                    </div>
                    <p class="text-muted small mb-3" id="opdAddress"><i class="bi bi-geo-alt-fill text-primary me-1"></i> Đang tải địa chỉ...</p>

                    <!-- Dynamic Body Container (View Mode) -->
                    <div id="opdDynamicBody" class="py-2">
                        <div class="text-center py-5">
                            <div class="spinner-border text-primary mb-2" role="status"></div>
                            <div class="text-muted small">Đang tải thông tin chi tiết cơ sở...</div>
                        </div>
                    </div>

                    <!-- Edit Form Container (Edit Mode) -->
                    <div id="opdEditContainer" class="py-2 d-none">
                        <form asp-action="UpdateProperty" method="post" enctype="multipart/form-data" id="opdEditForm">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="Id" id="opdEditPropId" value="" />
                            <input type="hidden" name="Resubmit" value="false" />

                            <div class="alert alert-info py-2 px-3 small rounded-3 mb-3">
                                <i class="bi bi-info-circle me-1"></i> <strong>Chế độ chỉnh sửa thông tin:</strong> Cập nhật thông tin liên hệ, địa chỉ, tiện ích và chính sách hoạt động của cơ sở.
                            </div>

                            <!-- 1. Thông tin chung & Liên hệ -->
                            <div class="p-3 bg-light rounded-4 mb-3">
                                <h6 class="fw-bold text-navy small mb-3"><i class="bi bi-info-circle-fill text-primary me-1"></i> 1. Thông tin chung &amp; Liên hệ</h6>
                                <div class="row g-3">
                                    <div class="col-md-6">
                                        <label class="form-label small fw-bold">Tên cơ sở lưu trú *</label>
                                        <input name="Name" id="opdEditName" class="form-control rounded-pill" required />
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label small fw-bold">Loại hình</label>
                                        <input name="Type" id="opdEditType" class="form-control rounded-pill" readonly style="background-color: #e9ecef;" />
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label small fw-bold">Số điện thoại *</label>
                                        <input name="Phone" id="opdEditPhone" class="form-control rounded-pill" required />
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label small fw-bold">Email *</label>
                                        <input name="Email" id="opdEditEmail" type="email" class="form-control rounded-pill" required />
                                    </div>
                                </div>
                            </div>

                            <!-- 2. Vị trí & Địa chỉ -->
                            <div class="p-3 bg-light rounded-4 mb-3">
                                <h6 class="fw-bold text-navy small mb-3"><i class="bi bi-geo-alt-fill text-primary me-1"></i> 2. Vị trí &amp; Địa chỉ</h6>
                                <div class="row g-3">
                                    <div class="col-md-6">
                                        <label class="form-label small fw-bold">Địa chỉ cụ thể *</label>
                                        <input name="Address" id="opdEditAddress" class="form-control rounded-pill" required />
                                    </div>
                                    <div class="col-md-3">
                                        <label class="form-label small fw-bold">Phường / Xã</label>
                                        <input name="Ward" id="opdEditWard" class="form-control rounded-pill" />
                                    </div>
                                    <div class="col-md-3">
                                        <label class="form-label small fw-bold">Tỉnh / Thành phố *</label>
                                        <input name="City" id="opdEditCity" class="form-control rounded-pill" required />
                                    </div>
                                </div>
                            </div>

                            <!-- 3. Cấu hình Homestay (nếu là homestay) -->
                            <div class="p-3 bg-light rounded-4 mb-3" id="opdEditHomestayPanel">
                                <h6 class="fw-bold text-navy small mb-3"><i class="bi bi-door-open-fill text-primary me-1"></i> 3. Cấu hình Homestay nguyên căn</h6>
                                <div class="row g-3">
                                    <div class="col-md-4">
                                        <label class="form-label small fw-bold">Giá thuê / đêm (₫)</label>
                                        <input name="HomestayPrice" id="opdEditHomestayPrice" type="number" step="10000" min="50000" class="form-control rounded-pill" />
                                    </div>
                                    <div class="col-md-4">
                                        <label class="form-label small fw-bold">Sức chứa tối đa (người)</label>
                                        <input name="HomestayCapacity" id="opdEditHomestayCapacity" type="number" min="1" max="50" class="form-control rounded-pill" />
                                    </div>
                                    <div class="col-md-4">
                                        <label class="form-label small fw-bold">Phân loại không gian</label>
                                        <select name="HomestayRoomTypeId" id="opdEditHomestayRoomTypeId" class="form-select rounded-pill">
                                            @foreach (var rt in Model.AvailableRoomTypes)
                                            {
                                                <option value="@rt.Id">@rt.Name</option>
                                            }
                                        </select>
                                    </div>
                                </div>
                            </div>

                            <!-- 4. Tiện ích & Quy định -->
                            <div class="p-3 bg-light rounded-4 mb-3">
                                <h6 class="fw-bold text-navy small mb-3"><i class="bi bi-stars text-primary me-1"></i> 4. Tiện ích &amp; Quy định</h6>
                                <div class="mb-3">
                                    <label class="form-label small fw-bold d-block mb-2">Tiện ích cơ sở</label>
                                    <div class="d-flex flex-wrap gap-2">
                                        @foreach (var a in Model.AvailableAmenities)
                                        {
                                            <div class="form-check form-check-inline amenity-chip m-0">
                                                <input class="form-check-input opd-edit-amenity-cb" type="checkbox" name="AmenityIds" value="@a.Id" id="opdAmenity_@a.Id">
                                                <label class="form-check-label small" for="opdAmenity_@a.Id">@a.Name</label>
                                            </div>
                                        }
                                    </div>
                                </div>
                                <div class="mb-0">
                                    <label class="form-label small fw-bold">Chính sách &amp; Quy định nhận/trả phòng</label>
                                    <textarea name="Policy" id="opdEditPolicy" class="form-control rounded-4 p-3" rows="2"></textarea>
                                </div>
                            </div>

                            <!-- 5. Cập nhật hồ sơ pháp lý nếu cần thay thế -->
                            <div class="p-3 bg-light rounded-4 mb-3">
                                <h6 class="fw-bold text-navy small mb-2"><i class="bi bi-shield-check text-primary me-1"></i> 5. Cập nhật hồ sơ pháp lý (Tùy chọn tải file mới thay thế)</h6>
                                <div class="row g-3">
                                    <div class="col-md-4">
                                        <label class="form-label small fw-bold">Giấy phép KD mới</label>
                                        <div class="small text-muted mb-1" id="opdEditOldBusinessLicense"></div>
                                        <input name="BusinessLicenseFile" type="file" class="form-control rounded-pill" accept="image/*,.pdf" />
                                    </div>
                                    <div class="col-md-4">
                                        <label class="form-label small fw-bold">Chứng nhận PCCC mới</label>
                                        <div class="small text-muted mb-1" id="opdEditOldFireSafety"></div>
                                        <input name="FireSafetyDocumentFile" type="file" class="form-control rounded-pill" accept="image/*,.pdf" />
                                    </div>
                                    <div class="col-md-4">
                                        <label class="form-label small fw-bold">Giấy tờ ANTT mới</label>
                                        <div class="small text-muted mb-1" id="opdEditOldSecurity"></div>
                                        <input name="SecurityDocumentFile" type="file" class="form-control rounded-pill" accept="image/*,.pdf" />
                                    </div>
                                </div>
                            </div>

                            <div class="d-flex justify-content-end gap-2 pt-2">
                                <button type="button" class="btn btn-outline-secondary rounded-pill px-4" onclick="toggleOwnerPropertyEditMode(false)">Hủy chỉnh sửa</button>
                                <button type="submit" class="btn btn-primary rounded-pill px-4 fw-bold shadow-sm">
                                    <i class="bi bi-check2-circle me-1"></i> Lưu thay đổi
                                </button>
                            </div>
                        </form>
                    </div>

                    <div class="d-flex justify-content-end gap-2 pt-3 border-top mt-3" id="opdFooterActions">
                        <button type="button" class="btn btn-outline-secondary rounded-pill px-4" data-bs-dismiss="modal">Đóng</button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Modal 3: Sửa & Gửi lại cơ sở bị từ chối (Resubmit Rejected Property Modal) -->
    <div class="modal fade" id="resubmitPropertyModal" tabindex="-1" aria-labelledby="resubmitModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content stayly-modal">
                <div class="modal-header-accent"></div>
