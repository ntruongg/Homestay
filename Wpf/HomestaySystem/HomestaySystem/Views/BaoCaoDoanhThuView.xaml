<UserControl x:Class="HomestaySystem.Views.BaoCaoDoanhThuView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:conv="clr-namespace:HomestaySystem.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="780" d:DesignWidth="1100">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <conv:ChuoiMauToBrushConverter x:Key="ColorToBrush"/>
        <conv:NullToVisibilityConverter x:Key="NullToVis"/>
    </UserControl.Resources>

    <Grid Background="{StaticResource MauNenChinh}">
        <Grid Margin="22">
            <Grid.RowDefinitions>
                <!-- Row 0: Header & Bộ lọc thời gian + Host + Actions -->
                <RowDefinition Height="Auto"/>
                <!-- Row 1: 3 Thẻ thống kê tài chính UniformGrid Columns="3" -->
                <RowDefinition Height="Auto"/>
                <!-- Row 2: Bảng DataGrid dòng tiền chi tiết -->
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 1. BỘ LỌC THỜI GIAN VÀ ĐỐI TÁC CHỦ HOMESTAY -->
            <Border Grid.Row="0" Background="White" CornerRadius="12" Padding="18,14" Margin="0,0,0,16" BorderBrush="{StaticResource MauVien}" BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="8" Direction="270" ShadowDepth="2" Opacity="0.04" Color="#000000"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Tiêu đề phân hệ -->
                    <Grid Grid.Row="0" Margin="0,0,0,14">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="36" Height="36" CornerRadius="18" Background="#EFF6FF" VerticalAlignment="Center" Margin="0,0,10,0">
                                <TextBlock Text="📊" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="BÁO CÁO DOANH THU &amp; QUYẾT TOÁN DÒNG TIỀN (85 / 15)" FontSize="15" FontWeight="Bold" Foreground="#0B3B60"/>
                                <TextBlock Text="Theo dõi dòng tiền ký quỹ minh bạch: 100% Khách trả ➔ 15% Hoa hồng sàn ➔ 85% Trả Đối tác Host" FontSize="11.5" Foreground="#64748B" Margin="0,2,0,0"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Thông báo / loading trạng thái -->
                        <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center" Text="{Binding ThongBaoTrangThai}" Foreground="#0194F3" FontWeight="SemiBold" FontSize="12"/>
                    </Grid>

                    <!-- Dải điều khiển lọc -->
                    <WrapPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Từ ngày -->
                        <StackPanel Orientation="Horizontal" Margin="0,4,14,4" VerticalAlignment="Center">
                            <TextBlock Text="Từ ngày:" VerticalAlignment="Center" FontWeight="Bold" Foreground="#334155" Margin="0,0,8,0" FontSize="12.5"/>
                            <DatePicker SelectedDate="{Binding TuNgay}" Width="130" VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- Đến ngày -->
                        <StackPanel Orientation="Horizontal" Margin="0,4,14,4" VerticalAlignment="Center">
                            <TextBlock Text="Đến ngày:" VerticalAlignment="Center" FontWeight="Bold" Foreground="#334155" Margin="0,0,8,0" FontSize="12.5"/>
                            <DatePicker SelectedDate="{Binding DenNgay}" Width="130" VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- Chọn Đối tác / Chủ nhà -->
                        <StackPanel Orientation="Horizontal" Margin="0,4,16,4" VerticalAlignment="Center">
                            <TextBlock Text="Đối tác / Host:" VerticalAlignment="Center" FontWeight="Bold" Foreground="#334155" Margin="0,0,8,0" FontSize="12.5"/>
                            <ComboBox ItemsSource="{Binding DanhSachChuHome}" SelectedItem="{Binding ChuHomeDangChon}"
                                      DisplayMemberPath="TenHienThi" Width="210" VerticalAlignment="Center" Padding="8,6"/>
                        </StackPanel>

                        <!-- Nút Lọc dữ liệu -->
                        <Button Content="🔍 Lọc dữ liệu" Command="{Binding LocDuLieuCommand}"
                                Background="#0194F3" Foreground="White" FontWeight="Bold" Padding="16,7" Margin="0,4,8,4"
                                BorderThickness="0" Cursor="Hand" VerticalAlignment="Center">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="6"/>
                                </Style>
                            </Button.Resources>
                        </Button>

                        <!-- Nút Đặt lại -->
                        <Button Content="🔄 Đặt lại" Command="{Binding DatLaiBoLocCommand}"
                                Background="#F1F5F9" Foreground="#475569" BorderBrush="#CBD5E1" BorderThickness="1"
                                Padding="12,6" Margin="0,4,12,4" Cursor="Hand" VerticalAlignment="Center">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="6"/>
                                </Style>
                            </Button.Resources>
                        </Button>

                        <!-- Nút Xuất CSV -->
                        <Button Content="📥 Xuất báo cáo CSV" Command="{Binding XuatBaoCaoCommand}"
                                Background="#0E9F6E" Foreground="White" FontWeight="Bold" Padding="14,7" Margin="0,4,0,4"
                                BorderThickness="0" Cursor="Hand" VerticalAlignment="Center">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="6"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </WrapPanel>
                </Grid>
            </Border>

            <!-- 2. PHẦN GIỮA: 3 THẺ THỐNG KÊ TÀI CHÍNH RÕ RÀNG (UNIFORMGRID COLUMNS="3") -->
            <UniformGrid Grid.Row="1" Columns="3" Margin="0,0,0,16">
                <!-- Card 1 (Xanh dương #0194F3): TỔNG TIỀN KHÁCH THANH TOÁN (100%) -->
                <Border Background="White" CornerRadius="12" Padding="20,16" Margin="0,0,8,0" BorderBrush="#BAE6FD" BorderThickness="1.5">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="8" Direction="270" ShadowDepth="2" Opacity="0.05" Color="#0194F3"/>
                    </Border.Effect>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <Border Background="#EFF6FF" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                    <TextBlock Text="100% GROSS" FontSize="10" FontWeight="Bold" Foreground="#0194F3"/>
                                </Border>
                                <TextBlock Text="TỔNG TIỀN KHÁCH THANH TOÁN" FontSize="11" FontWeight="Bold" Foreground="#64748B" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="{Binding ThongKe.TongThuTuKhachDinhDang}" FontSize="24" FontWeight="Black" Foreground="#0194F3" Margin="0,4,0,0"/>
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <TextBlock Text="Tổng đơn thanh toán:" FontSize="11.5" Foreground="#64748B"/>
                                <TextBlock Text="{Binding ThongKe.TongSoDon, StringFormat=' {0} đơn phát sinh'}" FontSize="11.5" FontWeight="Bold" Foreground="#1E293B"/>
                            </StackPanel>
                        </StackPanel>
                        <Border Grid.Column="1" Width="44" Height="44" CornerRadius="22" Background="#EFF6FF" VerticalAlignment="Top">
                            <TextBlock Text="💳" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- Card 2 (Cam #FF5E1F): DOANH THU HOA HỒNG SÀN (15%) -->
                <Border Background="White" CornerRadius="12" Padding="20,16" Margin="4,0,4,0" BorderBrush="#FED7AA" BorderThickness="1.5">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="8" Direction="270" ShadowDepth="2" Opacity="0.05" Color="#FF5E1F"/>
                    </Border.Effect>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <Border Background="#FFF7ED" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                    <TextBlock Text="15% COMMISSION" FontSize="10" FontWeight="Bold" Foreground="#FF5E1F"/>
                                </Border>
                                <TextBlock Text="DOANH THU HOA HỒNG SÀN" FontSize="11" FontWeight="Bold" Foreground="#C2410C" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="{Binding ThongKe.HoaHongSanHuongDinhDang}" FontSize="24" FontWeight="Black" Foreground="#FF5E1F" Margin="0,4,0,0"/>
                            <TextBlock Text="Doanh thu thực tế HomestaySystem giữ lại" FontSize="11.5" Foreground="#64748B" Margin="0,6,0,0"/>
                        </StackPanel>
                        <Border Grid.Column="1" Width="44" Height="44" CornerRadius="22" Background="#FFF7ED" VerticalAlignment="Top">
                            <TextBlock Text="📈" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- Card 3 (Xanh lá #0E9F6E): CẦN THANH TOÁN CHO ĐỐI TÁC (85%) -->
                <Border Background="White" CornerRadius="12" Padding="20,16" Margin="8,0,0,0" BorderBrush="#BBF7D0" BorderThickness="1.5">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="8" Direction="270" ShadowDepth="2" Opacity="0.05" Color="#0E9F6E"/>
                    </Border.Effect>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <Border Background="#ECFDF5" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                    <TextBlock Text="85% PAYOUT" FontSize="10" FontWeight="Bold" Foreground="#0E9F6E"/>
                                </Border>
                                <TextBlock Text="CẦN THANH TOÁN CHO ĐỐI TÁC" FontSize="11" FontWeight="Bold" Foreground="#047857" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="{Binding ThongKe.TienTraChuHomeDinhDang}" FontSize="24" FontWeight="Black" Foreground="#0E9F6E" Margin="0,4,0,0"/>
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <TextBlock Text="Chờ giải ngân: " FontSize="11.5" Foreground="#64748B"/>
                                <TextBlock Text="{Binding ThongKe.SoTienChuaQuyetToanDinhDang}" FontSize="11.5" FontWeight="Bold" Foreground="#D97706"/>
                            </StackPanel>
                        </StackPanel>
                        <Border Grid.Column="1" Width="44" Height="44" CornerRadius="22" Background="#ECFDF5" VerticalAlignment="Top">
                            <TextBlock Text="🏠" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                </Border>
            </UniformGrid>

            <!-- 3. PHẦN DƯỚI: BẢNG DATAGRID DÒNG TIỀN CHI TIẾT (ROW="*") -->
            <Border Grid.Row="2" Background="White" CornerRadius="12" BorderBrush="{StaticResource MauVien}" BorderThickness="1" Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Header bảng -->
                    <Border Grid.Row="0" Background="#F8FAFC" CornerRadius="8,8,0,0" Padding="14,10" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Margin="0,0,0,8">
                        <Grid>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Bảng Kê Chi Tiết Dòng Tiền Quyết Toán" FontWeight="Bold" FontSize="13.5" Foreground="#0F172A"/>
                                <Border Background="#E2E8F0" CornerRadius="10" Padding="8,2" Margin="10,0,0,0">
                                    <TextBlock Text="{Binding DanhSachDon.Count, StringFormat='{}{0} giao dịch'}" FontSize="11" FontWeight="SemiBold" Foreground="#475569"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="Đồng bộ thời gian thực từ CSDL &amp; Cổng thanh toán" HorizontalAlignment="Right" Foreground="#64748B" FontSize="11.5" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- DataGrid -->
                    <DataGrid Grid.Row="1" ItemsSource="{Binding DanhSachDon}"
                              AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#F1F5F9" Background="White" BorderThickness="0"
                              RowHeight="44"
                              ScrollViewer.CanContentScroll="True"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                              VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#F8FAFC"/>
                                <Setter Property="Foreground" Value="#475569"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="FontSize" Value="12"/>
                                <Setter Property="Padding" Value="10,8"/>
                                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                <Setter Property="BorderBrush" Value="#E2E8F0"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>

                        <DataGrid.Columns>
                            <!-- [Mã Đơn] (Fixed 100) -->
                            <DataGridTextColumn Header="Mã Đơn" Binding="{Binding MaDonHienThi}" Width="100">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="Foreground" Value="#0194F3"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- [Ngày GD] (Fixed 110) -->
                            <DataGridTextColumn Header="Ngày GD" Binding="{Binding ThoiGianTao, StringFormat='{}{0:dd/MM/yyyy}'}" Width="110">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#64748B"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- [Homestay/Phòng] (Star 2*) -->
                            <DataGridTextColumn Header="Homestay / Phòng" Binding="{Binding HomestayVaPhong}" Width="2*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="Foreground" Value="#1E293B"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- [Loại hình] (Fixed 110) -->
                            <DataGridTextColumn Header="Loại Hình" Binding="{Binding LoaiHinh}" Width="110">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#475569"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- [Khách hàng] (Fixed 140) -->
                            <DataGridTextColumn Header="Khách Hàng" Binding="{Binding TenKhachHang}" Width="140">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#334155"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- [Tiền gốc] (Fixed 130) -->
                            <DataGridTextColumn Header="Tiền Gốc (100%)" Binding="{Binding TongTienDinhDang}" Width="130">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="Foreground" Value="#0194F3"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- [Phí sàn] (Fixed 120) -->
                            <DataGridTextColumn Header="Phí Sàn (15%)" Binding="{Binding HoaHongSanDinhDang}" Width="120">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="Foreground" Value="#FF5E1F"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- [Thực nhận Host] (Fixed 130) -->
                            <DataGridTextColumn Header="Thực Nhận (85%)" Binding="{Binding TienChuHomeDinhDang}" Width="130">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="Foreground" Value="#0E9F6E"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- [Trạng thái] (Fixed 130) -->
                            <DataGridTemplateColumn Header="Trạng Thái" Width="130">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="{Binding MauTrangThai, Converter={StaticResource ColorToBrush}}"
                                                CornerRadius="10" Padding="8,3" HorizontalAlignment="Left" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding TenHienThiTrangThai}"
                                                       Foreground="White" FontSize="11" FontWeight="Bold"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
