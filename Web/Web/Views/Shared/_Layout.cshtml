<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - KLCN</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
    <style>
        body {
            display: flex;
            flex-direction: column;
            min-height: 100vh;
        }

        main {
            flex: 1;
        }

        .navbar-brand {
            font-weight: 900;
            letter-spacing: 1px;
        }
    </style>
</head>
<body>

    <nav class="navbar navbar-expand-lg navbar-light bg-white sticky-top shadow-sm py-3">
        <div class="container">
            <a class="navbar-brand text-primary" href="@Url.Action("Index", "Home")">
                <i class="bi bi-house-fill"></i> KLCN
            </a>

            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav me-auto">
                    <li class="nav-item">
                        <a class="nav-link" href="@Url.Action("Index", "Home")">Trang chủ</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="#">Khuyến mãi</a>
                    </li>
                </ul>

                <div class="d-flex align-items-center">
                    <a href="/Owner/Login" class="text-decoration-none me-4 text-secondary"><i class="bi bi-house-door"></i> Dành cho đối tác</a>

                    <div id="authArea">
                        <a href="@Url.Action("Login", "Account")" class="btn btn-outline-primary me-2">Đăng nhập</a>
                        <a href="@Url.Action("Login", "Account")" class="btn btn-primary">Đăng ký</a>
                    </div>

                    <div id="userArea" style="display:none;" class="dropdown">
                        <a class="btn btn-light dropdown-toggle fw-bold" href="#" role="button" data-bs-toggle="dropdown">
                            <i class="bi bi-person-circle text-primary me-1"></i> <span id="userNameDisplay">Khách</span>
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end">
                            <li><a class="dropdown-item" href="#">Lịch sử đặt phòng</a></li>
                            <li><a class="dropdown-item" href="#">Hồ sơ cá nhân</a></li>
                            <li><hr class="dropdown-divider"></li>
                            <li><button class="dropdown-item text-danger" onclick="logout()">Đăng xuất</button></li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </nav>

    <main>
        @RenderBody()
    </main>

    <footer class="bg-dark text-light py-4 mt-auto">
        <div class="container text-center">
            <p class="mb-0">&copy; @DateTime.Now.Year - Hệ thống Đặt phòng Homestay StayHub. Bảo lưu mọi quyền.</p>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        document.addEventListener("DOMContentLoaded", () => {
            const userJson = localStorage.getItem('guestUser'); // Key lưu từ trang Login
            if (userJson) {
                const user = JSON.parse(userJson);
                document.getElementById('authArea').style.display = 'none';
                document.getElementById('userArea').style.display = 'block';
                document.getElementById('userNameDisplay').innerText = user.HoTen || user.TenDangNhap;
            }
        });

        // Hàm đăng xuất
        function logout() {
            localStorage.removeItem('guestUser');
            window.location.href = '@Url.Action("Index", "Home")';
        }
    </script>

    @RenderSection("Scripts", required: false)
</body>
</html>