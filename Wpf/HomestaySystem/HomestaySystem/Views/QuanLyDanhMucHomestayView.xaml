<UserControl x:Class="HomestaySystem.Views.QuanLyDanhMucHomestayView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:conv="clr-namespace:HomestaySystem.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="850" d:DesignWidth="1200">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <conv:ChuoiMauToBrushConverter x:Key="ColorToBrush"/>
        <conv:NullToVisibilityConverter x:Key="NullToVis"/>
    </UserControl.Resources>

    <Grid Background="{StaticResource MauNenChinh}">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Hàng 0: Header & Thanh tìm kiếm/Bộ lọc -->
                <RowDefinition Height="Auto"/> <!-- Hàng 1: Các thẻ Card KPI -->
                <RowDefinition Height="*"/>    <!-- Hàng 2: Vùng chứa bảng BẮT BUỘC DÙNG DÒNG SAO '*' -->
            </Grid.RowDefinitions>

            <!-- ================= HÀNG 0: HEADER & THANH TÌM KIẾM / BỘ LỌC ================= -->
            <Border Grid.Row="0" Margin="0,0,0,16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Header bar -->
                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="40" Height="40" CornerRadius="20" Background="{StaticResource MauStaylyPrimaryLight}" Margin="0,0,12,0">
                                <TextBlock Text="🏘️" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Danh Mục &amp; Giám Sát Chỗ Nghỉ" FontSize="18" FontWeight="Bold" Foreground="{StaticResource MauChuTieuDe}"/>
                                <TextBlock Text="Quản lý toàn bộ danh mục homestay, villa, căn hộ và xử lý can thiệp vi phạm chất lượng" FontSize="12" Foreground="{StaticResource MauChuPhu}"/>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button Command="{Binding TaiDuLieuCommand}" Cursor="Hand" ToolTip="Tải lại danh sách cơ sở"
                                    Background="White" BorderBrush="{StaticResource MauVien}" BorderThickness="1" Padding="14,8">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="20"/>
                                    </Style>
                                </Button.Resources>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🔄 " FontSize="12"/>
                                    <TextBlock Text="Tải lại danh sách" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource MauChuChinh}"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- Filter Strip Ribbon: Ô tìm kiếm + 3 ComboBox (Loại hình, Trạng thái, Khu vực) -->
                    <Border Grid.Row="1" Background="White" CornerRadius="16" Padding="14,10" BorderBrush="{StaticResource MauVien}" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="175"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="155"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Ô tìm kiếm viên thuốc -->
                            <Border Grid.Column="0" Background="#F1F5F9" CornerRadius="20" Padding="12,6" BorderBrush="{StaticResource MauVien}" BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="🔍" FontSize="13" Margin="4,0,8,0" VerticalAlignment="Center"/>
                                    <TextBox Grid.Column="1" Text="{Binding TuKhoaTimKiem, UpdateSourceTrigger=PropertyChanged}"
                                             BorderThickness="0" Background="Transparent" VerticalAlignment="Center"
                                             FontSize="12" Foreground="{StaticResource MauChuChinh}"/>
                                    <TextBlock Grid.Column="1" Text="Tìm tên chỗ nghỉ, mã CS, chủ nhà, địa chỉ..." FontSize="12" Foreground="#94A3B8"
                                               VerticalAlignment="Center" Margin="2,0,0,0" IsHitTestVisible="False">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding TuKhoaTimKiem}" Value="">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding TuKhoaTimKiem}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </Border>

                            <!-- ComboBox Loại hình: Chỉ gồm Homestay nguyên căn và Khách sạn -->
                            <ComboBox Grid.Column="2" SelectedValue="{Binding BoLocLoaiHinh}" SelectedValuePath="Tag" Height="36" VerticalAlignment="Center">
                                <ComboBoxItem Content="Tất cả loại hình" Tag="TatCa" IsSelected="True"/>
                                <ComboBoxItem Content="Homestay nguyên căn" Tag="Homestay"/>
                                <ComboBoxItem Content="Khách sạn" Tag="Hotel"/>
                            </ComboBox>

                            <!-- ComboBox Trạng thái chuẩn bo tròn 8px hiện đại không lộ khung xám -->
                            <ComboBox Grid.Column="4" SelectedValue="{Binding BoLocTrangThai}" SelectedValuePath="Tag" Height="36" VerticalAlignment="Center">
                                <ComboBoxItem Content="Tất cả trạng thái" Tag="TatCa" IsSelected="True"/>
                                <ComboBoxItem Content="Đang mở bán" Tag="HoatDong"/>
                                <ComboBoxItem Content="Tạm dừng / Khóa" Tag="TamDung"/>
                                <ComboBoxItem Content="Chờ kiểm duyệt" Tag="ChoDuyet"/>
                            </ComboBox>

                            <!-- ComboBox Khu vực chuẩn bo tròn 8px hiện đại không lộ khung xám (Lấy động từ Database) -->
                            <ComboBox Grid.Column="6" 
                                      ItemsSource="{Binding DanhSachKhuVuc}" 
                                      SelectedItem="{Binding BoLocKhuVuc, Mode=TwoWay}" 
                                      Height="36" 
                                      VerticalAlignment="Center"/>

                            <!-- Nút Lọc danh sách -->
                            <Button Grid.Column="8" Command="{Binding ApDungBoLocCommand}" Content="🔍 Lọc"
                                    Background="{StaticResource MauStaylyPrimary}" Foreground="White"
                                    BorderThickness="0" Padding="16,8" FontSize="12" FontWeight="Bold" Cursor="Hand">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="18"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- ================= HÀNG 1: 4 THẺ CARD KPI (FORMAT CHUẨN THỐNG NHẤT) ================= -->
            <Grid Grid.Row="1" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- KPI 1: Tổng cơ sở niêm yết -->
                <Border Grid.Column="0" Background="White" CornerRadius="12" BorderBrush="#E2E8F0" BorderThickness="1" Padding="14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="TỔNG CƠ SỞ NIÊM YẾT" FontSize="11" FontWeight="Bold" Foreground="#64748B" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding TongSoCoSo, FallbackValue='0'}" FontSize="22" FontWeight="Black" Foreground="#0F172A" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="Đã qua kiểm định tiêu chuẩn" FontSize="11" Foreground="#0194F3" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <Border Grid.Column="1" Width="42" Height="42" CornerRadius="21" Background="#E0F2FE" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="🏨" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- KPI 2: Đang mở bán -->
                <Border Grid.Column="2" Background="White" CornerRadius="12" BorderBrush="#E2E8F0" BorderThickness="1" Padding="14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="ĐANG MỞ BÁN" FontSize="11" FontWeight="Bold" Foreground="#64748B" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding SoCoSoDangMoBan, FallbackValue='0'}" FontSize="22" FontWeight="Black" Foreground="#10B981" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="Khách đặt phòng trực tuyến" FontSize="11" Foreground="#64748B" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <Border Grid.Column="1" Width="42" Height="42" CornerRadius="21" Background="#ECFDF5" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="✅" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- KPI 3: Tạm dừng / Cảnh cáo -->
                <Border Grid.Column="4" Background="White" CornerRadius="12" BorderBrush="#E2E8F0" BorderThickness="1" Padding="14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="TẠM DỪNG / CẢNH CÁO" FontSize="11" FontWeight="Bold" Foreground="#64748B" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding SoCoSoTamDung, FallbackValue='0'}" FontSize="22" FontWeight="Black" Foreground="#EF4444" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="Đang xử lý khiếu nại" FontSize="11" Foreground="#64748B" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <Border Grid.Column="1" Width="42" Height="42" CornerRadius="21" Background="#FEE2E2" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="⚠️" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- KPI 4: Điểm đánh giá sàn -->
                <Border Grid.Column="6" Background="White" CornerRadius="12" BorderBrush="#E2E8F0" BorderThickness="1" Padding="14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="ĐÁNH GIÁ TRUNG BÌNH" FontSize="11" FontWeight="Bold" Foreground="#64748B" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="4.9 / 5.0" FontSize="22" FontWeight="Black" Foreground="#F59E0B" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="Toàn mạng lưới Stayly" FontSize="11" Foreground="#64748B" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <Border Grid.Column="1" Width="42" Height="42" CornerRadius="21" Background="#FEF3C7" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="⭐" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <!-- ================= HÀNG 2: BẢNG DANH MỤC CHỖ NGHỈ FULL-WIDTH ================= -->
            <Border Grid.Row="2" Style="{StaticResource StaylyCard}" Padding="0" ClipToBounds="True">
                <DataGrid ItemsSource="{Binding DanhSachHienThi}" SelectedItem="{Binding CoSoDangChon}"
                              Style="{StaticResource StaylyDataGridStyle}"
                              IsReadOnly="True"
                              RowHeight="58"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              CanUserResizeColumns="True"
                              CanUserSortColumns="True">
                        <DataGrid.Columns>
                            <!-- Cột Mã cơ sở: Tự động canh theo mã dài nhất #CS-00001 -->
                            <DataGridTextColumn Header="MÃ CƠ SỞ" Binding="{Binding MaCoSoHienThi}" Width="Auto" MinWidth="115">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="Foreground" Value="{StaticResource MauStaylyPrimary}"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Padding" Value="12,0"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Cột Tên chỗ nghỉ: Mở rộng tối thiểu 260px, bố cục 2 dòng rõ ràng -->
                            <DataGridTemplateColumn Header="TÊN CHỖ NGHỈ" Width="*" MinWidth="260">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel VerticalAlignment="Center" Margin="12,0" Cursor="Hand" ToolTip="{Binding TenCoSo}">
                                            <TextBlock Text="{Binding TenCoSo}" FontWeight="Bold" FontSize="12" Foreground="{StaticResource MauChuTieuDe}" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding DiaChi}" FontSize="11" Foreground="{StaticResource MauChuPhu}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Cột Chủ sở hữu: Tự động canh theo họ tên chủ nhà dài nhất -->
                            <DataGridTextColumn Header="CHỦ SỞ HỮU" Binding="{Binding TenChuHome}" Width="Auto" MinWidth="170">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontWeight" Value="Medium"/>
                                        <Setter Property="Foreground" Value="{StaticResource MauChuChinh}"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Padding" Value="12,0"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Cột Loại hình: Tự động canh theo loại hình dài nhất như 'Homestay nguyên căn', không bị che chữ -->
                            <DataGridTemplateColumn Header="LOẠI HÌNH" Width="Auto" MinWidth="175">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="8" Padding="10,4" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{StaticResource MauStaylyPrimaryLight}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding LoaiHinhHienThi}" Value="Khách sạn">
                                                            <Setter Property="Background" Value="#F1F5F9"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding LoaiHinhHienThi}" FontSize="11" FontWeight="Bold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{StaticResource MauStaylyPrimary}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding LoaiHinhHienThi}" Value="Khách sạn">
                                                                <Setter Property="Foreground" Value="#475569"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Cột Khu vực: Tự động canh theo tỉnh thành -->
                            <DataGridTextColumn Header="KHU VỰC" Binding="{Binding KhuVuc}" Width="Auto" MinWidth="125">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource MauChuPhu}"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Padding" Value="12,0"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Cột Đánh giá: Tự động canh theo sao và điểm số -->
                            <DataGridTemplateColumn Header="ĐÁNH GIÁ" Width="Auto" MinWidth="105">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0">
                                            <TextBlock Text="⭐" FontSize="11" Foreground="#F59E0B" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                            <TextBlock Text="{Binding DanhGia, StringFormat='{}{0:F1}'}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource MauChuTieuDe}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Cột Lượt đặt: Tự động canh theo số lượt -->
                            <DataGridTextColumn Header="LƯỢT ĐẶT" Binding="{Binding SoLuotDat, StringFormat='{}{0:N0}'}" Width="Auto" MinWidth="105">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="Foreground" Value="{StaticResource MauStaylyPrimary}"/>
                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Padding" Value="0,0,16,0"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Cột Trạng thái: Tự động canh theo trạng thái hiển thị -->
                            <DataGridTemplateColumn Header="TRẠNG THÁI" Width="Auto" MinWidth="145">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="10" Padding="10,4" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#ECFDF5"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding TrangThai}" Value="TamDung">
                                                            <Setter Property="Background" Value="#FEE2E2"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding TrangThai}" Value="TuChoi">
                                                            <Setter Property="Background" Value="#FEE2E2"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding TrangThai}" Value="ChoDuyet">
                                                            <Setter Property="Background" Value="#FEF3C7"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding TenHienThiTrangThai}" FontSize="11" FontWeight="Bold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{StaticResource MauStaylyGreen}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding TrangThai}" Value="TamDung">
                                                                <Setter Property="Foreground" Value="{StaticResource MauStaylyRed}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding TrangThai}" Value="TuChoi">
                                                                <Setter Property="Foreground" Value="{StaticResource MauStaylyRed}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding TrangThai}" Value="ChoDuyet">
                                                                <Setter Property="Foreground" Value="#D97706"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Cột 8: THAO TÁC / GIÁM SÁT -->
                            <DataGridTemplateColumn Header="THAO TÁC" Width="Auto" MinWidth="135">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="📋 Giám sát"
                                                Command="{Binding DataContext.XemHoSoCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource StaylyBtnSmall}"
                                                Background="{StaticResource MauStaylyPrimaryLight}"
                                                Foreground="{StaticResource MauStaylyPrimaryDark}"
                                                BorderThickness="0" FontWeight="Bold" FontSize="11" Padding="12,6"
                                                HorizontalAlignment="Center" VerticalAlignment="Center" Cursor="Hand"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
        </Grid>

        <!-- ================= MODAL DIALOG: GIÁM SÁT CHẤT LƯỢNG CHỖ NGHỈ (HIỆN NGAY GIỮA MÀN HÌNH) ================= -->
        <Grid Visibility="{Binding CoSoDangChon, Converter={StaticResource NullToVis}, FallbackValue=Collapsed}"
              HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <!-- Nền mờ: Nhấp chuột ra ngoài để đóng hồ sơ -->
            <Border Background="#99000000" Cursor="Hand" ToolTip="Nhấp vào vùng ngoài để đóng hồ sơ">
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftClick" Command="{Binding DongHoSoCommand}"/>
                </Border.InputBindings>
            </Border>
            <Border Background="White" CornerRadius="16" Width="540" MaxHeight="720" Padding="20" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" Opacity="0.25" BlurRadius="24" ShadowDepth="4"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Header Modal có nút [✕ Đóng] -->
                    <Border Grid.Row="0" BorderBrush="{StaticResource MauVien}" BorderThickness="0,0,0,1" Padding="0,0,0,12" Margin="0,0,0,14">
                        <DockPanel LastChildFill="True">
                            <Button DockPanel.Dock="Right" Command="{Binding DongHoSoCommand}"
                                    Content="✕ Đóng" ToolTip="Đóng hồ sơ để xem danh sách toàn màn hình"
                                    Background="#F1F5F9" Foreground="#64748B" BorderThickness="0"
                                    FontWeight="Bold" FontSize="12" Padding="12,6" Cursor="Hand" Margin="8,0,0,0">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="6"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                            <Border DockPanel.Dock="Right" Background="#FEE2E2" CornerRadius="8" Padding="8,3" Margin="8,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="AUDIT LOG" FontSize="11" FontWeight="Bold" Foreground="{StaticResource MauStaylyRed}"/>
                            </Border>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="🛡️" FontSize="16" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="GIÁM SÁT CHẤT LƯỢNG" FontSize="14" FontWeight="Bold" Foreground="{StaticResource MauChuTieuDe}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- VÙNG NỘI DUNG CUỘN CHI TIẾT -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,6,0">
                        <StackPanel>
                            <!-- Selected Entity Card -->
                            <Border Background="#F8FAFC" CornerRadius="12" Padding="14,12" Margin="0,0,0,14">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="64"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" CornerRadius="10" Height="64" Background="{StaticResource MauStaylyPrimaryLight}" ClipToBounds="True">
                                        <Grid>
                                            <TextBlock Text="🏨" FontSize="30" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            <Image Source="{Binding CoSoDangChon.HinhAnhDaiDien}" Stretch="UniformToFill"/>
                                        </Grid>
                                    </Border>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding CoSoDangChon.MaCoSoHienThi, FallbackValue='#CS-00001'}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource MauStaylyPrimary}"/>
                                        <TextBlock Text="{Binding CoSoDangChon.TenCoSo, FallbackValue='Chưa chọn chỗ nghỉ'}" FontSize="14.5" FontWeight="Bold" Foreground="{StaticResource MauChuTieuDe}" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding CoSoDangChon.DiaChi, FallbackValue='Địa chỉ cơ sở lưu trú'}" FontSize="12.5" Foreground="{StaticResource MauChuPhu}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                        <TextBlock Text="{Binding CoSoDangChon.TenChuHome, StringFormat='Chủ home: {0}', FallbackValue='Chủ home'}" FontSize="12.5" FontWeight="Medium" Foreground="{StaticResource MauChuChinh}" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Complaint Incident Alert Box -->
                            <Border Background="#FEF2F2" CornerRadius="12" Padding="14,12" Margin="0,0,0,14" BorderBrush="#FECACA" BorderThickness="1">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,6" LastChildFill="True">
                                        <Border DockPanel.Dock="Right" Background="#FEE2E2" CornerRadius="8" Padding="6,2" Margin="6,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="3 Khiếu nại" FontSize="10" FontWeight="Bold" Foreground="{StaticResource MauStaylyRed}"/>
                                        </Border>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="⚠️ " FontSize="13" Foreground="{StaticResource MauStaylyRed}"/>
                                            <TextBlock Text="Cảnh báo phản ánh từ khách thuê" FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource MauStaylyRed}" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </DockPanel>
                                    <TextBlock Text="• Phản ánh sai lệch phòng so với hình ảnh thực tế niêm yết.&#x0a;• Tình trạng vệ sinh và thiết bị tiện ích chưa đạt tiêu chuẩn Stayly."
                                               FontSize="12.5" Foreground="{StaticResource MauChuChinh}" TextWrapping="Wrap" Margin="0,0,0,6" LineHeight="18"/>
                                    <TextBlock Text="Báo cáo gần nhất: Hôm nay lúc 11:24 SA" FontSize="11" Foreground="{StaticResource MauChuPhu}"/>
                                </StackPanel>
                            </Border>

                            <!-- Audit Input Form: Lý do can thiệp -->
                            <StackPanel Margin="0,0,0,16">
                                <DockPanel Margin="0,0,0,6" LastChildFill="True">
                                    <TextBlock DockPanel.Dock="Right" Text="Lưu vào Audit Log" FontSize="11" Foreground="{StaticResource MauStaylyPrimary}" VerticalAlignment="Center"/>
                                    <TextBlock Text="LÝ DO CAN THIỆP / TẠM DỪNG *" FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource MauChuPhu}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                </DockPanel>
                                <Border Background="#F8FAFC" CornerRadius="12" Padding="10,8" BorderBrush="{StaticResource MauVien}" BorderThickness="1">
                                    <TextBox Text="{Binding LyDoXuLy, UpdateSourceTrigger=PropertyChanged}"
                                             BorderThickness="0" Background="Transparent" AcceptsReturn="True" TextWrapping="Wrap"
                                             MinHeight="65" FontSize="13" Foreground="{StaticResource MauChuChinh}"/>
                                </Border>
                                <TextBlock Text="Thông báo này sẽ được đẩy đến ứng dụng Host của đối tác." FontSize="11" Foreground="{StaticResource MauChuPhu}" Margin="0,4,0,0"/>
                            </StackPanel>

                            <!-- Action Buttons -->
                            <StackPanel>
                                <!-- NÚT CHỈNH SỬA THÔNG TIN CHỖ NGHỈ RIÊNG BIỆT -->
                                <Button Command="{Binding MoDialogChinhSuaCommand}" Cursor="Hand" Margin="0,0,0,8"
                                        Background="{StaticResource MauStaylyPrimary}" Foreground="White"
                                        FontSize="13.5" FontWeight="Bold" Padding="14,11" ToolTip="Chỉnh sửa thông tin cơ sở homestay / chỗ nghỉ">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="22"/>
                                        </Style>
                                    </Button.Resources>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <TextBlock Text="✏️ " FontSize="13.5"/>
                                        <TextBlock Text="Chỉnh Sửa Thông Tin Chỗ Nghỉ"/>
                                    </StackPanel>
                                </Button>

                                <Button Command="{Binding TamDungCoSoCommand}" Cursor="Hand" Margin="0,0,0,8"
                                        Background="{StaticResource MauStaylyRed}" Foreground="White"
                                        FontSize="13.5" FontWeight="Bold" Padding="14,11">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="22"/>
                                        </Style>
                                    </Button.Resources>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <TextBlock Text="🚫 " FontSize="13.5"/>
                                        <TextBlock Text="Tạm Ngưng Phân Phối / Khóa Chỗ Nghỉ"/>
                                    </StackPanel>
                                </Button>

                                <Button Command="{Binding MoBanLaiCoSoCommand}" Cursor="Hand"
                                        Background="{StaticResource MauStaylyGreen}" Foreground="White"
                                        FontSize="13.5" FontWeight="Bold" Padding="14,11">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="22"/>
                                        </Style>
                                    </Button.Resources>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <TextBlock Text="✔ " FontSize="13.5"/>
                                        <TextBlock Text="Xác Nhận Khắc Phục &amp; Mở Bán Lại"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- ================= MODAL DIALOG: CHỈNH SỬA THÔNG TIN CHỖ NGHỈ ================= -->
        <Grid Visibility="{Binding HienThiDialogChinhSua, Converter={StaticResource BoolToVis}}"
              HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <!-- Nền mờ: Nhấp chuột ra ngoài để hủy -->
            <Border Background="#99000000" Cursor="Hand" ToolTip="Nhấp vào vùng ngoài để đóng">
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftClick" Command="{Binding HuyDialogChinhSuaCommand}"/>
                </Border.InputBindings>
            </Border>
            <Border Background="White" CornerRadius="16" Width="540" Padding="24" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" Opacity="0.25" BlurRadius="24" ShadowDepth="4"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Header Modal -->
                    <DockPanel Grid.Row="0" Margin="0,0,0,14" LastChildFill="True">
                        <Border DockPanel.Dock="Right" Background="{StaticResource MauStaylyPrimaryLight}" CornerRadius="8" Padding="8,3" VerticalAlignment="Center">
                            <TextBlock Text="{Binding CoSoDangChon.MaCoSoHienThi, FallbackValue='#CS-0001'}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource MauStaylyPrimary}"/>
                        </Border>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="✏️ " FontSize="16"/>
                            <TextBlock Text="CHỈNH SỬA THÔNG TIN CHỖ NGHỈ" FontSize="15" FontWeight="Bold" Foreground="{StaticResource MauChuTieuDe}"/>
                        </StackPanel>
                    </DockPanel>

                    <!-- Form Body -->
                    <StackPanel Grid.Row="1" Margin="0,0,0,16">
                        <!-- Tên chỗ nghỉ -->
                        <TextBlock Text="Tên cơ sở lưu trú (*):" FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource MauChuPhu}" Margin="0,0,0,4"/>
                        <Border Background="#F1F5F9" CornerRadius="8" Padding="12,7" Margin="0,0,0,10" BorderBrush="{StaticResource MauVien}" BorderThickness="1">
                            <TextBox Text="{Binding SuaTenCoSo, UpdateSourceTrigger=PropertyChanged}"
                                     BorderThickness="0" Background="Transparent" FontSize="13.5" Foreground="{StaticResource MauChuChinh}"/>
                        </Border>

                        <!-- Địa chỉ cơ sở -->
                        <TextBlock Text="Địa chỉ chi tiết:" FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource MauChuPhu}" Margin="0,0,0,4"/>
                        <Border Background="#F1F5F9" CornerRadius="8" Padding="12,7" Margin="0,0,0,10" BorderBrush="{StaticResource MauVien}" BorderThickness="1">
                            <TextBox Text="{Binding SuaDiaChi, UpdateSourceTrigger=PropertyChanged}"
                                     BorderThickness="0" Background="Transparent" FontSize="13.5" Foreground="{StaticResource MauChuChinh}"/>
                        </Border>

                        <!-- Khu vực & Loại hình -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Khu vực / Tỉnh thành:" FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource MauChuPhu}" Margin="0,0,0,4"/>
                                <Border Background="#F1F5F9" CornerRadius="8" Padding="12,7" BorderBrush="{StaticResource MauVien}" BorderThickness="1">
                                    <TextBox Text="{Binding SuaKhuVuc, UpdateSourceTrigger=PropertyChanged}"
                                             BorderThickness="0" Background="Transparent" FontSize="13.5" Foreground="{StaticResource MauChuChinh}"/>
                                </Border>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Loại hình chỗ nghỉ:" FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource MauChuPhu}" Margin="0,0,0,4"/>
                                <ComboBox SelectedValue="{Binding SuaLoaiHinh}" SelectedValuePath="Content" Height="38" FontSize="13">
                                    <ComboBoxItem Content="Homestay"/>
                                    <ComboBoxItem Content="Khách sạn"/>
                                    <ComboBoxItem Content="Căn hộ nghỉ dưỡng"/>
                                    <ComboBoxItem Content="Biệt thự Villa"/>
                                </ComboBox>
                            </StackPanel>
                        </Grid>

                        <!-- Chủ nhà -->
                        <TextBlock Text="Họ tên chủ sở hữu (Host):" FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource MauChuPhu}" Margin="0,0,0,4"/>
                        <Border Background="#F1F5F9" CornerRadius="8" Padding="12,7" BorderBrush="{StaticResource MauVien}" BorderThickness="1">
                            <TextBox Text="{Binding SuaTenChuHome, UpdateSourceTrigger=PropertyChanged}"
                                     BorderThickness="0" Background="Transparent" FontSize="13.5" Foreground="{StaticResource MauChuChinh}"/>
                        </Border>
                    </StackPanel>

                    <!-- Buttons -->
                    <DockPanel Grid.Row="2" LastChildFill="False">
                        <Button DockPanel.Dock="Left" Command="{Binding HuyDialogChinhSuaCommand}" Content="Hủy bỏ" Background="#F1F5F9"
                                BorderThickness="0" Padding="20,9" FontSize="13" FontWeight="SemiBold" Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="8"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                        <Button DockPanel.Dock="Right" Command="{Binding XacNhanChinhSuaCommand}" Content="💾 Lưu thay đổi" Background="{StaticResource MauStaylyPrimary}"
                                Foreground="White" BorderThickness="0" Padding="22,9" FontSize="13" FontWeight="Bold" Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="8"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </DockPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
