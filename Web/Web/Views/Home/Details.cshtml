<!-- Javascript for Booking Form and Modal -->
<script>
    document.addEventListener('DOMContentLoaded', () => {
        // Initialize default dates
        const checkIn = document.getElementById('bookingCheckIn');
        const checkOut = document.getElementById('bookingCheckOut');
        const today = new Date();
        const tomorrow = new Date();
        tomorrow.setDate(today.getDate() + 1);

        if (checkIn && !checkIn.value) {
            checkIn.value = today.toISOString().split('T')[0];
            checkIn.min = today.toISOString().split('T')[0];
        }

        if (checkOut && !checkOut.value) {
            checkOut.value = tomorrow.toISOString().split('T')[0];
            checkOut.min = tomorrow.toISOString().split('T')[0];
        }

        calculateBookingTotal();
    });

    function openPhotoModal(slideIndex) {
        const modalEl = document.getElementById('staylyPhotoModal');
        if (modalEl) {
            const modal = new bootstrap.Modal(modalEl);
            modal.show();
            if (slideIndex !== undefined) {
                const carouselEl = document.getElementById('propertyPhotoCarousel');
                if (carouselEl) {
                    const carousel = bootstrap.Carousel.getOrCreateInstance(carouselEl);
                    carousel.to(slideIndex);
                }
            }
        }
    }

    function selectRoomForBooking(roomId, roomNumber, price, capacity) {
        const roomSelect = document.getElementById('bookingRoomSelect');
        if (roomSelect) {
            roomSelect.value = roomId;
            onRoomChanged(roomSelect);

            // Smooth scroll to booking widget
            const bookingWidget = document.querySelector('.stayly-sticky-booking-card');
            if (bookingWidget) {
                bookingWidget.scrollIntoView({ behavior: 'smooth', block: 'center' });
                bookingWidget.classList.add('border-primary');
                setTimeout(() => bookingWidget.classList.remove('border-primary'), 1500);
            }

            showStaylyToast('info', `Đã chọn Phòng ${roomNumber}. Hãy kiểm tra ngày nhận/trả phòng!`);
        }
    }

    function onRoomChanged(select) {
        const opt = select.options[select.selectedIndex];
        if (!opt) return;

        const price = Number(opt.dataset.price || 500000);
        const capacity = Number(opt.dataset.capacity || 2);

        const displayPrice = document.getElementById('widgetDisplayPrice');
        if (displayPrice) {
            displayPrice.textContent = price.toLocaleString('vi-VN');
        }

        const guestInput = document.getElementById('bookingGuestCount');
        const adultsInput = document.getElementById('bookingAdultsCount');
        if (adultsInput) {
            adultsInput.max = capacity;
            if (Number(adultsInput.value) > capacity) {
                adultsInput.value = capacity;
            }
        }

        calculateBookingTotal();
    }

    function updateServiceQty(idx, change) {
        const input = document.getElementById(`svc_qty_${idx}`);
        if (!input) return;
        let val = parseInt(input.value) || 0;
        val += change;
        if (val < 0) val = 0;
        input.value = val;
        calculateBookingTotal();
    }

    let currentAppliedPromo = null;

    async function applyPromoCode() {
        const input = document.getElementById('bookingPromoCode');
        const feedback = document.getElementById('promoFeedback');
        const btn = document.getElementById('btnApplyPromo');
        if (!input || !feedback) return;

        const code = input.value.trim().toUpperCase();
        if (!code) {
            currentAppliedPromo = null;
            feedback.className = 'small mt-1 text-danger';
            feedback.innerHTML = '<i class="bi bi-exclamation-circle me-1"></i> Vui lòng nhập mã giảm giá.';
            feedback.classList.remove('d-none');
            calculateBookingTotal();
            return;
        }

        const originalText = btn.innerHTML;
        btn.disabled = true;
        btn.innerHTML = '<span class="spinner-border spinner-border-sm"></span>';

        try {
            const res = await fetch(`/Home/CheckPromoCode?code=${encodeURIComponent(code)}`);
            const json = await res.json();

            if (res.ok && json.success && json.data) {
                currentAppliedPromo = json.data;
                feedback.className = 'small mt-1 text-success fw-semibold';
                const maxTxt = json.data.maxAmount ? ` (Tối đa ${Number(json.data.maxAmount).toLocaleString('vi-VN')} ₫)` : '';
                feedback.innerHTML = `<i class="bi bi-check-circle-fill me-1"></i> Đã áp dụng mã <strong>${json.data.code}</strong>: Giảm ${json.data.percentage}%${maxTxt}`;
                feedback.classList.remove('d-none');
                btn.classList.remove('btn-primary');
                btn.classList.add('btn-success');
                btn.innerHTML = '<i class="bi bi-check-lg"></i>';
                showStaylyToast('success', `Đã áp dụng mã ${json.data.code} thành công!`);
            } else {
                currentAppliedPromo = null;
                feedback.className = 'small mt-1 text-danger';
                feedback.innerHTML = `<i class="bi bi-x-circle-fill me-1"></i> ${json.message || 'Mã giảm giá không hợp lệ hoặc đã hết hạn.'}`;
                feedback.classList.remove('d-none');
                btn.classList.remove('btn-success');
                btn.classList.add('btn-primary');
                btn.innerHTML = 'Áp dụng';
                showStaylyToast('info', json.message || 'Mã giảm giá không hợp lệ.');
            }
        } catch (e) {
            currentAppliedPromo = null;
            feedback.className = 'small mt-1 text-danger';
            feedback.innerHTML = '<i class="bi bi-x-circle-fill me-1"></i> Lỗi kết nối khi kiểm tra mã.';
            feedback.classList.remove('d-none');
            btn.classList.remove('btn-success');
            btn.classList.add('btn-primary');
            btn.innerHTML = 'Áp dụng';
        } finally {
            btn.disabled = false;
            calculateBookingTotal();
        }
    }

    document.getElementById('bookingPromoCode')?.addEventListener('input', function() {
        const btn = document.getElementById('btnApplyPromo');
        if (btn) {
            btn.classList.remove('btn-success');
            btn.classList.add('btn-primary');
            btn.innerHTML = 'Áp dụng';
        }
    });

    document.getElementById('bookingPromoCode')?.addEventListener('keydown', function(e) {
        if (e.key === 'Enter') {
            e.preventDefault();
            applyPromoCode();
        }
    });

    function calculateBookingTotal() {
        const roomSelect = document.getElementById('bookingRoomSelect');
        const checkIn = document.getElementById('bookingCheckIn');
        const checkOut = document.getElementById('bookingCheckOut');

        if (!roomSelect || !checkIn || !checkOut) return;

        const opt = roomSelect.options[roomSelect.selectedIndex];
        const pricePerNight = opt ? Number(opt.dataset.price || 500000) : 500000;

        const d1 = new Date(checkIn.value);
        const d2 = new Date(checkOut.value);
        let nights = 1;

        if (d2 > d1) {
            const diffTime = Math.abs(d2 - d1);
            nights = Math.ceil(diffTime / (1000 * 60 * 60 * 24));
        }

        const total = pricePerNight * nights;

        let servicesTotal = 0;
        document.querySelectorAll('.service-qty').forEach(input => {
            const qty = parseInt(input.value) || 0;
            const p = parseFloat(input.dataset.price) || 0;
            servicesTotal += qty * p;
        });

        const rawTotal = total + servicesTotal;
        let discountAmount = 0;

        const discountRow = document.getElementById('breakdownDiscountRow');
        const discountText = document.getElementById('breakdownDiscount');
        const discountLabel = document.getElementById('breakdownDiscountLabel');

        if (currentAppliedPromo) {
            discountAmount = rawTotal * (currentAppliedPromo.percentage / 100);
            if (currentAppliedPromo.maxAmount && discountAmount > currentAppliedPromo.maxAmount) {
                discountAmount = currentAppliedPromo.maxAmount;
            }
            if (discountRow) discountRow.classList.remove('d-none');
            if (discountLabel) discountLabel.innerHTML = `<i class="bi bi-tag-fill me-1"></i> Mã <strong>${currentAppliedPromo.code}</strong> (-${currentAppliedPromo.percentage}%)`;
            if (discountText) discountText.textContent = `-${Math.round(discountAmount).toLocaleString('vi-VN')} ₫`;
        } else {
            if (discountRow) discountRow.classList.add('d-none');
        }

        const finalTotal = Math.max(0, rawTotal - discountAmount);

        const nightsText = document.getElementById('breakdownNightsText');
        const subtotal = document.getElementById('breakdownSubtotal');
        const servicesText = document.getElementById('breakdownServices');
        const grandTotal = document.getElementById('breakdownTotal');

        if (nightsText) nightsText.textContent = `${pricePerNight.toLocaleString('vi-VN')} ₫ × ${nights} đêm`;
        if (subtotal) subtotal.textContent = `${total.toLocaleString('vi-VN')} ₫`;
        if (servicesText) servicesText.textContent = servicesTotal > 0 ? `${servicesTotal.toLocaleString('vi-VN')} ₫` : '0 ₫';
        if (grandTotal) grandTotal.textContent = `${Math.round(finalTotal).toLocaleString('vi-VN')} ₫`;
    }

    function validateBookingSubmit(event) {
        const checkIn = document.getElementById('bookingCheckIn').value;
        const checkOut = document.getElementById('bookingCheckOut').value;

        if (!checkIn || !checkOut) {
            event.preventDefault();
            showStaylyToast('error', 'Vui lòng chọn ngày nhận phòng và ngày trả phòng.');
            return false;
        }

        if (new Date(checkOut) <= new Date(checkIn)) {
            event.preventDefault();
            showStaylyToast('error', 'Ngày trả phòng phải sau ngày nhận phòng.');
            return false;
        }

        const user = document.cookie.includes('token') || document.cookie.includes('.AspNetCore.Session'); // Better check via backend flow, but we let MVC handle it.
        // The controller will redirect to login if not authenticated anyway.

        const adults = Number(document.getElementById('bookingAdultsCount')?.value || 0);
        const children = Number(document.getElementById('bookingChildrenCount')?.value || 0);
        const guestInput = document.getElementById('bookingGuestCount');
        if (guestInput) guestInput.value = adults + children;

        // Bỏ qua các dịch vụ không chọn (số lượng = 0) để không gửi lên form
        document.querySelectorAll('.service-qty').forEach((qtyInput, idx) => {
            if (parseInt(qtyInput.value || 0) <= 0) {
                qtyInput.disabled = true;
                const idInput = document.querySelector(`input[name="Services[${idx}].ServiceId"]`);
                if (idInput) idInput.disabled = true;
            }
        });

        return true;
    }

    // Review Pagination Logic (tối đa 5 đánh giá / 1 trang)
    let currentReviewPage = 1;
    const totalReviewPages = @totalReviewPages;

    function goToReviewPage(pageNum) {
        if (pageNum < 1 || pageNum > totalReviewPages) return;
        currentReviewPage = pageNum;

        document.querySelectorAll('#reviewsContainer .review-page-item').forEach(item => {
            const itemPage = parseInt(item.getAttribute('data-page'));
            item.style.display = itemPage === currentReviewPage ? 'block' : 'none';
        });

        const displayEl = document.getElementById('currentReviewPageDisplay');
        if (displayEl) displayEl.textContent = currentReviewPage;

        const prevBtn = document.getElementById('btnPrevReviewPage');
        const nextBtn = document.getElementById('btnNextReviewPage');
        if (prevBtn) prevBtn.disabled = currentReviewPage <= 1;
        if (nextBtn) nextBtn.disabled = currentReviewPage >= totalReviewPages;

        document.querySelectorAll('#reviewPageNumbers .btn-review-page-btn').forEach(btn => {
            const btnPage = parseInt(btn.getAttribute('data-page'));
            if (btnPage === currentReviewPage) {
                btn.classList.remove('btn-outline-secondary');
                btn.classList.add('btn-primary');
            } else {
                btn.classList.remove('btn-primary');
                btn.classList.add('btn-outline-secondary');
            }
        });

        const section = document.getElementById('customerReviewsSection');
        if (section) {
            section.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
    }

    function changeReviewPage(delta) {
        goToReviewPage(currentReviewPage + delta);
    }

</script>
