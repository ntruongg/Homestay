                else
                {
                    <a class="nav-item host-portal-link" asp-controller="Home" asp-action="Register" asp-route-partner="true">
                        <span class="nav-icon">🤝</span> Hợp tác với chúng tôi (Host Portal)
                    </a>
                }
            </div>

            <!-- USER ACTIONS -->
            <div class="nav-user">
                @if (Context.Session.GetString("userName") is string name)
                {
                    <div class="user-dropdown-wrap">
                        <span class="user-greeting">
                            <span class="user-avatar-circle">👤</span>
                            <span>Xin chào, <strong>@name</strong></span>
                        </span>
                        @if (Context.Session.GetString("role") == "OWNER")
                        {
                            <a class="button outline owner-btn-nav" asp-controller="Home" asp-action="Dashboard">Dashboard Host</a>
                        }
                        <a class="button outline profile-btn" asp-controller="Home" asp-action="Profile">Hồ sơ</a>

                        <form asp-controller="Home" asp-action="Logout" method="post" style="display:inline;">
                            <button class="button logout-btn" title="Đăng xuất">Đăng xuất</button>
                            @Html.AntiForgeryToken()
                        </form>
                    </div>
                }
                else
                {
                    <a class="nav-login-btn" asp-controller="Home" asp-action="Login">
                        <span class="nav-icon-sm">🔑</span> Đăng nhập
                    </a>
                    <a class="button cta-btn-register" asp-controller="Home" asp-action="Register">
                        Đăng ký
                    </a>
                }
            </div>
        </nav>
    </header>

    <!-- MAIN BODY CONTENT -->
    <main class="main-content">
        @if (TempData["Error"] is string error)
        {
            <div class="container" style="margin-top: 20px;">
                <div class="alert error-traveloka">
                    <span class="alert-icon">⚠️</span>
                    <span>@error</span>
                </div>
            </div>
        }
        @if (TempData["Success"] is string success)
        {
            <div class="container" style="margin-top: 20px;">
                <div class="alert success-traveloka">
                    <span class="alert-icon">✅</span>
                    <span>@success</span>
                </div>
            </div>
        }
        @RenderBody()
    </main>

    <!-- OTA STANDARD FOOTER -->
    <footer class="traveloka-footer">
        <div class="footer-top">
            <div class="container footer-grid">
                <!-- Cột 1: Về Stayly -->
                <div class="footer-col">
                    <div class="footer-brand">
                        <span class="footer-logo">✈️ stayly</span>
                        <p class="footer-desc">Nền tảng đặt phòng homestay, căn hộ nghỉ dưỡng và khách sạn trực tuyến hàng đầu Việt Nam theo chuẩn Traveloka.</p>
                    </div>
                    <div class="hotline-box">
                        <span class="hotline-label">Tổng đài hỗ trợ 24/7 (Miễn phí)</span>
                        <strong class="hotline-number">📞 1900 8888</strong>
                        <span class="hotline-email">✉️ support@stayly.vn</span>
                    </div>
                </div>

                <!-- Cột 2: Sản phẩm & Khám phá -->
                <div class="footer-col">
                    <h4 class="footer-heading">Khám Phá Chỗ Nghỉ</h4>
                    <ul class="footer-links">
                        <li><a asp-controller="Home" asp-action="Index" asp-route-loaiHinh="Homestay">Homestay nguyên căn cao cấp</a></li>
                        <li><a asp-controller="Home" asp-action="Index" asp-route-loaiHinh="Hotel">Khách sạn theo hạng phòng</a></li>
                        <li><a asp-controller="Home" asp-action="Index" asp-route-location="Đà Lạt">Homestay Đà Lạt mộng mơ</a></li>
                        <li><a asp-controller="Home" asp-action="Index" asp-route-location="Vũng Tàu">Biệt thự biển Vũng Tàu</a></li>
                        <li><a asp-controller="Home" asp-action="Index" asp-route-location="Hà Nội">Căn hộ dịch vụ Hà Nội</a></li>
                    </ul>
                </div>

                <!-- Cột 3: Dành cho Đối tác (Host Portal) -->
                <div class="footer-col">
                    <h4 class="footer-heading">Dành Cho Đối Tác</h4>
                    <ul class="footer-links">
                        <li><a asp-controller="Home" asp-action="Register" asp-route-partner="true">Đăng ký trở thành Đối tác TERA</a></li>
                        <li><a asp-controller="Home" asp-action="Dashboard">Cổng quản lý Host Portal</a></li>
                        <li><a href="#stays">Chính sách hoa hồng sàn 15%</a></li>
                        <li><a href="#stays">Quy chuẩn an toàn PCCC &amp; ANTT</a></li>
                        <li><a href="#stays">Chính sách thanh toán &amp; quyết toán 85%</a></li>
                    </ul>
                </div>

                <!-- Cột 4: Điều khoản & Hỗ trợ -->
                <div class="footer-col">
                    <h4 class="footer-heading">Điều Khoản &amp; Hỗ Trợ</h4>
                    <ul class="footer-links">
                        <li><a href="#stays">Điều khoản sử dụng dịch vụ</a></li>
                        <li><a href="#stays">Chính sách quyền riêng tư</a></li>
                        <li><a href="#stays">Chính sách hoàn tiền &amp; hủy phòng</a></li>
                        <li><a href="#stays">Cơ chế bảo vệ thanh toán Stayly</a></li>
                        <li><a href="#stays">Câu hỏi thường gặp (FAQ)</a></li>
                    </ul>
                </div>

                <!-- Cột 5: Chứng nhận & Đối tác thanh toán -->
                <div class="footer-col">
                    <h4 class="footer-heading">Đối Tác &amp; Bảo Mật</h4>
                    <p class="footer-text-sm">Hệ thống thanh toán bảo mật đa lớp chuẩn PCI DSS Level 1 và SSL EV 256-bit.</p>
                    <div class="payment-badges">
                        <span class="pay-badge">VISA</span>
                        <span class="pay-badge">MasterCard</span>
                        <span class="pay-badge">JCB</span>
                        <span class="pay-badge">MoMo</span>
                        <span class="pay-badge">VNPay</span>
                    </div>
                    <div class="trust-badges" style="margin-top: 14px;">
                        <span class="trust-badge">🛡️ SSL SECURE</span>
                        <span class="trust-badge">🏛️ BỘ CÔNG THƯƠNG</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- FOOTER BOTTOM -->
        <div class="footer-bottom">
            <div class="container footer-bottom-inner">
                <p>&copy; @DateTime.Now.Year Stayly Traveloka Accommodation Platform. Bản quyền đã được đăng ký bảo hộ.</p>
                <div class="footer-bottom-links">
                    <span>Trụ sở: Tòa nhà Bitexco Financial Tower, Quận 1, TP. Hồ Chí Minh</span>
                </div>
            </div>
        </div>
    </footer>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
