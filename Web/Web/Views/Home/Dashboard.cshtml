                            <label style="display: flex; flex-direction: column; gap: 5px; font-size: 0.85rem; font-weight: 500; color: #334155;">
                                Tên cơ sở lưu trú *
                                <input type="text" name="Name" id="resubmitPropName" required style="padding: 9px 12px; border: 1px solid #cbd5e1; border-radius: 8px; font-size: 0.9rem;" />
                            </label>
                            <label style="display: flex; flex-direction: column; gap: 5px; font-size: 0.85rem; font-weight: 500; color: #334155;">
                                Loại hình
                                <input type="text" id="resubmitPropTypeDisplay" readonly style="padding: 9px 12px; border: 1px solid #e2e8f0; border-radius: 8px; font-size: 0.9rem; background: #f1f5f9; color: #475569;" />
                            </label>
                        </div>
                        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 14px; margin-top: 12px;">
                            <label style="display: flex; flex-direction: column; gap: 5px; font-size: 0.85rem; font-weight: 500; color: #334155;">
                                Số điện thoại đón khách *
                                <input type="text" name="Phone" id="resubmitPropPhone" required style="padding: 9px 12px; border: 1px solid #cbd5e1; border-radius: 8px; font-size: 0.9rem;" />
                            </label>
                            <label style="display: flex; flex-direction: column; gap: 5px; font-size: 0.85rem; font-weight: 500; color: #334155;">
                                Email liên hệ
                                <input type="email" name="Email" id="resubmitPropEmail" style="padding: 9px 12px; border: 1px solid #cbd5e1; border-radius: 8px; font-size: 0.9rem;" />
                            </label>
                        </div>
                        <div style="margin-top: 12px;">
                            <label style="display: flex; flex-direction: column; gap: 5px; font-size: 0.85rem; font-weight: 500; color: #334155;">
                                Mô tả / Chính sách cơ sở
                                <textarea name="Policy" id="resubmitPropPolicy" rows="2" style="padding: 9px 12px; border: 1px solid #cbd5e1; border-radius: 8px; font-size: 0.9rem; font-family: inherit;"></textarea>
                            </label>
                        </div>
                    </div>

                    <!-- Section 2: Location -->
                    <div style="margin-bottom: 20px; background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 12px; padding: 18px;">
                        <h4 style="margin: 0 0 12px; font-size: 0.95rem; color: #0f172a;">2. Vị trí &amp; Địa chỉ</h4>
                        <div style="display: grid; grid-template-columns: 2fr 1fr 1fr; gap: 14px;">
                            <label style="display: flex; flex-direction: column; gap: 5px; font-size: 0.85rem; font-weight: 500; color: #334155;">
                                Địa chỉ đường, số nhà *
                                <input type="text" name="Address" id="resubmitPropAddress" required style="padding: 9px 12px; border: 1px solid #cbd5e1; border-radius: 8px; font-size: 0.9rem;" />
                            </label>
                            <label style="display: flex; flex-direction: column; gap: 5px; font-size: 0.85rem; font-weight: 500; color: #334155;">
                                Phường / Xã
                                <input type="text" name="Ward" id="resubmitPropWard" style="padding: 9px 12px; border: 1px solid #cbd5e1; border-radius: 8px; font-size: 0.9rem;" />
                            </label>
                            <label style="display: flex; flex-direction: column; gap: 5px; font-size: 0.85rem; font-weight: 500; color: #334155;">
                                Tỉnh / Thành phố *
                                <input type="text" name="City" id="resubmitPropCity" required style="padding: 9px 12px; border: 1px solid #cbd5e1; border-radius: 8px; font-size: 0.9rem;" />
                            </label>
                        </div>
                    </div>

                    <!-- Section 2B: Homestay Pricing (if Homestay) -->
                    <div id="resubmitHomestayConfig" style="display: none; margin-bottom: 20px; background: #f0fdf4; border: 1px solid #bbf7d0; border-radius: 12px; padding: 18px;">
                        <h4 style="margin: 0 0 12px; font-size: 0.95rem; color: #166534;">2B. Thiết lập giá thuê Homestay nguyên căn</h4>
                        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 14px;">
                            <label style="display: flex; flex-direction: column; gap: 5px; font-size: 0.85rem; font-weight: 500; color: #166534;">
                                Giá thuê trọn gói / đêm (VNĐ)
                                <input type="number" name="HomestayPrice" id="resubmitHomestayPrice" min="50000" step="10000" style="padding: 9px 12px; border: 1px solid #86efac; border-radius: 8px; font-size: 0.9rem; background: #fff;" />
                            </label>
                            <label style="display: flex; flex-direction: column; gap: 5px; font-size: 0.85rem; font-weight: 500; color: #166534;">
                                Sức chứa tối đa (người)
                                <input type="number" name="HomestayCapacity" id="resubmitHomestayCapacity" min="1" max="100" style="padding: 9px 12px; border: 1px solid #86efac; border-radius: 8px; font-size: 0.9rem; background: #fff;" />
                            </label>
                        </div>
                    </div>

                    <!-- Section 3: Legal Documents Replacement -->
                    <div style="margin-bottom: 20px; background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 12px; padding: 18px;">
                        <h4 style="margin: 0 0 4px; font-size: 0.95rem; color: #0f172a;">3. Cập nhật / Tải lại Hồ sơ pháp lý thẩm định</h4>
                        <p style="margin: 0 0 14px; font-size: 0.8rem; color: #64748b;">
                            Nếu lý do từ chối liên quan đến giấy tờ (mờ, thiếu, sai thông tin), hãy tải lên tệp mới tại đây để thay thế.
                        </p>

                        <div style="display: flex; flex-direction: column; gap: 12px;">
                            <div style="background: #fff; border: 1px solid #cbd5e1; border-radius: 8px; padding: 12px 14px;">
                                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 6px;">
                                    <span style="font-size: 0.86rem; font-weight: 600; color: #334155;">📄 Giấy phép đăng ký kinh doanh</span>
                                    <span id="resubmitBizLicenseStatus" style="font-size: 0.78rem; color: #64748b;"></span>
                                </div>
                                <input type="file" name="BusinessLicenseFile" accept=".pdf,.png,.jpg,.jpeg" style="font-size: 0.85rem; width: 100%;" />
                            </div>

                            <div style="background: #fff; border: 1px solid #cbd5e1; border-radius: 8px; padding: 12px 14px;">
                                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 6px;">
                                    <span style="font-size: 0.86rem; font-weight: 600; color: #334155;">🔥 Chứng nhận đủ điều kiện PCCC</span>
                                    <span id="resubmitFireSafetyStatus" style="font-size: 0.78rem; color: #64748b;"></span>
                                </div>
                                <input type="file" name="FireSafetyFile" accept=".pdf,.png,.jpg,.jpeg" style="font-size: 0.85rem; width: 100%;" />
                            </div>

                            <div style="background: #fff; border: 1px solid #cbd5e1; border-radius: 8px; padding: 12px 14px;">
                                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 6px;">
                                    <span style="font-size: 0.86rem; font-weight: 600; color: #334155;">🛡️ Giấy xác nhận An ninh trật tự</span>
                                    <span id="resubmitSecurityStatus" style="font-size: 0.78rem; color: #64748b;"></span>
                                </div>
                                <input type="file" name="SecurityFile" accept=".pdf,.png,.jpg,.jpeg" style="font-size: 0.85rem; width: 100%;" />
                            </div>
                        </div>
                    </div>

                    <!-- Section 4: Amenities -->
                    @if (Model.AvailableAmenities != null && Model.AvailableAmenities.Any())
                    {
                        <div style="margin-bottom: 20px; background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 12px; padding: 18px;">
                            <h4 style="margin: 0 0 10px; font-size: 0.95rem; color: #0f172a;">4. Tiện ích cơ sở lưu trú</h4>
                            <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(180px, 1fr)); gap: 8px;">
                                @foreach (var am in Model.AvailableAmenities)
                                {
                                    <label style="display: flex; align-items: center; gap: 8px; font-size: 0.84rem; color: #334155; background: #fff; border: 1px solid #cbd5e1; padding: 6px 10px; border-radius: 6px; cursor: pointer;">
                                        <input type="checkbox" name="AmenityIds" value="@am.Id" class="resubmit-amenity-cb" />
                                        <span>@am.Name</span>
                                    </label>
                                }
                            </div>
                        </div>
                    }

                    <div style="display: flex; justify-content: flex-end; gap: 12px; margin-top: 20px; border-top: 1px solid #e2e8f0; padding-top: 16px;">
                        <button type="button" class="button outline" onclick="closeResubmitModal()">Hủy bỏ</button>
                        <button type="submit" class="button" style="background: #d97706; border-color: #d97706; padding: 10px 24px; font-weight: 600;">
                            🚀 Gửi lại yêu cầu thẩm định cho Admin &rarr;
                        </button>
                    </div>
                    @Html.AntiForgeryToken()
                </form>
            </div>
        </div>
    </div>
}
