@model ProfileViewModel

@{
    var profile = Model.Profile;
    var isOwner = profile.Role == "OWNER";
    ViewData["Title"] = isOwner ? "Hồ sơ Chủ cơ sở - Stayly" : "Thông tin cá nhân - Stayly";
    var initials = !string.IsNullOrWhiteSpace(profile.FullName) 
        ? profile.FullName.Substring(0, 1).ToUpper() 
        : "U";
    var activeTab = string.IsNullOrWhiteSpace(Model.ActiveTab) ? "personal" : Model.ActiveTab.ToLowerInvariant();
}

<div class="stayly-profile-page py-4" style="background-color: #f8f9fc; min-height: calc(100vh - 120px);">
    <div class="container py-2">
        <!-- Breadcrumb / Quay lại -->
        <div class="d-flex align-items-center justify-content-between mb-3 flex-wrap gap-2">
            <a asp-action="Index" class="btn btn-sm btn-outline-secondary rounded-pill px-3 py-2 d-inline-flex align-items-center gap-2">
                <i class="bi bi-arrow-left"></i>
                <span>Quay lại trang chủ</span>
            </a>
            @if (isOwner)
            {
                <a asp-action="Dashboard" class="btn btn-sm btn-primary rounded-pill px-4 py-2 fw-bold shadow-sm d-inline-flex align-items-center gap-2">
                    <i class="bi bi-speedometer2"></i>
                    <span>Bảng điều khiển chủ cơ sở</span>
                </a>
            }
            else
            {
                <a asp-action="Trips" class="btn btn-sm btn-outline-primary rounded-pill px-4 py-2 fw-bold d-inline-flex align-items-center gap-2">
                    <i class="bi bi-briefcase-fill"></i>
                    <span>Đơn đặt phòng của tôi</span>
                </a>
            }
        </div>

        <!-- 1. Top Banner Profile (Thẻ Squircle bo góc 24px, Soft Ocean Blue) -->
        <div class="card border-0 mb-4 p-4 p-md-5" style="border-radius: 24px; box-shadow: var(--stayly-shadow); background: #ffffff;">
            <div class="d-flex align-items-center justify-content-between flex-wrap gap-4">
                <div class="d-flex align-items-center gap-4">
                    <!-- Avatar tròn lớn với chữ cái đầu -->
                    <div class="d-flex align-items-center justify-content-center text-white fw-bold shadow-sm" 
                         style="width: 84px; height: 84px; border-radius: 50%; font-size: 2.2rem; background: linear-gradient(135deg, var(--stayly-primary) 0%, #0096c7 100%); flex-shrink: 0;">
                        @initials
                    </div>
                    <div>
                        <div class="d-flex align-items-center gap-2 flex-wrap mb-1">
                            <h2 class="fs-4 fw-bold text-navy mb-0">@profile.FullName</h2>
                            @if (isOwner)
                            {
                                <span class="badge rounded-pill px-3 py-1 bg-primary text-white small fw-bold">
                                    <i class="bi bi-patch-check-fill me-1"></i> Chủ cơ sở lưu trú
                                </span>
                            }
                            else
                            {
                                <span class="badge rounded-pill px-3 py-1 bg-light text-primary border small fw-bold">
                                    <i class="bi bi-person-heart me-1"></i> Khách hàng du lịch
                                </span>
                            }
                        </div>
                        <div class="text-muted small d-flex align-items-center gap-3 flex-wrap">
                            <span><i class="bi bi-envelope-fill text-primary me-1"></i> @profile.Email</span>
                            <span>•</span>
                            <span><i class="bi bi-telephone-fill text-primary me-1"></i> @(string.IsNullOrWhiteSpace(profile.Phone) ? "Chưa cập nhật SĐT" : profile.Phone)</span>
                            <span>•</span>
                            <span>Mã tài khoản: <strong>#ND-@profile.Id</strong></span>
                        </div>
                    </div>
                </div>

                <div class="d-flex gap-2">
                    @if (isOwner)
                    {
                        <span class="badge bg-light text-success border rounded-pill px-3 py-2 small d-inline-flex align-items-center gap-1">
                            <i class="bi bi-shield-fill-check fs-6 text-success"></i>
                            <span>Tài khoản đối tác đã kích hoạt</span>
                        </span>
                    }
                    else
                    {
                        <span class="badge bg-light text-navy border rounded-pill px-3 py-2 small d-inline-flex align-items-center gap-1">
                            <i class="bi bi-check-circle-fill fs-6 text-primary"></i>
                            <span>Thành viên Stayly</span>
                        </span>
                    }
                </div>
            </div>
        </div>

        <!-- Thông báo Toast / Alert nếu có -->
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success border-0 rounded-4 shadow-sm mb-4 d-flex align-items-center gap-2">
                <i class="bi bi-check-circle-fill fs-5 text-success"></i>
                <div>@TempData["Success"]</div>
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger border-0 rounded-4 shadow-sm mb-4 d-flex align-items-center gap-2">
                <i class="bi bi-exclamation-triangle-fill fs-5 text-danger"></i>
                <div>@TempData["Error"]</div>
            </div>
        }

        <!-- 2. Bố cục 2 cột (Tabs Sidebar trái + Nội dung Form phải) -->
        <div class="row g-4">
            <!-- Cột trái: Menu Tabs -->
            <div class="col-lg-4">
                <div class="card border-0 p-3" style="border-radius: 20px; box-shadow: var(--stayly-shadow); background: #ffffff;">
                    <div class="p-2 text-muted fw-bold small text-uppercase" style="letter-spacing: 0.05em;">
                        Quản lý tài khoản
                    </div>
                    <nav class="d-flex flex-column gap-2 mt-2" id="profileTabsNav">
                        <button type="button" class="btn text-start p-3 rounded-4 d-flex align-items-center justify-content-between profile-tab-btn @(activeTab == "personal" ? "active" : "")" data-tab="tab-personal">
                            <div class="d-flex align-items-center gap-3">
                                <span class="profile-tab-icon"><i class="bi bi-person-lines-fill"></i></span>
                                <div>
                                    <div class="fw-bold profile-tab-title">Thông tin cá nhân</div>
                                    <small class="text-muted">Họ tên, liên hệ &amp; định danh</small>
                                </div>
                            </div>
                            <i class="bi bi-chevron-right text-muted small"></i>
                        </button>

                        <button type="button" class="btn text-start p-3 rounded-4 d-flex align-items-center justify-content-between profile-tab-btn @(activeTab == "security" ? "active" : "")" data-tab="tab-security">
                            <div class="d-flex align-items-center gap-3">
                                <span class="profile-tab-icon"><i class="bi bi-shield-lock-fill"></i></span>
                                <div>
                                    <div class="fw-bold profile-tab-title">Bảo mật &amp; Mật khẩu</div>
                                    <small class="text-muted">Đổi mật khẩu tài khoản</small>
                                </div>
                            </div>
                            <i class="bi bi-chevron-right text-muted small"></i>
                        </button>

                        <button type="button" class="btn text-start p-3 rounded-4 d-flex align-items-center justify-content-between profile-tab-btn @(activeTab == "account" ? "active" : "")" data-tab="tab-account">
                            <div class="d-flex align-items-center gap-3">
                                <span class="profile-tab-icon"><i class="bi bi-grid-fill"></i></span>
                                <div>
                                    <div class="fw-bold profile-tab-title">Tổng quan tài khoản</div>
                                    <small class="text-muted">Vai trò &amp; thông tin hệ thống</small>
                                </div>
                            </div>
                            <i class="bi bi-chevron-right text-muted small"></i>
                        </button>
                    </nav>

                    <div class="p-3 bg-light rounded-4 mt-3 small text-muted">
                        <i class="bi bi-lightbulb-fill text-warning me-1"></i>
                        <strong>Mẹo:</strong> Hãy luôn cập nhật số điện thoại và email chính xác để nhận thông báo đặt phòng tức thì từ Stayly.
                    </div>
                </div>
            </div>

            <!-- Cột phải: Khối Nội dung Form tương ứng Tab -->
            <div class="col-lg-8">
                <!-- TAB 1: Thông tin cá nhân -->
                <div id="tab-personal" class="tab-pane-content @(activeTab == "personal" ? "active" : "d-none")">
                    <div class="card border-0 p-4 p-md-5" style="border-radius: 20px; box-shadow: var(--stayly-shadow); background: #ffffff;">
                        <div class="d-flex align-items-center justify-content-between mb-4 pb-3 border-bottom flex-wrap gap-2">
                            <div>
                                <h3 class="fs-5 fw-bold text-navy mb-1">
                                    <i class="bi bi-person-vcard text-primary me-2"></i>
                                    @(isOwner ? "Thông tin cá nhân & Đối tác Chủ cơ sở" : "Thông tin cá nhân khách hàng")
                                </h3>
                                <p class="text-muted small mb-0">Cập nhật thông tin định danh và liên hệ của bạn trên nền tảng Stayly.</p>
                            </div>
                            <span class="badge rounded-pill bg-light text-primary px-3 py-2 small fw-bold">
                                @(isOwner ? "Hồ sơ Đối tác" : "Hồ sơ Khách hàng")
                            </span>
                        </div>

                        <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-4 py-2 px-3 small mb-3"></div>

                        <form asp-action="Profile" method="post" id="profileForm">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="tab" value="personal" />

                            <!-- Khối 1: Thông tin liên hệ cơ bản -->
                            <div class="row g-3 mb-4">
                                <div class="col-md-12">
                                    <label class="form-label small fw-bold">Họ và tên đầy đủ *</label>
                                    <input asp-for="Input.FullName" class="form-control rounded-pill px-3 py-2" required placeholder="Ví dụ: Nguyễn Văn An" />
                                    <span asp-validation-for="Input.FullName" class="text-danger small"></span>
                                </div>

                                <div class="col-md-6">
                                    <label class="form-label small fw-bold">Ngày sinh</label>
                                    <input asp-for="Input.DateOfBirth" type="date" class="form-control rounded-pill px-3 py-2" />
                                </div>

                                <div class="col-md-6">
                                    <label class="form-label small fw-bold">Giới tính</label>
                                    <select asp-for="Input.Gender" class="form-select rounded-pill px-3 py-2">
                                        <option value="">Chọn giới tính</option>
                                        <option value="M">Nam</option>
                                        <option value="F">Nữ</option>
                                        <option value="O">Khác</option>
                                    </select>
                                </div>

                                <div class="col-md-6">
                                    <label class="form-label small fw-bold">Số điện thoại *</label>
                                    <input asp-for="Input.Phone" type="tel" class="form-control rounded-pill px-3 py-2" required placeholder="0901234567" />
                                    <span asp-validation-for="Input.Phone" class="text-danger small"></span>
                                </div>

                                <div class="col-md-6">
                                    <label class="form-label small fw-bold">Địa chỉ Email (Chỉ đọc)</label>
                                    <input asp-for="Input.Email" type="email" class="form-control rounded-pill px-3 py-2 bg-light" readonly />
                                    <span class="text-muted small">Vui lòng sang tab <strong>Bảo mật</strong> để đổi email.</span>
                                </div>
                            </div>

                            <!-- Khối 2: Dành riêng cho Chủ cơ sở lưu trú (CCCD & Ngân hàng) -->
                            @if (isOwner)
                            {
                                <div class="p-3 bg-light rounded-4 mb-4">
                                    <h6 class="fw-bold text-navy small mb-3">
                                        <i class="bi bi-bank2 text-primary me-1"></i> Thông tin pháp lý &amp; Thanh toán thụ hưởng của Chủ cơ sở
                                    </h6>
                                    <div class="row g-3">
                                        <div class="col-md-12">
                                            <label class="form-label small fw-bold">Số CCCD / Mã định danh cá nhân *</label>
                                            <input asp-for="Input.CitizenId" class="form-control rounded-pill px-3 py-2" required placeholder="Nhập 9 - 12 chữ số CCCD" />
                                            <span asp-validation-for="Input.CitizenId" class="text-danger small"></span>
                                        </div>

                                        <div class="col-md-6">
                                            <label class="form-label small fw-bold">Ngân hàng thụ hưởng *</label>
                                            <select asp-for="Input.BankName" class="form-select rounded-pill px-3 py-2" required>
                                                <option value="">-- Chọn ngân hàng hỗ trợ --</option>
                                                <option value="Vietcombank (VCB)">Vietcombank (Ngân hàng Ngoại thương)</option>
                                                <option value="VietinBank (CTG)">VietinBank (Ngân hàng Công thương)</option>
                                                <option value="BIDV">BIDV (Đầu tư và Phát triển)</option>
                                                <option value="Agribank">Agribank (Nông nghiệp &amp; PTNT)</option>
                                                <option value="MB Bank (Ngân hàng Quân Đội)">MB Bank (Ngân hàng Quân Đội)</option>
                                                <option value="Techcombank (TCB)">Techcombank (Kỹ thương)</option>
                                                <option value="ACB (Ngân hàng Á Châu)">ACB (Ngân hàng Á Châu)</option>
                                                <option value="VPBank">VPBank (Việt Nam Thịnh Vượng)</option>
                                                <option value="TPBank (Tiên Phong)">TPBank (Tiên Phong)</option>
                                                <option value="Sacombank">Sacombank (Sài Gòn Thương Tín)</option>
                                                <option value="HDBank">HDBank (Phát triển TP.HCM)</option>
                                                <option value="VIB (Quốc Tế)">VIB (Quốc tế Việt Nam)</option>
                                                <option value="SHB">SHB (Sài Gòn - Hà Nội)</option>
                                                <option value="SeABank">SeABank (Đông Nam Á)</option>
                                                <option value="OCB (Phương Đông)">OCB (Phương Đông)</option>
                                                <option value="MSB (Hàng Hải)">MSB (Hàng Hải)</option>
                                                <option value="Eximbank">Eximbank (Xuất Nhập Khẩu)</option>
                                                <option value="Nam A Bank">Nam A Bank (Nam Á)</option>
                                                <option value="LPBank (Lộc Phát VN)">LPBank (Lộc Phát Việt Nam)</option>
                                                <option value="BaoViet Bank">BaoViet Bank (Bảo Việt)</option>
                                            </select>
                                            <span asp-validation-for="Input.BankName" class="text-danger small"></span>
                                        </div>

                                        <div class="col-md-6">
                                            <label class="form-label small fw-bold">Số tài khoản *</label>
                                            <input asp-for="Input.AccountNumber" class="form-control rounded-pill px-3 py-2" required placeholder="Nhập số tài khoản" pattern="\d{6,20}" />
                                            <span asp-validation-for="Input.AccountNumber" class="text-danger small"></span>
                                        </div>

                                        <div class="col-md-12">
                                            <label class="form-label small fw-bold">Tên chủ tài khoản *</label>
                                            <input asp-for="Input.AccountHolder" class="form-control rounded-pill px-3 py-2" required placeholder="Ví dụ: NGUYEN VAN AN" pattern="^[a-zA-ZÀÁÂÃÈÉÊÌÍÒÓÔÕÙÚĂĐĨŨƠàáâãèéêìíòóôõùúăđĩũơƯĂẠẢẤẦẨẪẬẮẰẲẴẶẸẺẼỀỀỂưăạảấầẩẫậắằẳẵặẹẻẽềềểỄỆỈỊỌỎỐỒỔỖỘỚỜỞỠỢỤỦỨỪễệỉịọỏốồổỗộớờởỡợụủứừỬỮỰỲỴÝỶỸửữựỳỵỷỹ\s]+$" />
                                            <span asp-validation-for="Input.AccountHolder" class="text-danger small"></span>
                                        </div>
                                    </div>
                                </div>
                            }
                            else
                            {
                                <div class="p-3 bg-light rounded-4 mb-4">
                                    <h6 class="fw-bold text-navy small mb-1">
                                        <i class="bi bi-bank2 text-primary me-1"></i> Tài khoản ngân hàng nhận hoàn tiền (Tùy chọn)
                                    </h6>
                                    <p class="text-muted small mb-3">Lưu sẵn thông tin ngân hàng để tự động điền khi bạn hủy đơn hoặc yêu cầu hoàn tiền.</p>
                                    <div class="row g-3">
                                        <div class="col-md-6">
                                            <label class="form-label small fw-bold">Ngân hàng thụ hưởng</label>
                                            <select asp-for="Input.BankName" class="form-select rounded-pill px-3 py-2">
                                                <option value="">-- Chọn ngân hàng hỗ trợ --</option>
                                                <option value="Vietcombank (VCB)">Vietcombank (Ngân hàng Ngoại thương)</option>
                                                <option value="VietinBank (CTG)">VietinBank (Ngân hàng Công thương)</option>
                                                <option value="BIDV">BIDV (Đầu tư và Phát triển)</option>
                                                <option value="Agribank">Agribank (Nông nghiệp &amp; PTNT)</option>
                                                <option value="MB Bank (Ngân hàng Quân Đội)">MB Bank (Ngân hàng Quân Đội)</option>
                                                <option value="Techcombank (TCB)">Techcombank (Kỹ thương)</option>
                                                <option value="ACB (Ngân hàng Á Châu)">ACB (Ngân hàng Á Châu)</option>
                                                <option value="VPBank">VPBank (Việt Nam Thịnh Vượng)</option>
                                                <option value="TPBank (Tiên Phong)">TPBank (Tiên Phong)</option>
                                                <option value="Sacombank">Sacombank (Sài Gòn Thương Tín)</option>
                                                <option value="HDBank">HDBank (Phát triển TP.HCM)</option>
                                                <option value="VIB (Quốc Tế)">VIB (Quốc tế Việt Nam)</option>
                                                <option value="SHB">SHB (Sài Gòn - Hà Nội)</option>
                                                <option value="SeABank">SeABank (Đông Nam Á)</option>
                                                <option value="OCB (Phương Đông)">OCB (Phương Đông)</option>
                                                <option value="MSB (Hàng Hải)">MSB (Hàng Hải)</option>
                                                <option value="Eximbank">Eximbank (Xuất Nhập Khẩu)</option>
                                                <option value="Nam A Bank">Nam A Bank (Nam Á)</option>
                                                <option value="LPBank (Lộc Phát VN)">LPBank (Lộc Phát Việt Nam)</option>
                                                <option value="BaoViet Bank">BaoViet Bank (Bảo Việt)</option>
                                            </select>
                                        </div>
                                        <div class="col-md-6">
                                            <label class="form-label small fw-bold">Số tài khoản</label>
                                            <input asp-for="Input.AccountNumber" class="form-control rounded-pill px-3 py-2" placeholder="Nhập số tài khoản" />
                                        </div>
                                        <div class="col-md-12">
                                            <label class="form-label small fw-bold">Tên chủ tài khoản</label>
                                            <input asp-for="Input.AccountHolder" class="form-control rounded-pill px-3 py-2" placeholder="Ví dụ: NGUYEN VAN AN" />
                                        </div>
                                    </div>
                                </div>
                            }

                            <!-- Nút Lưu -->
                            <div class="d-flex align-items-center justify-content-end gap-3 pt-3 border-top">
                                <button type="reset" class="btn btn-light rounded-pill px-4 py-2 border">Hủy thay đổi</button>
                                <button type="submit" class="btn btn-primary rounded-pill px-4 py-2 fw-bold shadow-sm d-inline-flex align-items-center gap-2">
                                    <i class="bi bi-check2-circle"></i>
                                    <span>Lưu thông tin</span>
                                </button>
                            </div>
                        </form>
                    </div>
                </div>

                <!-- TAB 2: Bảo mật & Mật khẩu -->
                <div id="tab-security" class="tab-pane-content @(activeTab == "security" ? "active" : "d-none")">
                    <div class="card border-0 p-4 p-md-5" style="border-radius: 20px; box-shadow: var(--stayly-shadow); background: #ffffff;">
                        <div class="mb-4 pb-3 border-bottom">
                            <h3 class="fs-5 fw-bold text-navy mb-1">
                                <i class="bi bi-shield-lock text-primary me-2"></i> Bảo mật &amp; Đổi mật khẩu
                            </h3>
                            <p class="text-muted small mb-0">Thay đổi mật khẩu đăng nhập để bảo vệ an toàn cho tài khoản Stayly của bạn.</p>
                        </div>

                        <div class="alert alert-info py-2 px-3 small rounded-3 mb-4 d-flex align-items-center gap-2">
                            <i class="bi bi-info-circle-fill text-primary fs-5"></i>
                            <div><strong>Khuyến nghị an toàn:</strong> Sử dụng mật khẩu tối thiểu 8 ký tự, kết hợp chữ in hoa, chữ số và ký tự đặc biệt.</div>
                        </div>

                        <div class="row g-4">
                            <div class="col-md-6">
                                <h4 class="fw-bold text-navy mb-3">Đổi mật khẩu</h4>
                                <form asp-action="ChangePassword" method="post">
                                    @Html.AntiForgeryToken()

                                    <div class="mb-3">
                                        <label class="form-label small fw-bold">Mật khẩu hiện tại *</label>
                                        <input asp-for="PasswordInput.CurrentPassword" type="password" class="form-control rounded-pill px-3 py-2" required />
                                    </div>

                                    <div class="mb-3">
                                        <label class="form-label small fw-bold">Mật khẩu mới *</label>
                                        <input asp-for="PasswordInput.NewPassword" type="password" class="form-control rounded-pill px-3 py-2" required minlength="8" />
                                    </div>

                                    <div class="mb-3">
                                        <label class="form-label small fw-bold">Xác nhận mật khẩu mới *</label>
                                        <input asp-for="PasswordInput.ConfirmPassword" type="password" class="form-control rounded-pill px-3 py-2" required />
                                    </div>

                                    <div class="mb-4">
                                        <label class="form-label small fw-bold">Mã xác thực OTP (gửi về email hiện tại) *</label>
                                        <div class="input-group">
                                            <input asp-for="PasswordInput.OtpCode" type="text" class="form-control rounded-start-pill px-3 py-2" required />
                                            <button type="button" class="btn btn-outline-primary rounded-end-pill px-3 fw-bold" onclick="sendProfileOtp('ChangePassword', this)">Gửi mã</button>
                                        </div>
                                    </div>

                                    <button type="submit" class="btn btn-primary rounded-pill px-4 py-2 fw-bold w-100 shadow-sm">Cập nhật mật khẩu</button>
                                </form>
                            </div>

                            <div class="col-md-6">
                                <h4 class="fw-bold text-navy mb-3">Đổi địa chỉ Email</h4>
                                <form asp-action="ChangeEmail" method="post">
                                    @Html.AntiForgeryToken()

                                    <div class="mb-3">
                                        <label class="form-label small fw-bold">Địa chỉ Email mới *</label>
                                        <input asp-for="EmailInput.NewEmail" type="email" class="form-control rounded-pill px-3 py-2" required placeholder="nhap.email.moi@domain.com" />
                                    </div>

                                    <div class="mb-4">
                                        <label class="form-label small fw-bold">Mã xác thực OTP (gửi về email CŨ) *</label>
                                        <div class="input-group">
                                            <input asp-for="EmailInput.OtpCode" type="text" class="form-control rounded-start-pill px-3 py-2" required />
                                            <button type="button" class="btn btn-outline-primary rounded-end-pill px-3 fw-bold" onclick="sendProfileOtp('ChangeEmail', this)">Gửi mã</button>
                                        </div>
                                    </div>

                                    <button type="submit" class="btn btn-outline-primary rounded-pill px-4 py-2 fw-bold w-100 shadow-sm">Cập nhật Email</button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- TAB 3: Tổng quan tài khoản -->
                <div id="tab-account" class="tab-pane-content @(activeTab == "account" ? "active" : "d-none")">
                    <div class="card border-0 p-4 p-md-5" style="border-radius: 20px; box-shadow: var(--stayly-shadow); background: #ffffff;">
                        <div class="mb-4 pb-3 border-bottom">
                            <h3 class="fs-5 fw-bold text-navy mb-1">
                                <i class="bi bi-person-badge text-primary me-2"></i> Tổng quan tài khoản Stayly
                            </h3>
                            <p class="text-muted small mb-0">Tóm tắt các thông tin đăng ký định danh và quyền hạn của bạn trong hệ thống.</p>
                        </div>

                        <div class="row g-3 mb-4">
                            <div class="col-md-6">
                                <div class="p-3 bg-light rounded-4">
                                    <div class="text-muted small">Mã định danh (ID)</div>
                                    <div class="fw-bold fs-6 text-navy">#ND-@profile.Id</div>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="p-3 bg-light rounded-4">
                                    <div class="text-muted small">Loại tài khoản / Vai trò</div>
                                    <div class="fw-bold fs-6">
                                        @if (isOwner)
                                        {
                                            <span class="text-primary"><i class="bi bi-patch-check-fill me-1"></i> OWNER (Chủ cơ sở)</span>
                                        }
                                        else
                                        {
                                            <span class="text-info"><i class="bi bi-person-fill me-1"></i> GUEST (Khách thuê)</span>
                                        }
                                    </div>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="p-3 bg-light rounded-4">
                                    <div class="text-muted small">Email xác thực</div>
                                    <div class="fw-bold fs-6 text-navy">@profile.Email</div>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="p-3 bg-light rounded-4">
                                    <div class="text-muted small">Số điện thoại liên hệ</div>
                                    <div class="fw-bold fs-6 text-navy">@(string.IsNullOrWhiteSpace(profile.Phone) ? "Chưa cung cấp" : profile.Phone)</div>
                                </div>
                            </div>

                            @if (isOwner)
                            {
                                <div class="col-md-6">
                                    <div class="p-3 bg-light rounded-4">
                                        <div class="text-muted small">Số căn cước công dân (CCCD)</div>
                                        <div class="fw-bold fs-6 text-navy">@(string.IsNullOrWhiteSpace(profile.CitizenId) ? "Chưa cung cấp" : profile.CitizenId)</div>
                                    </div>
                                </div>

                                <div class="col-md-6">
                                    <div class="p-3 bg-light rounded-4">
                                        <div class="text-muted small">Tài khoản ngân hàng</div>
                                        <div class="fw-bold fs-6 text-navy text-truncate" title="@profile.BankName - @profile.AccountNumber - @profile.AccountHolder">@(string.IsNullOrWhiteSpace(profile.BankName) ? "Chưa cung cấp" : $"{profile.BankName} - {profile.AccountNumber} - {profile.AccountHolder}")</div>
                                    </div>
                                </div>
                            }
                        </div>

                        <div class="d-flex align-items-center gap-3 pt-3 border-top flex-wrap">
                            @if (isOwner)
                            {
                                <a asp-action="Dashboard" class="btn btn-primary rounded-pill px-4 py-2 fw-bold shadow-sm d-inline-flex align-items-center gap-2">
                                    <i class="bi bi-house-gear-fill"></i>
                                    <span>Mở Bảng điều khiển Quản trị Cơ sở</span>
                                </a>
                            }
                            <a asp-action="Trips" class="btn btn-outline-primary rounded-pill px-4 py-2 fw-bold d-inline-flex align-items-center gap-2">
                                <i class="bi bi-calendar2-check-fill"></i>
                                <span>Xem danh sách Đơn đặt phòng</span>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .profile-tab-btn {
        border: 1.5px solid transparent;
        background: #f8fafc;
        transition: all 0.2s ease;
    }
    .profile-tab-btn:hover {
        background: var(--stayly-light-accent);
        border-color: var(--stayly-primary);
    }
    .profile-tab-btn.active {
        background: var(--stayly-light-accent);
        border-color: var(--stayly-primary);
    }
    .profile-tab-btn.active .profile-tab-title {
        color: var(--stayly-primary);
    }
    .profile-tab-icon {
        width: 42px;
        height: 42px;
        border-radius: 12px;
        background: #ffffff;
        color: var(--stayly-primary);
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 1.25rem;
        box-shadow: 0 2px 6px rgba(0, 119, 182, 0.1);
        flex-shrink: 0;
    }
    .profile-tab-btn.active .profile-tab-icon {
        background: var(--stayly-primary);
        color: #ffffff;
    }
</style>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const navButtons = document.querySelectorAll("#profileTabsNav .profile-tab-btn");
            const panes = document.querySelectorAll(".tab-pane-content");

            navButtons.forEach(btn => {
                btn.addEventListener("click", function () {
                    const targetId = this.getAttribute("data-tab");

                    navButtons.forEach(b => b.classList.remove("active"));
                    panes.forEach(p => {
                        p.classList.remove("active");
                        p.classList.add("d-none");
                    });

                    this.classList.add("active");
                    const targetPane = document.getElementById(targetId);
                    if (targetPane) {
                        targetPane.classList.remove("d-none");
                        targetPane.classList.add("active");
                    }

                    // Update URL without reload
                    const tabKey = targetId.replace("tab-", "");
                    const newUrl = new URL(window.location);
                    newUrl.searchParams.set("tab", tabKey);
                    window.history.replaceState({}, "", newUrl);
                });
            });
        });

        async function sendProfileOtp(purpose, btn) {
            const originalText = btn.innerText;
            btn.disabled = true;
            btn.innerText = "Đang gửi...";
            try {
                const response = await fetch(`/Home/SendProfileOtp?purpose=${purpose}`, {
                    method: 'POST'
                });
                if (response.ok) {
                    showStaylyToast("Thành công", "Mã OTP đã được gửi về email của bạn.", "success");
                    let countdown = 60;
                    const interval = setInterval(() => {
                        countdown--;
                        btn.innerText = `Chờ ${countdown}s`;
                        if (countdown <= 0) {
                            clearInterval(interval);
                            btn.disabled = false;
                            btn.innerText = originalText;
                        }
                    }, 1000);
                    return;
                }
                const err = await response.text();
                showStaylyToast("Lỗi", err || "Không thể gửi OTP.", "error");
                btn.disabled = false;
                btn.innerText = originalText;
            } catch (e) {
                showStaylyToast("Lỗi", "Đã xảy ra lỗi kết nối.", "error");
                btn.disabled = false;
                btn.innerText = originalText;
            }
        }
    </script>
}