@model OwnerDashboardViewModel

@{
    ViewData["Title"] = "Owner Dashboard";
    var activeTab = string.IsNullOrWhiteSpace(Model.ActiveTab) ? "properties" : Model.ActiveTab.ToLowerInvariant();
    var approvedProps = Model.Properties.Where(p => (p.ApprovalStatus ?? "").Equals("Approved", StringComparison.OrdinalIgnoreCase)).ToList();
    var pendingProps = Model.Properties.Where(p => (p.ApprovalStatus ?? "").Equals("Pending", StringComparison.OrdinalIgnoreCase)).ToList();
    var rejectedProps = Model.Properties.Where(p => (p.ApprovalStatus ?? "").Equals("Rejected", StringComparison.OrdinalIgnoreCase)).ToList();
}

<style>
    /* Highlighting for unfulfilled input boxes on form submission */
    .field-error-highlight {
        border: 2px solid #ef4444 !important;
        background-color: #fef2f2 !important;
        box-shadow: 0 0 0 4px rgba(239, 68, 68, 0.18) !important;
        animation: shakeInput 0.4s ease-in-out !important;
        outline: none !important;
    }

    .field-error-highlight:focus {
        border-color: #dc2626 !important;
        box-shadow: 0 0 0 4px rgba(220, 38, 38, 0.25) !important;
    }

    .card-error-highlight {
        border: 2px solid #ef4444 !important;
        background-color: #fffaf0 !important;
        box-shadow: 0 0 0 4px rgba(239, 68, 68, 0.18) !important;
        animation: shakeInput 0.4s ease-in-out !important;
    }

    .field-error-msg {
        color: #dc2626;
        font-size: 0.8rem;
        font-weight: 600;
        margin-top: 5px;
        display: none;
        align-items: center;
        gap: 4px;
        line-height: 1.3;
    }

    .field-error-msg.visible {
        display: flex !important;
    }

    .form-validation-banner {
        display: none;
        background: #fef2f2;
        border: 1.5px solid #f87171;
        border-radius: 10px;
        padding: 14px 18px;
        margin-bottom: 20px;
        color: #991b1b;
        align-items: flex-start;
        gap: 12px;
        animation: shakeInput 0.4s ease-in-out;
    }

    .form-validation-banner.visible {
        display: flex !important;
    }

    @@keyframes shakeInput {
        0%, 100% { transform: translateX(0); }
        20% { transform: translateX(-6px); }
        40% { transform: translateX(6px); }
        60% { transform: translateX(-4px); }
        80% { transform: translateX(4px); }
    }
</style>

<div class="app-shell">
    <!-- Top Hero Banner -->
    <div class="dashboard-hero">
        <div>
            <h1>Host &amp; Owner Dashboard</h1>
            <p>Track performance, manage approved listings, room availability, guest bookings, and earnings.</p>
        </div>
        <div class="dashboard-hero-actions">
            <button type="button" class="button" onclick="toggleForm('createPropertyBox')">
                &#43; Register New Homestay
            </button>
            @if (approvedProps.Any())
            {
                <button type="button" class="button outline" onclick="toggleForm('createRoomBox')">
                    &#43; Add Room
                </button>
            }
        </div>
    </div>

    <!-- 4 KPI Summary Cards -->
    <div class="kpi-grid">
        <div class="kpi-card">
            <div class="kpi-icon-wrap green">&#127968;</div>
            <div class="kpi-stat-info">
                <span class="kpi-number">@Model.Summary.ApprovedProperties</span>
                <span class="kpi-label">Active Approved Stays</span>
            </div>
        </div>

        <div class="kpi-card">
            <div class="kpi-icon-wrap peach">&#9203;</div>
            <div class="kpi-stat-info">
                <span class="kpi-number">@Model.Summary.PendingProperties</span>
                <span class="kpi-label">Pending Admin Approval</span>
            </div>
        </div>

        <div class="kpi-card">
            <div class="kpi-icon-wrap sage">&#128716;</div>
            <div class="kpi-stat-info">
                <span class="kpi-number">@Model.Summary.TotalRooms</span>
                <span class="kpi-label">Active Rooms</span>
            </div>
        </div>

        <div class="kpi-card">
            <div class="kpi-icon-wrap gold">&#128176;</div>
            <div class="kpi-stat-info">
                <span class="kpi-number">@Model.Summary.TotalRevenue.ToString("N0") &#8363;</span>
                <span class="kpi-label">Total Revenue</span>
            </div>
        </div>
    </div>

    <!-- Main Column Tabs Management Layout -->
    <div class="column-tabs-layout">
        <!-- Left Column: Tabs Navigation Sidebar -->
        <aside class="column-tabs-sidebar">
            <span class="sidebar-section-title">Host Management</span>
            <nav class="column-tabs-nav" id="dashboardTabsNav">
                <button type="button" class="tab-nav-btn column-tab-btn @(activeTab == "properties" ? "active" : "")" data-tab="tab-properties">
                    <div class="column-tab-left">
                        <div class="column-tab-icon">&#127968;</div>
                        <div class="column-tab-meta">
                            <span class="column-tab-title">Properties</span>
                            <span class="column-tab-sub">Listings &amp; review</span>
                        </div>
                    </div>
                    <span class="column-tab-badge">@Model.Properties.Count</span>
                </button>

                <button type="button" class="tab-nav-btn column-tab-btn @(activeTab == "rooms" ? "active" : "")" data-tab="tab-rooms">
                    <div class="column-tab-left">
                        <div class="column-tab-icon">&#128716;</div>
                        <div class="column-tab-meta">
                            <span class="column-tab-title">Rooms</span>
                            <span class="column-tab-sub">Capacities &amp; rates</span>
                        </div>
                    </div>
                    <span class="column-tab-badge">@Model.Rooms.Count</span>
                </button>

                <button type="button" class="tab-nav-btn column-tab-btn @(activeTab == "bookings" ? "active" : "")" data-tab="tab-bookings">
                    <div class="column-tab-left">
                        <div class="column-tab-icon">&#128197;</div>
                        <div class="column-tab-meta">
                            <span class="column-tab-title">Bookings</span>
                            <span class="column-tab-sub">Reservations &amp; guests</span>
                        </div>
                    </div>
                    <span class="column-tab-badge">@Model.Bookings.Count</span>
                </button>

                <button type="button" class="tab-nav-btn column-tab-btn @(activeTab == "invoices" ? "active" : "")" data-tab="tab-invoices">
                    <div class="column-tab-left">
                        <div class="column-tab-icon">&#128176;</div>
                        <div class="column-tab-meta">
                            <span class="column-tab-title">Invoices</span>
                            <span class="column-tab-sub">Revenue &amp; payouts</span>
                        </div>
                    </div>
                    <span class="column-tab-badge">@Model.Invoices.Count</span>
                </button>
            </nav>

            <div class="sidebar-action-box">
                <span class="sidebar-section-title" style="border: none; padding: 0 0 4px; margin: 0;">Quick Actions</span>
                <button type="button" class="button small" style="width: 100%; justify-content: center;" onclick="toggleForm('createPropertyBox')">
                    &#43; Register Homestay
                </button>
                @if (approvedProps.Any())
                {
                    <button type="button" class="button outline small" style="width: 100%; justify-content: center;" onclick="toggleForm('createRoomBox')">
                        &#43; Add Room
                    </button>
                }
            </div>

            <div class="sidebar-tip-box">
                &#128161; <strong>Host Tip:</strong> Listings undergo admin verification. Once verified, room setup unlocks automatically.
            </div>
        </aside>

        <!-- Right Column: Content Column -->
        <main class="column-tabs-content">
            <!-- Collapsible Add Property Form -->
            <div id="createPropertyBox" class="collapsible-form-wrap" style="display: none; background: #ffffff; border: 1px solid #e2e8f0; border-radius: 16px; padding: 28px; margin-bottom: 32px; box-shadow: 0 10px 30px rgba(0,0,0,0.06);">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; border-bottom: 1px solid #f1f5f9; padding-bottom: 16px;">
                    <div>
                        <h2 style="margin: 0; font-size: 1.45rem; color: #1e293b; font-family: 'Playfair Display', serif; display: flex; align-items: center; gap: 10px;">
                            <span>🏡</span> Đăng ký Cơ sở lưu trú mới
                        </h2>
                        <p style="margin: 4px 0 0; color: #64748b; font-size: 0.9rem;">
                            Cung cấp đầy đủ thông tin, tiện ích và hồ sơ chứng nhận pháp lý để gửi Admin thẩm định phê duyệt.
                        </p>
                    </div>
                    <button type="button" class="action-btn-mini" onclick="toggleForm('createPropertyBox')" style="font-size: 0.9rem; padding: 6px 14px;">&times; Đóng form</button>
                </div>

                <div class="admin-pending-alert" style="margin-top: 0; margin-bottom: 24px; background: #eff6ff; border-left: 4px solid #3b82f6; border-radius: 8px; padding: 14px 18px; color: #1e40af;">
                    <strong>🛡️ Quy trình kiểm duyệt pháp lý (WPF Admin):</strong>
                    Hồ sơ sau khi gửi sẽ chuyển vào danh sách chờ duyệt của Quản trị viên. Khi Giấy phép kinh doanh, Giấy tờ PCCC và An ninh trật tự được thẩm định hợp lệ, cơ sở sẽ tự động xuất hiện trên website và mở khóa tạo phòng đón khách.
                </div>

                <!-- Validation Summary Alert Banner -->
                <div id="propertyFormValidationBanner" class="form-validation-banner">
                    <div style="font-size: 1.4rem; line-height: 1;">⚠️</div>
                    <div>
                        <strong style="display: block; font-size: 0.95rem; margin-bottom: 3px;">Vui lòng hoàn thành các trường bắt buộc được đánh dấu đỏ:</strong>
                        <span style="font-size: 0.85rem; color: #b91c1c;">Hệ thống phát hiện thông tin cơ bản hoặc hồ sơ thẩm định pháp lý chưa được điền đầy đủ. Vui lòng kiểm tra các ô bên dưới trước khi gửi yêu cầu.</span>
                    </div>
                </div>

                <form id="createPropertyForm" asp-action="CreateProperty" method="post" enctype="multipart/form-data" novalidate>
                    <!-- SECTION 1: Thông tin cơ bản & Liên hệ -->
                    <div style="margin-bottom: 24px; background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 12px; padding: 20px;">
                        <h4 style="margin: 0 0 14px; font-size: 1rem; color: #0f172a; display: flex; align-items: center; gap: 8px;">
                            <span style="background: #e0f2fe; color: #0284c7; width: 26px; height: 26px; border-radius: 50%; display: inline-flex; align-items: center; justify-content: center; font-size: 0.8rem; font-weight: bold;">1</span>
                            Thông tin chung &amp; Liên hệ
                        </h4>

                        <div class="form-row" style="display: grid; grid-template-columns: 2fr 1fr; gap: 16px;">
                            <label style="display: flex; flex-direction: column; gap: 6px; font-weight: 500; font-size: 0.88rem; color: #334155;">
                                Tên cơ sở lưu trú *
                                <input asp-for="NewProperty.Name" id="propName" required placeholder="Ví dụ: Pine Hill Mountain Homestay Da Lat" style="width: 100%; padding: 10px 14px; border: 1px solid #cbd5e1; border-radius: 8px; font-size: 0.92rem; transition: border-color 0.2s, box-shadow 0.2s;" />
                                <div id="err_propName" class="field-error-msg">⚠️ Vui lòng nhập tên cơ sở lưu trú.</div>
                            </label>

                            <label style="display: flex; flex-direction: column; gap: 6px; font-weight: 500; font-size: 0.88rem; color: #334155;">
                                Loại hình lưu trú *
                                <select asp-for="NewProperty.Type" id="propType" required style="width: 100%; padding: 10px 14px; border: 1px solid #cbd5e1; border-radius: 8px; font-size: 0.92rem; background: #fff; transition: border-color 0.2s, box-shadow 0.2s;">
                                    <option value="Homestay">Homestay gia đình</option>
                                    <option value="Hotel">Khách sạn (Hotel)</option>
                                    <option value="Villa">Biệt thự nghỉ dưỡng (Villa)</option>
                                    <option value="Resort">Khu nghỉ dưỡng (Resort)</option>
                                </select>
                                <div id="err_propType" class="field-error-msg">⚠️ Vui lòng chọn loại hình lưu trú.</div>
                            </label>
                        </div>

                        <div class="form-row" style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-top: 14px;">
                            <label style="display: flex; flex-direction: column; gap: 6px; font-weight: 500; font-size: 0.88rem; color: #334155;">
                                Hotline / Số điện thoại đón khách *
                                <input asp-for="NewProperty.Phone" id="propPhone" required placeholder="Ví dụ: 0988776655" style="width: 100%; padding: 10px 14px; border: 1px solid #cbd5e1; border-radius: 8px; font-size: 0.92rem; transition: border-color 0.2s, box-shadow 0.2s;" />
                                <div id="err_propPhone" class="field-error-msg">⚠️ Vui lòng nhập số điện thoại đón khách hợp lệ (tối thiểu 8 chữ số).</div>
                            </label>

                            <label style="display: flex; flex-direction: column; gap: 6px; font-weight: 500; font-size: 0.88rem; color: #334155;">
                                Email liên hệ tiếp nhận đơn đặt
                                <input asp-for="NewProperty.Email" id="propEmail" type="email" placeholder="Ví dụ: stay@pinehill.vn" style="width: 100%; padding: 10px 14px; border: 1px solid #cbd5e1; border-radius: 8px; font-size: 0.92rem; transition: border-color 0.2s, box-shadow 0.2s;" />
                            </label>
                        </div>
                    </div>

                    <!-- SECTION 2: Vị trí & Địa chỉ -->
                    <div style="margin-bottom: 24px; background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 12px; padding: 20px;">
                        <h4 style="margin: 0 0 14px; font-size: 1rem; color: #0f172a; display: flex; align-items: center; gap: 8px;">
                            <span style="background: #fef3c7; color: #b45309; width: 26px; height: 26px; border-radius: 50%; display: inline-flex; align-items: center; justify-content: center; font-size: 0.8rem; font-weight: bold;">2</span>
                            Vị trí &amp; Địa chỉ chi tiết
                        </h4>

                        <div class="form-row" style="display: grid; grid-template-columns: 2fr 1fr 1fr; gap: 16px;">
                            <label style="display: flex; flex-direction: column; gap: 6px; font-weight: 500; font-size: 0.88rem; color: #334155;">
                                Địa chỉ đường, số nhà *
                                <input asp-for="NewProperty.Address" id="propAddress" required placeholder="Ví dụ: 123 Hoàng Hoa Thám" style="width: 100%; padding: 10px 14px; border: 1px solid #cbd5e1; border-radius: 8px; font-size: 0.92rem; transition: border-color 0.2s, box-shadow 0.2s;" />
                                <div id="err_propAddress" class="field-error-msg">⚠️ Vui lòng nhập địa chỉ cụ thể của cơ sở.</div>
                            </label>

                            <label style="display: flex; flex-direction: column; gap: 6px; font-weight: 500; font-size: 0.88rem; color: #334155;">
                                Phường / Xã
                                <input asp-for="NewProperty.Ward" id="propWard" placeholder="Ví dụ: Phường 10" style="width: 100%; padding: 10px 14px; border: 1px solid #cbd5e1; border-radius: 8px; font-size: 0.92rem;" />
                            </label>

                            <label style="display: flex; flex-direction: column; gap: 6px; font-weight: 500; font-size: 0.88rem; color: #334155;">
                                Tỉnh / Thành phố *
                                <input asp-for="NewProperty.City" id="propCity" required placeholder="Ví dụ: Đà Lạt, Lâm Đồng" style="width: 100%; padding: 10px 14px; border: 1px solid #cbd5e1; border-radius: 8px; font-size: 0.92rem; transition: border-color 0.2s, box-shadow 0.2s;" />
                                <div id="err_propCity" class="field-error-msg">⚠️ Vui lòng nhập Tỉnh hoặc Thành phố.</div>
                            </label>
                        </div>
                    </div>

                    <!-- SECTION 3: Tiện nghi & Dịch vụ cơ sở lưu trú -->
                    <div style="margin-bottom: 24px; background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 12px; padding: 20px;">
                        <h4 style="margin: 0 0 8px; font-size: 1rem; color: #0f172a; display: flex; align-items: center; gap: 8px;">
                            <span style="background: #dcfce7; color: #166534; width: 26px; height: 26px; border-radius: 50%; display: inline-flex; align-items: center; justify-content: center; font-size: 0.8rem; font-weight: bold;">3</span>
                            Tiện nghi &amp; Dịch vụ cơ sở
                        </h4>
                        <p style="margin: 0 0 14px; font-size: 0.85rem; color: #64748b;">
                            Chọn các tiện ích nổi bật mà homestay của bạn cung cấp cho khách lưu trú:
                        </p>

                        <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 10px;">
                            @if (Model.AvailableAmenities != null && Model.AvailableAmenities.Any())
                            {
                                @foreach (var amenity in Model.AvailableAmenities)
                                {
                                    <label style="display: flex; align-items: center; gap: 10px; padding: 10px 14px; background: #ffffff; border: 1px solid #cbd5e1; border-radius: 8px; cursor: pointer; transition: all 0.2s;" onmouseover="this.style.borderColor='#3b82f6'" onmouseout="this.style.borderColor='#cbd5e1'">
                                        <input type="checkbox" name="NewProperty.AmenityIds" value="@amenity.Id" style="width: 16px; height: 16px; accent-color: #10b981;" />
                                        <span style="font-size: 0.88rem; color: #1e293b; font-weight: 500;">@amenity.Name</span>
                                    </label>
                                }
                            }
                            else
                            {
                                <div style="color: #64748b; font-size: 0.85rem; font-style: italic;">Đang tải danh mục tiện nghi hệ thống...</div>
                            }
                        </div>
                    </div>

                    <!-- SECTION 4: Hồ sơ pháp lý thẩm định (Admin Verification Documents) -->
                    <div style="margin-bottom: 24px; background: #fffbeb; border: 1px solid #fef3c7; border-radius: 12px; padding: 20px;">
                        <h4 style="margin: 0 0 8px; font-size: 1rem; color: #92400e; display: flex; align-items: center; gap: 8px;">
                            <span style="background: #fde68a; color: #b45309; width: 26px; height: 26px; border-radius: 50%; display: inline-flex; align-items: center; justify-content: center; font-size: 0.8rem; font-weight: bold;">4</span>
                            Hồ sơ pháp lý thẩm định (Admin Verification Documents)
                        </h4>
                        <p style="margin: 0 0 16px; font-size: 0.85rem; color: #78350f;">
                            Chủ cơ sở có thể tải lên ngay tài liệu scan/ảnh chụp hoặc bổ sung sau để Quản trị viên đối chiếu và kích hoạt đón khách:
                        </p>

                        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 18px;">
                            <!-- 1. Giấy phép kinh doanh -->
                            <div id="cardBizLicense" style="background: #ffffff; border: 1px solid #e2e8f0; border-radius: 10px; padding: 16px; transition: all 0.2s;">
                                <div style="font-weight: 600; font-size: 0.9rem; color: #1e293b; margin-bottom: 6px; display: flex; align-items: center; gap: 6px;">
                                    <span>📜</span> Giấy phép Kinh doanh (GPKD) <span style="font-size: 0.78rem; font-weight: normal; color: #64748b;">(Tùy chọn)</span>
                                </div>
                                <div style="font-size: 0.78rem; color: #64748b; margin-bottom: 10px;">
                                    Tải lên ảnh hoặc file PDF giấy phép hộ kinh doanh / doanh nghiệp:
                                </div>
                                <input asp-for="NewProperty.BusinessLicenseFile" id="propBizLicenseFile" type="file" accept="image/*,.pdf" style="width: 100%; font-size: 0.82rem; margin-bottom: 8px; padding: 6px; border: 1px solid #cbd5e1; border-radius: 6px;" />
                                <input asp-for="NewProperty.BusinessLicenseUrl" id="propBizLicenseUrl" placeholder="Hoặc dán URL ảnh GPKD..." style="width: 100%; padding: 8px 12px; border: 1px solid #cbd5e1; border-radius: 6px; font-size: 0.85rem;" />
                            </div>

                            <!-- 2. Giấy chứng nhận PCCC -->
                            <div id="cardFireSafety" style="background: #ffffff; border: 1px solid #e2e8f0; border-radius: 10px; padding: 16px; transition: all 0.2s;">
                                <div style="font-weight: 600; font-size: 0.9rem; color: #1e293b; margin-bottom: 6px; display: flex; align-items: center; gap: 6px;">
                                    <span>🧯</span> Giấy chứng nhận PCCC <span style="font-size: 0.78rem; font-weight: normal; color: #64748b;">(Tùy chọn)</span>
                                </div>
                                <div style="font-size: 0.78rem; color: #64748b; margin-bottom: 10px;">
                                    Biên bản / Giấy chứng nhận đủ điều kiện Phòng cháy chữa cháy:
                                </div>
                                <input asp-for="NewProperty.FireSafetyFile" id="propFireSafetyFile" type="file" accept="image/*,.pdf" style="width: 100%; font-size: 0.82rem; margin-bottom: 8px; padding: 6px; border: 1px solid #cbd5e1; border-radius: 6px;" />
                                <input asp-for="NewProperty.FireSafetyDocumentUrl" id="propFireSafetyUrl" placeholder="Hoặc dán URL ảnh PCCC..." style="width: 100%; padding: 8px 12px; border: 1px solid #cbd5e1; border-radius: 6px; font-size: 0.85rem;" />
                            </div>

                            <!-- 3. Giấy tờ ANTT -->
                            <div id="cardSecurity" style="background: #ffffff; border: 1px solid #e2e8f0; border-radius: 10px; padding: 16px; transition: all 0.2s;">
                                <div style="font-weight: 600; font-size: 0.9rem; color: #1e293b; margin-bottom: 6px; display: flex; align-items: center; gap: 6px;">
                                    <span>👮</span> Giấy xác nhận An ninh Trật tự (ANTT) <span style="font-size: 0.78rem; font-weight: normal; color: #64748b;">(Tùy chọn)</span>
                                </div>
                                <div style="font-size: 0.78rem; color: #64748b; margin-bottom: 10px;">
                                    Giấy chứng nhận đủ điều kiện về An ninh trật tự cơ sở lưu trú:
                                </div>
                                <input asp-for="NewProperty.SecurityFile" id="propSecurityFile" type="file" accept="image/*,.pdf" style="width: 100%; font-size: 0.82rem; margin-bottom: 8px; padding: 6px; border: 1px solid #cbd5e1; border-radius: 6px;" />
                                <input asp-for="NewProperty.SecurityDocumentUrl" id="propSecurityUrl" placeholder="Hoặc dán URL ảnh ANTT..." style="width: 100%; padding: 8px 12px; border: 1px solid #cbd5e1; border-radius: 6px; font-size: 0.85rem;" />
                            </div>
                        </div>
                    </div>

                    <!-- SECTION 5: Hình ảnh khuôn viên & Mặt tiền Homestay -->
                    <div style="margin-bottom: 24px; background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 12px; padding: 20px;">
                        <h4 style="margin: 0 0 8px; font-size: 1rem; color: #0f172a; display: flex; align-items: center; gap: 8px;">
                            <span style="background: #ede9fe; color: #6d28d9; width: 26px; height: 26px; border-radius: 50%; display: inline-flex; align-items: center; justify-content: center; font-size: 0.8rem; font-weight: bold;">5</span>
                            Bộ sưu tập ảnh Homestay (Showcase Gallery)
                        </h4>
                        <p style="margin: 0 0 12px; font-size: 0.85rem; color: #64748b;">
                            Tải lên hình ảnh khuôn viên, mặt tiền, phòng khách, phong cảnh xung quanh để tạo ấn tượng cho du khách:
                        </p>

                        <div style="background: #ffffff; border: 2px dashed #cbd5e1; border-radius: 10px; padding: 20px; text-align: center;">
                            <div style="font-size: 2rem; color: #94a3b8; margin-bottom: 8px;">📷</div>
                            <input asp-for="NewProperty.PhotoFiles" type="file" multiple accept="image/*" style="font-size: 0.9rem; margin-bottom: 8px;" />
                            <div style="font-size: 0.8rem; color: #64748b;">Hỗ trợ định dạng JPG, PNG, WEBP. Có thể chọn cùng lúc nhiều ảnh.</div>
                        </div>
                    </div>

                    <!-- SECTION 6: Chính sách & Nội quy lưu trú -->
                    <div style="margin-bottom: 24px; background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 12px; padding: 20px;">
                        <h4 style="margin: 0 0 8px; font-size: 1rem; color: #0f172a; display: flex; align-items: center; gap: 8px;">
                            <span style="background: #f1f5f9; color: #475569; width: 26px; height: 26px; border-radius: 50%; display: inline-flex; align-items: center; justify-content: center; font-size: 0.8rem; font-weight: bold;">6</span>
                            Chính sách &amp; Nội quy Homestay
                        </h4>
                        <label style="display: flex; flex-direction: column; gap: 6px; font-weight: 500; font-size: 0.88rem; color: #334155;">
                            Quy định nhận/trả phòng, giữ yên tĩnh, thú cưng &amp; hủy đơn
                            <textarea asp-for="NewProperty.Policy" rows="3" placeholder="Ví dụ: Nhận phòng sau 14:00, trả phòng trước 12:00. Không hút thuốc trong phòng kín. Giữ trật tự sau 22:00. Miễn phí hủy trước 48 giờ." style="width: 100%; padding: 12px; border: 1px solid #cbd5e1; border-radius: 8px; font-size: 0.92rem;"></textarea>
                        </label>
                    </div>

                    <div style="display: flex; justify-content: flex-end; gap: 12px; margin-top: 24px; border-top: 1px solid #e2e8f0; padding-top: 20px;">
                        <button type="button" class="button outline" onclick="toggleForm('createPropertyBox')">Hủy bỏ</button>
                        <button type="submit" id="btnSubmitProperty" class="button" style="background: #059669; border-color: #059669; padding: 12px 28px; font-weight: 600; display: inline-flex; align-items: center; gap: 8px;">
                            🚀 Gửi hồ sơ đăng ký thẩm định &rarr;
                        </button>
                    </div>
                    @Html.AntiForgeryToken()
                </form>
            </div>

            <!-- Collapsible Add Room Form -->
            <div id="createRoomBox" class="collapsible-form-wrap" style="display: none; background: #ffffff; border: 1px solid #e2e8f0; border-radius: 16px; padding: 28px; margin-bottom: 32px; box-shadow: 0 10px 30px rgba(0,0,0,0.06);">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; border-bottom: 1px solid #f1f5f9; padding-bottom: 16px;">
                    <div>
                        <h2 style="margin: 0; font-size: 1.45rem; color: #1e293b; font-family: 'Playfair Display', serif; display: flex; align-items: center; gap: 10px;">
                            <span>🛏️</span> Thêm Phòng mới vào Homestay
                        </h2>
                        <p style="margin: 4px 0 0; color: #64748b; font-size: 0.9rem;">
                            Thiết lập tên phòng, loại phòng, sức chứa, giá niêm yết mỗi đêm và ảnh chụp chi tiết.
                        </p>
                    </div>
                    <button type="button" class="action-btn-mini" onclick="toggleForm('createRoomBox')" style="font-size: 0.9rem; padding: 6px 14px;">&times; Đóng form</button>
                </div>

                @if (!approvedProps.Any())
                {
                    <div class="admin-pending-alert" style="background: #fffbeb; border-left: 4px solid #f59e0b; padding: 16px; border-radius: 8px; color: #92400e;">
                        <strong>⚠️ Chưa có cơ sở lưu trú được phê duyệt:</strong>
                        Tính năng tạo phòng chỉ khả dụng cho các homestay đã được Ban Quản trị (Admin WPF) duyệt kích hoạt. Các homestay đang chờ duyệt sẽ tự động xuất hiện tại đây ngay khi hoàn tất thẩm định.
                    </div>
                }
                else
                {
                    <form asp-action="CreateRoom" method="post" enctype="multipart/form-data">
                        <div class="form-row" style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-bottom: 16px;">
                            <label style="display: flex; flex-direction: column; gap: 6px; font-weight: 500; font-size: 0.88rem; color: #334155;">
                                Chọn Cơ sở lưu trú đã phê duyệt *
                                <select asp-for="NewRoom.PropertyId" id="roomPropertySelect" required style="width: 100%; padding: 10px 14px; border: 1px solid #cbd5e1; border-radius: 8px; font-size: 0.92rem; background: #fff;">
                                    @foreach (var prop in approvedProps)
                                    {
                                        <option value="@prop.Id">@prop.Name (@(prop.City ?? "Khu vực địa phương"))</option>
                                    }
                                </select>
                            </label>

                            <label style="display: flex; flex-direction: column; gap: 6px; font-weight: 500; font-size: 0.88rem; color: #334155;">
                                Tên phòng hoặc Số phòng *
                                <input asp-for="NewRoom.RoomNumber" required placeholder="Ví dụ: Phòng 101, Phòng Deluxe View Rừng Thông" style="width: 100%; padding: 10px 14px; border: 1px solid #cbd5e1; border-radius: 8px; font-size: 0.92rem;" />
                            </label>
                        </div>

                        <div class="form-row" style="display: grid; grid-template-columns: 1fr 1fr 1fr 1fr; gap: 16px; margin-bottom: 16px;">
                            <label style="display: flex; flex-direction: column; gap: 6px; font-weight: 500; font-size: 0.88rem; color: #334155;">
                                Loại phòng
                                <select asp-for="NewRoom.RoomTypeId" style="width: 100%; padding: 10px 14px; border: 1px solid #cbd5e1; border-radius: 8px; font-size: 0.92rem; background: #fff;">
                                    <option value="">-- Mặc định tiêu chuẩn --</option>
                                    @if (Model.AvailableRoomTypes != null)
                                    {
                                        @foreach (var rt in Model.AvailableRoomTypes)
                                        {
                                            <option value="@rt.Id">@rt.Name</option>
                                        }
                                    }
                                </select>
                            </label>

                            <label style="display: flex; flex-direction: column; gap: 6px; font-weight: 500; font-size: 0.88rem; color: #334155;">
                                Sức chứa tối đa (Khách) *
                                <input asp-for="NewRoom.Capacity" type="number" min="1" max="50" required value="2" style="width: 100%; padding: 10px 14px; border: 1px solid #cbd5e1; border-radius: 8px; font-size: 0.92rem;" />
                            </label>

                            <label style="display: flex; flex-direction: column; gap: 6px; font-weight: 500; font-size: 0.88rem; color: #334155;">
                                Giá mỗi đêm (VNĐ) *
                                <input asp-for="NewRoom.OriginalPrice" type="number" min="50000" step="10000" required value="500000" style="width: 100%; padding: 10px 14px; border: 1px solid #cbd5e1; border-radius: 8px; font-size: 0.92rem;" />
                            </label>

                            <label style="display: flex; flex-direction: column; gap: 6px; font-weight: 500; font-size: 0.88rem; color: #334155;">
                                Trạng thái ban đầu
                                <select asp-for="NewRoom.Status" style="width: 100%; padding: 10px 14px; border: 1px solid #cbd5e1; border-radius: 8px; font-size: 0.92rem; background: #fff;">
                                    <option value="Trống">Sẵn sàng đón khách (Trống)</option>
                                    <option value="Bảo trì">Đang bảo trì / Sửa chữa</option>
                                </select>
                            </label>
                        </div>

                        <!-- Room Amenities -->
                        <div style="margin-bottom: 16px;">
                            <label style="display: block; font-weight: 500; font-size: 0.88rem; color: #334155; margin-bottom: 8px;">
                                Tiện ích riêng trong phòng:
                            </label>
                            <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 8px;">
                                @if (Model.AvailableAmenities != null)
                                {
                                    @foreach (var a in Model.AvailableAmenities.Take(8))
                                    {
                                        <label style="display: flex; align-items: center; gap: 8px; padding: 8px 12px; background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 6px; cursor: pointer; font-size: 0.85rem;">
                                            <input type="checkbox" name="NewRoom.AmenityIds" value="@a.Id" />
                                            <span>@a.Name</span>
                                        </label>
                                    }
                                }
                            </div>
                        </div>

                        <!-- Room Photos -->
                        <div style="margin-bottom: 16px;">
                            <label style="display: block; font-weight: 500; font-size: 0.88rem; color: #334155; margin-bottom: 6px;">
                                Ảnh phòng:
                            </label>
                            <input asp-for="NewRoom.PhotoFiles" type="file" multiple accept="image/*" style="font-size: 0.88rem;" />
                        </div>

                        <div style="display: flex; justify-content: flex-end; gap: 12px; margin-top: 20px; border-top: 1px solid #e2e8f0; padding-top: 16px;">
                            <button type="button" class="button outline" onclick="toggleForm('createRoomBox')">Hủy bỏ</button>
                            <button type="submit" class="button" style="background: #2563eb; border-color: #2563eb; padding: 10px 24px; font-weight: 600;">
                                ➕ Thêm phòng vào hệ thống
                            </button>
                        </div>
                        @Html.AntiForgeryToken()
                    </form>
                }
            </div>

    <!-- ==================== TAB 1: PROPERTIES ==================== -->
    <div id="tab-properties" class="tab-pane @(activeTab == "properties" ? "active" : "")">
        <div class="content-card-header">
            <div>
                <h2>My Homestay Properties</h2>
                <p>Manage your verified accommodations and track listings submitted for Admin verification.</p>
            </div>
            <button type="button" class="button outline" onclick="toggleForm('createPropertyBox')">
                &#43; Register New Property
            </button>
        </div>

        @if (!Model.Properties.Any())
        {
            <div class="content-card empty-state-box">
                <span class="empty-icon">&#127968;</span>
                <h4>No homestays registered yet</h4>
                <p>Register your first property. It will be sent to Admin for review and activated once approved.</p>
                <button type="button" class="button" onclick="toggleForm('createPropertyBox')">Register Your First Homestay</button>
            </div>
        }
        else
        {
            <!-- SECTION 1: Active & Approved Listings -->
            <div style="margin-bottom: 32px;">
                <h3 style="margin-bottom: 14px; font-size: 1.15rem; color: var(--green-dark);">
                    &#9989; Active &amp; Approved Properties (@approvedProps.Count)
                </h3>

                @if (!approvedProps.Any())
                {
                    <div class="overview-tile" style="margin-bottom: 24px;">
                        <span style="color: var(--muted); font-size: 0.9rem;">
                            You do not have any active approved listings yet. Any newly created listings below are awaiting Admin approval.
                        </span>
                    </div>
                }
                else
                {
                    <div class="prop-grid-owner" style="margin-bottom: 28px;">
                        @foreach (var prop in approvedProps)
                        {
                            <div class="prop-card-owner">
                                <div class="prop-thumb-wrap">
                                    @if (!string.IsNullOrWhiteSpace(prop.CoverImageUrl))
                                    {
                                        <img src="@prop.CoverImageUrl" alt="@prop.Name" />
                                    }
                                    else
                                    {
                                        <div style="width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; color: rgba(255,255,255,0.7); font-size: 2.5rem;">
                                            &#127968;
                                        </div>
                                    }
                                    <span class="prop-status-tag approved">&#10003; Approved &amp; Live</span>
                                </div>
                                <div class="prop-body-owner">
                                    <h3>@prop.Name</h3>
                                    <div class="prop-location">
                                        &#128205; @prop.Address@(string.IsNullOrWhiteSpace(prop.City) ? "" : $", {prop.City}")
                                    </div>
                                    <div class="prop-meta-bar">
                                        <span>&#128716; <b>@prop.RoomsCount</b> rooms</span>
                                        <div style="display: flex; gap: 6px;">
                                            <button type="button" class="action-btn-mini" style="background: #eef2ff; color: #3730a3;" onclick="viewApprovalHistory(@prop.Id, '@Html.Raw(Html.Encode(prop.Name))')">
                                                &#128220; History
                                            </button>
                                            <button type="button" class="action-btn-mini" onclick="openAddRoomFor('@prop.Id')">
                                                &#43; Add Room
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>

            <!-- SECTION 2: Pending Admin Approval (WPF Admin Review) -->
            @if (pendingProps.Any())
            {
                <div style="margin-bottom: 32px;">
                    <h3 style="margin-bottom: 14px; font-size: 1.15rem; color: #b45309;">
                        &#9203; Awaiting Admin Approval via WPF (@pendingProps.Count)
                    </h3>
                    <div class="admin-pending-alert">
                        <strong>Sent to Admin for Review:</strong> The properties below have been submitted and are currently in the administrator's review queue. Once approved by the Admin, they will automatically appear on the public web list and room setup will be enabled.
                    </div>

                    <div class="prop-grid-owner">
                        @foreach (var prop in pendingProps)
                        {
                            <div class="prop-card-owner pending-lock">
                                <div class="prop-thumb-wrap">
                                    <div style="width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; color: rgba(255,255,255,0.8); font-size: 2.5rem;">
                                        &#9203;
                                    </div>
                                    <span class="prop-status-tag pending">&#9203; Pending Approval</span>
                                </div>
                                <div class="prop-body-owner">
                                    <h3>@prop.Name</h3>
                                    <div class="prop-location">
                                        &#128205; @prop.Address@(string.IsNullOrWhiteSpace(prop.City) ? "" : $", {prop.City}")
                                    </div>
                                    <div class="prop-meta-bar">
                                        <span style="font-size: 0.8rem; color: #b45309;">&#128274; Room setup locked until approved</span>
                                        <div style="display: flex; gap: 6px; align-items: center;">
                                            <button type="button" class="action-btn-mini" style="background: #fef3c7; color: #92400e;" onclick="viewApprovalHistory(@prop.Id, '@Html.Raw(Html.Encode(prop.Name))')">
                                                &#128220; History
                                            </button>
                                            <span class="status-pill pending">Under Review</span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }

            <!-- SECTION 3: Rejected Listings (if any) -->
            @if (rejectedProps.Any())
            {
                <div>
                    <h3 style="margin-bottom: 14px; font-size: 1.15rem; color: #b91c1c;">
                        &#10060; Rejected by Admin (@rejectedProps.Count)
                    </h3>
                    <div class="prop-grid-owner">
                        @foreach (var prop in rejectedProps)
                        {
                            <div class="prop-card-owner" style="border: 1px solid #f87171;">
                                <div class="prop-thumb-wrap" style="background: #991b1b;">
                                    <div style="width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; color: rgba(255,255,255,0.8); font-size: 2.5rem;">
                                        &#10060;
                                    </div>
                                    <span class="prop-status-tag rejected">Rejected</span>
                                </div>
                                <div class="prop-body-owner">
                                    <h3>@prop.Name</h3>
                                    <div class="prop-location">&#128205; @prop.Address</div>
                                    @if (!string.IsNullOrWhiteSpace(prop.RejectionReason))
                                    {
                                        <div class="admin-rejected-alert" style="margin: 8px 0 0; padding: 8px 12px; font-size: 0.82rem;">
                                            <strong>Reason:</strong> @prop.RejectionReason
                                        </div>
                                    }
                                    <div class="prop-meta-bar" style="margin-top: 8px;">
                                        <span class="status-pill rejected">Action Required</span>
                                        <button type="button" class="action-btn-mini" style="background: #fee2e2; color: #991b1b;" onclick="viewApprovalHistory(@prop.Id, '@Html.Raw(Html.Encode(prop.Name))')">
                                            &#128220; View Timeline
                                        </button>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
        }
    </div>

    <!-- ==================== TAB 2: ROOMS ==================== -->
    <div id="tab-rooms" class="tab-pane @(activeTab == "rooms" ? "active" : "")">
        <div class="content-card-header">
            <div>
                <h2>Rooms Management</h2>
                <p>Monitor individual rooms in approved homestays, set guest capacities, and update nightly rates.</p>
            </div>
            @if (approvedProps.Any())
            {
                <button type="button" class="button outline" onclick="toggleForm('createRoomBox')">
                    &#43; Add Room
                </button>
            }
        </div>

        @if (!Model.Rooms.Any())
        {
            <div class="content-card empty-state-box">
                <span class="empty-icon">&#128716;</span>
                <h4>No rooms added yet</h4>
                @if (approvedProps.Any())
                {
                    <p>Add rooms to your approved properties so travelers can book them.</p>
                    <button type="button" class="button" onclick="toggleForm('createRoomBox')">Add Room Now</button>
                }
                else
                {
                    <p>You can add rooms as soon as the administrator verifies and approves your homestay property.</p>
                    <button type="button" class="button outline" onclick="toggleForm('createPropertyBox')">Register Another Property</button>
                }
            </div>
        }
        else
        {
            <div class="data-table-container">
                <table class="modern-table">
                    <thead>
                        <tr>
                            <th>Room # / Name</th>
                            <th>Homestay Property</th>
                            <th>Room Type</th>
                            <th>Capacity</th>
                            <th>Nightly Price</th>
                            <th>Status</th>
                            <th>Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var room in Model.Rooms)
                        {
                            var statusClass = (room.Status ?? "Trống") switch
                            {
                                "Trống" => "empty",
                                "Đang sử dụng" => "occupied",
                                "Booked" => "confirmed",
                                _ => "pending"
                            };

                            <tr>
                                <td><b>@room.RoomNumber</b></td>
                                <td>@room.PropertyName</td>
                                <td><span class="role-tag guest">@room.RoomType</span></td>
                                <td>@room.Capacity guests</td>
                                <td><b>@room.Price.ToString("N0") &#8363;</b> / night</td>
                                <td>
                                    <span class="status-pill @statusClass">@room.Status</span>
                                </td>
                                <td>
                                    <form asp-action="DeleteRoom" method="post" style="display: inline;" onsubmit="return confirm('Bạn có chắc chắn muốn xóa phòng này khỏi hệ thống?');">
                                        <input type="hidden" name="propertyId" value="@room.PropertyId" />
                                        <input type="hidden" name="roomId" value="@room.Id" />
                                        <button type="submit" class="action-btn-mini" style="background: #fee2e2; color: #991b1b; padding: 4px 10px; cursor: pointer;">
                                            &#128465; Xóa
                                        </button>
                                        @Html.AntiForgeryToken()
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>

    <!-- ==================== TAB 3: BOOKINGS ==================== -->
    <div id="tab-bookings" class="tab-pane @(activeTab == "bookings" ? "active" : "")">
        <div class="content-card-header">
            <div>
                <h2>Guest Bookings Management</h2>
                <p>Manage reservations made for your homestay properties and change stay status.</p>
            </div>
        </div>

        @if (!Model.Bookings.Any())
        {
            <div class="content-card empty-state-box">
                <span class="empty-icon">&#128197;</span>
                <h4>No bookings received yet</h4>
                <p>When travelers book rooms at your approved homestays, their reservations will appear here.</p>
            </div>
        }
        else
        {
            <div class="data-table-container">
                <table class="modern-table">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Property &amp; Rooms</th>
                            <th>Guest Details</th>
                            <th>Stay Dates</th>
                            <th>Guests</th>
                            <th>Total Price</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var b in Model.Bookings)
                        {
                            var statusClass = b.Status.ToLowerInvariant();
                            <tr>
                                <td><b>#@b.Id</b></td>
                                <td>
                                    <strong>@b.PropertyName</strong>
                                    <div style="font-size: 0.8rem; color: var(--muted);">Room: @string.Join(", ", b.RoomNumbers)</div>
                                </td>
                                <td>
                                    <div><b>@b.GuestName</b></div>
                                    <div style="font-size: 0.8rem; color: var(--muted);">@b.GuestPhone</div>
                                </td>
                                <td>
                                    <div>@b.CheckIn.ToString("dd/MM/yyyy") &rarr; @b.CheckOut.ToString("dd/MM/yyyy")</div>
                                    <div style="font-size: 0.8rem; color: var(--muted);">@Math.Max(1, (b.CheckOut.Date - b.CheckIn.Date).Days) nights</div>
                                </td>
                                <td>@b.GuestCount guests</td>
                                <td><strong style="color: var(--green-dark);">@b.TotalAmount.ToString("N0") &#8363;</strong></td>
                                <td>
                                    <span class="status-pill @statusClass">@b.Status</span>
                                </td>
                                <td>
                                    <div class="action-btn-group">
                                        @if (b.Status == "Pending")
                                        {
                                            <form asp-action="UpdateBookingStatus" method="post" style="display:inline;">
                                                <input type="hidden" name="bookingId" value="@b.Id" />
                                                <input type="hidden" name="status" value="Confirmed" />
                                                <button type="submit" class="action-btn-mini">&#10003; Confirm</button>
                                                @Html.AntiForgeryToken()
                                            </form>
                                            <form asp-action="UpdateBookingStatus" method="post" style="display:inline;">
                                                <input type="hidden" name="bookingId" value="@b.Id" />
                                                <input type="hidden" name="status" value="Cancelled" />
                                                <button type="submit" class="action-btn-mini danger">&times; Cancel</button>
                                                @Html.AntiForgeryToken()
                                            </form>
                                        }
                                        else if (b.Status == "Confirmed")
                                        {
                                            <form asp-action="UpdateBookingStatus" method="post" style="display:inline;">
                                                <input type="hidden" name="bookingId" value="@b.Id" />
                                                <input type="hidden" name="status" value="CheckedIn" />
                                                <button type="submit" class="action-btn-mini">&#128204; Check In</button>
                                                @Html.AntiForgeryToken()
                                            </form>
                                            <form asp-action="UpdateBookingStatus" method="post" style="display:inline;">
                                                <input type="hidden" name="bookingId" value="@b.Id" />
                                                <input type="hidden" name="status" value="Cancelled" />
                                                <button type="submit" class="action-btn-mini danger">&times; Cancel</button>
                                                @Html.AntiForgeryToken()
                                            </form>
                                        }
                                        else if (b.Status == "CheckedIn")
                                        {
                                            <form asp-action="UpdateBookingStatus" method="post" style="display:inline;">
                                                <input type="hidden" name="bookingId" value="@b.Id" />
                                                <input type="hidden" name="status" value="CheckedOut" />
                                                <button type="submit" class="action-btn-mini">&#10004; Check Out</button>
                                                @Html.AntiForgeryToken()
                                            </form>
                                        }
                                        else
                                        {
                                            <span style="font-size: 0.8rem; color: var(--muted);">-</span>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>

    <!-- ==================== TAB 4: INVOICES & REVENUE ==================== -->
    <div id="tab-invoices" class="tab-pane @(activeTab == "invoices" ? "active" : "")">
        <div class="content-card-header">
            <div>
                <h2>Invoices &amp; Revenue Records</h2>
                <p>Financial ledger, guest payments, and breakdown of homestay earnings.</p>
            </div>
            <div>
                <strong style="font-size: 1.1rem; color: var(--green-dark);">Total Earned: @Model.Summary.TotalRevenue.ToString("N0") &#8363;</strong>
            </div>
        </div>

        @if (!Model.Invoices.Any())
        {
            <div class="content-card empty-state-box">
                <span class="empty-icon">&#128176;</span>
                <h4>No invoices generated yet</h4>
                <p>Invoices will be recorded automatically when bookings are confirmed and paid.</p>
            </div>
        }
        else
        {
            <div class="data-table-container">
                <table class="modern-table">
                    <thead>
                        <tr>
                            <th>Invoice #</th>
                            <th>Booking Ref</th>
                            <th>Property</th>
                            <th>Guest Name</th>
                            <th>Date Issued</th>
                            <th>Total Amount</th>
                            <th>Payment Method</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var inv in Model.Invoices)
                        {
                            <tr>
                                <td><b>#INV-@inv.Id</b></td>
                                <td><a href="#tab-bookings" onclick="switchToBookings()">#@inv.BookingId</a></td>
                                <td>@inv.PropertyName</td>
                                <td>@inv.GuestName</td>
                                <td>@inv.CreatedDate.ToString("dd/MM/yyyy HH:mm")</td>
                                <td><strong style="color: var(--green-dark);">@inv.TotalAmount.ToString("N0") &#8363;</strong></td>
                                <td><span class="role-tag guest">@inv.PaymentMethod</span></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
        </main>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            // Validation & Highlighting for Create Property Request Form
            const propForm = document.getElementById("createPropertyForm");
            const validationBanner = document.getElementById("propertyFormValidationBanner");

            if (propForm) {
                const requiredTextInputs = [
                    { id: "propName", errId: "err_propName", validate: val => val.trim() !== "" },
                    { id: "propType", errId: "err_propType", validate: val => val.trim() !== "" },
                    { id: "propPhone", errId: "err_propPhone", validate: val => val.trim().length >= 8 },
                    { id: "propAddress", errId: "err_propAddress", validate: val => val.trim() !== "" },
                    { id: "propCity", errId: "err_propCity", validate: val => val.trim() !== "" }
                ];

                const legalDocCards = [
                    {
                        cardId: "cardBizLicense",
                        fileId: "propBizLicenseFile",
                        urlId: "propBizLicenseUrl",
                        errId: "err_bizLicense"
                    },
                    {
                        cardId: "cardFireSafety",
                        fileId: "propFireSafetyFile",
                        urlId: "propFireSafetyUrl",
                        errId: "err_fireSafety"
                    },
                    {
                        cardId: "cardSecurity",
                        fileId: "propSecurityFile",
                        urlId: "propSecurityUrl",
                        errId: "err_security"
                    }
                ];

                function updateValidationBannerState() {
                    const hasInputErrors = propForm.querySelectorAll(".field-error-highlight").length > 0;
                    if (!hasInputErrors && validationBanner) {
                        validationBanner.classList.remove("visible");
                    }
                }

                // Dynamic real-time clear when user types or changes input
                requiredTextInputs.forEach(item => {
                    const inputEl = document.getElementById(item.id);
                    const errEl = document.getElementById(item.errId);
                    if (inputEl) {
                        ['input', 'change', 'blur'].forEach(evt => {
                            inputEl.addEventListener(evt, function () {
                                if (item.validate(inputEl.value)) {
                                    inputEl.classList.remove("field-error-highlight");
                                    if (errEl) errEl.classList.remove("visible");
                                    updateValidationBannerState();
                                }
                            });
                        });
                    }
                });

                // On Confirm/Submit Create Property Request
                propForm.addEventListener("submit", function (e) {
                    let hasMissingFields = false;
                    let firstMissingElement = null;

                    // 1. Validate required text/select inputs
                    requiredTextInputs.forEach(item => {
                        const inputEl = document.getElementById(item.id);
                        const errEl = document.getElementById(item.errId);
                        if (inputEl) {
                            if (!item.validate(inputEl.value)) {
                                hasMissingFields = true;
                                inputEl.classList.add("field-error-highlight");
                                if (errEl) errEl.classList.add("visible");
                                if (!firstMissingElement) firstMissingElement = inputEl;
                            } else {
                                inputEl.classList.remove("field-error-highlight");
                                if (errEl) errEl.classList.remove("visible");
                            }
                        }
                    });

                    // If any required field is missing, block submission & highlight
                    if (hasMissingFields) {
                        e.preventDefault();
                        if (validationBanner) {
                            validationBanner.classList.add("visible");
                        }

                        if (firstMissingElement) {
                            firstMissingElement.scrollIntoView({ behavior: "smooth", block: "center" });
                            setTimeout(() => {
                                if (typeof firstMissingElement.focus === "function") {
                                    firstMissingElement.focus();
                                }
                            }, 350);
                        }
                        return false;
                    }

                    // Submission is valid - show sending state
                    const submitBtn = document.getElementById("btnSubmitProperty");
                    if (submitBtn) {
                        submitBtn.disabled = true;
                        submitBtn.innerHTML = "⏳ Đang tải tài liệu &amp; gửi hồ sơ...";
                        submitBtn.style.opacity = "0.75";
                        submitBtn.style.cursor = "not-allowed";
                    }
                });
            }

            const navButtons = document.querySelectorAll("#dashboardTabsNav .tab-nav-btn");
            const panes = document.querySelectorAll(".tab-pane");

            navButtons.forEach(btn => {
                btn.addEventListener("click", function () {
                    const targetId = this.getAttribute("data-tab");

                    navButtons.forEach(b => b.classList.remove("active"));
                    panes.forEach(p => p.classList.remove("active"));

                    this.classList.add("active");
                    const targetPane = document.getElementById(targetId);
                    if (targetPane) {
                        targetPane.classList.add("active");
                    }

                    const tabKey = targetId.replace("tab-", "");
                    const newUrl = new URL(window.location);
                    newUrl.searchParams.set("tab", tabKey);
                    window.history.replaceState({}, "", newUrl);
                });
            });
        });

        function toggleForm(elementId) {
            const el = document.getElementById(elementId);
            if (el) {
                if (el.style.display === "none" || el.style.display === "") {
                    el.style.display = "block";
                    el.scrollIntoView({ behavior: "smooth", block: "start" });
                } else {
                    el.style.display = "none";
                }
            }
        }

        function openAddRoomFor(propertyId) {
            const select = document.getElementById("roomPropertySelect");
            if (select) {
                select.value = propertyId;
            }
            toggleForm("createRoomBox");
        }

        function switchToBookings() {
            const bookingsBtn = document.querySelector("#dashboardTabsNav [data-tab='tab-bookings']");
            if (bookingsBtn) {
                bookingsBtn.click();
            }
        }

        async function viewApprovalHistory(propId, propName) {
            const overlay = document.getElementById("historyModalOverlay");
            const title = document.getElementById("historyModalTitle");
            const subtitle = document.getElementById("historyModalSubtitle");
            const content = document.getElementById("historyModalContent");

            title.innerText = "Approval History";
            subtitle.innerText = propName;
            content.innerHTML = '<div style="text-align: center; padding: 24px; color: #64748b;">Loading history...</div>';
            overlay.style.display = "flex";

            try {
                const res = await fetch(`/Home/PropertyApprovalHistory?id=${propId}`);
                if (!res.ok) throw new Error("Could not load history");
                const items = await res.json();

                if (!items || items.length === 0) {
                    content.innerHTML = '<div style="text-align: center; padding: 24px; color: #94a3b8;">No approval history recorded yet.</div>';
                    return;
                }

                let html = '<div style="display: flex; flex-direction: column; gap: 14px;">';
                items.forEach((item) => {
                    const isApproved = item.status === 'Approved';
                    const isRejected = item.status === 'Rejected';
                    const badgeBg = isApproved ? '#dcfce7' : (isRejected ? '#fee2e2' : '#fef3c7');
                    const badgeColor = isApproved ? '#166534' : (isRejected ? '#991b1b' : '#92400e');
                    const icon = isApproved ? '&#10003;' : (isRejected ? '&#10060;' : '&#9203;');
                    const dateStr = new Date(item.reviewedAt).toLocaleString();

                    html += `
                        <div style="border: 1px solid #e2e8f0; border-radius: 10px; padding: 14px; background: #f8fafc;">
                            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 6px;">
                                <span style="font-size: 0.8rem; font-weight: 700; padding: 3px 10px; border-radius: 9999px; background: ${badgeBg}; color: ${badgeColor}; display: inline-flex; align-items: center; gap: 4px;">
                                    ${icon} ${item.status}
                                </span>
                                <span style="font-size: 0.78rem; color: #64748b;">${dateStr}</span>
                            </div>
                            ${item.reviewerName ? `<div style="font-size: 0.8rem; color: #475569; margin-bottom: 4px;"><strong>Reviewer:</strong> ${item.reviewerName}</div>` : ''}
                            ${item.rejectionReason ? `<div style="font-size: 0.85rem; color: #991b1b; background: #fff5f5; padding: 8px 10px; border-radius: 6px; border-left: 3px solid #ef4444; margin-top: 6px;"><strong>Note / Denial Reason:</strong> ${item.rejectionReason}</div>` : ''}
                        </div>
                    `;
                });
                html += '</div>';
                content.innerHTML = html;
            } catch (err) {
                content.innerHTML = `<div style="text-align: center; padding: 24px; color: #ef4444;">Error loading history: ${err.message}</div>`;
            }
        }

        function closeHistoryModal() {
            const overlay = document.getElementById("historyModalOverlay");
            if (overlay) overlay.style.display = "none";
        }
    </script>

    <!-- Approval History Modal Overlay -->
    <div id="historyModalOverlay" style="display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.55); z-index: 9999; align-items: center; justify-content: center; backdrop-filter: blur(3px);">
        <div style="background: #fff; border-radius: 16px; max-width: 580px; width: 92%; max-height: 85vh; overflow-y: auto; box-shadow: 0 20px 40px rgba(0,0,0,0.25); padding: 24px; position: relative;">
            <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 16px; border-bottom: 1px solid #e2e8f0; padding-bottom: 12px;">
                <div>
                    <h3 id="historyModalTitle" style="margin: 0; font-size: 1.25rem; color: #1e293b;">Approval History</h3>
                    <p id="historyModalSubtitle" style="margin: 4px 0 0; font-size: 0.85rem; color: #64748b;"></p>
                </div>
                <button type="button" onclick="closeHistoryModal()" style="background: transparent; border: none; font-size: 1.5rem; line-height: 1; cursor: pointer; color: #94a3b8;">&times;</button>
            </div>
            <div id="historyModalContent">
                <div style="text-align: center; padding: 24px; color: #64748b;">Loading history...</div>
            </div>
        </div>
    </div>
}
