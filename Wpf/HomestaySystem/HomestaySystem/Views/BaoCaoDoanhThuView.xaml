        <Grid Visibility="{Binding HienThiDialogQuyetToan, Converter={StaticResource BoolToVis}}"
              Panel.ZIndex="1000" VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
            <!-- Nền tối mờ: Nhấp chuột ra bất kỳ vị trí nào ngoài hộp thoại để đóng -->
