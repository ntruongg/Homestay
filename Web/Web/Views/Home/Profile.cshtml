@model ProfileViewModel

@{
    var profile = Model.Profile;
    var isOwner = profile.Role == "OWNER";
    ViewData["Title"] = isOwner ? "Hồ sơ Chủ cơ sở - Stayly" : "Thông tin cá nhân - Stayly";
    var initials = !string.IsNullOrWhiteSpace(profile.FullName) 
        ? profile.FullName.Substring(0, 1).ToUpper() 
        : "U";
    var activeTab = string.IsNullOrWhiteSpace(Model.ActiveTab) ? "personal" : Model.ActiveTab.ToLowerInvariant();
}

<div class="stayly-profile-page py-3 py-lg-4">
    <div class="container py-1 py-lg-2">
        <!-- Toast / Alerts -->
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success border-0 rounded-4 shadow-sm mb-3 mb-lg-4 d-flex align-items-center gap-2">
                <i class="bi bi-check-circle-fill fs-5 text-success"></i>
                <div class="fw-semibold">@TempData["Success"]</div>
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger border-0 rounded-4 shadow-sm mb-3 mb-lg-4 d-flex align-items-center gap-2">
                <i class="bi bi-exclamation-triangle-fill fs-5 text-danger"></i>
                <div class="fw-semibold">@TempData["Error"]</div>
            </div>
        }

        <!-- =====================================================================
             1. MOBILE HUB VIEW (Chỉ hiển thị trên Mobile < 992px phong cách Native App)
             ===================================================================== -->
        <div id="mobileProfileHub" class="d-block d-lg-none">
            <!-- Mobile Header Profile Hero Card -->
            <div class="mobile-profile-hero-card mb-3 p-3 bg-white rounded-4 shadow-sm border">
                <div class="d-flex align-items-center gap-3">
                    <div class="mobile-avatar-circle">
                        @initials
                        <div class="mobile-avatar-badge" title="Tài khoản Stayly">
                            <i class="bi bi-check-lg"></i>
                        </div>
                    </div>
                    <div class="flex-grow-1 min-w-0">
                        <div class="d-flex align-items-center gap-2 flex-wrap">
                            <h3 class="fs-5 fw-bold text-navy mb-0 text-truncate">@profile.FullName</h3>
                        </div>
                        <div class="mt-1">
                            @if (isOwner)
                            {
                                <span class="badge bg-primary text-white rounded-pill px-2.5 py-1 small fw-semibold">
                                    <i class="bi bi-patch-check-fill me-1"></i> Đối tác Chủ cơ sở
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-light text-primary border rounded-pill px-2.5 py-1 small fw-semibold">
                                    <i class="bi bi-person-heart me-1"></i> Khách hàng Stayly
                                </span>
                            }
                        </div>
                        <div class="text-muted small mt-1 text-truncate">
                            <i class="bi bi-envelope me-1"></i> @profile.Email
                        </div>
                    </div>
                </div>
            </div>



            <!-- Mobile Grouped Settings List (iOS / Android Style) -->
            <!-- Group 1: Tài khoản & Định danh -->
            <div class="mobile-settings-group mb-3">
                <div class="settings-group-header">Tài khoản &amp; Định danh</div>
                <div class="settings-card-group bg-white rounded-4 border overflow-hidden">
                    <div class="settings-item-row" onclick="openMobileSubView('tab-personal', 'Thông tin cá nhân')">
                        <div class="settings-item-icon bg-blue-light text-primary">
                            <i class="bi bi-person-vcard-fill"></i>
                        </div>
                        <div class="settings-item-content">
                            <div class="settings-item-title">Thông tin cá nhân</div>
                            <div class="settings-item-subtitle">Họ tên, SĐT, ngày sinh, giới tính</div>
                        </div>
                        <i class="bi bi-chevron-right settings-item-arrow"></i>
                    </div>

                    <div class="settings-item-row" onclick="openMobileSubView('tab-personal', 'Tài khoản ngân hàng', '#bankSection')">
                        <div class="settings-item-icon bg-green-light text-success">
                            <i class="bi bi-bank2"></i>
                        </div>
                        <div class="settings-item-content">
                            <div class="settings-item-title">Tài khoản ngân hàng</div>
                            <div class="settings-item-subtitle">@(isOwner ? "Nhận doanh thu thanh toán" : "Nhận tiền hoàn khi hủy phòng")</div>
                        </div>
                        <i class="bi bi-chevron-right settings-item-arrow"></i>
                    </div>

                    @if (isOwner)
                    {
                        <div class="settings-item-row" onclick="openMobileSubView('tab-personal', 'Căn cước công dân', '#citizenSection')">
                            <div class="settings-item-icon bg-purple-light text-purple">
                                <i class="bi bi-card-heading"></i>
                            </div>
                            <div class="settings-item-content">
                                <div class="settings-item-title">Căn cước công dân (CCCD)</div>
                                <div class="settings-item-subtitle">@(string.IsNullOrWhiteSpace(profile.CitizenId) ? "Chưa cập nhật định danh" : profile.CitizenId)</div>
                            </div>
                            <i class="bi bi-chevron-right settings-item-arrow"></i>
                        </div>
                    }

                    <div class="settings-item-row" onclick="openMobileSubView('tab-account', 'Tổng quan tài khoản')">
                        <div class="settings-item-icon bg-cyan-light text-info">
                            <i class="bi bi-grid-fill"></i>
                        </div>
                        <div class="settings-item-content">
                            <div class="settings-item-title">Tổng quan tài khoản</div>
                            <div class="settings-item-subtitle">Mã định danh #ND-@profile.Id, vai trò</div>
                        </div>
                        <i class="bi bi-chevron-right settings-item-arrow"></i>
                    </div>
                </div>
            </div>

            <!-- Group 2: An toàn & Đăng nhập -->
            <div class="mobile-settings-group mb-3">
                <div class="settings-group-header">An toàn &amp; Đăng nhập</div>
                <div class="settings-card-group bg-white rounded-4 border overflow-hidden">
                    <div class="settings-item-row" onclick="openMobileSubView('tab-security', 'Bảo mật & Mật khẩu')">
                        <div class="settings-item-icon bg-amber-light text-warning">
                            <i class="bi bi-shield-lock-fill"></i>
                        </div>
                        <div class="settings-item-content">
                            <div class="settings-item-title">Đổi mật khẩu</div>
                            <div class="settings-item-subtitle">Bảo vệ tài khoản với OTP email</div>
                        </div>
                        <i class="bi bi-chevron-right settings-item-arrow"></i>
                    </div>

                    <div class="settings-item-row" onclick="openMobileSubView('tab-security', 'Cập nhật Email', '#changeEmailSection')">
                        <div class="settings-item-icon bg-teal-light text-teal">
                            <i class="bi bi-envelope-at-fill"></i>
                        </div>
                        <div class="settings-item-content">
                            <div class="settings-item-title">Cập nhật địa chỉ Email</div>
                            <div class="settings-item-subtitle">@profile.Email</div>
                        </div>
                        <i class="bi bi-chevron-right settings-item-arrow"></i>
                    </div>
                </div>
            </div>

            @if (isOwner)
            {
                <!-- Group 3: Dành cho Chủ cơ sở -->
                <div class="mobile-settings-group mb-3">
                    <div class="settings-group-header">Quản trị Cơ sở lưu trú</div>
                    <div class="settings-card-group bg-white rounded-4 border overflow-hidden">
                        <a asp-action="Dashboard" class="settings-item-row text-decoration-none">
                            <div class="settings-item-icon bg-primary text-white">
                                <i class="bi bi-speedometer2"></i>
                            </div>
                            <div class="settings-item-content">
                                <div class="settings-item-title text-navy">Bảng điều khiển kinh doanh</div>
                                <div class="settings-item-subtitle">Cơ sở, phòng, hóa đơn &amp; doanh thu</div>
                            </div>
                            <i class="bi bi-arrow-up-right settings-item-arrow text-primary"></i>
                        </a>
                    </div>
                </div>
            }

            <!-- Group 4: Hỗ trợ & Ứng dụng -->
            <div class="mobile-settings-group mb-4">
                <div class="settings-group-header">Hỗ trợ &amp; Ứng dụng</div>
                <div class="settings-card-group bg-white rounded-4 border overflow-hidden">
                    <a href="tel:19006868" class="settings-item-row text-decoration-none">
                        <div class="settings-item-icon bg-indigo-light text-indigo">
                            <i class="bi bi-telephone-outbound-fill"></i>
                        </div>
                        <div class="settings-item-content">
                            <div class="settings-item-title text-navy">Hotline hỗ trợ 24/7</div>
                            <div class="settings-item-subtitle">1900 6868 (Bấm để gọi ngay)</div>
                        </div>
                        <i class="bi bi-telephone-forward settings-item-arrow"></i>
                    </a>

                    <div class="settings-item-row" onclick="showStaylyToast('info', 'Stayly cam kết bảo vệ tuyệt đối thông tin khách hàng và tuân thủ pháp luật Việt Nam.');">
                        <div class="settings-item-icon bg-slate-light text-secondary">
                            <i class="bi bi-file-earmark-lock-fill"></i>
                        </div>
                        <div class="settings-item-content">
                            <div class="settings-item-title">Chính sách bảo mật &amp; Quy định</div>
                            <div class="settings-item-subtitle">Điều khoản sử dụng dịch vụ Stayly</div>
                        </div>
                        <i class="bi bi-chevron-right settings-item-arrow"></i>
                    </div>
                </div>
            </div>

            <!-- Nút Đăng xuất Mobile -->
            <button type="button" class="btn btn-outline-danger w-100 rounded-pill py-2.5 fw-bold d-flex align-items-center justify-content-center gap-2 shadow-sm mb-4" data-bs-toggle="modal" data-bs-target="#logoutConfirmModal">
                <i class="bi bi-box-arrow-right"></i>
                <span>Đăng xuất tài khoản</span>
            </button>
        </div>

        <!-- =====================================================================
             2. MOBILE SUBVIEW HEADER (Khi mở form chỉnh sửa trên Mobile < 992px)
             ===================================================================== -->
        <div id="mobileSubviewHeader" class="d-none mb-3 align-items-center justify-content-between pb-2 border-bottom">
            <button type="button" class="btn btn-sm btn-light rounded-pill px-3 py-1.5 border d-inline-flex align-items-center gap-1.5" onclick="returnToMobileHub()">
                <i class="bi bi-arrow-left"></i>
                <span class="fw-semibold">Tài khoản</span>
            </button>
            <h5 class="fw-bold text-navy mb-0" id="mobileSubviewTitle">Chỉnh sửa hồ sơ</h5>
            <div style="width: 80px;"></div>
        </div>

        <!-- =====================================================================
             3. DESKTOP HEADER (Chỉ hiển thị trên Desktop >= 992px)
             ===================================================================== -->
        <div class="d-none d-lg-block">
            <!-- Breadcrumb / Quay lại -->
            <div class="d-flex align-items-center justify-content-between mb-3 flex-wrap gap-2">
                <a asp-action="Index" class="btn btn-sm btn-outline-secondary rounded-pill px-3 py-2 d-inline-flex align-items-center gap-2">
                    <i class="bi bi-arrow-left"></i>
                    <span>Quay lại trang chủ</span>
                </a>
                @if (isOwner)
                {
                    <a asp-action="Dashboard" class="btn btn-sm btn-primary rounded-pill px-4 py-2 fw-bold shadow-sm d-inline-flex align-items-center gap-2">
                        <i class="bi bi-speedometer2"></i>
                        <span>Bảng điều khiển chủ cơ sở</span>
                    </a>
                }
                else
                {
                    <a asp-action="Trips" class="btn btn-sm btn-outline-primary rounded-pill px-4 py-2 fw-bold d-inline-flex align-items-center gap-2">
                        <i class="bi bi-briefcase-fill"></i>
                        <span>Đơn đặt phòng của tôi</span>
                    </a>
                }
            </div>

            <!-- Top Banner Profile Desktop (Squircle 24px, Ocean Blue Gradient) -->
            <div class="card border-0 mb-4 p-4 p-md-5" style="border-radius: 24px; box-shadow: var(--stayly-shadow); background: #ffffff;">
                <div class="d-flex align-items-center justify-content-between flex-wrap gap-4">
                    <div class="d-flex align-items-center gap-4">
                        <div class="d-flex align-items-center justify-content-center text-white fw-bold shadow-sm" 
                             style="width: 84px; height: 84px; border-radius: 50%; font-size: 2.2rem; background: linear-gradient(135deg, var(--stayly-primary) 0%, #0096c7 100%); flex-shrink: 0;">
                            @initials
                        </div>
                        <div>
                            <div class="d-flex align-items-center gap-2 flex-wrap mb-1">
                                <h2 class="fs-4 fw-bold text-navy mb-0">@profile.FullName</h2>
                                @if (isOwner)
                                {
                                    <span class="badge rounded-pill px-3 py-1 bg-primary text-white small fw-bold">
                                        <i class="bi bi-patch-check-fill me-1"></i> Chủ cơ sở lưu trú
                                    </span>
                                }
                                else
                                {
                                    <span class="px-3 py-1 rounded-pill bg-light text-primary border small fw-bold">
                                        <i class="bi bi-person-heart me-1"></i> Khách hàng du lịch
                                    </span>
                                }
                            </div>
                            <div class="text-muted small d-flex align-items-center gap-3 flex-wrap">
                                <span><i class="bi bi-envelope-fill text-primary me-1"></i> @profile.Email</span>
                                <span>•</span>
                                <span><i class="bi bi-telephone-fill text-primary me-1"></i> @(string.IsNullOrWhiteSpace(profile.Phone) ? "Chưa cập nhật SĐT" : profile.Phone)</span>
                                <span>•</span>
                                <span>Mã tài khoản: <strong>#ND-@profile.Id</strong></span>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex gap-2">
                        @if (isOwner)
                        {
                            <span class="px-3 py-2 rounded-pill bg-light text-success border small fw-semibold d-inline-flex align-items-center gap-1">
                                <i class="bi bi-shield-fill-check fs-6 text-success"></i>
                                <span>Tài khoản đối tác đã kích hoạt</span>
                            </span>
                        }
                        else
                        {
                            <span class="px-3 py-2 rounded-pill bg-light text-navy border small fw-semibold d-inline-flex align-items-center gap-1">
                                <i class="bi bi-check-circle-fill fs-6 text-primary"></i>
                                <span>Thành viên Stayly</span>
                            </span>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- =====================================================================
             4. MAIN WORKSPACE (2 Cột trên Desktop, hoặc Form Subview trên Mobile)
             ===================================================================== -->
        <div class="row g-4" id="mainWorkspaceRow">
            <!-- Cột trái Desktop: Tabs Sidebar (Ẩn trên mobile < 992px) -->
            <div class="col-lg-4 d-none d-lg-block">
                <div class="card border-0 p-3" style="border-radius: 20px; box-shadow: var(--stayly-shadow); background: #ffffff;">
                    <div class="p-2 text-muted fw-bold small text-uppercase" style="letter-spacing: 0.05em;">
                        Quản lý tài khoản
                    </div>
                    <nav class="d-flex flex-column gap-2 mt-2" id="profileTabsNav">
                        <button type="button" class="btn text-start p-3 rounded-4 d-flex align-items-center justify-content-between profile-tab-btn @(activeTab == "personal" ? "active" : "")" data-tab="tab-personal">
                            <div class="d-flex align-items-center gap-3">
                                <span class="profile-tab-icon"><i class="bi bi-person-lines-fill"></i></span>
                                <div>
                                    <div class="fw-bold profile-tab-title">Thông tin cá nhân</div>
                                    <small class="text-muted">Họ tên, liên hệ &amp; ngân hàng</small>
                                </div>
                            </div>
                            <i class="bi bi-chevron-right text-muted small"></i>
                        </button>

                        <button type="button" class="btn text-start p-3 rounded-4 d-flex align-items-center justify-content-between profile-tab-btn @(activeTab == "security" ? "active" : "")" data-tab="tab-security">
                            <div class="d-flex align-items-center gap-3">
                                <span class="profile-tab-icon"><i class="bi bi-shield-lock-fill"></i></span>
                                <div>
                                    <div class="fw-bold profile-tab-title">Bảo mật &amp; Mật khẩu</div>
                                    <small class="text-muted">Đổi mật khẩu &amp; email với OTP</small>
                                </div>
                            </div>
                            <i class="bi bi-chevron-right text-muted small"></i>
                        </button>

                        <button type="button" class="btn text-start p-3 rounded-4 d-flex align-items-center justify-content-between profile-tab-btn @(activeTab == "account" ? "active" : "")" data-tab="tab-account">
                            <div class="d-flex align-items-center gap-3">
                                <span class="profile-tab-icon"><i class="bi bi-grid-fill"></i></span>
                                <div>
                                    <div class="fw-bold profile-tab-title">Tổng quan tài khoản</div>
                                    <small class="text-muted">Mã định danh, vai trò hệ thống</small>
                                </div>
                            </div>
                            <i class="bi bi-chevron-right text-muted small"></i>
                        </button>
                    </nav>

                    <div class="p-3 bg-light rounded-4 mt-3 small text-muted">
                        <i class="bi bi-lightbulb-fill text-warning me-1"></i>
                        <strong>Mẹo:</strong> Hãy luôn cập nhật số điện thoại và email chính xác để nhận thông báo đặt phòng tức thì từ Stayly.
                    </div>

                    <div class="pt-3 mt-3 border-top">
                        <button type="button" class="btn btn-outline-danger w-100 rounded-pill py-2 small fw-bold d-flex align-items-center justify-content-center gap-2" data-bs-toggle="modal" data-bs-target="#logoutConfirmModal">
                            <i class="bi bi-box-arrow-right"></i>
                            <span>Đăng xuất tài khoản</span>
                        </button>
                    </div>
                </div>
            </div>

            <!-- Cột phải: Khối Nội dung Form tương ứng Tab -->
            <div class="col-lg-8" id="profileContentArea">
                <!-- TAB 1: Thông tin cá nhân & Ngân hàng -->
                <div id="tab-personal" class="tab-pane-content @(activeTab == "personal" ? "active" : "d-none")">
                    <div class="card border-0 p-3 p-md-4 p-lg-5" style="border-radius: 20px; box-shadow: var(--stayly-shadow); background: #ffffff;">
                        <div class="d-flex align-items-center justify-content-between mb-4 pb-3 border-bottom flex-wrap gap-2">
                            <div>
                                <h3 class="fs-5 fw-bold text-navy mb-1">
                                    <i class="bi bi-person-vcard text-primary me-2"></i>
                                    @(isOwner ? "Thông tin cá nhân & Đối tác Chủ cơ sở" : "Thông tin cá nhân khách hàng")
                                </h3>
                                <p class="text-muted small mb-0">Cập nhật thông tin định danh và liên hệ của bạn trên nền tảng Stayly.</p>
                            </div>
                            <span class="px-3 py-2 rounded-pill bg-light text-primary border small fw-bold">
                                @(isOwner ? "Hồ sơ Đối tác" : "Hồ sơ Khách hàng")
                            </span>
                        </div>

                        <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-4 py-2 px-3 small mb-3"></div>

                        <form asp-action="Profile" method="post" id="profileForm">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="tab" value="personal" />

                            <!-- Khối 1: Thông tin liên hệ cơ bản -->
                            <div class="row g-3 mb-4">
                                <div class="col-md-12">
                                    <label class="form-label small fw-bold">Họ và tên đầy đủ *</label>
                                    <div class="input-group">
                                        <span class="input-group-text bg-light rounded-start-pill border-end-0"><i class="bi bi-person-fill text-primary"></i></span>
                                        <input asp-for="Input.FullName" class="form-control rounded-end-pill border-start-0 px-3 py-2" required placeholder="Ví dụ: Nguyễn Văn An" />
                                    </div>
                                    <span asp-validation-for="Input.FullName" class="text-danger small"></span>
                                </div>

                                <div class="col-md-6">
                                    <label class="form-label small fw-bold">Ngày sinh</label>
                                    <div class="input-group">
                                        <span class="input-group-text bg-light rounded-start-pill border-end-0"><i class="bi bi-calendar3 text-primary"></i></span>
                                        <input asp-for="Input.DateOfBirth" type="date" class="form-control rounded-end-pill border-start-0 px-3 py-2" />
                                    </div>
                                </div>

                                <div class="col-md-6">
                                    <label class="form-label small fw-bold">Giới tính</label>
                                    <div class="input-group">
                                        <span class="input-group-text bg-light rounded-start-pill border-end-0"><i class="bi bi-gender-ambiguous text-primary"></i></span>
                                        <select asp-for="Input.Gender" class="form-select rounded-end-pill border-start-0 px-3 py-2">
                                            <option value="">Chọn giới tính</option>
                                            <option value="M">Nam</option>
                                            <option value="F">Nữ</option>
                                            <option value="O">Khác</option>
                                        </select>
                                    </div>
                                </div>

                                <div class="col-md-6">
                                    <label class="form-label small fw-bold">Số điện thoại *</label>
                                    <div class="input-group">
                                        <span class="input-group-text bg-light rounded-start-pill border-end-0"><i class="bi bi-telephone-fill text-primary"></i></span>
                                        <input asp-for="Input.Phone" type="tel" class="form-control rounded-end-pill border-start-0 px-3 py-2" required placeholder="0901234567" />
                                    </div>
                                    <span asp-validation-for="Input.Phone" class="text-danger small"></span>
                                </div>

                                <div class="col-md-6">
                                    <label class="form-label small fw-bold">Địa chỉ Email</label>
                                    <div class="input-group">
                                        <span class="input-group-text bg-light rounded-start-pill border-end-0"><i class="bi bi-envelope-fill text-muted"></i></span>
                                        <input asp-for="Input.Email" type="email" class="form-control rounded-end-pill border-start-0 px-3 py-2 bg-light" readonly />
                                    </div>
                                    <span class="text-muted small">Vui lòng sang mục <strong>Bảo mật</strong> để đổi email.</span>
                                </div>
                            </div>

                            <!-- Khối 2: Dành riêng cho Chủ cơ sở lưu trú (CCCD & Ngân hàng) -->
                            @if (isOwner)
                            {
                                <div class="p-3 p-md-4 bg-light rounded-4 mb-4" id="citizenSection">
                                    <h6 class="fw-bold text-navy small mb-3">
                                        <i class="bi bi-card-heading text-primary me-1"></i> 1. Căn cước công dân (CCCD) định danh Chủ nhà
                                    </h6>
                                    <div class="row g-3">
                                        <div class="col-12">
                                            <label class="form-label small fw-bold">Số CCCD định danh cá nhân (12 số, bắt đầu bằng 0) *</label>
