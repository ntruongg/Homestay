<!doctype html>
<html lang="vi">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>@(ViewData["Title"] ?? "Stayly - Kỳ nghỉ trong mơ bắt đầu từ đây")</title>
    
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,400..800;1,9..40,400..800&display=swap" rel="stylesheet">
    
    <!-- Bootstrap 5.3 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
    
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    
    <!-- Custom Site CSS (Soft & Harmonious Monochromatic Ocean Blue) -->
    <link rel="stylesheet" href="/css/site.css" asp-append-version="true">
</head>
<body>
    <!-- 1. Navigation Bar (Sticky, Soft Shadow, Monochromatic Ocean Blue) -->
    <header class="site-header">
        <div class="container-fluid px-3 px-md-4 px-xl-5">
            <nav class="site-navbar">
                <!-- Left: Brand Logo -->
                <a class="stayly-brand" asp-controller="Home" asp-action="Index">
                    <span class="brand-icon"><i class="bi bi-water"></i></span>
                    <span>Stayly</span>
                </a>

                <!-- Middle: 3 Links (Giới thiệu, Khuyến mãi & Ưu đãi, Dành cho đối tác) -->
                <ul class="nav-center-links">
                    <li>
                        <a href="javascript:void(0)" class="nav-link-item" onclick="showFeatureNotice('Giới thiệu Stayly')">
                            Giới thiệu
                        </a>
                    </li>
                    <li>
                        <a href="javascript:void(0)" class="nav-link-item" onclick="openPromotionsModal()">
                            Khuyến mãi &amp; Ưu đãi
                        </a>
                    </li>
                    <li>
                        <a asp-controller="Home" asp-action="Register" asp-route-partner="true" class="nav-link-item partner-link">
                            <span>Dành cho đối tác</span>
                        </a>
                    </li>
                </ul>

                <!-- Right: Auth Area (DUY NHẤT 1 NÚT "Đăng nhập", hoặc Profile & Logout nếu đã đăng nhập) -->
                <div class="nav-auth-area" id="navAuthArea">
                    <!-- Default Server-rendered State (will be instantly synced with localStorage on DOM ready) -->
                    @if (Context.Session.GetString("userName") is string name)
                    {
                        @if (Context.Session.GetString("role") == "OWNER")
                        {
                            <a asp-controller="Home" asp-action="Dashboard" class="btn btn-sm btn-outline-primary rounded-pill px-3 me-1">
                                <i class="bi bi-grid-fill me-1"></i> Dashboard
                            </a>
                        }
                        <a asp-controller="Home" asp-action="Profile" class="user-profile-badge" id="navUserProfileLink">
                            <span class="user-avatar-circle">@(name.Length > 0 ? name[0].ToString().ToUpper() : "U")</span>
                            <span id="navUserName">@name</span>
                        </a>
                        <form asp-controller="Home" asp-action="Logout" method="post" class="d-inline" id="serverLogoutForm">
                            <button type="submit" class="btn-stayly-logout" id="navLogoutBtn">
                                <i class="bi bi-box-arrow-right me-1"></i> Đăng xuất
                            </button>
                            @Html.AntiForgeryToken()
                        </form>
                    }
                    else
                    {
                        <!-- Khi chưa đăng nhập: DUY NHẤT 1 NÚT Đăng nhập bo tròn 50px -->
                        <button type="button" class="btn-stayly-login" id="navLoginBtn" data-bs-toggle="modal" data-bs-target="#authModal">
                            <i class="bi bi-person-circle"></i>
                            <span>Đăng nhập</span>
                        </button>
                    }
                </div>
            </nav>
        </div>
    </header>

    <!-- Global Alerts from Server TempData -->
    <div class="container mt-3">
        @if (TempData["Error"] is string error)
        {
            <div class="stayly-alert stayly-alert-error alert-dismissible fade show" role="alert">
                <i class="bi bi-exclamation-triangle-fill fs-5"></i>
                <div class="flex-grow-1">@error</div>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @if (TempData["Success"] is string success)
        {
            <div class="stayly-alert stayly-alert-success alert-dismissible fade show" role="alert">
                <i class="bi bi-check-circle-fill fs-5"></i>
                <div class="flex-grow-1">@success</div>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
    </div>

    <!-- Main Body -->
    <main>
        @RenderBody()
    </main>

    @{
        var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
        var hideFooter = ViewBag.HideFooter == true 
                         || string.Equals(currentAction, "Dashboard", StringComparison.OrdinalIgnoreCase) 
                         || string.Equals(currentAction, "Details", StringComparison.OrdinalIgnoreCase);
    }
    @if (!hideFooter)
    {
        <!-- 5. Footer (Light Accent Background, Dark Typography, 3 Columns) -->
        <footer class="site-footer">
            <div class="container-fluid px-3 px-md-4 px-xl-5">
                <div class="row g-4">
                    <!-- Cột 1: Giới thiệu -->
                    <div class="col-lg-4 col-md-6">
                        <div class="footer-col">
                            <div class="stayly-brand mb-3">
                                <span class="brand-icon"><i class="bi bi-water"></i></span>
                                <span>Stayly</span>
                            </div>
                            <p class="footer-desc">
                                Nền tảng kết nối homestay và không gian nghỉ dưỡng độc đáo hàng đầu. Mang đến trải nghiệm nghỉ dưỡng mềm mại, ấm cúng và đáng nhớ cho mọi hành trình của bạn.
                            </p>
                            <div class="d-flex flex-column gap-2 text-muted small">
                                <div><i class="bi bi-geo-alt-fill text-primary me-2"></i> Trụ sở: Tòa nhà Stayly Hub, Quận 1, TP. Hồ Chí Minh</div>
                                <div><i class="bi bi-envelope-fill text-primary me-2"></i> Email: support@stayly.vn</div>
                                <div><i class="bi bi-telephone-fill text-primary me-2"></i> Hotline: 1900 6868 (8:00 - 22:00)</div>
                            </div>
                        </div>
                    </div>

                    <!-- Cột 2: Hỗ trợ khách hàng -->
                    <div class="col-lg-4 col-md-6">
                        <div class="footer-col ps-lg-4">
                            <h5 class="footer-col-title">Hỗ trợ khách hàng</h5>
                            <ul class="footer-links-list">
                                <li><a asp-controller="Home" asp-action="GeneralPolicy">Điều khoản & Chính sách chung</a></li>
                                <li><a asp-controller="Home" asp-action="Register" asp-route-partner="true">Đăng ký trở thành chủ nhà đối tác</a></li>
                            </ul>
                        </div>
                    </div>

                    <!-- Cột 3: Mạng xã hội & Phương thức thanh toán -->
                    <div class="col-lg-4 col-md-12">
                        <div class="footer-col">
                            <h5 class="footer-col-title">Kết nối &amp; Thanh toán</h5>
                            <p class="footer-desc mb-3">Theo dõi Stayly trên các kênh truyền thông để cập nhật ưu đãi mới nhất mỗi ngày:</p>
                            
                            <!-- Social Icons -->
                            <div class="social-icons-row">
                                <a href="https://facebook.com" target="_blank" class="social-circle-btn" title="Facebook"><i class="bi bi-facebook"></i></a>
                                <a href="https://instagram.com" target="_blank" class="social-circle-btn" title="Instagram"><i class="bi bi-instagram"></i></a>
                                <a href="https://tiktok.com" target="_blank" class="social-circle-btn" title="TikTok"><i class="bi bi-tiktok"></i></a>
                                <a href="https://youtube.com" target="_blank" class="social-circle-btn" title="YouTube"><i class="bi bi-youtube"></i></a>
                            </div>

                            <!-- Payment methods -->
                            <h6 class="fw-bold mb-2 text-dark small text-uppercase">Phương thức thanh toán an toàn</h6>
                            <div class="payment-badges-row">
                                <span class="payment-badge"><i class="bi bi-credit-card-2-front text-primary me-1"></i> Visa / Master</span>
                                <span class="payment-badge"><i class="bi bi-qr-code text-primary me-1"></i> VNPay-QR</span>
                                <span class="payment-badge"><i class="bi bi-wallet2 text-primary me-1"></i> MoMo</span>
                                <span class="payment-badge"><i class="bi bi-bank text-primary me-1"></i> Chuyển khoản</span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Bottom Copyright Bar -->
                <div class="footer-bottom-bar">
                    <div>&copy; 2026 Stayly. Bản quyền thuộc về Stayly. Thiết kế phong cách Soft &amp; Harmonious.</div>
                    <div class="d-flex gap-3">
                        <a asp-controller="Home" asp-action="GeneralPolicy">Điều khoản & Bảo mật</a>
                        <span>&bull;</span>
                        <a href="javascript:void(0)" onclick="showFeatureNotice('Sơ đồ trang web')">Sitemap</a>
                    </div>
                </div>
            </div>
        </footer>
    }

    <!-- ==========================================================================
         2. Modal Đăng nhập / Đăng ký (Bo tròn góc 24px, Toggle bằng Vanilla JS)
         ========================================================================== -->
    <div class="modal fade" id="authModal" tabindex="-1" aria-labelledby="authModalTitle" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered" style="max-width: 460px;">
            <div class="modal-content stayly-modal">
                <div class="modal-header-accent"></div>
                <div class="modal-body stayly-modal-body position-relative">
                    <button type="button" class="btn-close position-absolute top-0 end-0 m-3" data-bs-dismiss="modal" aria-label="Close"></button>

                    <!-- Alert message container inside modal -->
                    <div id="modalAuthAlert" class="stayly-alert stayly-alert-error d-none mb-3"></div>

                    <!-- FORM 1: ĐĂNG NHẬP -->
                    <div id="loginFormContainer">
                        <div class="modal-brand-header">
                            <span class="brand-icon"><i class="bi bi-water"></i></span>
                            <h4 id="authModalTitle">Đăng nhập Stayly</h4>
                            <p>Chào mừng bạn trở lại! Khám phá kỳ nghỉ trong mơ.</p>
                        </div>

                        <form id="ajaxLoginForm" onsubmit="handleAjaxLogin(event)">
                            <div class="modal-form-group">
                                <label class="modal-form-label" for="loginEmail">Địa chỉ Email</label>
                                <input type="email" id="loginEmail" class="modal-input-field" placeholder="vidu@gmail.com" required autocomplete="email">
                            </div>

                            <div class="modal-form-group">
                                <label class="modal-form-label" for="loginPassword">Mật khẩu</label>
                                <input type="password" id="loginPassword" class="modal-input-field" placeholder="Nhập mật khẩu của bạn" required autocomplete="current-password">
                            </div>

                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" id="rememberMe" checked>
                                    <label class="form-check-label text-muted small" for="rememberMe">Ghi nhớ đăng nhập</label>
                                </div>
                                <a href="javascript:void(0)" onclick="showFeatureNotice('Quên mật khẩu')" class="small text-decoration-none">Quên mật khẩu?</a>
                            </div>

                            <button type="submit" class="btn-modal-submit" id="loginSubmitBtn">
                                <span>Đăng nhập</span>
                            </button>
                        </form>

                        <!-- Toggle text to switch to Register form -->
                        <div class="modal-switch-prompt">
                            Bạn chưa có tài khoản? 
                            <a href="javascript:void(0)" id="toggleToRegisterBtn" onclick="toggleAuthModalView('register')">Đăng ký ngay</a>
                        </div>

                        <div class="modal-partner-note">
                            Bạn muốn kinh doanh cơ sở lưu trú? 
                            <a asp-controller="Home" asp-action="Register" asp-route-partner="true" class="fw-bold">Đăng ký chủ nhà đối tác &rarr;</a>
                        </div>
                    </div>

                    <!-- FORM 2: ĐĂNG KÝ (Tích hợp cùng Modal) -->
                    <div id="registerFormContainer" class="d-none">
                        <div class="modal-brand-header">
                            <span class="brand-icon"><i class="bi bi-person-plus-fill"></i></span>
                            <h4>Tạo tài khoản Stayly</h4>
                            <p>Đăng ký thành viên nhanh chóng và hoàn toàn miễn phí.</p>
                        </div>

                        <form id="ajaxRegisterForm" onsubmit="handleAjaxRegister(event)" novalidate>
                            <div class="modal-form-group">
                                <label class="modal-form-label" for="regFullName">Họ và tên <span class="text-danger">*</span></label>
                                <input type="text" id="regFullName" class="modal-input-field" placeholder="Nguyễn Văn A" autocomplete="name">
                                <div class="field-error-text" id="regFullNameError"></div>
                            </div>

                            <div class="row g-2">
                                <div class="col-7">
                                    <div class="modal-form-group">
                                        <label class="modal-form-label" for="regPhone">Số điện thoại <span class="text-danger">*</span></label>
                                        <input type="tel" id="regPhone" class="modal-input-field" placeholder="0912345678" autocomplete="tel">
                                        <div class="field-error-text" id="regPhoneError"></div>
                                    </div>
                                </div>
                                <div class="col-5">
                                    <div class="modal-form-group">
                                        <label class="modal-form-label" for="regGender">Giới tính</label>
                                        <select id="regGender" class="modal-input-field">
                                            <option value="M">Nam</option>
                                            <option value="F">Nữ</option>
                                        </select>
                                    </div>
                                </div>
                            </div>

                            <div class="modal-form-group">
                                <label class="modal-form-label" for="regDob">Ngày sinh <span class="text-danger">*</span></label>
                                <input type="date" id="regDob" class="modal-input-field">
                                <div class="field-error-text" id="regDobError"></div>
                            </div>

                            <div class="modal-form-group">
                                <label class="modal-form-label" for="regEmail">Email <span class="text-danger">*</span></label>
                                <input type="email" id="regEmail" class="modal-input-field" placeholder="vidu@gmail.com" autocomplete="email">
                                <div class="field-error-text" id="regEmailError"></div>
                            </div>

                            <div class="modal-form-group">
                                <label class="modal-form-label" for="regPassword">Mật khẩu (tối thiểu 8 ký tự) <span class="text-danger">*</span></label>
                                <input type="password" id="regPassword" class="modal-input-field" placeholder="Tạo mật khẩu an toàn" autocomplete="new-password">
                                <div class="field-error-text" id="regPasswordError"></div>
                            </div>

                            <button type="submit" class="btn-modal-submit" id="registerSubmitBtn">
                                <span>Tiếp tục &amp; Nhận mã OTP</span>
                            </button>
                        </form>

                        <!-- Toggle text to switch back to Login form -->
                        <div class="modal-switch-prompt">
                            Đã có tài khoản Stayly? 
                            <a href="javascript:void(0)" id="toggleToLoginBtn" onclick="toggleAuthModalView('login')">Đăng nhập ngay</a>
                        </div>
                    </div>

                    <!-- FORM 3: XÁC THỰC MÃ OTP (Gửi về Email) -->
                    <div id="registerOtpContainer" class="d-none">
                        <div class="modal-brand-header">
                            <span class="brand-icon"><i class="bi bi-shield-lock-fill"></i></span>
                            <h4>Xác thực mã OTP</h4>
                            <p>
                                Chúng tôi đã gửi mã xác thực 6 chữ số đến email:
                                <br><strong id="guestOtpEmailDisplay" class="text-navy"></strong>
                            </p>
                        </div>

                        <div id="modalOtpAlert" class="stayly-alert stayly-alert-error d-none mb-3"></div>

                        <form id="ajaxOtpConfirmForm" onsubmit="handleAjaxOtpConfirm(event)" novalidate>
                            <div class="modal-form-group text-center">
                                <label class="modal-form-label mb-2" for="guestOtpInput">Nhập mã 6 chữ số</label>
                                <input type="text"
                                       id="guestOtpInput"
                                       class="modal-input-field text-center fw-bold fs-3"
                                       maxlength="6"
                                       inputmode="numeric"
                                       pattern="[0-9]{6}"
                                       placeholder="· · · · · ·"
                                       style="letter-spacing: 10px; font-family: monospace;">
                                <div class="field-error-text text-center" id="guestOtpInputError"></div>
                            </div>

                            <div class="d-flex justify-content-between align-items-center mb-3 small text-muted">
                                <span>Hết hạn trong: <strong id="guestOtpCountdown" class="text-primary">10:00</strong></span>
                                <button type="button" class="btn btn-link p-0 text-decoration-none small" id="guestResendOtpBtn" onclick="resendGuestOtp()" disabled>
                                    Gửi lại mã (<span id="guestResendCount">60s</span>)
                                </button>
                            </div>

                            <button type="submit" class="btn-modal-submit" id="confirmGuestOtpBtn">
                                <span>Xác nhận &amp; Hoàn tất đăng ký</span>
                            </button>
                        </form>

                        <div class="text-center mt-3 pt-2">
                            <a href="javascript:void(0)" onclick="toggleAuthModalView('register')" class="small text-muted text-decoration-none">
                                &larr; Quay lại chỉnh sửa thông tin
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Modal Popup Thông báo Tính năng đang được xây dựng -->
    <div class="modal fade" id="featureNoticeModal" tabindex="-1" aria-labelledby="featureNoticeTitle" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered" style="max-width: 420px;">
            <div class="modal-content stayly-modal text-center p-4">
                <div class="modal-body p-2">
                    <div class="feature-notice-icon mx-auto">
                        <i class="bi bi-stars"></i>
                    </div>
                    <h4 id="featureNoticeTitle" class="fw-bold text-dark mb-2">Chức năng đang được xây dựng</h4>
                    <p class="text-muted small mb-4" id="featureNoticeMessage">
                        Đội ngũ Stayly đang nỗ lực hoàn thiện tính năng này để mang tới trải nghiệm trọn vẹn nhất cho bạn. Vui lòng quay lại trong các bản cập nhật tiếp theo!
                    </p>
                    <button type="button" class="btn-modal-submit" data-bs-dismiss="modal">
                        Đã hiểu
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Modal Khuyến mãi & Ưu đãi đặc biệt (Promotions Modal) -->
    <div class="modal fade" id="promotionsModal" tabindex="-1" aria-labelledby="promotionsModalTitle" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered" style="max-width: 580px;">
            <div class="modal-content stayly-modal">
                <div class="modal-header-accent"></div>
                <div class="modal-body stayly-modal-body p-4 position-relative">
                    <button type="button" class="btn-close position-absolute top-0 end-0 m-3" data-bs-dismiss="modal" aria-label="Close"></button>

                    <div class="modal-brand-header text-start mb-4">
                        <div class="d-flex align-items-center gap-2 mb-1">
                            <span class="brand-icon"><i class="bi bi-tag-fill"></i></span>
                            <h4 id="promotionsModalTitle" class="mb-0">Khuyến mãi &amp; Ưu đãi Stayly</h4>
                        </div>
                        <p class="text-muted small mb-0">Nhận ngay mã giảm giá độc quyền cho kỳ nghỉ dưỡng của bạn!</p>
                    </div>

                    <div id="promotionsLoadingState" class="text-center py-4">
                        <div class="spinner-border text-primary" role="status"></div>
                        <p class="text-muted small mt-2">Đang kiểm tra các ưu đãi mới nhất...</p>
                    </div>

                    <div id="promotionsListContainer" class="d-none">
                        <!-- Populated dynamically via JS -->
                    </div>

                    <div class="d-flex justify-content-end mt-4 pt-2 border-top">
                        <button type="button" class="btn btn-outline-secondary rounded-pill px-4" data-bs-dismiss="modal">
                            Đóng
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Bootstrap 5.3 JS Bundle -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>

    <!-- Vietnam Address & Autocomplete Service -->
    <script src="~/js/vn-address-api.js" asp-append-version="true"></script>

    <!-- Global Client-side Authentication & Feature Notice Scripts -->
    <script>
        // Promotions Modal Opener with live API call
        async function openPromotionsModal() {
            const modalEl = document.getElementById('promotionsModal');
            if (!modalEl) return;
            const modal = bootstrap.Modal.getOrCreateInstance(modalEl);
            modal.show();

            const loadingEl = document.getElementById('promotionsLoadingState');
            const listEl = document.getElementById('promotionsListContainer');
            loadingEl.classList.remove('d-none');
            listEl.classList.add('d-none');

            try {
                const res = await fetch('/Home/GetPromotionsJson');
                const result = await res.json();
                if (res.ok && result.success && result.data && result.data.length > 0) {
                    let html = '';
                    result.data.forEach(p => {
                        const maxTxt = p.maxAmount ? ` (Tối đa ${Number(p.maxAmount).toLocaleString('vi-VN')} ₫)` : '';
                        const dateTxt = p.endDate ? `HSD: ${new Date(p.endDate).toLocaleDateString('vi-VN')}` : 'Không giới hạn thời gian';
                        html += `
                            <div class="promo-voucher-card">
                                <div>
                                    <div class="d-flex align-items-center gap-2 mb-1">
                                        <span class="promo-discount-badge">
                                            <i class="bi bi-percent"></i> GIẢM ${p.percentage}%
                                        </span>
                                        <span class="text-muted small">${maxTxt}</span>
                                    </div>
                                    <div class="fw-bold text-navy small mb-1">Áp dụng cho mọi homestay toàn quốc</div>
                                    <div class="text-muted small"><i class="bi bi-clock me-1"></i>${dateTxt}</div>
                                </div>
                                <div class="text-end">
                                    <div class="promo-code-box mb-2">${p.code}</div>
                                    <button type="button" class="btn btn-sm btn-primary rounded-pill px-3 shadow-sm" onclick="copyPromoCode('${p.code}', this)">
                                        <i class="bi bi-clipboard me-1"></i> Sao chép
                                    </button>
                                </div>
                            </div>`;
                    });
                    listEl.innerHTML = html;
                } else {
                    listEl.innerHTML = `
                        <div class="text-center py-4 text-muted small">
                            <i class="bi bi-emoji-smile fs-3 d-block mb-2"></i>
                            Hiện tại chưa có ưu đãi mới. Hãy quay lại sau nhé!
                        </div>`;
                }
            } catch (err) {
                listEl.innerHTML = `
                    <div class="alert alert-warning small rounded-pill text-center">
                        Không thể tải danh sách ưu đãi. Vui lòng thử lại sau.
                    </div>`;
            } finally {
                loadingEl.classList.add('d-none');
                listEl.classList.remove('d-none');
            }
        }

        function copyPromoCode(code, btn) {
            navigator.clipboard.writeText(code).then(() => {
                const originalHtml = btn.innerHTML;
                btn.innerHTML = '<i class="bi bi-check-lg me-1"></i> Đã chép!';
                btn.classList.remove('btn-primary');
                btn.classList.add('btn-success');
                setTimeout(() => {
                    btn.innerHTML = originalHtml;
                    btn.classList.remove('btn-success');
                    btn.classList.add('btn-primary');
                }, 1500);
            });
        }

        // Feature notice popup function
        function showFeatureNotice(featureName) {
            const titleEl = document.getElementById('featureNoticeTitle');
            const msgEl = document.getElementById('featureNoticeMessage');
            if (titleEl && featureName) {
                titleEl.textContent = featureName;
            }
            if (msgEl && featureName) {
                msgEl.textContent = `Tính năng "${featureName}" đang được xây dựng và phát triển. Stayly sẽ sớm cập nhật trong thời gian tới!`;
            }
            const modalEl = document.getElementById('featureNoticeModal');
            if (modalEl) {
                const modal = bootstrap.Modal.getOrCreateInstance(modalEl);
                modal.show();
            }
        }

        // Vanilla JS Toggle between Login, Register, and OTP views inside Auth Modal
        function toggleAuthModalView(view) {
            const loginBox = document.getElementById('loginFormContainer');
            const registerBox = document.getElementById('registerFormContainer');
            const otpBox = document.getElementById('registerOtpContainer');
            const alertBox = document.getElementById('modalAuthAlert');
            const otpAlertBox = document.getElementById('modalOtpAlert');

            if (alertBox) {
                alertBox.classList.add('d-none');
                alertBox.textContent = '';
            }
            if (otpAlertBox) {
                otpAlertBox.classList.add('d-none');
                otpAlertBox.textContent = '';
            }

            clearAllValidationErrors();

            if (view === 'register') {
                loginBox.classList.add('d-none');
                otpBox.classList.add('d-none');
                registerBox.classList.remove('d-none');
                const firstInput = registerBox.querySelector('input');
                if (firstInput) setTimeout(() => firstInput.focus(), 150);
            } else if (view === 'otp') {
                loginBox.classList.add('d-none');
                registerBox.classList.add('d-none');
                otpBox.classList.remove('d-none');
                const otpInput = document.getElementById('guestOtpInput');
                if (otpInput) setTimeout(() => otpInput.focus(), 150);
            } else {
                registerBox.classList.add('d-none');
                otpBox.classList.add('d-none');
                loginBox.classList.remove('d-none');
                const firstInput = loginBox.querySelector('input');
                if (firstInput) setTimeout(() => firstInput.focus(), 150);
            }
        }

        function setFieldError(fieldId, errorId, message) {
            const field = document.getElementById(fieldId);
            const errEl = document.getElementById(errorId);
            if (field) {
                field.classList.add('is-invalid');
            }
            if (errEl) {
                errEl.textContent = message;
                errEl.classList.add('show');
            }
        }

        function clearFieldError(fieldId, errorId) {
            const field = document.getElementById(fieldId);
            const errEl = document.getElementById(errorId);
            if (field) {
                field.classList.remove('is-invalid');
            }
            if (errEl) {
                errEl.textContent = '';
                errEl.classList.remove('show');
            }
        }

        function clearAllValidationErrors() {
            ['regFullName', 'regPhone', 'regEmail', 'regPassword', 'guestOtpInput'].forEach(id => {
                const el = document.getElementById(id);
                if (el) el.classList.remove('is-invalid');
                const err = document.getElementById(id + 'Error');
                if (err) {
                    err.textContent = '';
                    err.classList.remove('show');
                }
            });
        }

        // Setup real-time error clearing when user types
        document.addEventListener('DOMContentLoaded', function () {
            ['regFullName', 'regPhone', 'regEmail', 'regPassword', 'guestOtpInput'].forEach(id => {
                const el = document.getElementById(id);
                if (el) {
                    el.addEventListener('input', () => clearFieldError(id, id + 'Error'));
                    el.addEventListener('change', () => clearFieldError(id, id + 'Error'));
                }
            });
        });

        // Check localStorage.getItem('guestUser') on page load to dynamically adapt Navbar
        document.addEventListener('DOMContentLoaded', function () {
            syncNavbarAuth();
        });

        function syncNavbarAuth(isAfterLogin = false) {
            const serverUserStr = '@Html.Raw(Context.Session.GetString("userName") ?? "")';
            if (!serverUserStr && !isAfterLogin) {
                // Server session is dead or expired, clear local storage to stay in sync
                localStorage.removeItem('guestUser');
                localStorage.removeItem('guestToken');
            }

            const navAuthArea = document.getElementById('navAuthArea');
            if (!navAuthArea) return;

            const storedUserJson = localStorage.getItem('guestUser');
            if (storedUserJson) {
                try {
                    const user = JSON.parse(storedUserJson);
                    const displayName = user.fullName || user.email || 'Thành viên';
                    const initial = displayName.trim().charAt(0).toUpperCase();
                    const isOwner = user.role === 'OWNER';

                    navAuthArea.innerHTML = `
                        ${isOwner ? `
                            <a href="/Home/Dashboard" class="btn btn-sm btn-outline-primary rounded-pill px-3 me-1">
                                <i class="bi bi-grid-fill me-1"></i> Dashboard
                            </a>
                        ` : ''}
                        <a href="/Home/Profile" class="user-profile-badge" id="navUserProfileLink" title="Xem hồ sơ cá nhân">
                            <span class="user-avatar-circle">${initial}</span>
                            <span id="navUserName">${escapeHtml(displayName)}</span>
                        </a>
                        <button type="button" class="btn-stayly-logout" onclick="handleClientLogout()">
                            <i class="bi bi-box-arrow-right me-1"></i> Đăng xuất
                        </button>
                    `;
                } catch (e) {
                    localStorage.removeItem('guestUser');
                }
            }
        }

        // AJAX Login Handler
        async function handleAjaxLogin(event) {
            event.preventDefault();
            const emailInput = document.getElementById('loginEmail');
            const passwordInput = document.getElementById('loginPassword');
            const submitBtn = document.getElementById('loginSubmitBtn');
            const alertBox = document.getElementById('modalAuthAlert');

            alertBox.classList.add('d-none');
            const originalText = submitBtn.innerHTML;
            submitBtn.disabled = true;
            submitBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span> Đang đăng nhập...';

            try {
                const response = await fetch('/Home/AjaxLogin', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        email: emailInput.value.trim(),
                        password: passwordInput.value
                    })
                });

                const data = await response.json();

                if (response.ok && data.success) {
                    // Save to localStorage
                    localStorage.setItem('guestUser', JSON.stringify(data.user));
                    if (data.token) {
                        localStorage.setItem('guestToken', data.token);
                    }

                    // Close modal
                    const authModalEl = document.getElementById('authModal');
                    const modal = bootstrap.Modal.getInstance(authModalEl);
                    if (modal) modal.hide();

                    // Update Navbar immediately
                    syncNavbarAuth(true);
                    showStaylyToast('success', `Chào mừng ${data.user.fullName || 'bạn'} đã đăng nhập thành công!`);

                    // If owner, redirect to Dashboard, otherwise reload context if needed
                    if (data.user && data.user.role === 'OWNER') {
                        setTimeout(() => window.location.href = '/Home/Dashboard', 800);
                    } else if (window.location.pathname.includes('/Details') || window.location.pathname.includes('/Trips')) {
                        setTimeout(() => window.location.reload(), 800);
                    }
                } else {
                    alertBox.textContent = data.message || 'Đăng nhập không thành công. Vui lòng thử lại.';
                    alertBox.classList.remove('d-none');
                }
            } catch (err) {
                alertBox.textContent = 'Lỗi kết nối máy chủ khi đăng nhập. Vui lòng kiểm tra lại mạng.';
                alertBox.classList.remove('d-none');
            } finally {
                submitBtn.disabled = false;
                submitBtn.innerHTML = originalText;
            }
        }

        // State for pending guest registration and OTP timers
        let pendingGuestData = null;
        let guestOtpCountdownTimer = null;
        let guestResendCooldownTimer = null;

        // AJAX Register Handler - Step 1: Client Validation & OTP Send
        async function handleAjaxRegister(event) {
            event.preventDefault();
            clearAllValidationErrors();

            const fullNameInput = document.getElementById('regFullName');
            const phoneInput = document.getElementById('regPhone');
            const emailInput = document.getElementById('regEmail');
            const passwordInput = document.getElementById('regPassword');
            const dobInput = document.getElementById('regDob');
            const genderInput = document.getElementById('regGender');
            const submitBtn = document.getElementById('registerSubmitBtn');
            const alertBox = document.getElementById('modalAuthAlert');

            if (alertBox) alertBox.classList.add('d-none');

            const fullName = fullNameInput ? fullNameInput.value.trim() : '';
            const phone = phoneInput ? phoneInput.value.trim() : '';
            const email = emailInput ? emailInput.value.trim().toLowerCase() : '';
            const password = passwordInput ? passwordInput.value : '';
            const dob = dobInput ? dobInput.value || null : null;
            const gender = genderInput ? genderInput.value || 'M' : 'M';

            let hasError = false;

            // 1. Validate FullName
            const nameRegex = /^[a-zA-ZÀÁÂÃÈÉÊÌÍÒÓÔÕÙÚĂĐĨŨƠàáâãèéêìíòóôõùúăđĩũơƯĂẠẢẤẦẨẪẬẮẰẲẴẶẸẺẼỀỀỂưăạảấầẩẫậắằẳẵặẹẻẽềềểỄỆỈỊỌỎỐỒỔỖỘỚỜỞỠỢỤỦỨỪễệỉịọỏốồổỗộớờởỡợụủứừỬỮỰỲỴÝỶỸửữựỳỵỷỹ\s]+$/;
            if (!fullName || !nameRegex.test(fullName)) {
                setFieldError('regFullName', 'regFullNameError', 'Họ tên bắt buộc và chỉ chứa chữ cái, khoảng trắng.');
                hasError = true;
            }

            // 1.5 Validate DateOfBirth
            if (!dob) {
                setFieldError('regDob', 'regDobError', 'Vui lòng chọn ngày sinh.');
                hasError = true;
            }

            // 2. Validate Phone (VN 10 digits starting with 0)
            const phoneRegex = /^(0[35789])[0-9]{8}$/;
            if (!phone || !phoneRegex.test(phone)) {
                setFieldError('regPhone', 'regPhoneError', 'Số điện thoại không hợp lệ (10 chữ số, bắt đầu bằng 03, 05, 07, 08 hoặc 09).');
                hasError = true;
            }

            // 3. Validate Email
            const emailRegex = /^[^\s@@]+@@[^\s@@]+\.[^\s@@]+$/;
            if (!email || !emailRegex.test(email)) {
                setFieldError('regEmail', 'regEmailError', 'Địa chỉ email không đúng định dạng.');
                hasError = true;
            }

            // 4. Validate Password
            if (!password || password.length < 8) {
                setFieldError('regPassword', 'regPasswordError', 'Mật khẩu phải có tối thiểu 8 ký tự.');
                hasError = true;
            }

            if (hasError) return;

            // 5. Check duplicate Email & Phone with database
            const originalText = submitBtn.innerHTML;
            submitBtn.disabled = true;
            submitBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span> Đang kiểm tra thông tin...';

            try {
                const availRes = await fetch(`/Home/CheckContactAvailability?email=${encodeURIComponent(email)}&phone=${encodeURIComponent(phone)}`);
                if (availRes.ok) {
                    const availData = await availRes.json();
                    if (availData.emailExists) {
                        setFieldError('regEmail', 'regEmailError', 'Địa chỉ email này đã được sử dụng trên hệ thống.');
                        hasError = true;
                    }
                    if (availData.phoneExists) {
                        setFieldError('regPhone', 'regPhoneError', 'Số điện thoại này đã được sử dụng trên hệ thống.');
                        hasError = true;
                    }
                }
            } catch (e) {
                // If availability check fails to connect, fallback to proceeding
            }

            if (hasError) {
                submitBtn.disabled = false;
                submitBtn.innerHTML = originalText;
                return;
            }

            // 6. Send OTP to Guest Email
            submitBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span> Đang gửi mã OTP...';

            try {
                const otpRes = await fetch('/Home/RequestRegisterOtp', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ email: email, fullName: fullName, purpose: 'Register' })
                });

                const otpData = await otpRes.json();

                if (otpRes.ok) {
                    // Save pending data
                    pendingGuestData = { fullName, phone, email, password, dateOfBirth: dob, gender };

                    // Switch to OTP view
                    toggleAuthModalView('otp');
                    document.getElementById('guestOtpEmailDisplay').textContent = email;

                    // Start OTP Timers
                    startGuestOtpTimers();
                    showStaylyToast('info', `Mã OTP đã được gửi đến email ${email}. Vui lòng kiểm tra hộp thư!`);
                } else {
                    if (alertBox) {
                        alertBox.textContent = otpData.message || 'Không thể gửi mã xác thực OTP. Vui lòng thử lại sau.';
                        alertBox.classList.remove('d-none');
                    }
                }
            } catch (err) {
                if (alertBox) {
                    alertBox.textContent = 'Lỗi kết nối khi gửi mã OTP. Vui lòng kiểm tra lại mạng.';
                    alertBox.classList.remove('d-none');
                }
            } finally {
                submitBtn.disabled = false;
                submitBtn.innerHTML = originalText;
            }
        }

        // AJAX Register Handler - Step 2: Confirm OTP & Complete Account Creation
        async function handleAjaxOtpConfirm(event) {
            event.preventDefault();
            clearFieldError('guestOtpInput', 'guestOtpInputError');

            const otpInput = document.getElementById('guestOtpInput');
            const submitBtn = document.getElementById('confirmGuestOtpBtn');
            const alertBox = document.getElementById('modalOtpAlert');
            if (alertBox) alertBox.classList.add('d-none');

            const code = otpInput ? otpInput.value.trim() : '';

            if (!code || code.length !== 6 || !/^\d{6}$/.test(code)) {
                setFieldError('guestOtpInput', 'guestOtpInputError', 'Vui lòng nhập đủ 6 chữ số của mã OTP.');
                return;
            }

            if (!pendingGuestData) {
                toggleAuthModalView('register');
                return;
            }

            const originalText = submitBtn.innerHTML;
            submitBtn.disabled = true;
            submitBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span> Đang xác thực...';

            try {
                const response = await fetch('/Home/AjaxRegisterGuest', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        fullName: pendingGuestData.fullName,
                        phone: pendingGuestData.phone,
                        email: pendingGuestData.email,
                        password: pendingGuestData.password,
                        dateOfBirth: pendingGuestData.dateOfBirth,
                        gender: pendingGuestData.gender,
                        otpCode: code
                    })
                });

                const data = await response.json();

                if (response.ok && data.success) {
                    // Stop timers
                    clearInterval(guestOtpCountdownTimer);
                    clearInterval(guestResendCooldownTimer);

                    // Save to localStorage
                    localStorage.setItem('guestUser', JSON.stringify(data.user));
                    if (data.token) {
                        localStorage.setItem('guestToken', data.token);
                    }

                    // Close modal
                    const authModalEl = document.getElementById('authModal');
                    const modal = bootstrap.Modal.getInstance(authModalEl);
                    if (modal) modal.hide();

                    // Update Navbar
                    syncNavbarAuth(true);
                    showStaylyToast('success', `Tài khoản ${data.user.fullName} đã được kích hoạt thành công!`);

                    // Reset state
                    pendingGuestData = null;
                } else {
                    setFieldError('guestOtpInput', 'guestOtpInputError', data.message || 'Mã xác thực OTP không chính xác hoặc đã hết hiệu lực.');
                }
            } catch (err) {
                setFieldError('guestOtpInput', 'guestOtpInputError', 'Lỗi kết nối máy chủ khi xác thực OTP.');
            } finally {
                submitBtn.disabled = false;
                submitBtn.innerHTML = originalText;
            }
        }

        // Resend OTP for Guest
        async function resendGuestOtp() {
            if (!pendingGuestData) return;

            const resendBtn = document.getElementById('guestResendOtpBtn');
            resendBtn.disabled = true;

            try {
                const res = await fetch('/Home/RequestRegisterOtp', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ email: pendingGuestData.email, fullName: pendingGuestData.fullName, purpose: 'Register' })
                });

                if (res.ok) {
                    startGuestOtpTimers();
                    showStaylyToast('info', 'Mã OTP mới đã được gửi lại vào email của bạn!');
                    clearFieldError('guestOtpInput', 'guestOtpInputError');
                    const otpInput = document.getElementById('guestOtpInput');
                    if (otpInput) {
                        otpInput.value = '';
                        otpInput.focus();
                    }
                } else {
                    const data = await res.json();
                    showStaylyToast('info', data.message || 'Không thể gửi lại mã OTP.');
                }
            } catch (e) {
                showStaylyToast('info', 'Lỗi kết nối khi gửi lại mã OTP.');
            }
        }

        function startGuestOtpTimers() {
            clearInterval(guestOtpCountdownTimer);
            clearInterval(guestResendCooldownTimer);

            let expireSeconds = 600; // 10 minutes
            const countdownEl = document.getElementById('guestOtpCountdown');

            guestOtpCountdownTimer = setInterval(() => {
                expireSeconds--;
                if (expireSeconds <= 0) {
                    clearInterval(guestOtpCountdownTimer);
                    if (countdownEl) countdownEl.textContent = '00:00 (Đã hết hạn)';
                } else {
                    const mins = String(Math.floor(expireSeconds / 60)).padStart(2, '0');
                    const secs = String(expireSeconds % 60).padStart(2, '0');
                    if (countdownEl) countdownEl.textContent = `${mins}:${secs}`;
                }
            }, 1000);

            let cooldownSeconds = 60;
            const resendBtn = document.getElementById('guestResendOtpBtn');
            const resendCount = document.getElementById('guestResendCount');
            if (resendBtn) resendBtn.disabled = true;

            guestResendCooldownTimer = setInterval(() => {
                cooldownSeconds--;
                if (cooldownSeconds <= 0) {
                    clearInterval(guestResendCooldownTimer);
                    if (resendBtn) resendBtn.disabled = false;
                    if (resendCount) resendCount.textContent = 'Gửi lại ngay';
                } else {
                    if (resendCount) resendCount.textContent = `${cooldownSeconds}s`;
                }
            }, 1000);
        }

        // Client-side Logout Handler
        async function handleClientLogout() {
            localStorage.removeItem('guestUser');
            localStorage.removeItem('guestToken');

            try {
                await fetch('/Home/AjaxLogout', { method: 'POST' });
            } catch (e) {
                // ignore
            }

            const navAuthArea = document.getElementById('navAuthArea');
            if (navAuthArea) {
                navAuthArea.innerHTML = `
                    <button type="button" class="btn-stayly-login" id="navLoginBtn" data-bs-toggle="modal" data-bs-target="#authModal">
                        <i class="bi bi-person-circle"></i>
                        <span>Đăng nhập</span>
                    </button>
                `;
            }

            showStaylyToast('info', 'Bạn đã đăng xuất thành công khỏi hệ thống.');
            if (window.location.pathname.includes('/Profile') || window.location.pathname.includes('/Dashboard') || window.location.pathname.includes('/Trips')) {
                window.location.href = '/';
            }
        }

        // Helper: Floating Toast Notification
        function showStaylyToast(type, message) {
            const existingToast = document.querySelector('.stayly-toast');
            if (existingToast) existingToast.remove();

            const toast = document.createElement('div');
            toast.className = 'stayly-toast';
            const icon = type === 'success' ? 'bi-check-circle-fill text-success' : 'bi-info-circle-fill text-primary';
            toast.innerHTML = `
                <i class="bi ${icon} fs-4"></i>
                <div class="fw-medium text-dark small">${escapeHtml(message)}</div>
            `;
            document.body.appendChild(toast);
            setTimeout(() => {
                toast.style.transition = 'opacity 0.4s';
                toast.style.opacity = '0';
                setTimeout(() => toast.remove(), 400);
            }, 3500);
        }

        function escapeHtml(str) {
            if (!str) return '';
            return str.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;").replace(/'/g, "&#039;");
        }
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
