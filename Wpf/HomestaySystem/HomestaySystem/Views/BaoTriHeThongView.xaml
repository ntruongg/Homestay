<UserControl x:Class="HomestaySystem.Views.BaoTriHeThongView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:conv="clr-namespace:HomestaySystem.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="850" d:DesignWidth="1200">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <conv:ChuoiMauToBrushConverter x:Key="ColorToBrush"/>
        <conv:NullToVisibilityConverter x:Key="NullToVis"/>
    </UserControl.Resources>

    <Grid Background="{StaticResource MauNenChinh}">
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Hàng 0: Header & Thanh thư mục -->
                <RowDefinition Height="Auto"/> <!-- Hàng 1: 2 Khối Thao tác Sao lưu & Phục hồi -->
                <RowDefinition Height="*"/>    <!-- Hàng 2: Lịch sử & Thống kê dữ liệu -->
            </Grid.RowDefinitions>

            <!-- ================= HÀNG 0: TIÊU ĐỀ & THANH ĐƯỜNG DẪN THƯ MỤC ================= -->
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Tiêu đề trang & Nút hành động trên cùng -->
                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <StackPanel Orientation="Vertical" VerticalAlignment="Center">
                        <TextBlock Text="Sao lưu &amp; Phục hồi dữ liệu" FontSize="18" FontWeight="Bold" Foreground="{StaticResource MauChuTieuDe}"/>
                        <TextBlock Text="Quản lý sao lưu an toàn và phục hồi dữ liệu hệ thống" FontSize="12" Foreground="{StaticResource MauChuPhu}" Margin="0,3,0,0"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <!-- Chỉ thị trạng thái nhẹ nhàng -->
                        <Border Background="#F1F5F9" CornerRadius="8" Padding="10,6" Margin="0,0,10,0" BorderBrush="#E2E8F0" BorderThickness="1">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="7" Height="7" Fill="#10B981" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Máy chủ: Hoạt động" FontSize="11" FontWeight="SemiBold" Foreground="#334155"/>
                            </StackPanel>
                        </Border>

                        <!-- Nút Làm mới -->
                        <Button Command="{Binding TaiNhatKyCommand}" Cursor="Hand" ToolTip="Tải lại thông tin nhật ký"
                                Background="White" BorderBrush="#E2E8F0" BorderThickness="1" Padding="12,6">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="8"/>
                                </Style>
                            </Button.Resources>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🔄" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Làm mới" FontSize="11" FontWeight="SemiBold" Foreground="#334155"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Thanh chọn thư mục sao lưu mặc định (Thiết kế phẳng, tinh tế) -->
                <Border Grid.Row="1" Background="White" CornerRadius="10" Padding="14,10" BorderBrush="#E2E8F0" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="Thư mục sao lưu:" FontSize="12" FontWeight="SemiBold" Foreground="#334155" VerticalAlignment="Center" Margin="0,0,12,0"/>

                        <Border Grid.Column="1" Background="#F8FAFC" CornerRadius="6" Padding="10,6" Margin="0,0,12,0" BorderBrush="#E2E8F0" BorderThickness="1">
                            <TextBlock Text="{Binding DuongDanThuMucSaoLuu}" FontSize="12" Foreground="#475569" VerticalAlignment="Center"/>
                        </Border>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Command="{Binding MoThuMucSaoLuuCommand}" Cursor="Hand" Margin="0,0,8,0"
                                    Background="White" BorderBrush="#E2E8F0" BorderThickness="1" Padding="12,6">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="6"/>
                                    </Style>
                                </Button.Resources>
                                <TextBlock Text="Mở thư mục" FontSize="11" FontWeight="Medium" Foreground="#334155"/>
                            </Button>

                            <Button Command="{Binding DatThuMucMacDinhCommand}" Cursor="Hand"
                                    Background="White" BorderBrush="#E2E8F0" BorderThickness="1" Padding="12,6">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="6"/>
                                    </Style>
                                </Button.Resources>
                                <TextBlock Text="Đặt lại mặc định" FontSize="11" FontWeight="Medium" Foreground="#64748B"/>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- ================= HÀNG 1: 2 THẺ THAO TÁC (SAO LƯU & PHỤC HỒI) ================= -->
            <Grid Grid.Row="1" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- THẺ 1: SAO LƯU DỮ LIỆU -->
                <Border Grid.Column="0" Background="White" CornerRadius="12" BorderBrush="#E2E8F0" BorderThickness="1" Padding="18">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Tiêu đề thẻ -->
                        <StackPanel Grid.Row="0" Margin="0,0,0,14">
                            <TextBlock Text="Sao lưu dữ liệu" FontSize="15" FontWeight="Bold" Foreground="#0F172A"/>
                            <TextBlock Text="Tạo bản sao lưu dữ liệu mới nhất vào thư mục lưu trữ." FontSize="12" Foreground="#64748B" Margin="0,3,0,0"/>
                        </StackPanel>

                        <!-- Đường dẫn thư mục -->
                        <StackPanel Grid.Row="1" Margin="0,0,0,14">
                            <TextBlock Text="Thư mục ghi nhận tệp sao lưu:" FontSize="12.5" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,6"/>
                            <Border Background="#F8FAFC" CornerRadius="8" Padding="12,7" BorderBrush="#E2E8F0" BorderThickness="1">
                                <TextBox Text="{Binding DuongDanThuMucSaoLuu, UpdateSourceTrigger=PropertyChanged}"
                                         BorderThickness="0" Background="Transparent" FontSize="13.5" Foreground="#0F172A"/>
                            </Border>
                        </StackPanel>

                        <!-- Ghi chú ngắn gọn -->
                        <Border Grid.Row="2" Background="#F8FAFC" CornerRadius="8" Padding="12,10" Margin="0,0,0,16" BorderBrush="#E2E8F0" BorderThickness="1">
                            <TextBlock Text="Dữ liệu sao lưu bao gồm: cơ sở lưu trú, đơn đặt phòng, tài khoản và doanh thu."
                                       FontSize="12" Foreground="#64748B" TextWrapping="Wrap"/>
                        </Border>

                        <!-- Nút Sao lưu -->
                        <Button Grid.Row="3" Command="{Binding SaoLuuCSDLCommand}" Cursor="Hand" Height="40"
                                Background="{StaticResource MauStaylyPrimary}" Foreground="White"
                                FontSize="13" FontWeight="Bold">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="8"/>
                                </Style>
                            </Button.Resources>
                            <TextBlock Text="Tạo bản sao lưu"/>
                        </Button>
                    </Grid>
                </Border>

                <!-- THẺ 2: PHỤC HỒI DỮ LIỆU -->
                <Border Grid.Column="2" Background="White" CornerRadius="12" BorderBrush="#E2E8F0" BorderThickness="1" Padding="18">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Tiêu đề thẻ -->
                        <StackPanel Grid.Row="0" Margin="0,0,0,14">
                            <TextBlock Text="Phục hồi dữ liệu" FontSize="15" FontWeight="Bold" Foreground="#0F172A"/>
                            <TextBlock Text="Khôi phục lại dữ liệu hệ thống từ tệp sao lưu đã chọn." FontSize="12" Foreground="#64748B" Margin="0,3,0,0"/>
                        </StackPanel>

                        <!-- Chọn tệp phục hồi -->
                        <StackPanel Grid.Row="1" Margin="0,0,0,14">
                            <TextBlock Text="Tệp sao lưu cần phục hồi:" FontSize="12.5" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,6"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="#F8FAFC" CornerRadius="8" Padding="12,7" BorderBrush="#E2E8F0" BorderThickness="1">
                                    <TextBox Text="{Binding DuongDanTepPhucHoi, UpdateSourceTrigger=PropertyChanged}"
                                             BorderThickness="0" Background="Transparent" FontSize="13.5" Foreground="#0F172A"/>
                                </Border>
                                <Button Grid.Column="2" Command="{Binding DuyetTepPhucHoiCommand}" Cursor="Hand"
                                        Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1" Padding="14,7">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="8"/>
                                        </Style>
                                    </Button.Resources>
                                    <TextBlock Text="Duyệt tệp..." FontSize="12.5" FontWeight="SemiBold" Foreground="#334155"/>
                                </Button>
                            </Grid>
                        </StackPanel>

                        <!-- Ghi chú lưu ý -->
                        <Border Grid.Row="2" Background="#FEF2F2" CornerRadius="8" Padding="12,10" Margin="0,0,0,16" BorderBrush="#FEE2E2" BorderThickness="1">
                            <TextBlock Text="Lưu ý: Quá trình phục hồi sẽ thay thế dữ liệu hiện tại bằng dữ liệu trong tệp sao lưu."
                                       FontSize="12" Foreground="#B91C1C" TextWrapping="Wrap"/>
                        </Border>

                        <!-- Nút Phục hồi -->
                        <Button Grid.Row="3" Command="{Binding PhucHoiCSDLCommand}" Cursor="Hand" Height="40"
                                Background="#DC2626" Foreground="White"
                                FontSize="13" FontWeight="Bold">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="8"/>
                                </Style>
                            </Button.Resources>
                            <TextBlock Text="Phục hồi dữ liệu"/>
                        </Button>
                    </Grid>
                </Border>
            </Grid>

            <!-- ================= HÀNG 2: LỊCH SỬ SAO LƯU & THỐNG KÊ DỮ LIỆU ================= -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="6*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="4*"/>
                </Grid.ColumnDefinitions>

                <!-- BẢNG LỊCH SỬ SAO LƯU -->
                <Border Grid.Column="0" Background="White" CornerRadius="12" BorderBrush="#E2E8F0" BorderThickness="1" Padding="16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Header bảng -->
                        <TextBlock Grid.Row="0" Text="Nhật ký sao lưu &amp; bảo trì" FontSize="14" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,12"/>

                        <!-- Danh sách nhật ký -->
                        <ListBox Grid.Row="1" ItemsSource="{Binding DanhSachNhatKy}"
                                 BorderThickness="0" Background="Transparent" ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="0,0,0,6"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="itemBorder" Background="#F8FAFC" CornerRadius="8" BorderBrush="#E2E8F0" BorderThickness="1" Padding="12,9" Cursor="Hand">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="• " FontSize="14" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding}" FontSize="12.5" Foreground="#334155" VerticalAlignment="Center"/>
                                                    </Grid>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="itemBorder" Property="Background" Value="#F1F5F9"/>
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="itemBorder" Property="Background" Value="#E0F2FE"/>
                                                        <Setter TargetName="itemBorder" Property="BorderBrush" Value="#BAE6FD"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                        </ListBox>
                    </Grid>
                </Border>

                <!-- THỐNG KÊ DỮ LIỆU HỆ THỐNG -->
                <Border Grid.Column="2" Background="White" CornerRadius="12" BorderBrush="#E2E8F0" BorderThickness="1" Padding="16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Header -->
                        <TextBlock Grid.Row="0" Text="Tình trạng dữ liệu" FontSize="14" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,12"/>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <!-- Mục 1: CoSoLuuTru -->
                                <Border Background="#F8FAFC" CornerRadius="8" Padding="14,11" Margin="0,0,0,8" BorderBrush="#E2E8F0" BorderThickness="1">
                                    <Grid>
                                        <TextBlock Text="Cơ sở lưu trú" FontSize="12.5" FontWeight="SemiBold" Foreground="#334155"/>
                                        <TextBlock HorizontalAlignment="Right" Text="128 bản ghi" FontSize="12.5" Foreground="#0077B6" FontWeight="Bold"/>
                                    </Grid>
                                </Border>

                                <!-- Mục 2: TaiKhoan -->
                                <Border Background="#F8FAFC" CornerRadius="8" Padding="14,11" Margin="0,0,0,8" BorderBrush="#E2E8F0" BorderThickness="1">
                                    <Grid>
                                        <TextBlock Text="Tài khoản người dùng" FontSize="12.5" FontWeight="SemiBold" Foreground="#334155"/>
                                        <TextBlock HorizontalAlignment="Right" Text="1,428 tài khoản" FontSize="12.5" Foreground="#0077B6" FontWeight="Bold"/>
                                    </Grid>
                                </Border>

                                <!-- Mục 3: DonDatPhong -->
                                <Border Background="#F8FAFC" CornerRadius="8" Padding="14,11" Margin="0,0,0,8" BorderBrush="#E2E8F0" BorderThickness="1">
                                    <Grid>
                                        <TextBlock Text="Đơn đặt phòng" FontSize="12.5" FontWeight="SemiBold" Foreground="#334155"/>
                                        <TextBlock HorizontalAlignment="Right" Text="4,850 đơn" FontSize="12.5" Foreground="#0077B6" FontWeight="Bold"/>
                                    </Grid>
                                </Border>

                                <!-- Mục 4: KhuyenMai -->
                                <Border Background="#F8FAFC" CornerRadius="8" Padding="14,11" Margin="0,0,0,8" BorderBrush="#E2E8F0" BorderThickness="1">
                                    <Grid>
                                        <TextBlock Text="Mã ưu đãi" FontSize="12.5" FontWeight="SemiBold" Foreground="#334155"/>
                                        <TextBlock HorizontalAlignment="Right" Text="24 mã" FontSize="12.5" Foreground="#0077B6" FontWeight="Bold"/>
                                    </Grid>
                                </Border>

                                <!-- Mục 5: GiaoDich -->
                                <Border Background="#F8FAFC" CornerRadius="8" Padding="14,11" BorderBrush="#E2E8F0" BorderThickness="1">
                                    <Grid>
                                        <TextBlock Text="Dữ liệu giao dịch" FontSize="12.5" FontWeight="SemiBold" Foreground="#334155"/>
                                        <TextBlock HorizontalAlignment="Right" Text="Đã đối soát" FontSize="12.5" Foreground="#10B981" FontWeight="Bold"/>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
