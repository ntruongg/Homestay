<UserControl x:Class="HomestaySystem.Views.QuanLyDonDatView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:conv="clr-namespace:HomestaySystem.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="850" d:DesignWidth="1200">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <conv:ChuoiMauToBrushConverter x:Key="ColorToBrush"/>
        <conv:NullToVisibilityConverter x:Key="NullToVis"/>
        <conv:TrangThaiDonToColorConverter x:Key="TrangThaiDonToColorConverter"/>
        <conv:TrangThaiDonToBgConverter x:Key="TrangThaiDonToBgConverter"/>
    </UserControl.Resources>

    <Grid Background="{StaticResource MauNenChinh}">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Hàng 0: Header & Bộ lọc đơn đặt -->
                <RowDefinition Height="Auto"/> <!-- Hàng 1: 4 Thẻ Card KPI -->
                <RowDefinition Height="*"/>    <!-- Hàng 2: Vùng chứa bảng BẮT BUỘC DÙNG DÒNG SAO '*' -->
            </Grid.RowDefinitions>

            <!-- ================= HÀNG 0: HEADER & THANH TÌM KIẾM / BỘ LỌC ================= -->
            <Border Grid.Row="0" Margin="0,0,0,16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Header bar -->
                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="40" Height="40" CornerRadius="20" Background="{StaticResource MauStaylyPrimaryLight}" Margin="0,0,12,0">
                                <TextBlock Text="📑" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Quản Lý Giao Dịch &amp; Hoàn Tiền" FontSize="18" FontWeight="Bold" Foreground="{StaticResource MauChuTieuDe}"/>
                                <TextBlock Text="Giám sát luồng đặt phòng, trạng thái cổng thanh toán và thẩm định yêu cầu hoàn tiền" FontSize="12" Foreground="{StaticResource MauChuPhu}"/>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Border Background="#ECFDF5" CornerRadius="16" Padding="12,6" Margin="0,0,10,0">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="8" Height="8" Fill="{StaticResource MauStaylyGreen}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Auto-Refund Gateway: BẬT" FontSize="11" FontWeight="Bold" Foreground="{StaticResource MauStaylyGreen}"/>
                                </StackPanel>
                            </Border>
                            <Button Command="{Binding TaiDuLieuCommand}" Cursor="Hand" ToolTip="Tải lại danh sách đơn đặt"
                                    Background="White" BorderBrush="{StaticResource MauVien}" BorderThickness="1" Padding="14,6">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="20"/>
                                    </Style>
                                </Button.Resources>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🔄" FontSize="12" Margin="0,0,6,0"/>
                                    <TextBlock Text="Tải lại dữ liệu" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource MauChuChinh}"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- Filter Ribbon: Ô tìm kiếm + ComboBox trạng thái -->
                    <Border Grid.Row="1" Background="White" CornerRadius="16" Padding="14,10" BorderBrush="{StaticResource MauVien}" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="220"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Ô tìm kiếm viên thuốc -->
                            <Border Grid.Column="0" Background="#F1F5F9" CornerRadius="20" Padding="12,6" BorderBrush="{StaticResource MauVien}" BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="🔍" FontSize="13" Margin="4,0,8,0" VerticalAlignment="Center"/>
                                    <TextBox Grid.Column="1" Text="{Binding TuKhoaTimKiem, UpdateSourceTrigger=PropertyChanged}"
                                             BorderThickness="0" Background="Transparent" VerticalAlignment="Center"
                                             FontSize="12" Foreground="{StaticResource MauChuChinh}"/>
                                    <TextBlock Grid.Column="1" Text="Tìm kiếm theo mã đơn (DDP...), tên khách, cơ sở, email, SĐT..." FontSize="12" Foreground="#94A3B8"
                                               VerticalAlignment="Center" Margin="2,0,0,0" IsHitTestVisible="False">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding TuKhoaTimKiem}" Value="">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding TuKhoaTimKiem}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </Border>

                            <!-- ComboBox trạng thái đơn đặt chuẩn bo tròn 8px hiện đại không lộ khung xám -->
                            <ComboBox Grid.Column="2" SelectedValue="{Binding BoLocTrangThai}" SelectedValuePath="Tag" Height="36" VerticalAlignment="Center">
                                <ComboBoxItem Content="Tất cả trạng thái" Tag="TatCa" IsSelected="True"/>
                                <ComboBoxItem Content="Yêu cầu hoàn tiền (Cần duyệt)" Tag="RefundRequested"/>
                                <ComboBoxItem Content="Đang lưu trú (Checked-in)" Tag="CheckedIn"/>
                                <ComboBoxItem Content="Đã Check-out (Hoàn thành)" Tag="CheckedOut"/>
                                <ComboBoxItem Content="Chờ xác nhận" Tag="Pending"/>
                                <ComboBoxItem Content="Đã hủy" Tag="Cancelled"/>
                            </ComboBox>

                            <!-- Badge kết quả -->
                            <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Background="{StaticResource MauStaylyPrimaryLight}" CornerRadius="12" Padding="12,6">
                                    <TextBlock Text="{Binding DanhSachHienThi.Count, StringFormat='{}Hiển thị {0} đơn hàng'}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource MauStaylyPrimary}"/>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- ================= HÀNG 1: 4 THẺ CARD KPI (FORMAT CHUẨN THỐNG NHẤT) ================= -->
            <Grid Grid.Row="1" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- KPI 1: Tổng giá trị giao dịch -->
                <Border Grid.Column="0" Background="White" CornerRadius="12" BorderBrush="#E2E8F0" BorderThickness="1" Padding="14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="TỔNG ĐƠN ĐẶT PHÒNG" FontSize="11" FontWeight="Bold" Foreground="#64748B" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding TongSoDon, FallbackValue='0'}" FontSize="22" FontWeight="Black" Foreground="#0F172A" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="Giao dịch sàn Stayly" FontSize="11" Foreground="#0194F3" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <Border Grid.Column="1" Width="42" Height="42" CornerRadius="21" Background="#E0F2FE" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="💳" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- KPI 2: Đơn đặt phòng thành công -->
                <Border Grid.Column="2" Background="White" CornerRadius="12" BorderBrush="#E2E8F0" BorderThickness="1" Padding="14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="ĐƠN ĐẶT HOÀN TẤT" FontSize="11" FontWeight="Bold" Foreground="#64748B" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding SoDonHoanThanh, FallbackValue='0'}" FontSize="22" FontWeight="Black" Foreground="#10B981" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="Khách đã hoàn thành kỳ nghỉ" FontSize="11" Foreground="#64748B" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <Border Grid.Column="1" Width="42" Height="42" CornerRadius="21" Background="#ECFDF5" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="🛌" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- KPI 3: Cần xử lý hoàn tiền -->
                <Border Grid.Column="4" Background="White" CornerRadius="12" BorderBrush="#E2E8F0" BorderThickness="1" Padding="14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="CẦN XỬ LÝ HOÀN TIỀN" FontSize="11" FontWeight="Bold" Foreground="#64748B" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding SoDonYeuCauHoanTien, FallbackValue='0'}" FontSize="22" FontWeight="Black" Foreground="#EF4444" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="Yêu cầu chờ thẩm định" FontSize="11" Foreground="#64748B" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <Border Grid.Column="1" Width="42" Height="42" CornerRadius="21" Background="#FEE2E2" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="💸" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- KPI 4: Đơn chờ xác nhận -->
                <Border Grid.Column="6" Background="White" CornerRadius="12" BorderBrush="#E2E8F0" BorderThickness="1" Padding="14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="CHỜ CHỦ NHÀ XÁC NHẬN" FontSize="11" FontWeight="Bold" Foreground="#64748B" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding SoDonChoXacNhan, FallbackValue='0'}" FontSize="22" FontWeight="Black" Foreground="#F59E0B" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="Đang xử lý xếp phòng" FontSize="11" Foreground="#64748B" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <Border Grid.Column="1" Width="42" Height="42" CornerRadius="21" Background="#FEF3C7" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="⏳" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <!-- ================= HÀNG 2: BẢNG KÊ ĐƠN ĐẶT PHÒNG FULL-WIDTH ================= -->
            <Border Grid.Row="2" Style="{StaticResource StaylyCard}" Padding="0" ClipToBounds="True">
                <DataGrid ItemsSource="{Binding DanhSachHienThi}" SelectedItem="{Binding DonDangChon}"
                              Style="{StaticResource StaylyDataGridStyle}"
                              IsReadOnly="True"
                              RowHeight="54"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              CanUserResizeColumns="True"
                              CanUserSortColumns="True">
                        <DataGrid.Columns>
                            <!-- Cột Mã đơn: Tự động canh theo mã đơn dài nhất -->
                            <DataGridTextColumn Header="MÃ ĐƠN" Binding="{Binding MaDonHienThi}" Width="Auto" MinWidth="110">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="Foreground" Value="{StaticResource MauStaylyPrimary}"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Padding" Value="12,0"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Cột Khách hàng: Tự động canh theo tên khách hàng dài nhất -->
                            <DataGridTextColumn Header="KHÁCH HÀNG" Binding="{Binding TenKhachHang}" Width="Auto" MinWidth="170">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="Foreground" Value="{StaticResource MauChuTieuDe}"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Padding" Value="12,0"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Cột Chỗ nghỉ Homestay: Mở rộng tối thiểu 240px -->
                            <DataGridTextColumn Header="CƠ SỞ HOMESTAY" Binding="{Binding TenCoSo}" Width="*" MinWidth="240">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource MauChuChinh}"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Padding" Value="12,0"/>
                                        <Setter Property="ToolTip" Value="{Binding TenCoSo}"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Cột Nhận / Trả phòng: Tự động canh theo chuỗi thời gian -->
                            <DataGridTextColumn Header="THỜI GIAN LƯU TRÚ" Binding="{Binding NgayNhanTraHienThi}" Width="Auto" MinWidth="170">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource MauChuPhu}"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Padding" Value="12,0"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Cột Tổng tiền (Căn phải, Bold): Tự động canh theo số tiền -->
                            <DataGridTextColumn Header="TỔNG TIỀN" Binding="{Binding TongTienDinhDang}" Width="Auto" MinWidth="130">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="Foreground" Value="{StaticResource MauChuTieuDe}"/>
                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Padding" Value="0,0,14,0"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Cột Cổng thanh toán: Tự động canh -->
                            <DataGridTextColumn Header="CỔNG TT" Binding="{Binding CongThanhToan}" Width="Auto" MinWidth="110">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource MauStaylyPrimary}"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Padding" Value="12,0"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Cột Trạng thái đơn: Tự động canh theo nhãn trạng thái -->
                            <DataGridTemplateColumn Header="TRẠNG THÁI" Width="Auto" MinWidth="145">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="10" Padding="10,4" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#F1F5F9"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding TrangThai}" Value="RefundRequested">
                                                            <Setter Property="Background" Value="#FEF3C7"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding TrangThai}" Value="HoanThanh">
                                                            <Setter Property="Background" Value="#ECFDF5"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding TrangThai}" Value="CheckedOut">
                                                            <Setter Property="Background" Value="#ECFDF5"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding TrangThai}" Value="DangO">
                                                            <Setter Property="Background" Value="#ECFDF5"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding TrangThai}" Value="DaXacNhan">
                                                            <Setter Property="Background" Value="#ECFDF5"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding TrangThai}" Value="ChoXacNhan">
                                                            <Setter Property="Background" Value="#FEF3C7"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding TrangThai}" Value="DaHuy">
                                                            <Setter Property="Background" Value="#FEE2E2"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding TrangThai}" Value="Cancelled">
                                                            <Setter Property="Background" Value="#FEE2E2"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding TenHienThiTrangThai}" FontSize="11" FontWeight="Bold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#475569"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding TrangThai}" Value="RefundRequested">
                                                                <Setter Property="Foreground" Value="#D97706"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding TrangThai}" Value="HoanThanh">
                                                                <Setter Property="Foreground" Value="{StaticResource MauStaylyGreen}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding TrangThai}" Value="CheckedOut">
                                                                <Setter Property="Foreground" Value="{StaticResource MauStaylyGreen}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding TrangThai}" Value="DangO">
                                                                <Setter Property="Foreground" Value="{StaticResource MauStaylyGreen}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding TrangThai}" Value="DaXacNhan">
                                                                <Setter Property="Foreground" Value="{StaticResource MauStaylyGreen}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding TrangThai}" Value="ChoXacNhan">
                                                                <Setter Property="Foreground" Value="#D97706"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding TrangThai}" Value="DaHuy">
                                                                <Setter Property="Foreground" Value="{StaticResource MauStaylyRed}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding TrangThai}" Value="Cancelled">
                                                                <Setter Property="Foreground" Value="{StaticResource MauStaylyRed}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Cột 8: THAO TÁC / THẨM ĐỊNH -->
                            <DataGridTemplateColumn Header="THAO TÁC" Width="Auto" MinWidth="135">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="⚖️ Thẩm định"
                                                Command="{Binding DataContext.XemHoSoCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource StaylyBtnSmall}"
                                                Background="{StaticResource MauStaylyPrimaryLight}"
                                                Foreground="{StaticResource MauStaylyPrimaryDark}"
                                                BorderThickness="0" FontWeight="Bold" FontSize="11" Padding="12,6"
                                                HorizontalAlignment="Center" VerticalAlignment="Center" Cursor="Hand"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
        </Grid>

        <!-- ================= MODAL DIALOG: THẨM ĐỊNH HOÀN TIỀN & CHI TIẾT ĐƠN ĐẶT (HIỆN NGAY GIỮA MÀN HÌNH) ================= -->
        <Grid Visibility="{Binding DonDangChon, Converter={StaticResource NullToVis}, FallbackValue=Collapsed}"
              HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <!-- Nền mờ: Nhấp chuột ra ngoài để đóng chi tiết -->
            <Border Background="#99000000" Cursor="Hand" ToolTip="Nhấp vào vùng ngoài để đóng hồ sơ">
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftClick" Command="{Binding DongHoSoCommand}"/>
                </Border.InputBindings>
            </Border>
            <Border Background="White" CornerRadius="16" Width="560" MaxHeight="740" Padding="22" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" Opacity="0.25" BlurRadius="24" ShadowDepth="4"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Header Modal -->
                        <RowDefinition Height="*"/>   <!-- Vùng nội dung cuộn -->
                    </Grid.RowDefinitions>

                    <!-- Header Modal có nút [✕ Đóng] -->
                    <Border Grid.Row="0" BorderBrush="{StaticResource MauVien}" BorderThickness="0,0,0,1" Padding="0,0,0,12" Margin="0,0,0,14">
                        <DockPanel LastChildFill="True">
                            <Button DockPanel.Dock="Right" Command="{Binding DongHoSoCommand}"
                                    Content="✕ Đóng" ToolTip="Đóng chi tiết để xem danh sách toàn màn hình"
                                    Background="#F1F5F9" Foreground="#64748B" BorderThickness="0"
                                    FontWeight="Bold" FontSize="12" Padding="14,6" Cursor="Hand" Margin="8,0,0,0">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="6"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                            <Border DockPanel.Dock="Right" Background="{StaticResource MauStaylyPrimaryLight}" CornerRadius="10" Padding="10,3" VerticalAlignment="Center">
                                <TextBlock Text="{Binding DonDangChon.MaDonHienThi, FallbackValue='DDP000001'}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource MauStaylyPrimary}"/>
                            </Border>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="⚖️" FontSize="18" Margin="0,0,8,0"/>
                                <TextBlock Text="THẨM ĐỊNH HOÀN TIỀN &amp; CHI TIẾT ĐƠN" FontSize="14.5" FontWeight="Bold" Foreground="{StaticResource MauChuTieuDe}"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- VÙNG NỘI DUNG CUỘN CHI TIẾT -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,6,0">
                        <StackPanel>
                            <!-- Profile khách hàng -->
                            <Border Background="#F8FAFC" CornerRadius="12" Padding="14,12" Margin="0,0,0,14">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="44" Height="44" CornerRadius="22" Background="{StaticResource MauStaylyPrimaryLight}" Margin="0,0,12,0">
                                        <TextBlock Text="🧑" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding DonDangChon.TenKhachHang, FallbackValue='Chưa chọn đơn hàng'}" FontSize="14.5" FontWeight="Bold" Foreground="{StaticResource MauChuTieuDe}"/>
                                        <TextBlock Text="{Binding DonDangChon.SoDienThoaiKhach, FallbackValue='0918 345 678'}" FontSize="12.5" Foreground="{StaticResource MauChuPhu}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <Border Grid.Column="2" Background="#FEF3C7" CornerRadius="10" Padding="10,4" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding DonDangChon.HangThanhVienKhach, FallbackValue='Hội viên Vàng'}" FontSize="11" FontWeight="Bold" Foreground="#D97706"/>
                                    </Border>
                                </Grid>
                            </Border>

                            <!-- Thông tin tài khoản ngân hàng của khách để hoàn tiền -->
                            <Border Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="1" CornerRadius="12" Padding="14,10" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="TÀI KHOẢN NGÂN HÀNG HOÀN TIỀN (KHÁCH):" FontSize="11.5" FontWeight="Bold" Foreground="#15803D" Margin="0,0,0,4"/>
                                    <TextBlock Text="{Binding DonDangChon.ThongTinNganHangKhachHienThi, FallbackValue='Chưa cung cấp'}" FontSize="13" FontWeight="Bold" Foreground="#1E293B"/>
                                    <TextBlock Text="{Binding DonDangChon.LyDoHoanTien, StringFormat='Lý do: {0}'}" FontSize="12" Foreground="#64748B" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- Đối soát chính sách hủy phòng -->
                            <Border Background="#F1F5F9" CornerRadius="12" Padding="14,12" Margin="0,0,0,14">
                                <StackPanel>
                                    <Grid Margin="0,0,0,8">
                                        <TextBlock Text="QUY TẮC ĐỐI SOÁT CHÍNH SÁCH" FontSize="12" FontWeight="Bold" Foreground="{StaticResource MauChuTieuDe}"/>
                                        <Border HorizontalAlignment="Right" Background="#ECFDF5" CornerRadius="8" Padding="8,3">
                                            <TextBlock Text="Hợp lệ 100%" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource MauStaylyGreen}"/>
                                        </Border>
                                    </Grid>
                                    
                                    <Border Background="White" CornerRadius="8" Padding="12,8" Margin="0,0,0,8">
                                        <TextBlock Text="{Binding DonDangChon.ChinhSachHuy, FallbackValue='Miễn phí 100% hủy phòng trước 07 ngày; hủy sau 7 ngày mất 50% tiền cọc.'}"
                                                   FontSize="12" Foreground="{StaticResource MauChuPhu}" TextWrapping="Wrap"/>
                                    </Border>

                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Thời điểm khách hủy:" FontSize="13" Foreground="{StaticResource MauChuPhu}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock Grid.Column="1" HorizontalAlignment="Right" Text="{Binding DonDangChon.ThoiDiemKhachHuy, FallbackValue='Trước 09 ngày'}" FontSize="13.5" FontWeight="Bold" Foreground="{StaticResource MauChuChinh}" TextAlignment="Right" TextWrapping="Wrap"/>
                                    </Grid>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Kết quả thẩm định:" FontSize="13" Foreground="{StaticResource MauChuPhu}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock Grid.Column="1" HorizontalAlignment="Right" Text="{Binding DonDangChon.KetQuaThamDinh, FallbackValue='Đủ điều kiện hoàn 100%'}" FontSize="13.5" FontWeight="Bold" Foreground="{StaticResource MauStaylyGreen}" TextAlignment="Right" TextWrapping="Wrap"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Bảng chiết tính dòng tiền hoàn -->
                            <Border Background="#F8FAFC" CornerRadius="12" Padding="14,12" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="BẢNG CHIẾT TÍNH DÒNG TIỀN HOÀN" FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource MauChuTieuDe}" Margin="0,0,0,10"/>
                                    
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Tổng tiền thanh toán:" FontSize="13" Foreground="{StaticResource MauChuPhu}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock Grid.Column="1" HorizontalAlignment="Right" Text="{Binding DonDangChon.TongTienDinhDang, FallbackValue='0 đ'}" FontSize="14" FontWeight="Bold" Foreground="{StaticResource MauChuChinh}" TextAlignment="Right"/>
                                    </Grid>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Phí xử lý giao dịch sàn:" FontSize="13" Foreground="{StaticResource MauChuPhu}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock Grid.Column="1" HorizontalAlignment="Right" Text="0 đ (Miễn phí)" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource MauStaylyGreen}" TextAlignment="Right"/>
                                    </Grid>
                                    <Border BorderBrush="{StaticResource MauVien}" BorderThickness="0,1,0,0" Margin="0,6,0,10"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="SỐ TIỀN HOÀN THỰC TẾ:" FontSize="13.5" FontWeight="Bold" Foreground="{StaticResource MauChuTieuDe}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock Grid.Column="1" HorizontalAlignment="Right" Text="{Binding DonDangChon.TongTienDinhDang, FallbackValue='0 đ'}" FontSize="16.5" FontWeight="Black" Foreground="{StaticResource MauStaylyPrimary}" TextAlignment="Right"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Các nút hành động quản trị -->
                            <StackPanel>
                                <!-- NÚT CHỈNH SỬA THÔNG TIN ĐƠN ĐẶT RIÊNG BIỆT -->
                                <Button Command="{Binding MoDialogChinhSuaCommand}" Cursor="Hand" Margin="0,0,0,10"
                                        Background="{StaticResource MauStaylyPrimary}" Foreground="White"
                                        FontSize="13" FontWeight="Bold" Height="40" ToolTip="Mở form chỉnh sửa thông tin đơn đặt phòng">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="20"/>
                                        </Style>
                                    </Button.Resources>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <TextBlock Text="✏️ " FontSize="13"/>
                                        <TextBlock Text="Chỉnh Sửa Thông Tin Đơn Đặt"/>
                                    </StackPanel>
                                </Button>

                                <Button Command="{Binding MoDialogHoanTienCommand}" Cursor="Hand" Margin="0,0,0,10"
                                        Background="{StaticResource MauStaylyGreen}" Foreground="White"
                                        FontSize="13" FontWeight="Bold" Height="40">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="20"/>
                                        </Style>
                                    </Button.Resources>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <TextBlock Text="✔ " FontSize="13"/>
                                        <TextBlock Text="Phê Duyệt Hoàn Tiền Qua Cổng"/>
                                    </StackPanel>
                                </Button>

                                <Button Command="{Binding MoDialogTuChoiHoanTienCommand}" Cursor="Hand"
                                        Background="{StaticResource MauStaylyRed}" Foreground="White"
                                        FontSize="13" FontWeight="Bold" Height="40">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="20"/>
                                        </Style>
                                    </Button.Resources>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <TextBlock Text="✕ " FontSize="13"/>
                                        <TextBlock Text="Từ Chối Yêu Cầu Hoàn Tiền"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- ================= DIALOG DUYỆT HOÀN TIỀN ================= -->
        <Grid Visibility="{Binding HienThiDialogHoanTien, Converter={StaticResource BoolToVis}}"
              HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <!-- Nền mờ: Nhấp chuột ra ngoài để hủy -->
            <Border Background="#99000000" Cursor="Hand" ToolTip="Nhấp vào vùng ngoài để đóng">
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftClick" Command="{Binding HuyDialogHoanTienCommand}"/>
                </Border.InputBindings>
            </Border>
            <Border Background="White" CornerRadius="16" Width="530" Padding="26" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="XÁC NHẬN PHÊ DUYỆT HOÀN TIỀN" FontSize="16" FontWeight="Bold" Foreground="{StaticResource MauStaylyGreen}" Margin="0,0,0,8"/>
                    <TextBlock Grid.Row="1" Text="Lệnh hoàn tiền chuyển khoản trực tiếp về tài khoản khách hàng:" FontSize="13" Foreground="{StaticResource MauChuChinh}" Margin="0,0,0,14"/>

                    <StackPanel Grid.Row="2" Margin="0,0,0,18">
                        <!-- Thông tin tài khoản ngân hàng thụ hưởng của khách -->
                        <Border Background="#F0FDF4" BorderBrush="#86EFAC" BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="THÔNG TIN TÀI KHOẢN NHẬN TIỀN CỦA KHÁCH:" FontSize="11.5" FontWeight="Bold" Foreground="#15803D" Margin="0,0,0,6"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Ngân hàng:" Foreground="#64748B" FontSize="12.5" Margin="0,0,8,3"/>
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding DonDangChon.TenNganHangKhach, FallbackValue='Chưa cung cấp'}" FontWeight="Bold" Foreground="#1E293B" FontSize="12.5"/>
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Số tài khoản:" Foreground="#64748B" FontSize="12.5" Margin="0,0,8,3"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding DonDangChon.SoTaiKhoanKhach, FallbackValue='Chưa cung cấp'}" FontWeight="Bold" Foreground="#2563EB" FontSize="13.5"/>
                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Chủ tài khoản:" Foreground="#64748B" FontSize="12.5"/>
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding DonDangChon.TenChuTaiKhoanKhach, FallbackValue='Chưa cung cấp'}" FontWeight="Bold" Foreground="#1E293B" FontSize="12.5"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Số tiền hoàn (VNĐ):" FontSize="12.5" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,5"/>
                        <Border Background="#F1F5F9" CornerRadius="8" Padding="12,7" Margin="0,0,0,12" BorderBrush="{StaticResource MauVien}" BorderThickness="1">
                            <TextBox Text="{Binding SoTienHoan, UpdateSourceTrigger=PropertyChanged}"
                                     BorderThickness="0" Background="Transparent" FontSize="14" FontWeight="Bold" Foreground="{StaticResource MauChuChinh}"/>
                        </Border>
                        
                        <TextBlock Text="Lý do hoàn tiền:" FontSize="12.5" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,5"/>
                        <Border Background="#F1F5F9" CornerRadius="8" Padding="12,7" BorderBrush="{StaticResource MauVien}" BorderThickness="1">
                            <TextBox Text="{Binding LyDoHoanTien, UpdateSourceTrigger=PropertyChanged}"
                                     BorderThickness="0" Background="Transparent" FontSize="13.5" Foreground="{StaticResource MauChuChinh}"/>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Command="{Binding HuyDialogHoanTienCommand}" Content="Hủy bỏ" Background="#F1F5F9"
                                BorderThickness="0" Padding="18,9" Margin="0,0,12,0" FontSize="13" FontWeight="SemiBold" Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="18"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                        <Button Command="{Binding XacNhanHoanTienCommand}" Content="Xác nhận hoàn tiền" Background="{StaticResource MauStaylyGreen}"
                                Foreground="White" BorderThickness="0" Padding="20,9" FontSize="13" FontWeight="Bold" Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="18"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- ================= DIALOG TỪ CHỐI HOÀN TIỀN ================= -->
        <Grid Visibility="{Binding HienThiDialogTuChoiHoanTien, Converter={StaticResource BoolToVis}}"
              HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <!-- Nền mờ: Nhấp chuột ra ngoài để hủy -->
            <Border Background="#99000000" Cursor="Hand" ToolTip="Nhấp vào vùng ngoài để đóng">
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftClick" Command="{Binding HuyDialogTuChoiHoanTienCommand}"/>
                </Border.InputBindings>
            </Border>
            <Border Background="White" CornerRadius="16" Width="530" Padding="26" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="TỪ CHỐI YÊU CẦU HOÀN TIỀN" FontSize="16" FontWeight="Bold" Foreground="{StaticResource MauStaylyRed}" Margin="0,0,0,8"/>
                    <TextBlock Grid.Row="1" Text="Vui lòng cung cấp lý do từ chối gửi tới khách hàng:" FontSize="13" Foreground="{StaticResource MauChuChinh}" Margin="0,0,0,12"/>

                    <Border Grid.Row="2" Background="#F1F5F9" CornerRadius="8" Padding="10,8" Margin="0,0,0,18" BorderBrush="{StaticResource MauVien}" BorderThickness="1">
                        <TextBox Text="{Binding LyDoTuChoiHoanTien, UpdateSourceTrigger=PropertyChanged}"
                                 Height="80" AcceptsReturn="True" TextWrapping="Wrap" BorderThickness="0" Background="Transparent" FontSize="13.5" Foreground="{StaticResource MauChuChinh}"/>
                    </Border>

                    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Command="{Binding HuyDialogTuChoiHoanTienCommand}" Content="Hủy bỏ" Background="#F1F5F9"
                                BorderThickness="0" Padding="18,9" Margin="0,0,12,0" FontSize="13" FontWeight="SemiBold" Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="18"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                        <Button Command="{Binding XacNhanTuChoiHoanTienCommand}" Content="Xác nhận từ chối" Background="{StaticResource MauStaylyRed}"
                                Foreground="White" BorderThickness="0" Padding="20,9" FontSize="13" FontWeight="Bold" Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="18"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- ================= DIALOG CHỈNH SỬA THÔNG TIN ĐƠN ĐẶT ================= -->
        <Grid Visibility="{Binding HienThiDialogChinhSua, Converter={StaticResource BoolToVis}}"
              HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <!-- Nền mờ: Nhấp chuột ra ngoài để hủy -->
            <Border Background="#99000000" Cursor="Hand" ToolTip="Nhấp vào vùng ngoài để đóng">
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftClick" Command="{Binding HuyDialogChinhSuaCommand}"/>
                </Border.InputBindings>
            </Border>
            <Border Background="White" CornerRadius="16" Width="550" Padding="26" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" Opacity="0.25" BlurRadius="24" ShadowDepth="4"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Header Modal -->
                    <DockPanel Grid.Row="0" Margin="0,0,0,16" LastChildFill="True">
                        <Border DockPanel.Dock="Right" Background="{StaticResource MauStaylyPrimaryLight}" CornerRadius="8" Padding="10,4" VerticalAlignment="Center">
                            <TextBlock Text="{Binding DonDangChon.MaDonHienThi, FallbackValue='#DDP-001'}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource MauStaylyPrimary}"/>
                        </Border>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="✏️ " FontSize="18"/>
                            <TextBlock Text="CHỈNH SỬA THÔNG TIN ĐƠN ĐẶT PHÒNG" FontSize="15" FontWeight="Bold" Foreground="{StaticResource MauChuTieuDe}"/>
                        </StackPanel>
                    </DockPanel>

                    <!-- Form Body -->
                    <StackPanel Grid.Row="1" Margin="0,0,0,18">
                        <!-- Tên khách hàng -->
                        <TextBlock Text="Tên khách hàng (*):" FontSize="12.5" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,5"/>
                        <Border Background="#F1F5F9" CornerRadius="8" Padding="12,7" Margin="0,0,0,12" BorderBrush="{StaticResource MauVien}" BorderThickness="1">
                            <TextBox Text="{Binding SuaTenKhachHang, UpdateSourceTrigger=PropertyChanged}"
                                     BorderThickness="0" Background="Transparent" FontSize="13.5" Foreground="{StaticResource MauChuChinh}"/>
                        </Border>

                        <!-- SĐT & Email -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Số điện thoại:" FontSize="12.5" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,5"/>
                                <Border Background="#F1F5F9" CornerRadius="8" Padding="12,7" BorderBrush="{StaticResource MauVien}" BorderThickness="1">
                                    <TextBox Text="{Binding SuaSoDienThoai, UpdateSourceTrigger=PropertyChanged}"
                                             BorderThickness="0" Background="Transparent" FontSize="13.5" Foreground="{StaticResource MauChuChinh}"/>
                                </Border>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Email liên hệ:" FontSize="12.5" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,5"/>
                                <Border Background="#F1F5F9" CornerRadius="8" Padding="12,7" BorderBrush="{StaticResource MauVien}" BorderThickness="1">
                                    <TextBox Text="{Binding SuaEmail, UpdateSourceTrigger=PropertyChanged}"
                                             BorderThickness="0" Background="Transparent" FontSize="13.5" Foreground="{StaticResource MauChuChinh}"/>
                                </Border>
                            </StackPanel>
                        </Grid>

                        <!-- Trạng thái đơn -->
                        <TextBlock Text="Trạng thái đơn hàng:" FontSize="12.5" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,5"/>
                        <ComboBox SelectedValue="{Binding SuaTrangThai}" SelectedValuePath="Tag" Height="38" FontSize="13" Margin="0,0,0,12">
                            <ComboBoxItem Content="⏳ Chờ chủ nhà xác nhận" Tag="ChoXacNhan"/>
                            <ComboBoxItem Content="✅ Đã xác nhận / Sẵn sàng đón" Tag="DaXacNhan"/>
                            <ComboBoxItem Content="🏡 Khách đang lưu trú (Đang ở)" Tag="DangO"/>
                            <ComboBoxItem Content="🏁 Đã hoàn thành (Checked-out)" Tag="HoanThanh"/>
                            <ComboBoxItem Content="🚫 Đã hủy đơn" Tag="DaHuy"/>
                        </ComboBox>

                        <!-- Ghi chú quản trị -->
                        <TextBlock Text="Ghi chú quản trị viên:" FontSize="12.5" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,5"/>
                        <Border Background="#F1F5F9" CornerRadius="8" Padding="12,7" BorderBrush="{StaticResource MauVien}" BorderThickness="1">
                            <TextBox Text="{Binding SuaGhiChu, UpdateSourceTrigger=PropertyChanged}"
                                     Height="70" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                     BorderThickness="0" Background="Transparent" FontSize="13.5" Foreground="{StaticResource MauChuChinh}"/>
                        </Border>
                    </StackPanel>

                    <!-- Buttons -->
                    <DockPanel Grid.Row="2" LastChildFill="False">
                        <Button DockPanel.Dock="Left" Command="{Binding HuyDialogChinhSuaCommand}" Content="Hủy bỏ" Background="#F1F5F9"
                                BorderThickness="0" Padding="20,9" FontSize="13" FontWeight="SemiBold" Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="8"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                        <Button DockPanel.Dock="Right" Command="{Binding XacNhanChinhSuaCommand}" Content="💾 Lưu thay đổi" Background="{StaticResource MauStaylyPrimary}"
                                Foreground="White" BorderThickness="0" Padding="22,9" FontSize="13" FontWeight="Bold" Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="8"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </DockPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
