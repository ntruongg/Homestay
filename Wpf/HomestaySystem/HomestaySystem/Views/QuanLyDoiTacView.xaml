<UserControl x:Class="HomestaySystem.Views.QuanLyDoiTacView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:conv="clr-namespace:HomestaySystem.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="850" d:DesignWidth="1200">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <conv:ChuoiMauToBrushConverter x:Key="ColorToBrush"/>
        <conv:NullToVisibilityConverter x:Key="NullToVis"/>
        <conv:BooleanToTeraBadgeTextConverter x:Key="BoolToTeraText"/>
        <conv:BooleanToTeraColorConverter x:Key="BoolToTeraColor"/>
        <conv:BooleanToTeraBgConverter x:Key="BoolToTeraBg"/>
    </UserControl.Resources>

    <Grid Background="{StaticResource MauNenChinh}">
        <Grid Margin="20,16,20,16">
            <!-- CẤU TRÚC LAYOUT 3 HÀNG: HÀNG 2 DÙNG '*' CHỨA DATAGRID VÀ CHI TIẾT -->
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Hàng 0: Header & Thanh tìm kiếm/Lọc -->
                <RowDefinition Height="Auto"/> <!-- Hàng 1: 4 Thẻ Card KPI Đối tác -->
                <RowDefinition Height="*"/>    <!-- Hàng 2: DataGrid và Panel chi tiết -->
            </Grid.RowDefinitions>

            <!-- ================= HÀNG 0: HEADER & THANH TÌM KIẾM / BỘ LỌC ================= -->
            <Border Grid.Row="0" Margin="0,0,0,16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 0.1 Header bar: Tên tiếng Việt chuẩn nghiệp vụ Stayly -->
                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="42" Height="42" CornerRadius="21" Background="{StaticResource MauStaylyGreenNhat}" Margin="0,0,12,0">
                                <TextBlock Text="🤝" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Quản Lý Đối Tác" FontSize="19" FontWeight="Bold" Foreground="{StaticResource MauChuTieuDe}"/>
                                    <Border Background="{StaticResource MauStaylyGreenNhat}" CornerRadius="8" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="Chủ Nhà &amp; Cơ Sở Lưu Trú TERA" FontSize="11" FontWeight="Bold" Foreground="{StaticResource MauStaylyGreen}"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="Định danh đối tác TERA, thẩm định hồ sơ kinh doanh và kiểm soát tài khoản chủ nhà" FontSize="12" Foreground="{StaticResource MauChuPhu}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Thao tác làm mới & chuyển nhanh sang Quản lý người dùng -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button Command="{Binding MoDialogThemMoiCommand}" Cursor="Hand" ToolTip="Đăng ký thêm hồ sơ đối tác chủ nhà mới"
                                    Background="{StaticResource MauStaylyPrimary}" Foreground="White" BorderThickness="0" Padding="14,7" Margin="0,0,8,0"
                                    FontSize="12" FontWeight="Bold">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="18"/>
                                    </Style>
                                </Button.Resources>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="➕ " FontSize="12"/>
                                    <TextBlock Text="Thêm đối tác mới"/>
                                </StackPanel>
                            </Button>

                            <Button Command="{Binding ChuyenSangNguoiDungCommand}" Cursor="Hand" ToolTip="Chuyển sang Quản lý Người dùng (Khách hàng)"
                                    Background="#F8FAFC" BorderBrush="{StaticResource MauVien}" BorderThickness="1" Padding="12,7" Margin="0,0,8,0">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="18"/>
                                    </Style>
                                </Button.Resources>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="👤 " FontSize="12"/>
                                    <TextBlock Text="Sang Quản lý người dùng" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource MauChuChinh}"/>
                                </StackPanel>
                            </Button>

                            <Button Command="{Binding TaiDuLieuCommand}" Cursor="Hand" ToolTip="Tải lại danh sách đối tác"
                                    Background="White" BorderBrush="{StaticResource MauVien}" BorderThickness="1" Padding="14,7">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="18"/>
                                    </Style>
                                </Button.Resources>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🔄 " FontSize="12"/>
                                    <TextBlock Text="Làm mới" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource MauChuChinh}"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- 0.2 Thanh tìm kiếm & bộ lọc Ribbon -->
                    <Border Grid.Row="1" Background="White" CornerRadius="16" Padding="14,10" BorderBrush="{StaticResource MauVien}" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="230"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Ô tìm kiếm viên thuốc -->
                            <Border Grid.Column="0" Background="#F1F5F9" CornerRadius="20" Height="36" Padding="12,0" BorderBrush="{StaticResource MauVien}" BorderThickness="1">
                                <Grid VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="🔍" FontSize="12" Margin="2,0,8,0" VerticalAlignment="Center"/>
                                    <TextBox Grid.Column="1" Text="{Binding TuKhoaTimKiem, UpdateSourceTrigger=PropertyChanged}"
                                             BorderThickness="0" Background="Transparent" VerticalAlignment="Center"
                                             FontSize="12" Foreground="{StaticResource MauChuChinh}"/>
                                    <TextBlock Grid.Column="1" Text="Tìm kiếm theo tên chủ nhà, username, email, số điện thoại, CCCD hoặc MST..." FontSize="12" Foreground="#94A3B8"
                                               VerticalAlignment="Center" Margin="2,0,0,0" IsHitTestVisible="False">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding TuKhoaTimKiem}" Value="">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding TuKhoaTimKiem}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </Border>

                            <!-- Bộ lọc phân loại hồ sơ đối tác TERA -->
                            <ComboBox Grid.Column="2" SelectedValue="{Binding BoLocTrangThai}" SelectedValuePath="Tag" Height="36" VerticalAlignment="Center">
                                <ComboBoxItem Content="Tất cả đối tác" Tag="TatCa" IsSelected="True"/>
                                <ComboBoxItem Content="Đã xác thực TERA" Tag="DaXacThucTERA"/>
                                <ComboBoxItem Content="Chờ xác thực TERA" Tag="ChoXacThucTERA"/>
                                <ComboBoxItem Content="Bị từ chối hồ sơ" Tag="TuChoi"/>
                                <ComboBoxItem Content="Bị khóa hoạt động" Tag="BiKhoa"/>
                                <ComboBoxItem Content="Bị từ chối / Khóa" Tag="BiKhoaHoacTuChoi"/>
                            </ComboBox>

                            <!-- Số lượng kết quả lọc -->
                            <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Background="{StaticResource MauStaylyGreenNhat}" CornerRadius="16" Height="36" Padding="14,0">
                                    <TextBlock Text="{Binding DanhSachHienThi.Count, StringFormat='{}Hiển thị {0} đối tác'}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource MauStaylyGreen}" VerticalAlignment="Center"/>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- ================= HÀNG 1: 4 THẺ CARD KPI ĐỐI TÁC ================= -->
            <Grid Grid.Row="1" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- KPI 1: Tổng đối tác -->
                <Border Grid.Column="0" Background="White" CornerRadius="12" BorderBrush="{StaticResource MauVien}" BorderThickness="1" Padding="14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="TỔNG ĐỐI TÁC (HOST)" FontSize="11" FontWeight="Bold" Foreground="{StaticResource MauChuPhu}" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding TongSoDoiTac, FallbackValue='0'}" FontSize="22" FontWeight="Black" Foreground="{StaticResource MauChuTieuDe}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="Cơ sở lưu trú toàn mạng" FontSize="11" Foreground="{StaticResource MauStaylySkyBlue}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <Border Grid.Column="1" Width="42" Height="42" CornerRadius="21" Background="#EBF3FA" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="🏡" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- KPI 2: Đã xác thực TERA -->
                <Border Grid.Column="2" Background="White" CornerRadius="12" BorderBrush="{StaticResource MauVien}" BorderThickness="1" Padding="14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="ĐÃ DUYỆT TERA" FontSize="11" FontWeight="Bold" Foreground="{StaticResource MauChuPhu}" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding SoDoiTacDaXacThucTERA, FallbackValue='0'}" FontSize="22" FontWeight="Black" Foreground="{StaticResource MauStaylyGreen}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="Hồ sơ định danh hợp lệ" FontSize="11" Foreground="{StaticResource MauChuPhu}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <Border Grid.Column="1" Width="42" Height="42" CornerRadius="21" Background="{StaticResource MauStaylyGreenNhat}" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="⭐" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- KPI 3: Chờ xác minh TERA -->
                <Border Grid.Column="4" Background="White" CornerRadius="12" BorderBrush="{StaticResource MauVien}" BorderThickness="1" Padding="14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="CHỜ XÁC MINH" FontSize="11" FontWeight="Bold" Foreground="{StaticResource MauChuPhu}" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding SoDoiTacChoXacThuc, FallbackValue='0'}" FontSize="22" FontWeight="Black" Foreground="#D97706" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="Chưa kích hoạt chuẩn TERA" FontSize="11" Foreground="{StaticResource MauChuPhu}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <Border Grid.Column="1" Width="42" Height="42" CornerRadius="21" Background="#FEF3C7" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="⏳" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- KPI 4: Từ chối / Bị khóa -->
                <Border Grid.Column="6" Background="White" CornerRadius="12" BorderBrush="{StaticResource MauVien}" BorderThickness="1" Padding="14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="TỪ CHỐI / BỊ KHÓA" FontSize="11" FontWeight="Bold" Foreground="{StaticResource MauChuPhu}" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding SoDoiTacBiTuChoiHoacKhoa, FallbackValue='0'}" FontSize="22" FontWeight="Black" Foreground="{StaticResource MauStaylyRed}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="Hồ sơ vi phạm hoặc sai lệch" FontSize="11" Foreground="{StaticResource MauChuPhu}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <Border Grid.Column="1" Width="42" Height="42" CornerRadius="21" Background="#FEE2E2" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="🚫" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <!-- ================= HÀNG 2: BẢNG DATAGRID TOÀN MÀN HÌNH FULL-WIDTH ================= -->
            <Border Grid.Row="2" Style="{StaticResource StaylyCard}" Padding="0" ClipToBounds="True">
                <DataGrid x:Name="dgDoiTac"
                              ItemsSource="{Binding DanhSachHienThi}"
                              SelectedItem="{Binding SelectedHost}"
                              Style="{StaticResource StaylyDataGridStyle}"
                              IsReadOnly="True"
                              RowHeight="58"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              CanUserResizeColumns="True"
                              CanUserSortColumns="True">
                        <DataGrid.Columns>
                            <!-- Cột 1: MÃ ĐỐI TÁC (Tự động canh theo mã dài nhất) -->
                            <DataGridTextColumn Header="MÃ ĐỐI TÁC" Binding="{Binding MaDoiTacHienThi}" Width="Auto" MinWidth="115">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="Foreground" Value="{StaticResource MauStaylyGreen}"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Padding" Value="12,0"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Cột 2: HỌ VÀ TÊN CHỦ NHÀ (Mở rộng tối thiểu 220px, click để xem hồ sơ) -->
                            <DataGridTemplateColumn Header="HỌ VÀ TÊN CHỦ NHÀ" Width="*" MinWidth="220">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel VerticalAlignment="Center" Margin="12,0" Cursor="Hand" ToolTip="{Binding HoTen}">
                                            <TextBlock Text="{Binding HoTen}" FontWeight="Bold" FontSize="12.5" Foreground="{StaticResource MauChuTieuDe}" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding TenDangNhap, StringFormat='@{0}'}" FontSize="11" Foreground="{StaticResource MauChuPhu}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Cột 3: EMAIL ĐỐI TÁC (Tự động canh theo email dài nhất) -->
                            <DataGridTextColumn Header="EMAIL ĐỐI TÁC" Binding="{Binding Email}" Width="Auto" MinWidth="200">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource MauChuPhu}"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Padding" Value="12,0"/>
                                        <Setter Property="ToolTip" Value="{Binding Email}"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Cột 4: SỐ ĐIỆN THOẠI (Tự động canh theo số điện thoại) -->
                            <DataGridTextColumn Header="SỐ ĐIỆN THOẠI" Binding="{Binding SoDienThoai}" Width="Auto" MinWidth="130">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="Foreground" Value="{StaticResource MauStaylyPrimary}"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Padding" Value="12,0"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Cột 5: XÁC THỰC TERA (Tự động canh theo badge định danh) -->
                            <DataGridTemplateColumn Header="ĐỊNH DANH TERA" Width="Auto" MinWidth="175">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="8" Padding="10,4" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="8,0"
                                                Background="{Binding DaXacThucTERA, Converter={StaticResource BoolToTeraBg}}">
                                            <TextBlock Text="{Binding DaXacThucTERA, Converter={StaticResource BoolToTeraText}}" FontSize="11" FontWeight="Bold"
                                                       Foreground="{Binding DaXacThucTERA, Converter={StaticResource BoolToTeraColor}}"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Cột 6: TRẠNG THÁI TÀI KHOẢN (Tự động canh theo trạng thái) -->
                            <DataGridTemplateColumn Header="TRẠNG THÁI" Width="Auto" MinWidth="135">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="8" Padding="10,4" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0"
                                                Background="{Binding TrangThaiBackground}">
                                            <TextBlock Text="{Binding TrangThaiText}" FontSize="11" FontWeight="Bold"
                                                       Foreground="{Binding TrangThaiForeground}"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Cột 7: NGÀY THAM GIA -->
                            <DataGridTextColumn Header="NGÀY THAM GIA" Binding="{Binding NgayTaoHienThi}" Width="Auto" MinWidth="120">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource MauChuPhu}"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Padding" Value="12,0"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Cột 8: NÚT THAO TÁC MỞ HỒ SƠ -->
                            <DataGridTemplateColumn Header="THAO TÁC" Width="Auto" MinWidth="135">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="👁️ Xem hồ sơ"
                                                Command="{Binding DataContext.XemHoSoCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource StaylyBtnSmall}"
                                                Background="{StaticResource MauStaylyGreenNhat}"
                                                Foreground="{StaticResource MauStaylyGreenDam}"
                                                BorderThickness="0" FontWeight="Bold" FontSize="11" Padding="12,6"
                                                HorizontalAlignment="Center" VerticalAlignment="Center" Cursor="Hand"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
        </Grid>

        <!-- ================= MODAL DIALOG: HỒ SƠ ĐỐI TÁC TERA CHI TIẾT (HIỆN NGAY GIỮA MÀN HÌNH) ================= -->
        <Grid Visibility="{Binding SelectedHost, Converter={StaticResource NullToVis}, FallbackValue=Collapsed}"
              HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <!-- Nền mờ: Nhấp chuột ra ngoài để đóng hồ sơ -->
            <Border Background="#99000000" Cursor="Hand" ToolTip="Nhấp vào vùng ngoài để đóng hồ sơ">
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftClick" Command="{Binding DongHoSoCommand}"/>
                </Border.InputBindings>
            </Border>
            <Border Background="White" CornerRadius="16" Width="540" MaxHeight="740" Padding="20" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" Opacity="0.25" BlurRadius="24" ShadowDepth="4"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                        <!-- Header Panel Title có nút [✕ Đóng] -->
                        <Border Grid.Row="0" BorderBrush="{StaticResource MauVien}" BorderThickness="0,0,0,1" Padding="0,0,0,12" Margin="0,0,0,14">
                            <DockPanel LastChildFill="True">
                                <Button DockPanel.Dock="Right" Command="{Binding DongHoSoCommand}"
                                        Content="✕ Đóng" ToolTip="Đóng hồ sơ để hiển thị danh sách toàn màn hình"
                                        Background="#F1F5F9" Foreground="#64748B" BorderThickness="0"
                                        FontWeight="Bold" FontSize="11" Padding="10,4" Cursor="Hand" Margin="8,0,0,0">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="6"/>
                                        </Style>
                                    </Button.Resources>
                                </Button>
                                <Border DockPanel.Dock="Right" Background="{StaticResource MauStaylyGreenNhat}" CornerRadius="8" Padding="8,3" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding SelectedHost.MaDoiTacHienThi, FallbackValue='#HST-001'}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource MauStaylyGreen}"/>
                                </Border>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="🏡" FontSize="15" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="HỒ SƠ ĐỐI TÁC TERA" FontWeight="Bold" FontSize="13" Foreground="{StaticResource MauChuTieuDe}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <!-- Vùng nội dung chi tiết -->
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,6,0">
                            <StackPanel>
                                <!-- Avatar & Tên đại diện -->
                                <Border Width="56" Height="56" CornerRadius="28" Background="{StaticResource MauStaylyGreenNhat}" HorizontalAlignment="Center" Margin="0,4,0,8">
                                    <TextBlock Text="🏡" FontSize="28" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="{Binding SelectedHost.HoTen, FallbackValue='Chưa chọn đối tác'}" 
                                           FontWeight="Bold" FontSize="15" HorizontalAlignment="Center" Foreground="{StaticResource MauChuTieuDe}" TextAlignment="Center" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding SelectedHost.TenDangNhap, StringFormat='@{0}', FallbackValue='@username'}" 
                                           FontSize="12" Foreground="{StaticResource MauChuPhu}" HorizontalAlignment="Center" Margin="0,2,0,8"/>

                                <!-- Badges Phân loại: TERA & Trạng thái -->
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,14">
                                    <Border Background="{Binding SelectedHost.DaXacThucTERA, Converter={StaticResource BoolToTeraBg}}" CornerRadius="8" Padding="10,4" Margin="0,0,8,0">
                                        <TextBlock Text="{Binding SelectedHost.DaXacThucTERA, Converter={StaticResource BoolToTeraText}}" FontSize="11" Foreground="{Binding SelectedHost.DaXacThucTERA, Converter={StaticResource BoolToTeraColor}}" FontWeight="Bold"/>
                                    </Border>
                                    <Border Background="{Binding SelectedHost.TrangThaiBackground, FallbackValue='#DCFCE7'}" CornerRadius="8" Padding="10,4">
                                        <TextBlock Text="{Binding SelectedHost.TrangThaiText, FallbackValue='Hoạt động'}" FontSize="11" Foreground="{Binding SelectedHost.TrangThaiForeground, FallbackValue='#16A34A'}" FontWeight="Bold"/>
                                    </Border>
                                </StackPanel>

                                <!-- NẾU ĐỐI TÁC BỊ TỪ CHỐI / BỊ KHÓA VÀ CÓ LÝ DO -> HIỂN THỊ KHUNG NÊU LÝ DO NỔI BẬT -->
                                <Border Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1" CornerRadius="10" Padding="12,10" Margin="0,0,0,14"
                                        Visibility="{Binding SelectedHost.DaBiTuChoiHoacKhoa, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                            <TextBlock Text="⚠️ " FontSize="12"/>
                                            <TextBlock Text="LÝ DO TỪ CHỐI HỒ SƠ ĐỐI TÁC:" FontWeight="Bold" FontSize="11" Foreground="#DC2626"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding SelectedHost.LyDoTuChoiHienThi, FallbackValue='Chưa có lý do cụ thể'}" FontSize="12" Foreground="#991B1B" TextWrapping="Wrap" LineHeight="18"/>
                                    </StackPanel>
                                </Border>

                                <Separator Background="#F1F5F9" Margin="0,0,0,12"/>

                                <!-- Thông tin liên hệ -->
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="175"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Email đối tác:" FontSize="13" Foreground="{StaticResource MauChuPhu}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding SelectedHost.EmailHienThi, FallbackValue='-'}" 
                                               FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource MauChuChinh}" TextAlignment="Right" TextWrapping="Wrap"/>
                                </Grid>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="175"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Số điện thoại:" FontSize="13" Foreground="{StaticResource MauChuPhu}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding SelectedHost.SoDienThoaiHienThi, FallbackValue='-'}" 
                                               FontSize="13.5" FontWeight="Bold" Foreground="{StaticResource MauStaylyPrimary}" TextAlignment="Right"/>
                                </Grid>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="175"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Địa chỉ cơ sở:" FontSize="13" Foreground="{StaticResource MauChuPhu}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding SelectedHost.DiaChiHienThi, FallbackValue='-'}" 
                                               FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource MauChuChinh}" TextAlignment="Right" TextWrapping="Wrap"/>
                                </Grid>

                                <Separator Background="#F1F5F9" Margin="0,6,0,10"/>
                                <TextBlock Text="THÔNG TIN ĐỊNH DANH PHÁP LÝ TERA" FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource MauStaylyPrimary}" Margin="0,0,0,10"/>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="185"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Số CCCD:" FontSize="13" Foreground="{StaticResource MauChuPhu}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding SelectedHost.CCCDHienThi, FallbackValue='Chưa cung cấp'}" 
                                               FontSize="13.5" FontWeight="Bold" Foreground="{StaticResource MauChuTieuDe}" TextAlignment="Right"/>
                                </Grid>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="185"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Ngân hàng thụ hưởng:" FontSize="13" Foreground="{StaticResource MauChuPhu}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding SelectedHost.NganHangHienThi, FallbackValue='-'}" 
                                               FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource MauChuChinh}" TextAlignment="Right" TextWrapping="Wrap"/>
                                </Grid>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="185"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Số tài khoản:" FontSize="13" Foreground="{StaticResource MauChuPhu}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding SelectedHost.SoTaiKhoanHienThi, FallbackValue='-'}" 
                                               FontSize="14" FontWeight="Bold" Foreground="{StaticResource MauStaylyPrimary}" TextAlignment="Right"/>
                                </Grid>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="185"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Tên chủ tài khoản:" FontSize="13" Foreground="{StaticResource MauChuPhu}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding SelectedHost.ChuTaiKhoanHienThi, FallbackValue='-'}" 
                                               FontSize="13.5" FontWeight="Bold" Foreground="{StaticResource MauChuTieuDe}" TextAlignment="Right"/>
                                </Grid>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="185"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Số cơ sở homestay:" FontSize="13" Foreground="{StaticResource MauChuPhu}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding SelectedHost.SoCoSoLuuTru, StringFormat='{}{0} cơ sở'}" 
                                               FontSize="13.5" FontWeight="Bold" Foreground="{StaticResource MauChuTieuDe}" TextAlignment="Right"/>
                                </Grid>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- Sticky Bottom Action Buttons -->
                        <Border Grid.Row="2" BorderBrush="{StaticResource MauVien}" BorderThickness="0,1,0,0" Padding="0,12,0,0" Margin="0,6,0,0">
                            <StackPanel>
                                <TextBlock Text="THAO TÁC HỒ SƠ ĐỐI TÁC" FontSize="12" FontWeight="Bold" Foreground="{StaticResource MauChuPhu}" Margin="0,0,0,8"/>
                                
                                <!-- NÚT CHỈNH SỬA THÔNG TIN ĐỐI TÁC RIÊNG BIỆT -->
                                <Button Content="✏️ Chỉnh sửa hồ sơ đối tác" Height="38" Background="{StaticResource MauStaylyPrimary}" Foreground="White" 
                                        FontWeight="Bold" FontSize="13" BorderThickness="0" Margin="0,0,0,8"
                                        Command="{Binding MoDialogChinhSuaCommand}" Cursor="Hand" ToolTip="Chỉnh sửa thông tin cá nhân và tài khoản đối tác TERA">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="8"/>
                                        </Style>
                                    </Button.Resources>
                                </Button>

                                <!-- Hàng nút 1: Xác thực TERA -->
                                <Button Content="⭐ Xác nhận / Đổi trạng thái TERA" Height="38" Background="{StaticResource MauStaylyGreen}" Foreground="White" 
                                        FontWeight="Bold" FontSize="13" BorderThickness="0" Margin="0,0,0,8"
                                        Command="{Binding XacThucTERACommand}" Cursor="Hand" ToolTip="Cấp hoặc thu hồi chứng nhận hồ sơ TERA">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="8"/>
                                        </Style>
                                    </Button.Resources>
                                </Button>

                                <!-- Hàng nút 2: Từ chối / Mở tài khoản -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <!-- NÚT TỪ CHỐI ĐỐI TÁC: MỞ MODAL DIALOG KHUNG NÊU LÝ DO -->
                                    <Button Grid.Column="0" Content="🚫 Từ chối đối tác" Height="38" Background="{StaticResource MauStaylyRed}" Foreground="White" 
                                            FontWeight="Bold" FontSize="13" BorderThickness="0"
                                            Command="{Binding MoDialogTuChoiCommand}" Cursor="Hand" ToolTip="Từ chối tài khoản đối tác với khung nêu lý do chi tiết">
                                        <Button.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="8"/>
                                            </Style>
                                        </Button.Resources>
                                    </Button>

                                    <!-- NÚT MỞ TÀI KHOẢN ĐỐI TÁC -->
                                    <Button Grid.Column="2" Content="🔓 Mở tài khoản" Height="38" Background="{StaticResource MauStaylyGreen}" Foreground="White" 
                                            FontWeight="Bold" FontSize="13" BorderThickness="0"
                                            Command="{Binding MoKhoaTaiKhoanCommand}" Cursor="Hand" ToolTip="Kích hoạt lại tài khoản đối tác">
                                        <Button.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="8"/>
                                            </Style>
                                        </Button.Resources>
                                    </Button>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

        <!-- ================= MODAL DIALOG: KHUNG NÊU LÝ DO TỪ CHỐI TÀI KHOẢN ĐỐI TÁC ================= -->
        <Grid Visibility="{Binding HienThiDialogTuChoi, Converter={StaticResource BoolToVis}}"
              HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <!-- Nền mờ: Nhấp chuột ra ngoài để hủy -->
            <Border Background="#99000000" Cursor="Hand" ToolTip="Nhấp vào vùng ngoài để đóng">
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftClick" Command="{Binding HuyBoTuChoiCommand}"/>
                </Border.InputBindings>
            </Border>
            <Border Background="White" CornerRadius="16" Width="520" Padding="24" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" Opacity="0.25" BlurRadius="24" ShadowDepth="4"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Header Modal -->
                    <StackPanel Grid.Row="0" Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="🚫 " FontSize="18"/>
                            <TextBlock Text="{Binding TieuDeDialog}" FontSize="16" FontWeight="ExtraBold" Foreground="{StaticResource MauStaylyRed}"/>
                        </StackPanel>
                        <TextBlock Text="Vui lòng cung cấp lý do từ chối hồ sơ để gửi thông báo hướng dẫn đối tác bổ sung hoặc điều chỉnh:" 
                                   FontSize="12.5" Foreground="{StaticResource MauChuPhu}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                    </StackPanel>

                    <!-- Snippet thông tin đối tác đang xử lý -->
                    <Border Grid.Row="1" Background="#F8FAFC" BorderBrush="{StaticResource MauVien}" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="36" Height="36" CornerRadius="18" Background="{StaticResource MauStaylyGreenNhat}" Margin="0,0,10,0">
                                <TextBlock Text="🏡" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding TaiKhoanDangChon.HoTen}" FontWeight="Bold" FontSize="13.5" Foreground="{StaticResource MauChuTieuDe}"/>
                                <TextBlock Text="{Binding TaiKhoanDangChon.Email}" FontSize="12" Foreground="{StaticResource MauChuPhu}"/>
                            </StackPanel>
                            <Border Grid.Column="2" Background="{StaticResource MauStaylyGreenNhat}" CornerRadius="6" Padding="8,3" VerticalAlignment="Center">
                                <TextBlock Text="{Binding TaiKhoanDangChon.MaDoiTacHienThi}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource MauStaylyGreen}"/>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Các lý do gợi ý nhanh cho đối tác -->
                    <StackPanel Grid.Row="2" Margin="0,0,0,8">
                        <TextBlock Text="Gợi ý lý do thẩm định đối tác (Nhấp chọn nhanh):" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource MauChuPhu}" Margin="0,0,0,6"/>
                        <WrapPanel Orientation="Horizontal">
                            <Button Command="{Binding ChonLyDoGoiYCommand}" CommandParameter="Ảnh chụp CCCD/Giấy phép kinh doanh bị mờ, không khớp thông tin"
                                    Content="Ảnh CCCD/Giấy phép mờ" Background="#F1F5F9" BorderThickness="0" Padding="10,5" Margin="0,0,6,6" FontSize="11.5" Cursor="Hand">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="6"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                            <Button Command="{Binding ChonLyDoGoiYCommand}" CommandParameter="Thông tin tài khoản ngân hàng thụ hưởng không trùng khớp tên chủ hộ"
                                    Content="Sai lệch tài khoản ngân hàng" Background="#F1F5F9" BorderThickness="0" Padding="10,5" Margin="0,0,6,6" FontSize="11.5" Cursor="Hand">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="6"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                            <Button Command="{Binding ChonLyDoGoiYCommand}" CommandParameter="Cơ sở lưu trú chưa đáp ứng quy chuẩn an toàn dịch vụ phòng sàn Stayly"
                                    Content="Chưa đạt chuẩn an toàn" Background="#F1F5F9" BorderThickness="0" Padding="10,5" Margin="0,0,6,6" FontSize="11.5" Cursor="Hand">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="6"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                        </WrapPanel>
                    </StackPanel>

                    <!-- KHUNG NÊU LÝ DO (TEXTBOX BẮT BUỘC) -->
                    <StackPanel Grid.Row="3" Margin="0,0,0,16">
                        <TextBlock Text="Nội dung lý do từ chối hồ sơ đối tác (*):" FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource MauChuTieuDe}" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding LyDoTuChoi, UpdateSourceTrigger=PropertyChanged}"
                                 Height="80" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                 BorderBrush="{StaticResource MauVien}" Padding="10,8" FontSize="13" Foreground="{StaticResource MauChuChinh}">
                            <TextBox.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="8"/>
                                </Style>
                            </TextBox.Resources>
                        </TextBox>
                    </StackPanel>

                    <!-- Nút thao tác xác nhận / hủy -->
                    <DockPanel Grid.Row="4" LastChildFill="False">
                        <Button DockPanel.Dock="Left" Command="{Binding HuyBoTuChoiCommand}" Content="Hủy bỏ" Background="#F1F5F9"
                                BorderThickness="0" Padding="20,9" FontSize="13" FontWeight="SemiBold" Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="8"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                        <Button DockPanel.Dock="Right" Command="{Binding XacNhanTuChoiCommand}" Content="Xác nhận từ chối đối tác" Background="{StaticResource MauStaylyRed}"
                                Foreground="White" BorderThickness="0" Padding="22,9" FontSize="13" FontWeight="Bold" Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="8"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </DockPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- ================= MODAL DIALOG: CHỈNH SỬA HỒ SƠ ĐỐI TÁC TERA ================= -->
        <Grid Visibility="{Binding HienThiDialogChinhSua, Converter={StaticResource BoolToVis}}"
              HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <!-- Nền mờ: Nhấp chuột ra ngoài để hủy -->
            <Border Background="#99000000" Cursor="Hand" ToolTip="Nhấp vào vùng ngoài để đóng">
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftClick" Command="{Binding HuyDialogChinhSuaCommand}"/>
                </Border.InputBindings>
            </Border>
            <Border Background="White" CornerRadius="16" Width="550" MaxHeight="680" Padding="24" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" Opacity="0.25" BlurRadius="24" ShadowDepth="4"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Header Modal -->
                    <DockPanel Grid.Row="0" Margin="0,0,0,14" LastChildFill="True">
                        <Border DockPanel.Dock="Right" Background="{StaticResource MauStaylyPrimaryLight}" CornerRadius="8" Padding="8,3" VerticalAlignment="Center">
                            <TextBlock Text="{Binding TaiKhoanDangChon.MaDoiTacHienThi, FallbackValue='#HST-001'}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource MauStaylyPrimary}"/>
                        </Border>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="✏️ " FontSize="16"/>
                            <TextBlock Text="CHỈNH SỬA HỒ SƠ ĐỐI TÁC TERA" FontSize="15" FontWeight="Bold" Foreground="{StaticResource MauChuTieuDe}"/>
                        </StackPanel>
                    </DockPanel>

                    <!-- Form Body (Cuộn mượt mà) -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,6,0" Margin="0,0,0,16">
                        <StackPanel>
                            <!-- Họ và tên chủ nhà -->
                            <TextBlock Text="Họ và tên chủ nhà (*):" FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource MauChuPhu}" Margin="0,0,0,4"/>
                            <Border Background="#F1F5F9" CornerRadius="8" Padding="12,7" Margin="0,0,0,10" BorderBrush="{StaticResource MauVien}" BorderThickness="1">
                                <TextBox Text="{Binding SuaHoTen, UpdateSourceTrigger=PropertyChanged}"
                                         BorderThickness="0" Background="Transparent" FontSize="13.5" Foreground="{StaticResource MauChuChinh}"/>
                            </Border>

                            <!-- SĐT & Email -->
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Số điện thoại:" FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource MauChuPhu}" Margin="0,0,0,4"/>
                                    <Border Background="#F1F5F9" CornerRadius="8" Padding="12,7" BorderBrush="{StaticResource MauVien}" BorderThickness="1">
                                        <TextBox Text="{Binding SuaSoDienThoai, UpdateSourceTrigger=PropertyChanged}"
                                                 BorderThickness="0" Background="Transparent" FontSize="13.5" Foreground="{StaticResource MauChuChinh}"/>
                                    </Border>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Email đối tác:" FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource MauChuPhu}" Margin="0,0,0,4"/>
                                    <Border Background="#F1F5F9" CornerRadius="8" Padding="12,7" BorderBrush="{StaticResource MauVien}" BorderThickness="1">
                                        <TextBox Text="{Binding SuaEmail, UpdateSourceTrigger=PropertyChanged}"
                                                 BorderThickness="0" Background="Transparent" FontSize="13.5" Foreground="{StaticResource MauChuChinh}"/>
                                    </Border>
                                </StackPanel>
                            </Grid>

                            <!-- Địa chỉ cơ sở -->
                            <TextBlock Text="Địa chỉ cơ sở lưu trú:" FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource MauChuPhu}" Margin="0,0,0,4"/>
                            <Border Background="#F1F5F9" CornerRadius="8" Padding="12,7" Margin="0,0,0,10" BorderBrush="{StaticResource MauVien}" BorderThickness="1">
                                <TextBox Text="{Binding SuaDiaChi, UpdateSourceTrigger=PropertyChanged}"
                                         BorderThickness="0" Background="Transparent" FontSize="13.5" Foreground="{StaticResource MauChuChinh}"/>
                            </Border>

                            <!-- Số CCCD định danh -->
                            <TextBlock Text="Số CCCD định danh:" FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource MauChuPhu}" Margin="0,0,0,4"/>
                            <Border Background="#F1F5F9" CornerRadius="8" Padding="12,7" Margin="0,0,0,10" BorderBrush="{StaticResource MauVien}" BorderThickness="1">
                                <TextBox Text="{Binding SuaCCCD, UpdateSourceTrigger=PropertyChanged}"
                                         BorderThickness="0" Background="Transparent" FontSize="13.5" Foreground="{StaticResource MauChuChinh}"/>
                            </Border>

                            <!-- Ngân hàng & Số tài khoản -->
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Ngân hàng thụ hưởng:" FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource MauChuPhu}" Margin="0,0,0,4"/>
                                    <Border Background="#F1F5F9" CornerRadius="8" Padding="12,7" BorderBrush="{StaticResource MauVien}" BorderThickness="1">
                                        <ComboBox ItemsSource="{Binding DanhSachNganHangHoTro}"
                                                  SelectedItem="{Binding SuaNganHang, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  BorderThickness="0" Background="Transparent" FontSize="13" Foreground="{StaticResource MauChuChinh}"/>
                                    </Border>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Số tài khoản:" FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource MauChuPhu}" Margin="0,0,0,4"/>
                                    <Border Background="#F1F5F9" CornerRadius="8" Padding="12,7" BorderBrush="{StaticResource MauVien}" BorderThickness="1">
                                        <TextBox Text="{Binding SuaSoTaiKhoan, UpdateSourceTrigger=PropertyChanged}"
                                                 BorderThickness="0" Background="Transparent" FontSize="13.5" Foreground="{StaticResource MauChuChinh}"/>
                                    </Border>
                                </StackPanel>
                            </Grid>

                            <!-- Tên chủ tài khoản -->
                            <TextBlock Text="Tên chủ tài khoản thụ hưởng:" FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource MauChuPhu}" Margin="0,0,0,4"/>
                            <Border Background="#F1F5F9" CornerRadius="8" Padding="12,7" BorderBrush="{StaticResource MauVien}" BorderThickness="1">
                                <TextBox Text="{Binding SuaChuTaiKhoan, UpdateSourceTrigger=PropertyChanged}"
                                         BorderThickness="0" Background="Transparent" FontSize="13.5" Foreground="{StaticResource MauChuChinh}"/>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Buttons -->
                    <DockPanel Grid.Row="2" LastChildFill="False">
                        <Button DockPanel.Dock="Left" Command="{Binding HuyDialogChinhSuaCommand}" Content="Hủy bỏ" Background="#F1F5F9"
                                BorderThickness="0" Padding="20,9" FontSize="13" FontWeight="SemiBold" Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="8"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                        <Button DockPanel.Dock="Right" Command="{Binding XacNhanChinhSuaCommand}" Content="💾 Lưu thay đổi" Background="{StaticResource MauStaylyPrimary}"
                                Foreground="White" BorderThickness="0" Padding="22,9" FontSize="13" FontWeight="Bold" Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="8"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </DockPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- ================= MODAL DIALOG: THÊM HỒ SƠ ĐỐI TÁC CHỦ HOMESTAY MỚI ================= -->
        <Grid Visibility="{Binding HienThiDialogThemMoi, Converter={StaticResource BoolToVis}}"
              HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <!-- Nền mờ: Nhấp chuột ra ngoài để hủy -->
            <Border Background="#99000000" Cursor="Hand" ToolTip="Nhấp vào vùng ngoài để đóng">
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftClick" Command="{Binding HuyDialogThemMoiCommand}"/>
                </Border.InputBindings>
            </Border>
            <Border Background="White" CornerRadius="16" Width="560" MaxHeight="680" Padding="24" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" Opacity="0.25" BlurRadius="24" ShadowDepth="4"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Header Modal -->
                    <DockPanel Grid.Row="0" Margin="0,0,0,16">
                        <Border Width="36" Height="36" CornerRadius="18" Background="{StaticResource MauStaylyPrimaryLight}" Margin="0,0,10,0">
                            <TextBlock Text="🤝" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="ĐĂNG KÝ HỒ SƠ ĐỐI TÁC CHỦ NHÀ MỚI" FontSize="15" FontWeight="Bold" Foreground="{StaticResource MauStaylyPrimary}"/>
                            <TextBlock Text="Tạo tài khoản quản trị homestay và kích hoạt định danh đối tác TERA" FontSize="12" Foreground="{StaticResource MauChuPhu}"/>
                        </StackPanel>
                    </DockPanel>

                    <!-- Form Input Fields cuộn mượt -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,16" Padding="0,0,8,0">
                        <StackPanel>
                            <!-- Tên đăng nhập & Mật khẩu -->
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Tên đăng nhập (Username) *:" FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource MauChuPhu}" Margin="0,0,0,4"/>
                                    <Border Background="#F1F5F9" CornerRadius="8" Padding="12,7" BorderBrush="{StaticResource MauVien}" BorderThickness="1">
                                        <TextBox Text="{Binding ThemTenDangNhap, UpdateSourceTrigger=PropertyChanged}"
                                                 BorderThickness="0" Background="Transparent" FontSize="13.5" Foreground="{StaticResource MauChuChinh}"/>
                                    </Border>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Mật khẩu khởi tạo *:" FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource MauChuPhu}" Margin="0,0,0,4"/>
                                    <Border Background="#F1F5F9" CornerRadius="8" Padding="12,7" BorderBrush="{StaticResource MauVien}" BorderThickness="1">
                                        <TextBox Text="{Binding ThemMatKhau, UpdateSourceTrigger=PropertyChanged}"
                                                 BorderThickness="0" Background="Transparent" FontSize="13.5" Foreground="{StaticResource MauChuChinh}"/>
                                    </Border>
                                </StackPanel>
                            </Grid>

                            <!-- Họ tên chủ nhà & Số điện thoại -->
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Họ và tên chủ nhà *:" FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource MauChuPhu}" Margin="0,0,0,4"/>
                                    <Border Background="#F1F5F9" CornerRadius="8" Padding="12,7" BorderBrush="{StaticResource MauVien}" BorderThickness="1">
                                        <TextBox Text="{Binding ThemHoTen, UpdateSourceTrigger=PropertyChanged}"
                                                 BorderThickness="0" Background="Transparent" FontSize="13.5" Foreground="{StaticResource MauChuChinh}"/>
                                    </Border>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Số điện thoại liên hệ *:" FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource MauChuPhu}" Margin="0,0,0,4"/>
                                    <Border Background="#F1F5F9" CornerRadius="8" Padding="12,7" BorderBrush="{StaticResource MauVien}" BorderThickness="1">
                                        <TextBox Text="{Binding ThemSoDienThoai, UpdateSourceTrigger=PropertyChanged}"
                                                 BorderThickness="0" Background="Transparent" FontSize="13.5" Foreground="{StaticResource MauChuChinh}"/>
                                    </Border>
                                </StackPanel>
                            </Grid>

                            <!-- Email & Địa chỉ -->
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Email liên hệ:" FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource MauChuPhu}" Margin="0,0,0,4"/>
                                    <Border Background="#F1F5F9" CornerRadius="8" Padding="12,7" BorderBrush="{StaticResource MauVien}" BorderThickness="1">
                                        <TextBox Text="{Binding ThemEmail, UpdateSourceTrigger=PropertyChanged}"
                                                 BorderThickness="0" Background="Transparent" FontSize="13.5" Foreground="{StaticResource MauChuChinh}"/>
                                    </Border>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Địa chỉ cư trú / cơ sở:" FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource MauChuPhu}" Margin="0,0,0,4"/>
                                    <Border Background="#F1F5F9" CornerRadius="8" Padding="12,7" BorderBrush="{StaticResource MauVien}" BorderThickness="1">
                                        <TextBox Text="{Binding ThemDiaChi, UpdateSourceTrigger=PropertyChanged}"
                                                 BorderThickness="0" Background="Transparent" FontSize="13.5" Foreground="{StaticResource MauChuChinh}"/>
                                    </Border>
                                </StackPanel>
                            </Grid>

                            <!-- Định danh pháp lý TERA: CCCD -->
                            <TextBlock Text="THÔNG TIN ĐỊNH DANH PHÁP LÝ TERA" FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource MauStaylyPrimary}" Margin="0,4,0,8"/>
                            <TextBlock Text="Số CCCD / CMND:" FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource MauChuPhu}" Margin="0,0,0,4"/>
                            <Border Background="#F1F5F9" CornerRadius="8" Padding="12,7" Margin="0,0,0,10" BorderBrush="{StaticResource MauVien}" BorderThickness="1">
                                <TextBox Text="{Binding ThemCCCD, UpdateSourceTrigger=PropertyChanged}"
                                         BorderThickness="0" Background="Transparent" FontSize="13.5" Foreground="{StaticResource MauChuChinh}"/>
                            </Border>

                            <!-- Tài khoản ngân hàng nhận tiền quyết toán (85%) -->
                            <TextBlock Text="TÀI KHOẢN NGÂN HÀNG QUYẾT TOÁN DÒNG TIỀN (85%)" FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource MauStaylyPrimary}" Margin="0,4,0,8"/>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Ngân hàng thụ hưởng:" FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource MauChuPhu}" Margin="0,0,0,4"/>
                                    <Border Background="#F1F5F9" CornerRadius="8" Padding="12,7" BorderBrush="{StaticResource MauVien}" BorderThickness="1">
                                        <ComboBox ItemsSource="{Binding DanhSachNganHangHoTro}"
                                                  SelectedItem="{Binding ThemNganHang, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  BorderThickness="0" Background="Transparent" FontSize="13" Foreground="{StaticResource MauChuChinh}"/>
                                    </Border>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Số tài khoản ngân hàng:" FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource MauChuPhu}" Margin="0,0,0,4"/>
                                    <Border Background="#F1F5F9" CornerRadius="8" Padding="12,7" BorderBrush="{StaticResource MauVien}" BorderThickness="1">
                                        <TextBox Text="{Binding ThemSoTaiKhoan, UpdateSourceTrigger=PropertyChanged}"
                                                 BorderThickness="0" Background="Transparent" FontSize="13.5" Foreground="{StaticResource MauChuChinh}"/>
                                    </Border>
                                </StackPanel>
                            </Grid>

                            <!-- Tên chủ tài khoản -->
                            <TextBlock Text="Tên chủ tài khoản thụ hưởng (In hoa không dấu):" FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource MauChuPhu}" Margin="0,0,0,4"/>
                            <Border Background="#F1F5F9" CornerRadius="8" Padding="12,7" BorderBrush="{StaticResource MauVien}" BorderThickness="1" Margin="0,0,0,12">
                                <TextBox Text="{Binding ThemChuTaiKhoan, UpdateSourceTrigger=PropertyChanged}"
                                         BorderThickness="0" Background="Transparent" FontSize="13.5" Foreground="{StaticResource MauChuChinh}"/>
                            </Border>

                            <!-- Checkbox cấp chứng nhận TERA -->
                            <CheckBox IsChecked="{Binding ThemXacThucTERANgay}" Content="Cấp chứng nhận Đối tác đã xác thực TERA ngay lập tức" 
                                      FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource MauStaylyGreen}" Cursor="Hand"/>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Buttons -->
                    <DockPanel Grid.Row="2" LastChildFill="False">
                        <Button DockPanel.Dock="Left" Command="{Binding HuyDialogThemMoiCommand}" Content="Hủy bỏ" Background="#F1F5F9"
                                BorderThickness="0" Padding="20,9" FontSize="13" FontWeight="SemiBold" Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="8"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                        <Button DockPanel.Dock="Right" Command="{Binding XacNhanThemMoiCommand}" Content="✅ Đăng ký đối tác" Background="{StaticResource MauStaylyGreen}"
                                Foreground="White" BorderThickness="0" Padding="22,9" FontSize="13" FontWeight="Bold" Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="8"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </DockPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
