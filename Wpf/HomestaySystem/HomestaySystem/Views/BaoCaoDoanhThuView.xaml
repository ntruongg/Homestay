                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftClick" Command="{Binding DongDialogQuyetToanCommand}"/>
                </Border.InputBindings>
            </Border>

            <!-- Khung hộp thoại -->
            <Border Background="White" CornerRadius="16" Width="560" MaxWidth="600"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Padding="26" BorderBrush="#E2E8F0" BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="25" ShadowDepth="8" Opacity="0.3" Color="#000000"/>
                </Border.Effect>
                <StackPanel>
                    <!-- Header Modal có nút [✕ Đóng] chuẩn Stayly Admin -->
                    <DockPanel LastChildFill="True" Margin="0,0,0,16">
                        <Button DockPanel.Dock="Right" Command="{Binding DongDialogQuyetToanCommand}"
                                Content="✕ Đóng" ToolTip="Đóng cửa sổ (hoặc nhấp chuột ra ngoài màn hình)"
                                Background="#F1F5F9" Foreground="#64748B" BorderThickness="0"
                                FontWeight="Bold" FontSize="11.5" Padding="14,6" Cursor="Hand" VerticalAlignment="Center">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="6"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="38" Height="38" CornerRadius="10" Background="{Binding MauNenIconDialogQuyetToan, FallbackValue='#DCFCE7'}" Margin="0,0,12,0">
                                <TextBlock Text="{Binding IconDialogQuyetToan, FallbackValue='💳'}" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding TieuDeDialogQuyetToan, FallbackValue='Xác Nhận Quyết Toán Cho Chủ Homestay'}" FontSize="16" FontWeight="Bold" Foreground="#0F172A"/>
                                <TextBlock Text="{Binding PhuDeDialogQuyetToan, FallbackValue='Chuyển khoản thủ công qua ngân hàng và đối soát mã giao dịch'}" FontSize="11.5" Foreground="#64748B"/>
                            </StackPanel>
                        </StackPanel>
                    </DockPanel>

                    <!-- Thẻ tóm tắt thông tin thanh toán & Tài khoản ngân hàng Host -->
                    <Border Background="#F8FAFC" CornerRadius="12" BorderBrush="#E2E8F0" BorderThickness="1" Padding="16" Margin="0,0,0,16">
                        <StackPanel>
                            <!-- Hàng 1: Mã đơn & Cơ sở -->
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Đơn đặt phòng:" FontSize="12" Foreground="#64748B" Width="120"/>
                                <TextBlock Grid.Column="1" Text="{Binding DonDangQuyetToan.MaDonHienThi}" FontWeight="Bold" Foreground="#0194F3" FontSize="12.5"/>
                            </Grid>

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Chỗ nghỉ:" FontSize="12" Foreground="#64748B" Width="120"/>
                                <TextBlock Grid.Column="1" Text="{Binding DonDangQuyetToan.TenCoSo}" FontWeight="SemiBold" Foreground="#0F172A" FontSize="12"/>
                            </Grid>

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Chủ Homestay:" FontSize="12" Foreground="#64748B" Width="120"/>
                                <TextBlock Grid.Column="1" Text="{Binding DonDangQuyetToan.TenChuHome}" FontWeight="Bold" Foreground="#0F172A" FontSize="12"/>
                            </Grid>

                            <Separator Background="#E2E8F0" Margin="0,4,0,10"/>

                            <!-- Thông tin ngân hàng của Host -->
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Ngân hàng nhận:" FontSize="12" Foreground="#64748B" Width="120"/>
                                <TextBlock Grid.Column="1" Text="{Binding DonDangQuyetToan.TenNganHangChuHome, FallbackValue='Chưa cập nhật'}" FontWeight="Bold" Foreground="#0F172A" FontSize="12.5"/>
                            </Grid>

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Số tài khoản:" FontSize="12" Foreground="#64748B" Width="120"/>
                                <TextBlock Grid.Column="1" Text="{Binding DonDangQuyetToan.SoTaiKhoanNganHangChuHome, FallbackValue='Chưa cập nhật'}" FontWeight="Black" Foreground="#15803D" FontSize="14" FontFamily="Consolas"/>
                            </Grid>

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Chủ tài khoản:" FontSize="12" Foreground="#64748B" Width="120"/>
                                <TextBlock Grid.Column="1" Text="{Binding DonDangQuyetToan.ChuTaiKhoanNganHangChuHome, FallbackValue='Chưa cập nhật'}" FontWeight="SemiBold" Foreground="#0F172A" FontSize="12"/>
                            </Grid>

                            <Separator Background="#E2E8F0" Margin="0,4,0,10"/>

                            <!-- Số tiền thực chi trả (85%) -->
